---
// src/layouts/Layout.astro
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { tools } from "../data/tools.js";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/effects.css";
import "../styles/pages.css";

const {
  title = "TooManyToolz — Free Online Developer Tools",
  description = `${tools.length}+ free online tools for developers, creators, and everyday tasks. Fast, simple, and it never leaves your browser.`,
  ogTitle,
  ogDescription,
  ogImage,
  faqItems = [],
  breadcrumbs = [],
  appName,
  appCategory = "UtilitiesApplication",
} = Astro.props;

const resolvedOgTitle = ogTitle || title;
const resolvedOgDescription = ogDescription || description;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);

// FAQPage — accepts either { q, a } (content files) or { question, answer } (tools.js fallback)
const faqSchema = faqItems.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map((item) => ({
    "@type": "Question",
    "name": item.q ?? item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a ?? item.answer,
    },
  })),
} : null;

// WebPage — always present, describes the current page itself
const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": title,
  "description": description,
  "url": canonicalURL.toString(),
};

// BreadcrumbList — only when the page supplies a trail (e.g. Home / Category / Tool)
const breadcrumbSchema = breadcrumbs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.map((crumb, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": crumb.name,
    "item": new URL(crumb.url, Astro.site || Astro.url.origin).toString(),
  })),
} : null;

// SoftwareApplication — only when a page identifies itself as a tool (pass appName)
const softwareAppSchema = appName ? {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": appName,
  "applicationCategory": appCategory,
  "operatingSystem": "Any (runs in browser)",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD",
  },
} : null;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
   <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light dark" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <title>{title}</title>  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={resolvedOgTitle} />
  <meta property="og:description" content={resolvedOgDescription} />
  <meta property="og:url" content={canonicalURL} />
  {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site || Astro.url.origin)} />}

  <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
  <meta name="twitter:title" content={resolvedOgTitle} />
  <meta name="twitter:description" content={resolvedOgDescription} />
  {ogImage && <meta name="twitter:image" content={new URL(ogImage, Astro.site || Astro.url.origin)} />}

  <script is:inline>
    const saved = localStorage.getItem('theme');
    if (saved === 'dark') {
      document.documentElement.classList.add('dark');
    }
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700;800&display=swap" rel="stylesheet" />

  {faqSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}
  <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
  {breadcrumbSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  )}
  {softwareAppSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(softwareAppSchema)} />
  )}

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-6N3REFVQ1L"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-6N3REFVQ1L');
  </script>
</head>
<body>
  <Navbar />
  <slot />
  <Footer />

  <script is:inline>
    // single delegated handler — works even if a page has a stray duplicate toggle
    document.addEventListener('click', (e) => {
      if (!e.target.closest('#theme-toggle')) return;
      document.documentElement.classList.toggle('dark');
      const isDark = document.documentElement.classList.contains('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      document.querySelectorAll('#theme-icon').forEach(el => { el.textContent = isDark ? '☀️' : '🌙'; });
    });
  </script>

  <script is:inline>
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in-view'); io.unobserve(e.target); } });
    }, { threshold: 0.15 });
    document.querySelectorAll('.reveal, .reveal-stagger').forEach((el) => io.observe(el));
  </script>
</body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg-page);
    color: var(--text-primary);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
  }
  a { text-decoration: none; color: inherit; }
  button, input { font-family: inherit; }
</style>

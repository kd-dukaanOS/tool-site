---
// src/layouts/Layout.astro
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { tools } from "../data/tools.js";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/effects.css";
import "../styles/pages.css";

const {
  title = "ToolSite — Free Online Developer Tools",
  description = `${tools.length}+ free online tools for developers, creators, and everyday tasks. Fast, simple, and it never leaves your browser.`,
  ogTitle,
  ogDescription,
  ogImage,
} = Astro.props;

const resolvedOgTitle = ogTitle || title;
const resolvedOgDescription = ogDescription || description;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={resolvedOgTitle} />
  <meta property="og:description" content={resolvedOgDescription} />
  <meta property="og:url" content={canonicalURL} />
  {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site || Astro.url.origin)} />}

  <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
  <meta name="twitter:title" content={resolvedOgTitle} />
  <meta name="twitter:description" content={resolvedOgDescription} />
  {ogImage && <meta name="twitter:image" content={new URL(ogImage, Astro.site || Astro.url.origin)} />}

  <script is:inline>
    const saved = localStorage.getItem('theme');
    if (saved === 'dark') {
      document.documentElement.classList.add('dark');
    }
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <Navbar />
  <slot />
  <Footer />

  <script is:inline>
    // single delegated handler — works even if a page has a stray duplicate toggle
    document.addEventListener('click', (e) => {
      if (!e.target.closest('#theme-toggle')) return;
      document.documentElement.classList.toggle('dark');
      const isDark = document.documentElement.classList.contains('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      document.querySelectorAll('#theme-icon').forEach(el => { el.textContent = isDark ? '☀️' : '🌙'; });
    });
  </script>

  <script is:inline>
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in-view'); io.unobserve(e.target); } });
    }, { threshold: 0.15 });
    document.querySelectorAll('.reveal, .reveal-stagger').forEach((el) => io.observe(el));
  </script>
</body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg-page);
    color: var(--text-primary);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
  }
  a { text-decoration: none; color: inherit; }
  button, input { font-family: inherit; }
</style>

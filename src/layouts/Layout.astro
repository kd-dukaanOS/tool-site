---
// src/layouts/Layout.astro
// Every page uses this: <Layout title="..." description="..."> your content </Layout>
import { categories, tools } from "../data/tools.js";

const { title = "ToolSite — Free Online Developer Tools", description = "77+ free online tools for developers, creators, and everyday tasks. Fast, simple, and it never leaves your browser." } = Astro.props;
const footerCategories = categories.slice(0, 4);
const footerPopular = tools.slice(0, 3);
const toolsForSearch = tools.map((t) => ({ name: t.name, slug: t.slug, category: t.category, desc: t.desc }));
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <script is:inline>
    const saved = localStorage.getItem('theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    if (saved === 'dark' || (!saved && prefersDark)) {
      document.documentElement.classList.add('dark');
    }
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>

  <header>
    <div class="wrap bar">
      <a href="/" class="logo"><span class="mark">T</span>ToolSite</a>
      <nav class="top">
        <a href="/tools/">Tools</a>
        <a href="/categories/">Categories</a>
        <a href="/blog/">Blog</a>
        <a href="/about/">About</a>
      </nav>
      <div class="header-search" id="header-search-wrap">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
        <input placeholder="Search tools…" id="header-search-input" autocomplete="off" />
        <button class="search-clear" id="header-search-clear" type="button" aria-label="Clear search">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
        <div class="search-suggestions" id="header-search-suggestions"></div>
      </div>
      <button class="icon-btn" id="dark-toggle" aria-label="Toggle dark mode">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1111.2 3 7 7 0 0021 12.8z"/></svg>
      </button>
    </div>
  </header>

  <slot />

  <footer>
    <div class="wrap">
      <div class="footer-grid">
        <div>
          <div class="logo"><span class="mark">T</span>ToolSite</div>
          <p style="font-size:13px;color:var(--muted);margin-top:12px;max-width:220px;">Fast, private, free tools for everyday work — nothing ever leaves your browser.</p>
        </div>
        <div><h5>Categories</h5><ul>{footerCategories.map(c => <li><a href={`/${c.slug}/`}>{c.name}</a></li>)}</ul></div>
        <div><h5>Resources</h5><ul><li><a href="/blog/">Blog</a></li><li><a href="/about/">About</a></li><li><a href="/request-a-tool/">Request a Tool</a></li><li><a href="/contact/">Contact</a></li></ul></div>
        <div><h5>Popular</h5><ul>{footerPopular.map(t => <li><a href={`/${t.category}/${t.slug}/`}>{t.name}</a></li>)}</ul></div>
      </div>
      <div class="footer-bottom">
        <span>© 2026 ToolSite. All rights reserved.</span>
        <span><a href="/privacy-policy/">Privacy Policy</a> · <a href="/terms/">Terms & Conditions</a></span>
      </div>
    </div>
  </footer>

  <script is:inline>
    document.getElementById('dark-toggle').addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
  </script>

  <script define:vars={{ toolsForSearch }}>
    const input = document.getElementById('header-search-input');
    const clearBtn = document.getElementById('header-search-clear');
    const suggestionsBox = document.getElementById('header-search-suggestions');
    const wrap = document.getElementById('header-search-wrap');

    function renderSuggestions(query) {
      const q = query.trim().toLowerCase();
      if (!q) {
        suggestionsBox.innerHTML = '';
        suggestionsBox.classList.remove('open');
        return;
      }
      const matches = toolsForSearch
        .filter((t) => t.name.toLowerCase().startsWith(q))
        .slice(0, 6);

      if (matches.length === 0) {
        suggestionsBox.innerHTML = '<div class="search-empty">No tools found</div>';
        suggestionsBox.classList.add('open');
        return;
      }

      suggestionsBox.innerHTML = matches
        .map(
          (t) =>
            `<a href="/${t.category}/${t.slug}/" class="search-item"><span class="search-item-name">${t.name}</span><span class="search-item-desc">${t.desc}</span></a>`
        )
        .join('');
      suggestionsBox.classList.add('open');
    }

    input?.addEventListener('input', () => {
      clearBtn.style.display = input.value ? 'flex' : 'none';
      renderSuggestions(input.value);
    });

    input?.addEventListener('focus', () => {
      if (input.value) renderSuggestions(input.value);
    });

    clearBtn?.addEventListener('click', () => {
      input.value = '';
      clearBtn.style.display = 'none';
      suggestionsBox.innerHTML = '';
      suggestionsBox.classList.remove('open');
      input.focus();
    });

    document.addEventListener('click', (e) => {
      if (!wrap.contains(e.target)) {
        suggestionsBox.classList.remove('open');
      }
    });

    input?.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        suggestionsBox.classList.remove('open');
        input.blur();
      }
    });
  </script>

</body>
</html>

<style is:global>
  :root {
    --bg: #F8FAFC; --surface: #FFFFFF; --ink: #0F172A; --muted: #64748B; --border: #E2E8F0;
    --primary: #4F46E5; --primary-hover: #4338CA; --accent: #06B6D4;
    --accent-soft: #ECFEFF; --primary-soft: #EEF2FF; --success: #10B981;
    --shadow-sm: 0 1px 2px rgba(15,23,42,.04);
    --shadow-lg: 0 20px 40px -12px rgba(79,70,229,.18);
    color-scheme: light;
  }
  html.dark {
    --bg: #09090B; --surface: #111217; --ink: #F1F5F9; --muted: #8B93A3; --border: #23252D;
    --primary-soft: #1B1B2E; --accent-soft: #0B2027;
    --shadow-lg: 0 20px 40px -12px rgba(0,0,0,.5);
    color-scheme: dark;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--ink); font-family: 'Inter', system-ui, sans-serif; -webkit-font-smoothing: antialiased; transition: background .2s ease, color .2s ease; }
  a { text-decoration: none; color: inherit; }
  .wrap { max-width: 1120px; margin: 0 auto; padding: 0 24px; }
  code, .mono { font-family: 'JetBrains Mono', monospace; }

  header { position: sticky; top: 0; background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--border); z-index: 20; }
  header .bar { display: flex; align-items: center; gap: 28px; height: 68px; }
  .logo { display: flex; align-items: center; gap: 9px; font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 18px; }
  .logo .mark { width: 30px; height: 30px; border-radius: 8px; background: linear-gradient(135deg, var(--primary), var(--accent)); display: flex; align-items: center; justify-content: center; color: #fff; font-size: 14px; font-weight: 700; }
  nav.top { display: flex; gap: 22px; font-size: 14px; color: var(--muted); font-weight: 500; }
  nav.top a:hover { color: var(--ink); }
  .header-search { position: relative; margin-left: auto; display: flex; align-items: center; gap: 8px; border: 1px solid var(--border); background: var(--surface); border-radius: 8px; padding: 8px 12px; color: var(--muted); font-size: 13px; width: 220px; cursor: text; transition: width .2s ease, border-color .2s ease; }
  .header-search:hover, .header-search:focus-within { width: 280px; border-color: var(--primary); }
  .header-search input { border: none; outline: none; background: none; flex: 1; font-size: 13px; color: var(--ink); font-family: inherit; }
  .search-clear { display: none; align-items: center; justify-content: center; background: none; border: none; color: var(--muted); cursor: pointer; padding: 2px; flex-shrink: 0; }
  .search-clear:hover { color: var(--ink); }
  .search-suggestions { display: none; position: absolute; top: calc(100% + 10px); left: 0; right: 0; min-width: 260px; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; box-shadow: var(--shadow-lg); overflow: hidden; z-index: 30; }
  .search-suggestions.open { display: block; }
  .search-item { display: flex; flex-direction: column; gap: 2px; padding: 10px 14px; border-bottom: 1px solid var(--border); }
  .search-item:last-child { border-bottom: none; }
  .search-item:hover { background: var(--primary-soft); }
  .search-item-name { font-size: 13.5px; font-weight: 600; color: var(--ink); }
  .search-item-desc { font-size: 12px; color: var(--muted); }
  .search-empty { padding: 14px; font-size: 13px; color: var(--muted); text-align: center; }
  .icon-btn { width: 36px; height: 36px; border-radius: 8px; border: 1px solid var(--border); background: var(--surface); display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--ink); flex-shrink: 0; }
  .icon-btn:hover { border-color: var(--primary); }
  button:focus-visible, a:focus-visible, input:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }

  .hero { padding: 84px 0 56px; text-align: center; }
  .eyebrow { display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; font-weight: 600; color: var(--primary); background: var(--primary-soft); border-radius: 20px; padding: 6px 14px; margin-bottom: 24px; }
  h1 { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: clamp(34px, 6vw, 58px); line-height: 1.08; letter-spacing: -0.02em; margin: 0 0 18px; }
  h1 .accent-text { background: linear-gradient(135deg, var(--primary), var(--accent)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .hero p.sub { font-size: 17px; color: var(--muted); max-width: 480px; margin: 0 auto 36px; line-height: 1.6; }
  .hero-search { max-width: 560px; margin: 0 auto; display: flex; align-items: center; gap: 12px; border: 1px solid var(--border); background: var(--surface); border-radius: 14px; padding: 16px 20px; box-shadow: var(--shadow-sm); }
  .hero-search input { flex: 1; border: none; outline: none; background: none; font-size: 15px; color: var(--ink); font-family: inherit; }
  .hero-search kbd { font-family: 'JetBrains Mono', monospace; font-size: 11px; border: 1px solid var(--border); border-radius: 5px; padding: 3px 7px; color: var(--muted); }
  .hero-search .go { width: 34px; height: 34px; border-radius: 9px; border: none; background: var(--primary); color: #fff; display: flex; align-items: center; justify-content: center; cursor: pointer; }
  .hero-search .go:hover { background: var(--primary-hover); }

  .popular-searches { margin-top: 22px; display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; font-size: 12.5px; color: var(--muted); }
  .popular-searches span.label { padding-top: 5px; }
  .stat-strip { margin-top: 40px; display: flex; justify-content: center; gap: 48px; flex-wrap: wrap; }
  .stat-strip .stat { display: flex; flex-direction: column; align-items: center; gap: 2px; }
  .stat-strip .stat strong { font-family: 'Space Grotesk', sans-serif; font-size: 24px; color: var(--ink); }
  .stat-strip .stat span { font-size: 12px; color: var(--muted); }
  .tag-pill { border: 1px solid var(--border); background: var(--surface); border-radius: 20px; padding: 5px 12px; }
  .tag-pill:hover { border-color: var(--primary); color: var(--primary); }

  .section { padding: 56px 0; }
  .section-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 24px; }
  .section-head h2 { font-family: 'Space Grotesk', sans-serif; font-size: 24px; font-weight: 600; margin: 0; letter-spacing: -0.01em; }
  .section-head a { font-size: 13.5px; font-weight: 600; color: var(--primary); }

  .cat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .cat-card { position: relative; display: block; border: 1px solid var(--border); background: var(--surface); border-radius: 16px; padding: 26px; overflow: hidden; box-shadow: var(--shadow-sm); transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }
  .cat-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, var(--primary), var(--accent)); opacity: 0; transition: opacity .18s ease; }
  .cat-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); border-color: transparent; }
  .cat-card:hover::before { opacity: 1; }
  .cat-icon { width: 44px; height: 44px; border-radius: 11px; background: var(--accent-soft); color: var(--accent); display: flex; align-items: center; justify-content: center; margin-bottom: 16px; }
  .cat-card h3 { font-family: 'Space Grotesk', sans-serif; font-size: 17px; font-weight: 600; margin: 0 0 4px; }
  .cat-card .count { font-size: 12.5px; color: var(--muted); margin: 0 0 10px; }
  .cat-card .cat-desc { font-size: 13px; color: var(--muted); line-height: 1.5; margin: 0 0 14px; }
  .cat-card .tool-list { list-style: none; margin: 0 0 16px; padding: 0; font-size: 13px; color: var(--muted); display: flex; flex-direction: column; gap: 6px; }
  .cat-card .explore { font-size: 13px; font-weight: 600; color: var(--primary); display: flex; align-items: center; gap: 5px; padding-top: 12px; border-top: 1px solid var(--border); }

  .tool-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .tool-card { display: flex; gap: 14px; align-items: flex-start; border: 1px solid var(--border); background: var(--surface); border-radius: 14px; padding: 18px; box-shadow: var(--shadow-sm); transition: transform .15s ease, box-shadow .15s ease; }
  .tool-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-lg); }
  .tool-icon { width: 38px; height: 38px; border-radius: 9px; background: var(--primary-soft); color: var(--primary); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .tool-card h4 { font-size: 14.5px; font-weight: 600; margin: 0 0 3px; }
  .tool-card p { font-size: 12.5px; color: var(--muted); margin: 0; line-height: 1.4; }
  .tool-card .fav { margin-left: auto; color: var(--border); flex-shrink: 0; }

  /* Tool widget internals — used INSIDE individual tool pages (Word Counter, Base64, JSON Formatter, etc.) */
  .tool-panel { position: relative; background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 22px; box-shadow: var(--shadow-lg); overflow: hidden; }
  .tool-panel::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, var(--primary), var(--accent)); }

  .tool-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }

  .tool-label { display: block; font-size: 12.5px; font-weight: 600; color: var(--muted); margin-bottom: 6px; }
  .tool-textarea { width: 100%; min-height: 180px; resize: vertical; border: 1px solid var(--border); border-radius: 9px; padding: 12px 14px; font-family: 'JetBrains Mono', monospace; font-size: 13px; color: var(--ink); background: var(--bg); outline: none; transition: border-color .15s ease; }
  .tool-textarea:focus { border-color: var(--primary); }
  .tool-textarea[readonly] { background: var(--primary-soft); color: var(--muted); }

  .tool-stats { display: flex; gap: 12px; margin-top: 16px; flex-wrap: wrap; }
  .tool-stat { flex: 1; min-width: 100px; background: var(--primary-soft); border-radius: 11px; padding: 10px 16px; }
  .tool-stat:nth-child(even) { background: var(--accent-soft); }
  .tool-stat .value { font-family: 'Space Grotesk', sans-serif; font-size: 22px; font-weight: 700; background: linear-gradient(135deg, var(--primary), var(--accent)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .tool-stat .label { font-size: 11px; color: var(--muted); margin-top: 2px; }

  .tool-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
  .tool-btn { border: none; border-radius: 9px; padding: 10px 18px; font-size: 13px; font-weight: 600; cursor: pointer; font-family: inherit; transition: opacity .15s ease, transform .1s ease; }
  .tool-btn:active { transform: scale(.97); }
  .tool-btn-primary { background: linear-gradient(135deg, var(--primary), var(--accent)); color: #fff; }
  .tool-btn-primary:hover { opacity: .92; }
  .tool-btn-secondary { background: var(--primary-soft); color: var(--primary); }
  .tool-btn-secondary:hover { opacity: .85; }
  .tool-btn-danger { background: transparent; color: #DC2626; border: 1px solid var(--border); }
  .tool-btn-danger:hover { border-color: #DC2626; }

  .tool-error { color: #DC2626; font-size: 13px; font-weight: 600; margin-top: 12px; }

  @media (max-width: 640px) {
    .tool-grid-2 { grid-template-columns: 1fr; }
  }

  .newsletter { border: 1px solid var(--border); background: linear-gradient(135deg, var(--primary-soft), var(--accent-soft)); border-radius: 20px; padding: 40px; display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .newsletter h3 { font-family: 'Space Grotesk', sans-serif; font-size: 20px; margin: 0 0 6px; }
  .newsletter p { font-size: 13.5px; color: var(--muted); margin: 0; }
  .newsletter form { display: flex; gap: 10px; }
  .newsletter input { border: 1px solid var(--border); border-radius: 9px; padding: 12px 14px; font-size: 13.5px; width: 220px; background: var(--surface); color: var(--ink); font-family: inherit; }
  .newsletter button { border: none; background: var(--primary); color: #fff; border-radius: 9px; padding: 12px 20px; font-size: 13.5px; font-weight: 600; cursor: pointer; }
  .newsletter button:hover { background: var(--primary-hover); }

  footer { border-top: 1px solid var(--border); margin-top: 40px; padding: 48px 0 28px; }
  .footer-grid { display: grid; grid-template-columns: 1.4fr repeat(3, 1fr); gap: 32px; margin-bottom: 32px; }
  .footer-grid h5 { font-size: 12.5px; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); margin: 0 0 14px; }
  .footer-grid ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; font-size: 13.5px; color: var(--muted); }
  .footer-grid ul a:hover { color: var(--ink); }
  .footer-bottom { display: flex; justify-content: space-between; padding-top: 24px; border-top: 1px solid var(--border); font-size: 12.5px; color: var(--muted); flex-wrap: wrap; gap: 12px; }

  /* Category page extras */
  .breadcrumb { font-size: 13px; color: var(--muted); padding: 24px 0 0; }
  .breadcrumb a:hover { color: var(--primary); }
  .category-header { padding: 24px 0 40px; display: flex; align-items: center; gap: 18px; }
  .category-header .cat-icon { width: 56px; height: 56px; margin-bottom: 0; }
  .category-header h1 { font-size: 30px; margin: 0 0 6px; }
  .category-header p { color: var(--muted); font-size: 14.5px; margin: 0; max-width: 520px; }

  @media (max-width: 860px) {
    .cat-grid, .tool-grid { grid-template-columns: repeat(2, 1fr); }
    .footer-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    nav.top, .header-search { display: none; }
    .cat-grid, .tool-grid { grid-template-columns: 1fr; }
    .footer-grid { grid-template-columns: 1fr; }
    .newsletter { flex-direction: column; align-items: stretch; text-align: left; }
    .newsletter form { flex-direction: column; }
    .newsletter input { width: 100%; }
    .hero { padding: 48px 0 40px; }
    .category-header { flex-direction: column; align-items: flex-start; }
  }
</style>

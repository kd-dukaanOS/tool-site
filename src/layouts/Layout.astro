---
// src/layouts/Layout.astro
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/effects.css";
import "../styles/pages.css";

const {
  title = "ToolSite — Free Online Developer Tools",
  description = "77+ free online tools for developers, creators, and everyday tasks. Fast, simple, and it never leaves your browser.",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <script is:inline>
    const saved = localStorage.getItem('theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    if (saved === 'dark' || (!saved && prefersDark)) {
      document.documentElement.classList.add('dark');
    }
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <Navbar />
  <slot />
  <Footer />

  <script is:inline>
    // persist whatever Navbar's #theme-toggle button switches
    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.contains('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
  </script>

  <script is:inline>
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in-view'); io.unobserve(e.target); } });
    }, { threshold: 0.15 });
    document.querySelectorAll('.reveal, .reveal-stagger').forEach((el) => io.observe(el));
  </script>
</body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg-page);
    color: var(--text-primary);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
  }
  a { text-decoration: none; color: inherit; }
  button, input { font-family: inherit; }
</style>

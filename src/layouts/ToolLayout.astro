---
import '../styles/global.css'; // adjust path to wherever you place global.css

export interface Props {
  title: string;         // e.g. "Base64 Encoder & Decoder"
  description: string;   // 1-2 sentence meta description
  slug: string;           // e.g. "base64-encoder-decoder" -> /tools/base64-encoder-decoder
}

const { title, description, slug } = Astro.props;
const siteName = 'YourToolSite'; // TODO: replace with your real site name
const canonicalURL = new URL(`/tools/${slug}`, Astro.site);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Unique per-page SEO tags -->
    <title>{title} — {siteName}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / social sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} — ${siteName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} — ${siteName}`} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="site-logo">{siteName}</a>
      <nav>
        <a href="/tools">All Tools</a>
      </nav>
    </header>

    <nav aria-label="Breadcrumb" class="breadcrumb">
      <a href="/">Home</a> / <a href="/tools">Tools</a> / <span>{title}</span>
    </nav>

    <main class="site-main">
      <h1>{title}</h1>
      <slot />
    </main>

    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} {siteName}. All tools run entirely in your browser — nothing is uploaded.</p>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  .site-logo {
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--color-text);
    text-decoration: none;
  }
  .breadcrumb {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    padding: 0.75rem 1.5rem 0;
  }
  .breadcrumb a {
    color: var(--color-text-muted);
  }
  .site-main {
    max-width: 720px;
    margin: 0 auto;
    padding: 1.5rem;
  }
  .site-main h1 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .site-footer {
    text-align: center;
    padding: 1.5rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }
</style>

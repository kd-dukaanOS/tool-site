---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import { categories, tools, categoryIcons } from "../data/tools.js";

const popularSearches = ["JSON Formatter", "Word Counter", "UUID Generator", "Hash Generator"];

// homepage shows a 3-tool preview per category + a curated "most popular" row
const previewByCategory = categories.map(cat => ({
  ...cat,
  icon: categoryIcons[cat.slug],
  count: tools.filter(t => t.category === cat.slug).length,
  preview: tools.filter(t => t.category === cat.slug).slice(0, 3),
}));

const popularSlugs = ["json-formatter", "base64-tool", "uuid-generator", "password-generator", "emi-calculator", "bmi-calculator"];
const popularTools = popularSlugs
  .map(slug => tools.find(t => t.slug === slug))
  .filter((t): t is NonNullable<typeof t> => t !== undefined)
  .map(t => ({ ...t, icon: categoryIcons[t.category] }));

const catColors: Record<string, { fg: string; bg: string }> = {
  "text-tools": { fg: "#4F46E5", bg: "#EEF2FF" },
  "developer-tools": { fg: "#7C3AED", bg: "#F3EEFF" },
  "converters": { fg: "#06B6D4", bg: "#ECFEFF" },
  "security-tools": { fg: "#DC2626", bg: "#FEF2F2" },
  "generators-calculators": { fg: "#D97706", bg: "#FFFBEB" },
  "finance": { fg: "#059669", bg: "#ECFDF5" },
  "health": { fg: "#DB2777", bg: "#FDF2F8" },
  "date-time": { fg: "#2563EB", bg: "#EFF6FF" },
  "math-stats": { fg: "#0891B2", bg: "#ECFEFF" },
};
---

<Layout>
  <section class="hero">
    <div class="wrap">
      <span class="eyebrow">✦ 77+ Free Tools · No Sign-up · Privacy First</span>
      <h1>Essential Tools.<br /><span class="accent-text">Instant</span> Results.</h1>
      <p class="sub">77+ fast, free browser-based tools for developers, creators, and everyday tasks — no installs, no accounts, and nothing ever leaves your device.</p>
      <div class="hero-search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--muted)"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
        <input placeholder="Search any tool…" id="hero-search-input" />
        <kbd>Ctrl /</kbd>
        <button class="go" aria-label="Search">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
      </div>
      <div class="popular-searches">
        <span class="label">Popular:</span>
        {popularSearches.map(term => <span class="tag-pill">{term}</span>)}
      </div>
      <div class="stat-strip">
        <div class="stat"><strong>{tools.length}+</strong><span>Free tools</span></div>
        <div class="stat"><strong>0</strong><span>Sign-ups needed</span></div>
        <div class="stat"><strong>100%</strong><span>Runs in your browser</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><h2>Browse by category</h2><a href="/categories/">View all →</a></div>
      <div class="cat-grid">
        {previewByCategory.map(cat => (
          <a href={`/${cat.slug}/`} class="cat-card">
            <div class="cat-icon" style={`background:${catColors[cat.slug]?.bg};color:${catColors[cat.slug]?.fg}`}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" set:html={cat.icon} /></div>
            <h3>{cat.name}</h3>
            <p class="count">{cat.count} tools</p>
            <p class="cat-desc">{cat.description}</p>
            <ul class="tool-list">{cat.preview.map(t => <li>{t.name}</li>)}</ul>
            <div class="explore">Explore <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="section-head"><h2>Most popular tools</h2><a href="/tools/">View all →</a></div>
      <div class="tool-grid">
        {popularTools.map(tool => (
          <a href={`/${tool.category}/${tool.slug}/`} class="tool-card">
            <div class="tool-icon"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" set:html={tool.icon} /></div>
            <div><h4>{tool.name}</h4><p>{tool.desc}</p></div>
            <svg class="fav" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s-7-4.5-9.3-8.7C1 8.4 2.7 5 6.3 5 8.4 5 10 6.2 12 8.5 14 6.2 15.6 5 17.7 5c3.6 0 5.3 3.4 3.6 7.3C19 16.5 12 21 12 21z"/></svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="newsletter">
        <div>
          <h3>New tools, before anyone else</h3>
          <p>One short email when we ship something new. No spam, unsubscribe anytime.</p>
        </div>
        <form onsubmit="return false">
          <input type="email" placeholder="Enter your email" required />
          <button type="submit">Subscribe</button>
        </form>
      </div>
    </div>
  </section>
</Layout>

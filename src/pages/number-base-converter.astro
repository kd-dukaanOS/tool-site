---
import Layout from '../layouts/Layout.astro';
import FaqSection from '../components/FaqSection.astro';
const faqs = [
  { question: "Why do computers use binary instead of decimal?", answer: "Computers are built from electronic switches with two states (on/off), which map directly to binary's two digits (0 and 1), making binary the natural internal representation for digital hardware." },
  { question: "Why is hexadecimal commonly used in programming?", answer: "Hexadecimal is compact and maps cleanly to binary (each hex digit represents exactly 4 binary digits), making it a convenient shorthand for things like memory addresses and color codes." },
  { question: "How do I convert binary to decimal manually?", answer: "Multiply each binary digit by its corresponding power of 2 (starting from the rightmost digit as 2⁰) and sum the results." },
  { question: "What is octal used for today?", answer: "Octal is less common now but still appears in some legacy systems and in Unix/Linux file permission notation (like chmod 755)." },
  { question: "Can this tool handle negative numbers?", answer: "This tool is designed for positive whole numbers across all four bases; negative number representation varies by system and isn't covered here." },
];
---

<Layout title="Free Number Base Converter — Binary, Decimal, Hex, Octal">
  <main class="max-w-4xl mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold text-gray-800 mb-2">Number Base Converter</h1>
    <p class="text-gray-600 mb-6">Convert numbers between binary, decimal, hexadecimal, and octal instantly.</p>

    <div class="space-y-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Decimal</label>
        <input id="decimalInput" type="text" class="w-full p-2 border border-gray-300 rounded-lg font-mono text-sm focus:outline-none focus:ring-2 focus:ring-blue-400" placeholder="e.g. 255" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Binary</label>
        <input id="binaryInput" type="text" class="w-full p-2 border border-gray-300 rounded-lg font-mono text-sm focus:outline-none focus:ring-2 focus:ring-blue-400" placeholder="e.g. 11111111" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Hexadecimal</label>
        <input id="hexInput" type="text" class="w-full p-2 border border-gray-300 rounded-lg font-mono text-sm focus:outline-none focus:ring-2 focus:ring-blue-400" placeholder="e.g. ff" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Octal</label>
        <input id="octalInput" type="text" class="w-full p-2 border border-gray-300 rounded-lg font-mono text-sm focus:outline-none focus:ring-2 focus:ring-blue-400" placeholder="e.g. 377" />
      </div>
    </div>

    <p id="baseError" class="text-red-600 mt-3 font-medium"></p>

    <section class="mt-12 text-gray-700 leading-relaxed">
      <h2 class="text-xl font-semibold mb-2">About This Number Base Converter</h2>
      <p>
        Different numeral systems represent numbers using different bases: decimal (base 10) is what we use daily,
        binary (base 2) is used internally by computers, hexadecimal (base 16) is common in programming and color
        codes, and octal (base 8) appears in some legacy systems and file permissions. Type a number into any field
        and this tool instantly converts it into all the others.
      </p>
    </section>

    <FaqSection faqs={faqs} />
  </main>
</Layout>

<script>
  // @ts-nocheck
  const decimalInput = document.getElementById('decimalInput');
  const binaryInput = document.getElementById('binaryInput');
  const hexInput = document.getElementById('hexInput');
  const octalInput = document.getElementById('octalInput');
  const errorEl = document.getElementById('baseError');

  function updateAll(sourceValue, sourceBase) {
    errorEl.textContent = '';
    if (!sourceValue) {
      [decimalInput, binaryInput, hexInput, octalInput].forEach(el => { if (el !== document.activeElement) el.value = ''; });
      return;
    }

    const decimalValue = parseInt(sourceValue, sourceBase);
    if (isNaN(decimalValue)) {
      errorEl.textContent = 'Invalid number for this base.';
      return;
    }

    if (decimalInput !== document.activeElement) decimalInput.value = decimalValue.toString(10);
    if (binaryInput !== document.activeElement) binaryInput.value = decimalValue.toString(2);
    if (hexInput !== document.activeElement) hexInput.value = decimalValue.toString(16);
    if (octalInput !== document.activeElement) octalInput.value = decimalValue.toString(8);
  }

  decimalInput?.addEventListener('input', () => updateAll(decimalInput.value, 10));
  binaryInput?.addEventListener('input', () => updateAll(binaryInput.value, 2));
  hexInput?.addEventListener('input', () => updateAll(hexInput.value, 16));
  octalInput?.addEventListener('input', () => updateAll(octalInput.value, 8));
</script>
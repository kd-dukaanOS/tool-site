---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<Layout title="Blog — ToolSite" description="Guides on tax, salary and everyday calculations, with the tools to do the math for you.">
  <section class="ts-blog-index">
    <div class="ts-blog-index-inner">
      <h1>Blog</h1>
      <p class="ts-blog-index-sub">Guides on tax, salary and everyday calculations.</p>
      <div class="ts-blog-list">
        {posts.map((post) => (
          <a class={`ts-blog-card ${post.data.heroImage ? '' : 'ts-blog-card-no-thumb'}`} href={`/blog/${post.id}/`}>
            {post.data.heroImage && (
              <div class="ts-blog-card-thumb">
                <img src={post.data.heroImage} alt={post.data.title} loading="lazy" />
              </div>
            )}
            <div class="ts-blog-card-body">
              <span class="ts-blog-card-date">
                {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </span>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
              <span class="ts-blog-card-cta">Read guide →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .ts-blog-index { padding: var(--space-12) var(--space-6); }
  .ts-blog-index-inner { max-width: 780px; margin: 0 auto; }
  .ts-blog-index-inner h1 { font-family: var(--font-sans); font-size: var(--fs-h1, var(--fs-h2)); font-weight: 800; color: var(--text-primary); margin: 0 0 var(--space-2); }
  .ts-blog-index-sub { font-size: var(--fs-body); color: var(--text-secondary); margin: 0 0 var(--space-8); }
  .ts-blog-list { display: flex; flex-direction: column; gap: var(--space-5); }
  .ts-blog-card {
    display: flex; align-items: stretch; gap: var(--space-5);
    padding: var(--space-5); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg);
    background: var(--bg-card); text-decoration: none;
    box-shadow: 0 1px 2px rgba(0,0,0,0.04);
    transition: border-color .18s, transform .18s, box-shadow .18s;
  }
  .ts-blog-card:hover {
    border-color: var(--color-primary); transform: translateY(-3px);
    box-shadow: 0 12px 24px rgba(0,0,0,0.08);
  }
  .ts-blog-card-thumb {
    flex: 0 0 160px; width: 160px; height: 120px; border-radius: var(--radius-md);
    overflow: hidden; background: var(--bg-subtle, var(--border-subtle));
  }
  .ts-blog-card-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ts-blog-card-body { display: flex; flex-direction: column; flex: 1; min-width: 0; }
  .ts-blog-card-no-thumb .ts-blog-card-body { flex: 1; }
  .ts-blog-card-date {
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.03em; text-transform: uppercase;
    color: var(--color-primary); margin: 0 0 6px;
  }
  .ts-blog-card h2 {
    font-family: var(--font-sans); font-size: var(--fs-h3, var(--fs-body)); font-weight: 700;
    color: var(--text-primary); margin: 0 0 6px; line-height: 1.3;
  }
  .ts-blog-card p {
    font-size: var(--fs-small); color: var(--text-secondary); margin: 0 0 var(--space-2);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .ts-blog-card-cta {
    margin-top: auto; font-size: var(--fs-small); font-weight: 700; color: var(--color-primary);
  }
  @media (max-width: 560px) {
    .ts-blog-card { flex-direction: column; }
    .ts-blog-card-thumb { width: 100%; height: 160px; }
  }
  .ts-blog-post-content :global(h3) { font-size: var(--fs-body); font-weight: 700; margin: var(--space-6) 0 var(--space-2); }
  .ts-blog-post-content :global(blockquote) {
    border-left: 4px solid var(--color-primary); background: var(--bg-card);
    padding: var(--space-4) var(--space-5); margin: var(--space-6) 0;
    border-radius: var(--radius-md); font-size: var(--fs-body);
  }
  .ts-blog-post-content :global(blockquote p) { margin: 0 0 var(--space-2); }
  .ts-blog-post-content :global(blockquote a) { color: var(--color-primary); font-weight: 700; }
</style>
---
import Layout from "../../layouts/Layout.astro";

const tools = [
  {
    name: "US Take-Home Pay Calculator",
    href: "/finance/us-take-home-pay-calculator/",
    desc: "Estimate your net salary after federal income tax, Social Security and Medicare.",
  },
];
---
<Layout
  title="US Financial Calculators - Salary, Tax & Take-Home Pay Tools"
  description="Free US financial calculators covering take-home pay, federal tax and FICA deductions. Fast, accurate and no sign-up required."
>
  <section class="us-hub">
    <header class="us-hub__header">
      <h1>US Financial Calculators</h1>
      <p>
        Free tools to estimate your take-home pay, federal tax and payroll
        deductions in the United States. All calculations run in your
        browser — nothing is sent to a server.
      </p>
    </header>

    <section class="us-hub__grid">
      {tools.map((tool) => (
        <a class="us-hub__card" href={tool.href}>
          <h2>{tool.name}</h2>
          <p>{tool.desc}</p>
          <span class="us-hub__link">Open calculator →</span>
        </a>
      ))}
    </section>

    <section class="us-hub__note">
      <p>
        More US tools — including a standalone salary converter and
        state-level breakdowns — are on the way.
      </p>
    </section>
  </section>
</Layout>

<style>
.us-hub{max-width:960px;margin:0 auto;padding:48px 24px;}
.us-hub__header{margin-bottom:40px;}
.us-hub__header h1{font-size:2rem;font-weight:800;margin:0 0 12px;color:#111827;}
.us-hub__header p{font-size:1rem;line-height:1.7;color:#6B7280;max-width:640px;}
.us-hub__grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:20px;}
.us-hub__card{display:block;padding:24px;border:1px solid #E5E7EB;border-radius:18px;background:#FFFFFF;text-decoration:none;transition:border-color .15s,transform .15s;}
.us-hub__card:hover{border-color:#111827;transform:translateY(-2px);}
.us-hub__card h2{font-size:1.05rem;font-weight:700;margin:0 0 8px;color:#111827;}
.us-hub__card p{font-size:.9rem;line-height:1.6;color:#6B7280;margin:0 0 14px;}
.us-hub__link{font-size:.85rem;font-weight:600;color:#111827;}
.us-hub__note{margin-top:32px;padding:18px 20px;border-radius:14px;background:#F9FAFB;border:1px dashed #D1D5DB;}
.us-hub__note p{margin:0;font-size:.88rem;color:#6B7280;}
:global(.dark) .us-hub__header h1{color:#FAFAFA;}
:global(.dark) .us-hub__header p{color:#A1A1AA;}
:global(.dark) .us-hub__card{background:#111217;border-color:#27272A;}
:global(.dark) .us-hub__card:hover{border-color:#FAFAFA;}
:global(.dark) .us-hub__card h2{color:#FAFAFA;}
:global(.dark) .us-hub__card p{color:#A1A1AA;}
:global(.dark) .us-hub__note{background:#111217;border-color:#27272A;}
:global(.dark) .us-hub__note p{color:#A1A1AA;}
@media(max-width:640px){.us-hub{padding:32px 16px;}.us-hub__header h1{font-size:1.5rem;}}
</style>
---
import Layout from '../layouts/Layout.astro';
import FaqSection from '../components/FaqSection.astro';
const faqs = [
  { question: "What is Title Case used for?", answer: "Title Case capitalizes the first letter of most words and is commonly used for headings, blog titles, and book titles." },
  { question: "What's the difference between Sentence case and Title Case?", answer: "Sentence case only capitalizes the first word of each sentence (like normal prose), while Title Case capitalizes most words in a heading or title." },
  { question: "Can I convert text back to normal after using aLtErNaTiNg case?", answer: "Yes, paste your original text again or use the lowercase/UPPERCASE buttons to reset it to a standard case." },
  { question: "Does this tool work with special characters and numbers?", answer: "Yes, numbers and symbols are left unchanged — only letters are affected by the case conversion." },
  { question: "Is this tool free to use with no limits?", answer: "Yes, there's no character limit or sign-up required — paste any amount of text and convert it instantly." },
];
---

<Layout title="Free Case Converter Online — Upper, Lower, Title, Sentence Case">
  <main class="max-w-4xl mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold text-gray-800 mb-2">Case Converter</h1>
    <p class="text-gray-600 mb-6">Convert text between UPPERCASE, lowercase, Title Case, Sentence case, and more — instantly.</p>

    <textarea
      id="caseInput"
      class="w-full h-56 p-3 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-400"
      placeholder="Type or paste your text here..."
    ></textarea>

    <div class="flex flex-wrap gap-3 mt-4">
      <button id="upperBtn" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700">UPPERCASE</button>
      <button id="lowerBtn" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700">lowercase</button>
      <button id="titleBtn" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700">Title Case</button>
      <button id="sentenceBtn" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700">Sentence case</button>
      <button id="alternatingBtn" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700">aLtErNaTiNg</button>
      <button id="copyCaseBtn" class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700">Copy</button>
      <button id="clearCaseBtn" class="bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600">Clear</button>
    </div>

    <section class="mt-12 text-gray-700 leading-relaxed">
      <h2 class="text-xl font-semibold mb-2">About This Case Converter Tool</h2>
      <p>
        This free case converter lets you quickly transform text between different capitalization styles.
        Convert to UPPERCASE for emphasis, lowercase for consistency, Title Case for headings, Sentence case
        for proper prose, or even aLtErNaTiNg case for fun. The conversion happens instantly and directly in
        your browser — paste your text, click a button, and copy the result.
      </p>
    </section>

    <FaqSection faqs={faqs} />
  </main>
</Layout>

<script>
  const input = document.getElementById('caseInput');
  const upperBtn = document.getElementById('upperBtn');
  const lowerBtn = document.getElementById('lowerBtn');
  const titleBtn = document.getElementById('titleBtn');
  const sentenceBtn = document.getElementById('sentenceBtn');
  const alternatingBtn = document.getElementById('alternatingBtn');
  const copyBtn = document.getElementById('copyCaseBtn');
  const clearBtn = document.getElementById('clearCaseBtn');

  if (input instanceof HTMLTextAreaElement) {
    upperBtn?.addEventListener('click', () => {
      input.value = input.value.toUpperCase();
    });

    lowerBtn?.addEventListener('click', () => {
      input.value = input.value.toLowerCase();
    });

    titleBtn?.addEventListener('click', () => {
      input.value = input.value.replace(/\w\S*/g, (txt) => {
        return txt.charAt(0).toUpperCase() + txt.substring(1).toLowerCase();
      });
    });

    sentenceBtn?.addEventListener('click', () => {
      const lower = input.value.toLowerCase();
      input.value = lower.replace(/(^\s*\w|[.!?]\s*\w)/g, (c) => c.toUpperCase());
    });

    alternatingBtn?.addEventListener('click', () => {
      input.value = input.value
        .split('')
        .map((char, i) => (i % 2 === 0 ? char.toLowerCase() : char.toUpperCase()))
        .join('');
    });

    copyBtn?.addEventListener('click', () => {
      navigator.clipboard.writeText(input.value);
    });

    clearBtn?.addEventListener('click', () => {
      input.value = '';
    });
  }
</script>
---
import Layout from '../layouts/Layout.astro';
import FaqSection from '../components/FaqSection.astro';
const faqs = [
  { question: "Does this word counter count spaces as characters?", answer: "Yes, the 'Characters' count includes spaces, while 'Characters (no spaces)' excludes them, so you can check either depending on what your word limit requires." },
  { question: "How many words is a typical college essay?", answer: "Most US undergraduate college application essays require 200-650 words, while graduate school admission essays typically range from 1,500-5,000 words depending on the program." },
  { question: "How does this tool count sentences?", answer: "Sentences are counted by detecting periods, question marks, and exclamation points that end a group of words, so abbreviations with periods may occasionally be counted as sentence breaks." },
  { question: "Can I count words in a Word or Google Docs document?", answer: "Yes — copy your text from Word, Google Docs, or any app and paste it directly into the box above; the counter works with any pasted text." },
  { question: "Is this word counter free to use?", answer: "Yes, this tool is completely free with no sign-up required, and all counting happens instantly in your browser." },
];
---

<Layout title="Free Word Counter & Character Counter Online">
  <main class="max-w-4xl mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold text-gray-800 mb-2">Word & Character Counter</h1>
    <p class="text-gray-600 mb-6">Paste or type your text below to instantly see word count, character count, and more.</p>

    <textarea
      id="textInput"
      class="w-full h-64 p-3 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-400"
      placeholder="Start typing or paste your text here..."
    ></textarea>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-6">
      <div class="bg-white border border-gray-200 rounded-lg p-4 text-center">
        <div id="wordCount" class="text-2xl font-bold text-blue-600">0</div>
        <div class="text-sm text-gray-500">Words</div>
      </div>
      <div class="bg-white border border-gray-200 rounded-lg p-4 text-center">
        <div id="charCount" class="text-2xl font-bold text-blue-600">0</div>
        <div class="text-sm text-gray-500">Characters</div>
      </div>
      <div class="bg-white border border-gray-200 rounded-lg p-4 text-center">
        <div id="charNoSpaceCount" class="text-2xl font-bold text-blue-600">0</div>
        <div class="text-sm text-gray-500">Characters (no spaces)</div>
      </div>
      <div class="bg-white border border-gray-200 rounded-lg p-4 text-center">
        <div id="sentenceCount" class="text-2xl font-bold text-blue-600">0</div>
        <div class="text-sm text-gray-500">Sentences</div>
      </div>
    </div>

    <div class="flex gap-3 mt-4">
      <button id="clearTextBtn" class="bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600">Clear</button>
    </div>

    <section class="mt-12 text-gray-700 leading-relaxed">
      <h2 class="text-xl font-semibold mb-2">About This Word Counter Tool</h2>
      <p>
        This free word counter and character counter tool helps writers, students, and professionals instantly
        check the length of their text. Whether you're writing an essay with a word limit, a tweet with a
        character limit, or checking the length of an SEO meta description, this tool gives you real-time counts
        of words, characters (with and without spaces), and sentences — all calculated instantly in your browser
        as you type.
      </p>
    </section>

    <FaqSection faqs={faqs} />
  </main>
</Layout>

<script>
  const textInput = document.getElementById('textInput');
  const wordCount = document.getElementById('wordCount');
  const charCount = document.getElementById('charCount');
  const charNoSpaceCount = document.getElementById('charNoSpaceCount');
  const sentenceCount = document.getElementById('sentenceCount');
  const clearBtn = document.getElementById('clearTextBtn');

  if (
    textInput instanceof HTMLTextAreaElement &&
    wordCount &&
    charCount &&
    charNoSpaceCount &&
    sentenceCount
  ) {
    const updateCounts = () => {
      const text = textInput.value;

      const words = text.trim().length === 0 ? [] : text.trim().split(/\s+/);
      wordCount.textContent = String(words.length);

      charCount.textContent = String(text.length);

      charNoSpaceCount.textContent = String(text.replace(/\s/g, '').length);

      const sentences = text.trim().length === 0 ? [] : text.split(/[.!?]+/).filter(s => s.trim().length > 0);
      sentenceCount.textContent = String(sentences.length);
    };

    textInput.addEventListener('input', updateCounts);

    clearBtn?.addEventListener('click', () => {
      textInput.value = '';
      updateCounts();
    });
  }
</script>
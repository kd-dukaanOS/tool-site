---
import Layout from '../layouts/Layout.astro';
import FaqSection from '../components/FaqSection.astro';
const faqs = [
  { question: "What is a UUID used for?", answer: "A UUID is a 128-bit unique identifier commonly used as a database primary key, session token, or unique reference ID in distributed systems, without needing a central authority to avoid duplicates." },
  { question: "How unlikely is it for two UUIDs to be the same?", answer: "Version 4 UUIDs are generated from random numbers with so many possible combinations that the chance of a collision is astronomically small, even across billions of generated IDs." },
  { question: "Can I generate multiple UUIDs at once?", answer: "Yes, set the count field to however many you need (up to 100 at a time) and click Generate." },
  { question: "Is a UUID the same as a GUID?", answer: "Yes, GUID (Globally Unique Identifier) is Microsoft's term for the same concept as a UUID — they're functionally identical." },
  { question: "Are the UUIDs generated here truly random?", answer: "Yes, this tool uses your browser's built-in cryptographically secure random number generator to create version 4 UUIDs." },
];
---

<Layout title="Free UUID Generator Online — v4 UUIDs Instantly">
  <main class="max-w-4xl mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold text-gray-800 mb-2">UUID Generator</h1>
    <p class="text-gray-600 mb-6">Generate random, unique UUIDs (v4) instantly — one at a time or in bulk.</p>

    <div class="flex flex-wrap items-center gap-3 mb-4">
      <label class="text-sm font-medium text-gray-700">How many?</label>
      <input
        id="uuidCount"
        type="number"
        min="1"
        max="100"
        value="1"
        class="w-24 p-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-400"
      />
      <button id="generateBtn" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700">Generate</button>
      <button id="copyUuidBtn" class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700">Copy All</button>
      <button id="clearUuidBtn" class="bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600">Clear</button>
    </div>

    <textarea
      id="uuidOutput"
      class="w-full h-64 p-3 border border-gray-300 rounded-lg font-mono text-sm bg-gray-100"
      readonly
      placeholder="Your UUIDs will appear here"
    ></textarea>

    <section class="mt-12 text-gray-700 leading-relaxed">
      <h2 class="text-xl font-semibold mb-2">About This UUID Generator</h2>
      <p>
        A UUID (Universally Unique Identifier) is a 128-bit identifier used to uniquely label information
        without needing a central authority to coordinate uniqueness. This tool generates version 4 UUIDs,
        which are created using random numbers, making them ideal for database primary keys, session tokens,
        distributed systems, and any place you need a globally unique ID. Everything runs directly in your
        browser — no data is sent anywhere.
      </p>
    </section>

    <FaqSection faqs={faqs} />
  </main>
</Layout>

<script>
  const countInput = document.getElementById('uuidCount');
  const output = document.getElementById('uuidOutput');
  const generateBtn = document.getElementById('generateBtn');
  const copyBtn = document.getElementById('copyUuidBtn');
  const clearBtn = document.getElementById('clearUuidBtn');

  if (countInput instanceof HTMLInputElement && output instanceof HTMLTextAreaElement) {
    generateBtn?.addEventListener('click', () => {
      let count = parseInt(countInput.value, 10);
      if (isNaN(count) || count < 1) count = 1;
      if (count > 100) count = 100;

      const uuids = [];
      for (let i = 0; i < count; i++) {
        uuids.push(crypto.randomUUID());
      }
      output.value = uuids.join('\n');
    });

    copyBtn?.addEventListener('click', () => {
      navigator.clipboard.writeText(output.value);
    });

    clearBtn?.addEventListener('click', () => {
      output.value = '';
    });
  }
</script>
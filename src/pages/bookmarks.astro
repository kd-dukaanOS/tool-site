---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Bookmarks — ToolSite" description="Your saved tools, stored locally in your browser.">
  <div class="wrap">
    <h1>Bookmarks</h1>
    <div id="bookmarks-list"></div>
    <p id="bookmarks-empty" style="display:none;">No bookmarks yet. Click ☆ Save on any tool to add it here.</p>
  </div>
</Layout>

<script>
  const list = document.getElementById('bookmarks-list');
  const empty = document.getElementById('bookmarks-empty');
  const saved = JSON.parse(localStorage.getItem('bookmarkedTools') || '[]');
  if (!saved.length) {
    empty.style.display = 'block';
  } else {
    list.innerHTML = saved.map(b => `
      <div class="bookmark-item">
        <a href="${b.url}">${b.name}</a>
        <button data-slug="${b.slug}" class="remove-bookmark">Remove</button>
      </div>
    `).join('');
    list.querySelectorAll('.remove-bookmark').forEach(el => {
      el.addEventListener('click', () => {
        const slug = el.dataset.slug;
        const updated = JSON.parse(localStorage.getItem('bookmarkedTools') || '[]').filter(b => b.slug !== slug);
        localStorage.setItem('bookmarkedTools', JSON.stringify(updated));
        el.closest('.bookmark-item').remove();
        if (!updated.length) empty.style.display = 'block';
      });
    });
  }
</script>

<style>
  .wrap { max-width: 720px; margin: 0 auto; padding: 24px; }
  .bookmark-item { display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid var(--border); }
  .remove-bookmark { background: none; border: 1px solid var(--border); border-radius: 6px; padding: 4px 10px; cursor: pointer; font-size: 13px; }
</style>
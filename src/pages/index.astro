---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Free Online Developer Tools — Fast & Simple">
  <main class="max-w-4xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold text-gray-800 mb-3">Free Online Tools</h1>
    <p class="text-gray-600 mb-10">Simple, fast, no-signup tools for developers and everyday tasks.</p>

    <div class="grid sm:grid-cols-2 gap-4">
      <a href="/json-formatter" class="block p-5 border border-gray-200 rounded-lg hover:border-blue-400 hover:shadow-md transition">
        <h2 class="text-lg font-semibold text-gray-800">JSON Formatter</h2>
        <p class="text-sm text-gray-500 mt-1">Format, validate, and minify JSON instantly.</p>
      </a>

      <a href="/base64-encoder-decoder" class="block p-5 border border-gray-200 rounded-lg hover:border-blue-400 hover:shadow-md transition">
        <h2 class="text-lg font-semibold text-gray-800">Base64 Encoder / Decoder</h2>
        <p class="text-sm text-gray-500 mt-1">Encode text to Base64 or decode it back instantly.</p>
      </a>
	  <a href="/uuid-generator" class="block p-5 border border-gray-200 rounded-lg hover:border-blue-400 hover:shadow-md transition">
  <h2 class="text-lg font-semibold text-gray-800">UUID Generator</h2>
  <p class="text-sm text-gray-500 mt-1">Generate unique v4 UUIDs instantly, one or many at a time.</p>
</a>
<a href="/word-counter" class="block p-5 border border-gray-200 rounded-lg hover:border-blue-400 hover:shadow-md transition">
  <h2 class="text-lg font-semibold text-gray-800">Word & Character Counter</h2>
  <p class="text-sm text-gray-500 mt-1">Count words, characters, and sentences in real-time.</p>
</a>
<a href="/case-converter" class="block p-5 border border-gray-200 rounded-lg hover:border-blue-400 hover:shadow-md transition">
  <h2 class="text-lg font-semibold text-gray-800">Case Converter</h2>
  <p class="text-sm text-gray-500 mt-1">Convert text to UPPERCASE, lowercase, Title Case, and more.</p>
</a>
<a href="/regex-tester" class="block p-5 border border-gray-200 rounded-lg hover:border-blue-400 hover:shadow-md transition">
  <h2 class="text-lg font-semibold text-gray-800">Regex Tester</h2>
  <p class="text-sm text-gray-500 mt-1">Test regular expressions with live match highlighting.</p>
</a>

<a href="/timestamp-converter" class="block p-5 border border-gray-200 rounded-lg hover:border-blue-400 hover:shadow-md transition">
  <h2 class="text-lg font-semibold text-gray-800">Timestamp Converter</h2>
  <p class="text-sm text-gray-500 mt-1">Convert Unix timestamps to dates and back.</p>
</a>

<a href="/url-encoder-decoder" class="block p-5 border border-gray-200 rounded-lg hover:border-blue-400 hover:shadow-md transition">
  <h2 class="text-lg font-semibold text-gray-800">URL Encoder / Decoder</h2>
  <p class="text-sm text-gray-500 mt-1">Encode or decode text for safe use in URLs.</p>
</a>
<a href="/lorem-ipsum-generator" class="block p-5 border border-gray-200 rounded-lg hover:border-blue-400 hover:shadow-md transition">
  <h2 class="text-lg font-semibold text-gray-800">Lorem Ipsum Generator</h2>
  <p class="text-sm text-gray-500 mt-1">Generate placeholder text for designs and mockups.</p>
</a>

<a href="/markdown-previewer" class="block p-5 border border-gray-200 rounded-lg hover:border-blue-400 hover:shadow-md transition">
  <h2 class="text-lg font-semibold text-gray-800">Markdown Previewer</h2>
  <p class="text-sm text-gray-500 mt-1">Write Markdown and see the live formatted preview.</p>
</a>
    </div>
  </main>
</Layout>
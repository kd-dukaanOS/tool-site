---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Free Online Developer Tools — Fast & Simple">
  <main class="max-w-4xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold text-gray-800 mb-3">Free Online Tools</h1>
    <p class="text-gray-600 mb-10">Simple, fast, no-signup tools for developers and everyday tasks.</p>

    <div class="grid sm:grid-cols-2 gap-4">
      <a href="/json-formatter" class="block p-5 border border-gray-200 rounded-lg hover:border-blue-400 hover:shadow-md transition">
        <h2 class="text-lg font-semibold text-gray-800">JSON Formatter</h2>
        <p class="text-sm text-gray-500 mt-1">Format, validate, and minify JSON instantly.</p>
      </a>
    </div>
  </main>
</Layout>
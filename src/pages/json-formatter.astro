---
import Layout from '../layouts/Layout.astro';
import FaqSection from '../components/FaqSection.astro';

const faqs = [{ question: "Why does my JSON show an error when I try to format it?", answer: "A formatting error usually means the JSON has a syntax issue — common causes include a missing comma, an extra trailing comma, or unmatched braces or brackets." },
  { question: "What's the difference between formatting and minifying JSON?", answer: "Formatting adds indentation and line breaks to make JSON readable, while minifying removes whitespace to make the file as small as possible for production use." },
  { question: "Is my JSON data sent to a server when I use this tool?", answer: "No, all formatting and validation happens directly in your browser — your data is never uploaded anywhere." },
  { question: "Can this tool validate if my JSON is correct?", answer: "Yes, clicking Format will show an error if your JSON is invalid, or display the properly indented result if it's valid." },
  { question: "What is JSON used for?", answer: "JSON is a lightweight data format used to exchange information between servers and applications, and it's the standard format for most modern APIs." },
  
];
---

<Layout title="Free JSON Formatter & Validator Online">
  <main class="max-w-4xl mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold text-gray-800 mb-2">JSON Formatter & Validator</h1>
    <p class="text-gray-600 mb-6">Paste your JSON below, then format or validate it instantly.</p>

    <div class="grid md:grid-cols-2 gap-4">
      <!-- Input side -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Input JSON</label>
        <textarea
          id="jsonInput"
          class="w-full h-80 p-3 border border-gray-300 rounded-lg font-mono text-sm focus:outline-none focus:ring-2 focus:ring-blue-400"
          placeholder='{"name": "example", "value": 123}'
        ></textarea>
      </div>

      <!-- Output side -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Output</label>
        <textarea
          id="jsonOutput"
          class="w-full h-80 p-3 border border-gray-300 rounded-lg font-mono text-sm bg-gray-100"
          readonly
        ></textarea>
      </div>
    </div>

    <!-- Buttons -->
    <div class="flex flex-wrap gap-3 mt-4">
      <button id="formatBtn" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700">Format</button>
      <button id="minifyBtn" class="bg-gray-600 text-white px-4 py-2 rounded-lg hover:bg-gray-700">Minify</button>
      <button id="copyBtn" class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700">Copy Output</button>
      <button id="clearBtn" class="bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600">Clear</button>
    </div>

    <!-- Error message -->
    <p id="errorMsg" class="text-red-600 mt-3 font-medium"></p>

    <!-- SEO content section -->
    <section class="mt-12 text-gray-700 leading-relaxed">
      <h2 class="text-xl font-semibold mb-2">About This JSON Formatter Tool</h2>
      <p>
        This free online JSON formatter helps developers quickly format, validate, and beautify JSON data.
        Paste any raw or minified JSON into the input box, and instantly get a clean, properly indented version.
        If your JSON has a syntax error, this tool will tell you exactly what's wrong so you can fix it fast.
      </p>
    </section>

    <FaqSection faqs={faqs} />
  </main>
</Layout>

<script>
  const input = document.getElementById('jsonInput') as HTMLTextAreaElement;
  const output = document.getElementById('jsonOutput') as HTMLTextAreaElement;
  const errorMsg = document.getElementById('errorMsg') as HTMLParagraphElement;

  document.getElementById('formatBtn')?.addEventListener('click', () => {
    try {
      const parsed = JSON.parse(input.value);
      output.value = JSON.stringify(parsed, null, 2);
      errorMsg.textContent = '';
    } catch (e) {
      errorMsg.textContent = 'Invalid JSON: ' + (e as Error).message;
      output.value = '';
    }
  });

  document.getElementById('minifyBtn')?.addEventListener('click', () => {
    try {
      const parsed = JSON.parse(input.value);
      output.value = JSON.stringify(parsed);
      errorMsg.textContent = '';
    } catch (e) {
      errorMsg.textContent = 'Invalid JSON: ' + (e as Error).message;
      output.value = '';
    }
  });

  document.getElementById('copyBtn')?.addEventListener('click', () => {
    navigator.clipboard.writeText(output.value);
  });

  document.getElementById('clearBtn')?.addEventListener('click', () => {
    input.value = '';
    output.value = '';
    errorMsg.textContent = '';
  });
</script>
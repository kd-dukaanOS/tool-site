---
// src/pages/es/text-tools/markdown-previewer.astro
import Layout from "../../../layouts/Layout.astro";
import MarkdownPreviewerWidget from "../../../components/tools/MarkdownPreviewerWidget.astro";
import CalculatorContent from "../../../components/content/CalculatorContent.astro";
import { tools, categoryIcons } from "../../../data/tools.js";
import { markdownPreviewerContent } from "../../../data/calculators/es/markdown-previewer.ts";

const tool = tools.find((t) => t.slug === "markdown-previewer")!;
const content = markdownPreviewerContent;
---

<Layout
  lang="es"
  title={`${content.meta.seoTitle} | TooManyToolz`}
  description={content.meta.metaDescription}
  ogTitle={content.meta.ogTitle}
  ogDescription={content.meta.ogDescription}
  faqItems={content.faq}
  breadcrumbs={[
    { name: "Inicio", url: "/es/" },
    { name: "Herramientas de Texto", url: "/es/text-tools/" },
    { name: "Visor de Markdown", url: "/es/text-tools/markdown-previewer/" },
  ]}
  appName="Visor de Markdown"
>
  <div class="wrap">
    <p class="breadcrumb">
      <a href="/es/">Inicio</a> / <a href="/es/text-tools/">Herramientas de Texto</a> / Visor de Markdown
    </p>
    <div class="category-header">
      <div class="cat-icon">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" set:html={categoryIcons["text-tools"]} />
      </div>
      <div class="category-header-text">
        <h1>Visor de Markdown</h1>
        <p>Vista previa de Markdown en vivo</p>
      </div>
      <button id="bookmark-btn" class="bookmark-btn" data-slug="markdown-previewer" data-name="Visor de Markdown" data-url="/es/text-tools/markdown-previewer/" aria-label="Guardar esta herramienta">
        <svg id="bookmark-star" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 17.3l-6.16 3.6 1.64-7.03L2 9.24l7.19-.61L12 2l2.81 6.63 7.19.61-5.48 4.63 1.64 7.03z"/></svg>
        <span class="bookmark-btn-label">Guardar</span>
      </button>
    </div>
    <MarkdownPreviewerWidget lang="es" />
    <CalculatorContent {...content} lang="es" allTools={tools} />
  </div>
</Layout>
---
// src/pages/es/text-tools/slug-generator.astro
import Layout from "../../../layouts/Layout.astro";
import SlugGeneratorWidget from "../../../components/tools/SlugGeneratorWidget.astro";
import CalculatorContent from "../../../components/content/CalculatorContent.astro";
import { tools, categoryIcons } from "../../../data/tools.js";
import { slugGeneratorContent } from "../../../data/calculators/es/slug-generator.ts";

const tool = tools.find((t) => t.slug === "slug-generator")!;
const content = slugGeneratorContent;
---

<Layout
  lang="es"
  title={`${content.meta.seoTitle} | TooManyToolz`}
  description={content.meta.metaDescription}
  ogTitle={content.meta.ogTitle}
  ogDescription={content.meta.ogDescription}
  faqItems={content.faq}
  breadcrumbs={[
    { name: "Inicio", url: "/es/" },
    { name: "Herramientas de Texto", url: "/es/text-tools/" },
    { name: "Generador de Slugs", url: "/es/text-tools/slug-generator/" },
  ]}
  appName="Generador de Slugs"
>
  <div class="wrap">
    <p class="breadcrumb">
      <a href="/es/">Inicio</a> / <a href="/es/text-tools/">Herramientas de Texto</a> / Generador de Slugs
    </p>
    <div class="category-header">
      <div class="cat-icon">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" set:html={categoryIcons["text-tools"]} />
      </div>
      <div class="category-header-text">
        <h1>Generador de Slugs</h1>
        <p>Convierte texto en un slug de URL optimizado para SEO</p>
      </div>
      <button id="bookmark-btn" class="bookmark-btn" data-slug="slug-generator" data-name="Generador de Slugs" data-url="/es/text-tools/slug-generator/" aria-label="Guardar esta herramienta">
        <svg id="bookmark-star" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 17.3l-6.16 3.6 1.64-7.03L2 9.24l7.19-.61L12 2l2.81 6.63 7.19.61-5.48 4.63 1.64 7.03z"/></svg>
        <span class="bookmark-btn-label">Guardar</span>
      </button>
    </div>
    <SlugGeneratorWidget lang="es" />
    <CalculatorContent {...content} lang="es" allTools={tools} />
  </div>
</Layout>
---
// src/pages/es/dev/regex-tester.astro
import Layout from "../../../layouts/Layout.astro";
import RegexTesterWidget from "../../../components/tools/RegexTesterWidget.astro";
import CalculatorContent from "../../../components/content/CalculatorContent.astro";
import { tools, categoryIcons } from "../../../data/tools.js";
import { regexTesterContent } from "../../../data/calculators/es/regex-tester.ts";

const tool = tools.find((t) => t.slug === "regex-tester")!;
const content = regexTesterContent;
---

<Layout
  lang="es"
  title={`${content.meta.seoTitle} | TooManyToolz`}
  description={content.meta.metaDescription}
  ogTitle={content.meta.ogTitle}
  ogDescription={content.meta.ogDescription}
  faqItems={content.faq}
  breadcrumbs={[
    { name: "Inicio", url: "/es/" },
    { name: "Desarrollo", url: "/es/dev/" },
    { name: "Probador de Expresiones Regulares", url: "/es/dev/regex-tester/" },
  ]}
  appName="Probador de Expresiones Regulares"
>
  <div class="wrap">
    <p class="breadcrumb">
      <a href="/es/">Inicio</a> / <a href="/es/dev/">Desarrollo</a> / Probador de Expresiones Regulares
    </p>

    <div class="category-header">
      <div class="cat-icon">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" set:html={categoryIcons["dev"]} />
      </div>
      <div class="category-header-text">
        <h1>Probador de Expresiones Regulares</h1>
        <p>Prueba patrones regex con resaltado en vivo</p>
      </div>
      <button id="bookmark-btn" class="bookmark-btn" data-slug="regex-tester" data-name="Probador de Expresiones Regulares" data-url="/es/dev/regex-tester/" aria-label="Guardar esta herramienta">
        <svg id="bookmark-star" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 17.3l-6.16 3.6 1.64-7.03L2 9.24l7.19-.61L12 2l2.81 6.63 7.19.61-5.48 4.63 1.64 7.03z"/></svg>
        <span class="bookmark-btn-label">Guardar</span>
      </button>
    </div>

    <RegexTesterWidget lang="es" />

    <CalculatorContent {...content} lang="es" allTools={tools} />
  </div>
</Layout>
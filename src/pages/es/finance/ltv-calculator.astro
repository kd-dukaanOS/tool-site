---
// src/pages/es/finance/ltv-calculator.astro
import Layout from "../../../layouts/Layout.astro";
import LTVWidget from "../../../components/tools/LTVWidget.astro";
import CalculatorContent from "../../../components/content/CalculatorContent.astro";
import { tools, categoryIcons } from "../../../data/tools.js";
import { ltvCalculatorContent } from "../../../data/calculators/es/ltv-calculator.ts";

const tool = tools.find((t) => t.slug === "ltv-calculator")!;
const content = ltvCalculatorContent;
---

<Layout
  lang="es"
  title={`${content.meta.seoTitle} | TooManyToolz`}
  description={content.meta.metaDescription}
  ogTitle={content.meta.ogTitle}
  ogDescription={content.meta.ogDescription}
  faqItems={content.faq}
  breadcrumbs={[
    { name: "Inicio", url: "/es/" },
    { name: "Finanzas", url: "/es/finance/" },
    { name: "Calculadora LTV", url: "/es/finance/ltv-calculator/" },
  ]}
  appName="Calculadora LTV"
>
  <div class="wrap">
    <p class="breadcrumb">
      <a href="/es/">Inicio</a> / <a href="/es/finance/">Finanzas</a> / Calculadora LTV
    </p>
    <div class="category-header">
      <div class="cat-icon">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" set:html={categoryIcons["finance"]} />
      </div>
      <div class="category-header-text">
        <h1>Calculadora LTV (Préstamo-Valor)</h1>
        <p>Calcula tu ratio préstamo-valor y capital de vivienda</p>
      </div>
      <button id="bookmark-btn" class="bookmark-btn" data-slug="ltv-calculator" data-name="Calculadora LTV" data-url="/es/finance/ltv-calculator/" aria-label="Guardar esta herramienta">
        <svg id="bookmark-star" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 17.3l-6.16 3.6 1.64-7.03L2 9.24l7.19-.61L12 2l2.81 6.63 7.19.61-5.48 4.63 1.64 7.03z"/></svg>
        <span class="bookmark-btn-label">Guardar</span>
      </button>
    </div>
    <LTVWidget lang="es" />
    <CalculatorContent {...content} lang="es" allTools={tools} />
  </div>
</Layout>
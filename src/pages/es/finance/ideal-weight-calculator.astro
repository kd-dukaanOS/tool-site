---
// src/pages/es/health/ideal-weight-calculator.astro
import Layout from "../../../layouts/Layout.astro";
import IdealWeightCalculatorWidget from "../../../components/tools/IdealWeightCalculatorWidget.astro";
import CalculatorContent from "../../../components/content/CalculatorContent.astro";
import { tools, categoryIcons } from "../../../data/tools.js";
import { idealWeightCalculatorContent } from "../../../data/calculators/es/ideal-weight-calculator.ts";

const tool = tools.find((t) => t.slug === "ideal-weight-calculator")!;
const content = idealWeightCalculatorContent;
---

<Layout
  lang="es"
  title={`${content.meta.seoTitle} | TooManyToolz`}
  description={content.meta.metaDescription}
  ogTitle={content.meta.ogTitle}
  ogDescription={content.meta.ogDescription}
  faqItems={content.faq}
  breadcrumbs={[
    { name: "Inicio", url: "/es/" },
    { name: "Salud", url: "/es/health/" },
    { name: "Peso Ideal", url: "/es/health/ideal-weight-calculator/" },
  ]}
  appName="Peso Ideal"
>
  <div class="wrap">
    <p class="breadcrumb">
      <a href="/es/">Inicio</a> / <a href="/es/health/">Salud</a> / Peso Ideal
    </p>
    <div class="category-header">
      <div class="cat-icon">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" set:html={categoryIcons["health"]} />
      </div>
      <div class="category-header-text">
        <h1>Calculadora de Peso Ideal</h1>
        <p>Fórmula Devine y rango saludable</p>
      </div>
      <button id="bookmark-btn" class="bookmark-btn" data-slug="ideal-weight-calculator" data-name="Peso Ideal" data-url="/es/health/ideal-weight-calculator/" aria-label="Guardar esta herramienta">
        <svg id="bookmark-star" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 17.3l-6.16 3.6 1.64-7.03L2 9.24l7.19-.61L12 2l2.81 6.63 7.19.61-5.48 4.63 1.64 7.03z"/></svg>
        <span class="bookmark-btn-label">Guardar</span>
      </button>
    </div>
    <IdealWeightCalculatorWidget lang="es" />
    <CalculatorContent {...content} lang="es" allTools={tools} />
  </div>
</Layout>
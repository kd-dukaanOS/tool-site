---
// src/pages/es/finance/eitc-calculator.astro
import Layout from "../../../layouts/Layout.astro";
import EITCWidget from "../../../components/tools/EITCWidget.astro";
import CalculatorContent from "../../../components/content/CalculatorContent.astro";
import { tools, categoryIcons } from "../../../data/tools.js";
import { eitcCalculatorContentEs } from "../../../data/calculators/es/eitc-calculator.ts";

const tool = tools.find((t) => t.slug === "eitc-calculator")!;
const content = eitcCalculatorContentEs;
---

<Layout
  lang="es"
  title={`${content.meta.seoTitle} | TooManyToolz`}
  description={content.meta.metaDescription}
  ogTitle={content.meta.ogTitle}
  ogDescription={content.meta.ogDescription}
  faqItems={content.faq}
  breadcrumbs={[
    { name: "Inicio", url: "/es/" },
    { name: "Finanzas", url: "/es/finance/" },
    { name: "Calculadora de EITC", url: "/es/finance/eitc-calculator/" },
  ]}
  appName="Calculadora de EITC"
>
  <div class="wrap">
    <p class="breadcrumb">
      <a href="/es/">Inicio</a> / <a href="/es/finance/">Finanzas</a> / Calculadora de EITC
    </p>

    <div class="category-header">
      <div class="cat-icon">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" set:html={categoryIcons["finance"]} />
      </div>
      <div class="category-header-text">
        <h1>Calculadora de EITC</h1>
        <p>Estima tu Crédito Tributario por Ingreso del Trabajo</p>
      </div>
      <button id="bookmark-btn" class="bookmark-btn" data-slug="eitc-calculator" data-name="Calculadora de EITC" data-url="/es/finance/eitc-calculator/" aria-label="Guardar esta herramienta">
        <svg id="bookmark-star" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 17.3l-6.16 3.6 1.64-7.03L2 9.24l7.19-.61L12 2l2.81 6.63 7.19.61-5.48 4.63 1.64 7.03z"/></svg>
        <span class="bookmark-btn-label">Guardar</span>
      </button>
    </div>

    <EITCWidget lang="es" />

    <CalculatorContent {...content} lang="es" allTools={tools} />
  </div>
</Layout>
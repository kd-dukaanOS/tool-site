---
// src/pages/es/business/profit-margin-calculator.astro
import Layout from "../../../layouts/Layout.astro";
import ProfitMarginCalculatorWidget from "../../../components/tools/ProfitMarginCalculatorWidget.astro";
import CalculatorContent from "../../../components/content/CalculatorContent.astro";
import { tools, categoryIcons } from "../../../data/tools.js";
import { profitMarginCalculatorContent } from "../../../data/calculators/es/profit-margin-calculator.ts";

const tool = tools.find((t) => t.slug === "profit-margin-calculator")!;
const content = profitMarginCalculatorContent;
---

<Layout
  lang="es"
  title={`${content.meta.seoTitle} | TooManyToolz`}
  description={content.meta.metaDescription}
  ogTitle={content.meta.ogTitle}
  ogDescription={content.meta.ogDescription}
  faqItems={content.faq}
  breadcrumbs={[
    { name: "Inicio", url: "/es/" },
    { name: "Negocios", url: "/es/business/" },
    { name: "Margen de Ganancia", url: "/es/finance/profit-margin-calculator/" },
  ]}
  appName="Calculadora de Margen de Ganancia"
>
  <div class="wrap">
    <p class="breadcrumb">
      <a href="/es/">Inicio</a> / <a href="/es/finance/">Finanzas</a> / Margen de Ganancia
    </p>
    <div class="category-header">
      <div class="cat-icon">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" set:html={categoryIcons["finance"]} />
      </div>
      <div class="category-header-text">
        <h1>Calculadora de Margen de Ganancia</h1>
        <p>Ganancia y porcentaje de margen</p>
      </div>
      <button id="bookmark-btn" class="bookmark-btn" data-slug="profit-margin-calculator" data-name="Margen de Ganancia" data-url="/es/business/profit-margin-calculator/" aria-label="Guardar esta herramienta">
        <svg id="bookmark-star" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 17.3l-6.16 3.6 1.64-7.03L2 9.24l7.19-.61L12 2l2.81 6.63 7.19.61-5.48 4.63 1.64 7.03z"/></svg>
        <span class="bookmark-btn-label">Guardar</span>
      </button>
    </div>
    <ProfitMarginCalculatorWidget lang="es" />
    <CalculatorContent {...content} lang="es" allTools={tools} />
  </div>
</Layout>
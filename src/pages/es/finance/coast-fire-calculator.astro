---
// src/pages/es/finance/coast-fire-calculator.astro
import Layout from "../../../layouts/Layout.astro";
import CoastFireWidget from "../../../components/tools/CoastFireWidget.astro";
import CalculatorContent from "../../../components/content/CalculatorContent.astro";
import { tools, categoryIcons } from "../../../data/tools.js";
import { coastFireCalculatorContent } from "../../../data/calculators/es/coast-fire-calculator.ts";

const tool = tools.find((t) => t.slug === "coast-fire-calculator")!;
const content = coastFireCalculatorContent;
---

<Layout
  lang="es"
  title={`${content.meta.seoTitle} | TooManyToolz`}
  description={content.meta.metaDescription}
  ogTitle={content.meta.ogTitle}
  ogDescription={content.meta.ogDescription}
  faqItems={content.faq}
  breadcrumbs={[
    { name: "Inicio", url: "/es/" },
    { name: "Finanzas", url: "/es/finance/" },
    { name: "Calculadora Coast FIRE", url: "/es/finance/coast-fire-calculator/" },
  ]}
  appName="Calculadora Coast FIRE"
>
  <div class="wrap">
    <p class="breadcrumb">
      <a href="/es/">Inicio</a> / <a href="/es/finance/">Finanzas</a> / Calculadora Coast FIRE
    </p>

    <div class="category-header">
      <div class="cat-icon">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" set:html={categoryIcons["finance"]} />
      </div>
      <div class="category-header-text">
        <h1>Calculadora Coast FIRE</h1>
        <p>¿Ya puedes dejar de ahorrar para el retiro?</p>
      </div>
      <button id="bookmark-btn" class="bookmark-btn" data-slug="coast-fire-calculator" data-name="Calculadora Coast FIRE" data-url="/es/finance/coast-fire-calculator/" aria-label="Guardar esta herramienta">
        <svg id="bookmark-star" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 17.3l-6.16 3.6 1.64-7.03L2 9.24l7.19-.61L12 2l2.81 6.63 7.19.61-5.48 4.63 1.64 7.03z"/></svg>
        <span class="bookmark-btn-label">Guardar</span>
      </button>
    </div>

    <CoastFireWidget lang="es" />

    <CalculatorContent {...content} lang="es" allTools={tools} />
  </div>
</Layout>
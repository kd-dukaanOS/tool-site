---
import Layout from "../../../layouts/Layout.astro";
import Base64EncoderDecoderWidget from "../../../components/tools/Base64EncoderDecoderWidget.astro";
import CalculatorContent from "../../../components/content/CalculatorContent.astro";
import { tools, categoryIcons } from "../../../data/tools.js";
import { base64CalculatorContent } from "../../../data/calculators/es/base64.ts";

const tool = tools.find((t) => t.slug === "base64-tool")!;
const content = base64CalculatorContent;
---

<Layout
  lang="es"
  title={`${content.meta.seoTitle} | TooManyToolz`}
  description={content.meta.metaDescription}
  ogTitle={content.meta.ogTitle}
  ogDescription={content.meta.ogDescription}
  faqItems={content.faq}
  breadcrumbs={[
    { name: "Inicio", url: "/es/" },
    { name: "Convertidores", url: "/es/converters/" },
    { name: "Base64 Online", url: "/es/converters/base64-tool/" },
  ]}
  appName="Codificador / Decodificador Base64"
>
  <div class="wrap">
    <p class="breadcrumb">
      <a href="/es/">Inicio</a> / <a href="/es/converters/">Convertidores</a> / Base64 Online
    </p>

    <div class="category-header">
      <div class="cat-icon">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" set:html={categoryIcons["converters"]} />
      </div>
      <div class="category-header-text">
        <h1>Codificador y Decodificador Base64</h1>
        <p>Codifica o decodifica texto en Base64 al instante</p>
      </div>
      <button id="bookmark-btn" class="bookmark-btn" data-slug="base64-tool" data-name="Codificador / Decodificador Base64" data-url="/es/converters/base64-tool/" aria-label="Guardar esta herramienta">
        <svg id="bookmark-star" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 17.3l-6.16 3.6 1.64-7.03L2 9.24l7.19-.61L12 2l2.81 6.63 7.19.61-5.48 4.63 1.64 7.03z"/></svg>
        <span class="bookmark-btn-label">Guardar</span>
      </button>
    </div>

    <Base64EncoderDecoderWidget lang="es" />

    <CalculatorContent {...content} lang="es" allTools={tools} />
  </div>
</Layout>
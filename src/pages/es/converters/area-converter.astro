---
import Layout from "../../../layouts/Layout.astro";
import AreaCalculatorWidget from "../../../components/tools/AreaCalculatorWidget.astro";
import CalculatorContent from "../../../components/content/CalculatorContent.astro";
import { tools, categoryIcons } from "../../../data/tools.js";
import { areaCalculatorContent } from "../../../data/calculators/es/area.ts";

const tool = tools.find((t) => t.slug === "area-converter")!;
const content = areaCalculatorContent;
---

<Layout
  lang="es"
  title={`${content.meta.seoTitle} | TooManyToolz`}
  description={content.meta.metaDescription}
  ogTitle={content.meta.ogTitle}
  ogDescription={content.meta.ogDescription}
  faqItems={content.faq}
  breadcrumbs={[
    { name: "Inicio", url: "/es/" },
    { name: "Conversores", url: "/es/converters/" },
    { name: "Conversor de Área", url: "/es/converters/area-converter/" },
  ]}
  appName="Conversor de Área"
>
  <div class="wrap">
    <p class="breadcrumb">
      <a href="/es/">Inicio</a> / <a href="/es/converters/">Conversores</a> / Conversor de Área
    </p>

    <div class="category-header">
      <div class="cat-icon">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" set:html={categoryIcons["converters"]} />
      </div>
      <div class="category-header-text">
        <h1>Conversor de Área</h1>
        <p>Convierte entre unidades de área</p>
      </div>
      <button id="bookmark-btn" class="bookmark-btn" data-slug="area-converter" data-name="Conversor de Área" data-url="/es/converters/area-converter/" aria-label="Guardar esta herramienta">
        <svg id="bookmark-star" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 17.3l-6.16 3.6 1.64-7.03L2 9.24l7.19-.61L12 2l2.81 6.63 7.19.61-5.48 4.63 1.64 7.03z"/></svg>
        <span class="bookmark-btn-label">Guardar</span>
      </button>
    </div>

    <AreaCalculatorWidget lang="es" />

    <CalculatorContent {...content} lang="es" allTools={tools} />
  </div>
</Layout>
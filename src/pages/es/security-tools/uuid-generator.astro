---
// src/pages/es/security-tools/uuid-generator.astro
import Layout from "../../../layouts/Layout.astro";
import UuidGeneratorWidget from "../../../components/tools/UuidGeneratorWidget.astro";
import CalculatorContent from "../../../components/content/CalculatorContent.astro";
import { tools, categoryIcons } from "../../../data/tools.js";
import { uuidGeneratorContent } from "../../../data/calculators/es/uuid-generator.ts";

const tool = tools.find((t) => t.slug === "uuid-generator")!;
const content = uuidGeneratorContent;
---

<Layout
  lang="es"
  title={`${content.meta.seoTitle} | TooManyToolz`}
  description={content.meta.metaDescription}
  ogTitle={content.meta.ogTitle}
  ogDescription={content.meta.ogDescription}
  faqItems={content.faq}
  breadcrumbs={[
    { name: "Inicio", url: "/es/" },
    { name: "Herramientas de Seguridad", url: "/es/security-tools/" },
    { name: "Generador de UUID", url: "/es/security-tools/uuid-generator/" },
  ]}
  appName="Generador de UUID"
>
  <div class="wrap">
    <p class="breadcrumb">
      <a href="/es/">Inicio</a> / <a href="/es/security-tools/">Herramientas de Seguridad</a> / Generador de UUID
    </p>
    <div class="category-header">
      <div class="cat-icon">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" set:html={categoryIcons["security-tools"]} />
      </div>
      <div class="category-header-text">
        <h1>Generador de UUID</h1>
        <p>v4 aleatorio, generación masiva</p>
      </div>
      <button id="bookmark-btn" class="bookmark-btn" data-slug="uuid-generator" data-name="Generador de UUID" data-url="/es/security-tools/uuid-generator/" aria-label="Guardar esta herramienta">
        <svg id="bookmark-star" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 17.3l-6.16 3.6 1.64-7.03L2 9.24l7.19-.61L12 2l2.81 6.63 7.19.61-5.48 4.63 1.64 7.03z"/></svg>
        <span class="bookmark-btn-label">Guardar</span>
      </button>
    </div>
    <UuidGeneratorWidget lang="es" />
    <CalculatorContent {...content} lang="es" allTools={tools} />
  </div>
</Layout>---

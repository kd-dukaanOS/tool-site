---
import Layout from "../../../layouts/Layout.astro";
import BMICalculatorWidget from "../../../components/tools/BMICalculatorWidget.astro";
import CalculatorContent from "../../../components/content/CalculatorContent.astro";
import { tools, categoryIcons } from "../../../data/tools.js";
import { bmiCalculatorContent } from "../../../data/calculators/es/bmi.ts";

const tool = tools.find((t) => t.slug === "bmi-calculator")!;
const content = bmiCalculatorContent;
---

<Layout
  lang="es"
  title={`${content.meta.seoTitle} | TooManyToolz`}
  description={content.meta.metaDescription}
  ogTitle={content.meta.ogTitle}
  ogDescription={content.meta.ogDescription}
  faqItems={content.faq}
  breadcrumbs={[
    { name: "Inicio", url: "/es/" },
    { name: "Salud", url: "/es/health/" },
    { name: "Calculadora de IMC", url: "/es/health/bmi-calculator/" },
  ]}
  appName="Calculadora de IMC"
>
  <div class="wrap">
    <p class="breadcrumb">
      <a href="/es/">Inicio</a> / <a href="/es/health/">Salud</a> / Calculadora de IMC
    </p>

    <div class="category-header">
      <div class="cat-icon">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" set:html={categoryIcons["health"]} />
      </div>
      <div class="category-header-text">
        <h1>Calculadora de IMC</h1>
        <p>Índice de Masa Corporal y rango de peso saludable</p>
      </div>
      <button id="bookmark-btn" class="bookmark-btn" data-slug="bmi-calculator" data-name="Calculadora de IMC" data-url="/es/health/bmi-calculator/" aria-label="Guardar esta herramienta">
        <svg id="bookmark-star" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 17.3l-6.16 3.6 1.64-7.03L2 9.24l7.19-.61L12 2l2.81 6.63 7.19.61-5.48 4.63 1.64 7.03z"/></svg>
        <span class="bookmark-btn-label">Guardar</span>
      </button>
    </div>

    <BMICalculatorWidget lang="es" />

    <CalculatorContent {...content} lang="es" allTools={tools} />
  </div>
</Layout>
---
// src/pages/es/business/markup-calculator.astro
import Layout from "../../../layouts/Layout.astro";
import MarkupCalculatorWidget from "../../../components/tools/MarkupCalculatorWidget.astro";
import CalculatorContent from "../../../components/content/CalculatorContent.astro";
import { tools, categoryIcons } from "../../../data/tools.js";
import { markupCalculatorContent } from "../../../data/calculators/es/markup-calculator.ts";

const tool = tools.find((t) => t.slug === "markup-calculator")!;
const content = markupCalculatorContent;
---

<Layout
  lang="es"
  title={`${content.meta.seoTitle} | TooManyToolz`}
  description={content.meta.metaDescription}
  ogTitle={content.meta.ogTitle}
  ogDescription={content.meta.ogDescription}
  faqItems={content.faq}
  breadcrumbs={[
    { name: "Inicio", url: "/es/" },
    { name: "Negocios", url: "/es/business/" },
    { name: "Calculadora de Margen", url: "/es/business/markup-calculator/" },
  ]}
  appName="Calculadora de Margen"
>
  <div class="wrap">
    <p class="breadcrumb">
      <a href="/es/">Inicio</a> / <a href="/es/business/">Negocios</a> / Calculadora de Margen
    </p>
    <div class="category-header">
      <div class="cat-icon">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" set:html={categoryIcons["business"]} />
      </div>
      <div class="category-header-text">
        <h1>Calculadora de Margen de Ganancia</h1>
        <p>Precio de venta y ganancia a partir del costo</p>
      </div>
      <button id="bookmark-btn" class="bookmark-btn" data-slug="markup-calculator" data-name="Calculadora de Margen" data-url="/es/business/markup-calculator/" aria-label="Guardar esta herramienta">
        <svg id="bookmark-star" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 17.3l-6.16 3.6 1.64-7.03L2 9.24l7.19-.61L12 2l2.81 6.63 7.19.61-5.48 4.63 1.64 7.03z"/></svg>
        <span class="bookmark-btn-label">Guardar</span>
      </button>
    </div>
    <MarkupCalculatorWidget lang="es" />
    <CalculatorContent {...content} lang="es" allTools={tools} />
  </div>
</Layout>
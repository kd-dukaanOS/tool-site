---
import Layout from '../layouts/Layout.astro';
import FaqSection from '../components/FaqSection.astro';
const faqs = [
  { question: "Is it safe to use an online password generator?", answer: "Yes, this generator creates passwords entirely in your browser using your device's built-in cryptographic random number generator — nothing is transmitted over the internet or stored on any server." },
  { question: "What makes a password strong?", answer: "A strong password is typically at least 12-16 characters long and includes a mix of uppercase letters, lowercase letters, numbers, and symbols, avoiding common words, names, or personal information like birthdays." },
  { question: "Does this tool save or store the passwords I generate?", answer: "No, generated passwords exist only in your browser session and are never saved, logged, or sent anywhere — closing or refreshing the page clears them." },
  { question: "How long should my password be?", answer: "Security experts generally recommend at least 12 characters as a minimum, with 16 or more being stronger, since each additional character exponentially increases the time needed to crack it by brute force." },
  { question: "Should I use the same password for multiple accounts?", answer: "No — using a unique password for every account limits the damage if one service is breached, since attackers commonly try leaked passwords across other sites." },
];
---

<Layout title="Free Strong Password Generator Online">
  <main class="max-w-4xl mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold text-gray-800 mb-2">Password Generator</h1>
    <p class="text-gray-600 mb-6">Generate strong, random passwords instantly — customize length and character types.</p>

    <div class="bg-white border border-gray-200 rounded-lg p-4 mb-6">
      <p id="passwordOutput" class="text-2xl font-mono font-bold text-blue-600 break-all min-h-[2rem]"></p>
    </div>

    <div class="space-y-4 mb-6">
      <div class="flex items-center gap-3">
        <label class="text-sm font-medium text-gray-700 w-32">Length: <span id="lengthValue">16</span></label>
        <input id="lengthSlider" type="range" min="6" max="64" value="16" class="flex-1" />
      </div>

      <label class="flex items-center gap-2 text-sm text-gray-700">
        <input id="includeUpper" type="checkbox" checked class="w-4 h-4" /> Uppercase (A-Z)
      </label>
      <label class="flex items-center gap-2 text-sm text-gray-700">
        <input id="includeLower" type="checkbox" checked class="w-4 h-4" /> Lowercase (a-z)
      </label>
      <label class="flex items-center gap-2 text-sm text-gray-700">
        <input id="includeNumbers" type="checkbox" checked class="w-4 h-4" /> Numbers (0-9)
      </label>
      <label class="flex items-center gap-2 text-sm text-gray-700">
        <input id="includeSymbols" type="checkbox" checked class="w-4 h-4" /> Symbols (!@#$%)
      </label>
    </div>

    <div class="flex gap-3">
      <button id="generatePwBtn" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700">Generate Password</button>
      <button id="copyPwBtn" class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700">Copy</button>
    </div>

    <section class="mt-12 text-gray-700 leading-relaxed">
      <h2 class="text-xl font-semibold mb-2">About This Password Generator</h2>
      <p>
        A strong password should be long, random, and include a mix of uppercase letters, lowercase letters,
        numbers, and symbols to resist guessing and brute-force attacks. This tool generates cryptographically
        random passwords entirely in your browser using the Web Crypto API — nothing is sent to a server, and no
        password is ever stored or logged. Adjust the length and character types to match any website's requirements.
      </p>
    </section>

    <FaqSection faqs={faqs} />
  </main>
</Layout>

<script>
  // @ts-nocheck
  const lengthSlider = document.getElementById('lengthSlider');
  const lengthValue = document.getElementById('lengthValue');
  const includeUpper = document.getElementById('includeUpper');
  const includeLower = document.getElementById('includeLower');
  const includeNumbers = document.getElementById('includeNumbers');
  const includeSymbols = document.getElementById('includeSymbols');
  const output = document.getElementById('passwordOutput');
  const generateBtn = document.getElementById('generatePwBtn');
  const copyBtn = document.getElementById('copyPwBtn');

  const UPPER = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
  const LOWER = 'abcdefghijklmnopqrstuvwxyz';
  const NUMBERS = '0123456789';
  const SYMBOLS = '!@#$%^&*()_+-=[]{}|;:,.<>?';

  function generatePassword() {
    const length = parseInt(lengthSlider.value, 10);
    let charset = '';
    if (includeUpper.checked) charset += UPPER;
    if (includeLower.checked) charset += LOWER;
    if (includeNumbers.checked) charset += NUMBERS;
    if (includeSymbols.checked) charset += SYMBOLS;

    if (!charset) {
      output.textContent = 'Select at least one character type';
      return;
    }

    const randomValues = new Uint32Array(length);
    crypto.getRandomValues(randomValues);

    let password = '';
    for (let i = 0; i < length; i++) {
      password += charset[randomValues[i] % charset.length];
    }
    output.textContent = password;
  }

  lengthSlider?.addEventListener('input', () => {
    lengthValue.textContent = lengthSlider.value;
  });

  generateBtn?.addEventListener('click', generatePassword);
  copyBtn?.addEventListener('click', () => {
    navigator.clipboard.writeText(output.textContent || '');
  });

  generatePassword();
</script>
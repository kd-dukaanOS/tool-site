---
import Layout from "../layouts/Layout.astro";
import { categories, tools } from "../data/tools.js";
---

<Layout title="All Tools — ToolSite" description="Browse all 77+ free browser-based tools, organized by category.">
  <section class="ts-tools-page">
    <div class="ts-tools-inner">
      <div class="ts-tools-head">
        <h1 class="ts-tools-title">All Tools</h1>
        <p class="ts-tools-sub">{tools.length}+ free tools, organized by category. No installs, no sign-up.</p>
      </div>

      {categories.map((cat) => {
        const catTools = tools.filter((t) => t.category === cat.slug);
        if (!catTools.length) return null;
        return (
          <div class="ts-tools-group" id={cat.slug}>
            <div class="ts-tools-group-head">
              <h2 class="ts-tools-group-title">{cat.name}</h2>
              <span class="ts-tools-group-count">{catTools.length} tools</span>
            </div>
            <p class="ts-tools-group-desc">{cat.description}</p>
            <div class="ts-tools-grid">
              {catTools.map((t) => (
                <a href={`/${t.category}/${t.slug}/`} class="ts-tools-card">
                  <button
                    class="ts-tools-card-bookmark"
                    data-slug={t.slug}
                    data-name={t.name}
                    data-url={`/${t.category}/${t.slug}/`}
                    aria-label="Bookmark this tool"
                    onclick="event.preventDefault(); event.stopPropagation(); window.toggleBookmark(this);"
                  >☆</button>
                  <span class="ts-tools-card-name">{t.name}</span>
                  {t.desc && <span class="ts-tools-card-desc">{t.desc}</span>}
                </a>
              ))}
            </div>
          </div>
        );
      })}

      <!-- Ad slot: place a leaderboard/responsive unit here once AdSense is approved.
           Keep it below the fold and away from tool cards to avoid accidental clicks. -->
      <!-- <div class="ts-tools-ad-slot"></div> -->
    </div>
  </section>
</Layout>

<script>
  function getBookmarks() {
    return JSON.parse(localStorage.getItem('bookmarkedTools') || '[]');
  }
  function setBookmarks(arr: any[]) {
    localStorage.setItem('bookmarkedTools', JSON.stringify(arr));
  }
  function paint(btn: HTMLElement) {
    const slug = btn.dataset.slug;
    const saved = getBookmarks().some((b: any) => b.slug === slug);
    btn.textContent = saved ? '★' : '☆';
    btn.classList.toggle('active', saved);
  }
  (window as any).toggleBookmark = function (btn: HTMLElement) {
    const slug = btn.dataset.slug;
    let bookmarks = getBookmarks();
    const saved = bookmarks.some((b: any) => b.slug === slug);
    bookmarks = saved
      ? bookmarks.filter((b: any) => b.slug !== slug)
      : [...bookmarks, { name: btn.dataset.name, slug, url: btn.dataset.url }];
    setBookmarks(bookmarks);
    paint(btn);
  };
  document.querySelectorAll<HTMLElement>('.ts-tools-card-bookmark').forEach(paint);
</script>

<style>
  .ts-tools-page { padding: var(--space-12) var(--space-6); }
  .ts-tools-inner { max-width: 1280px; margin: 0 auto; }

  .ts-tools-head { text-align: center; margin-bottom: var(--space-12); }
  .ts-tools-title {
    font-family: var(--font-sans);
    font-size: var(--fs-h1, var(--fs-h2));
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 var(--space-2);
  }
  .ts-tools-sub {
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    color: var(--text-secondary);
    margin: 0;
  }

  .ts-tools-group { margin-bottom: var(--space-12); scroll-margin-top: var(--space-8); }
  .ts-tools-group-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-1);
  }
  .ts-tools-group-title {
    font-family: var(--font-sans);
    font-size: var(--fs-h3, var(--fs-h2));
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }
  .ts-tools-group-count {
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .ts-tools-group-desc {
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    color: var(--text-secondary);
    margin: 0 0 var(--space-4);
    max-width: 640px;
  }

  .ts-tools-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
  }

  .ts-tools-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    padding-right: var(--space-8);
    text-decoration: none;
    transition: transform var(--duration-fast) var(--ease-standard),
                border-color var(--duration-fast) var(--ease-standard),
                box-shadow var(--duration-fast) var(--ease-standard);
  }
  :global(.ts-tools-card-bookmark) {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    background: none;
    border: none;
    font-size: 18px;
    line-height: 1;
    color: var(--text-muted);
    cursor: pointer;
    padding: 2px;
  }
  :global(.ts-tools-card-bookmark.active) {
    color: var(--color-primary, #6366f1);
  }
  .ts-tools-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-hover);
    box-shadow: var(--shadow-md);
  }
  .ts-tools-card-name {
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    font-weight: 600;
    color: var(--text-primary);
  }
  .ts-tools-card-desc {
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  @media (max-width: 1100px) {
    .ts-tools-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .ts-tools-page { padding: var(--space-8) var(--space-4); }
    .ts-tools-grid { grid-template-columns: 1fr; }
  }
</style>

import DateDifferenceCalculatorWidget from "../../components/tools/DateDifferenceCalculatorWidget.astro";
import TimeDurationCalculatorWidget from "../../components/tools/TimeDurationCalculatorWidget.astro";
import TimezoneCalculatorWidget from "../../components/tools/TimezoneCalculatorWidget.astro";
import { categories, tools, categoryIcons } from "../../data/tools.js";
import { contentMap } from "../../data/calculator-content-map.js";
import CalculatorContent from "../../components/content/CalculatorContent.astro";

// Build one real page per tool (20 pages total from this one file).
// Each entry needs BOTH params filled in, because the URL needs both
// pieces: /developer-tools/json-formatter/
export function getStaticPaths() {
  return tools.map((tool) => {
    const category = categories.find((c) => c.slug === tool.category);
    return {
      params: { category: tool.category, tool: tool.slug },
      props: { tool, category },
    };
  });
}

interface Props {
  tool: (typeof tools)[number];
  category: (typeof categories)[number];
}

const { tool, category } = Astro.props as Props;

// "Related tools" = other tools in the same category, excluding this one
const relatedTools = tools
  .filter((t) => t.category === tool.category && t.slug !== tool.slug)
  .slice(0, 3);

// Rich per-tool content (formula, steps, examples, tips, faq) written
// separately in src/data/calculators/*.ts. contentMap looks up the right
// file for this tool's slug; import.meta.glob loads them all at build time.
const contentModules = import.meta.glob("../../data/calculators/*.ts", { eager: true });
const contentFile = (contentMap as Record<string, string>)[tool.slug];
const contentModule = contentFile ? contentModules[`../../data/calculators/${contentFile}.ts`] : null;
const content = contentModule ? Object.values(contentModule)[0] as any : null;

// FAQs: prefer the rich content file's faq list (q/a shape), fall back to
// tools.js's thinner faqs list (question/answer shape) for any tool without one.
const faqs = (content?.faq?.length ? content.faq.map((f: any) => ({ question: f.q, answer: f.a })) : tool.faqs) || [];

// FAQPage structured data â€” this is what lets Google show your FAQs
// as expandable rich results directly in search, not just a blue link.
const faqSchema = faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f: any) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
} : null;

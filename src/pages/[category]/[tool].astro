<style>
  .tool-widget-placeholder {
    border: 1px dashed var(--border);
    border-radius: 14px;
    padding: 48px 24px;
    text-align: center;
    color: var(--muted);
    background: var(--surface);
    margin-bottom: 16px;
  }
  .tool-about { margin: 32px 0; }
  .tool-about h2 { font-family: 'Space Grotesk', sans-serif; font-size: 20px; margin: 0 0 10px; }
  .tool-about p { color: var(--muted); font-size: 14.5px; line-height: 1.7; max-width: 720px; }
  .tool-list { color: var(--muted); font-size: 14.5px; line-height: 1.8; max-width: 720px; padding-left: 20px; }
  .tool-examples { display: grid; gap: 12px; max-width: 720px; }
  .tool-example-card { border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px; background: var(--surface); font-size: 14px; }
  .tool-example-card p { margin: 4px 0; }
  .tool-example-note { color: var(--muted); }
  .bookmark-btn {
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 13px;
    cursor: pointer;
    margin-bottom: 16px;
  }
  .bookmark-btn.active { border-color: var(--color-primary, #6366f1); color: var(--color-primary, #6366f1); }
</style>

<script>
  const btn = document.getElementById('bookmark-btn');
  if (btn) {
    const slug = btn.dataset.slug;
    const getBookmarks = () => JSON.parse(localStorage.getItem('bookmarkedTools') || '[]');
    const setBookmarks = (arr) => localStorage.setItem('bookmarkedTools', JSON.stringify(arr));
    const isSaved = () => getBookmarks().some(b => b.slug === slug);
    const label = btn.querySelector('.bookmark-btn-label');
    const render = () => {
      if (label) label.textContent = isSaved() ? 'Saved' : 'Save';
      btn.classList.toggle('active', isSaved());
    };
    render();
    btn.addEventListener('click', () => {
      let bookmarks = getBookmarks();
      bookmarks = isSaved()
        ? bookmarks.filter(b => b.slug !== slug)
        : [...bookmarks, { name: btn.dataset.name, slug, url: btn.dataset.url }];
      setBookmarks(bookmarks);
      render();
    });
  }
</script>


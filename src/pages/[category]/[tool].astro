---
// src/pages/[category]/[tool].astro
import Layout from "../../layouts/Layout.astro";
import FaqSection from "../../components/FaqSection.astro";
import JsonFormatterWidget from "../../components/tools/JsonFormatterWidget.astro";
import Base64Widget from "../../components/tools/Base64Widget.astro";
import CaseConverterWidget from "../../components/tools/CaseConverterWidget.astro";
import ColorConverterWidget from "../../components/tools/ColorConverterWidget.astro";
import CsvJsonWidget from "../../components/tools/CsvJsonWidget.astro";
import DiffCheckerWidget from "../../components/tools/DiffCheckerWidget.astro";
import HashGeneratorWidget from "../../components/tools/HashGeneratorWidget.astro";
import JwtDecoderWidget from "../../components/tools/JwtDecoderWidget.astro";
import LoremIpsumWidget from "../../components/tools/LoremIpsumWidget.astro";
import MarkdownPreviewerWidget from "../../components/tools/MarkdownPreviewerWidget.astro";
import NumberBaseConverterWidget from "../../components/tools/NumberBaseConverterWidget.astro";
import PasswordGeneratorWidget from "../../components/tools/PasswordGeneratorWidget.astro";
import PercentageCalculatorWidget from "../../components/tools/PercentageCalculatorWidget.astro";
import QrCodeGeneratorWidget from "../../components/tools/QrCodeGeneratorWidget.astro";
import RegexTesterWidget from "../../components/tools/RegexTesterWidget.astro";
import SlugGeneratorWidget from "../../components/tools/SlugGeneratorWidget.astro";
import TimestampConverterWidget from "../../components/tools/TimestampConverterWidget.astro";
import UrlEncoderDecoderWidget from "../../components/tools/UrlEncoderDecoderWidget.astro";
import UuidGeneratorWidget from "../../components/tools/UuidGeneratorWidget.astro";
import WordCounterWidget from "../../components/tools/WordCounterWidget.astro";
import { categories, tools, categoryIcons } from "../../data/tools.js";

// Build one real page per tool (20 pages total from this one file).
// Each entry needs BOTH params filled in, because the URL needs both
// pieces: /developer-tools/json-formatter/
export function getStaticPaths() {
  return tools.map((tool) => {
    const category = categories.find((c) => c.slug === tool.category);
    return {
      params: { category: tool.category, tool: tool.slug },
      props: { tool, category },
    };
  });
}

interface Props {
  tool: (typeof tools)[number];
  category: (typeof categories)[number];
}

const { tool, category } = Astro.props as Props;

// "Related tools" = other tools in the same category, excluding this one
const relatedTools = tools
  .filter((t) => t.category === tool.category && t.slug !== tool.slug)
  .slice(0, 3);

// FAQPage structured data — this is what lets Google show your FAQs
// as expandable rich results directly in search, not just a blue link.
const faqSchema = tool.faqs && tool.faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: tool.faqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
} : null;
---

<Layout
  title={`${tool.name} — Free Online Tool | ToolSite`}
  description={tool.desc}
>
  <div class="wrap">
    <p class="breadcrumb">
      <a href="/">Home</a> / <a href={`/${category.slug}/`}>{category.name}</a> / {tool.name}
    </p>

    <div class="category-header">
      <div class="cat-icon">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" set:html={categoryIcons[tool.category as keyof typeof categoryIcons]} />
      </div>
      <div>
        <h1>{tool.name}</h1>
        <p>{tool.desc}</p>
      </div>
    </div>

    <!--
      Each tool gets its own widget component. Add a new "if" line here
      whenever a new tool's real logic is ready — until then it falls
      back to the placeholder box automatically.
    -->
    {tool.slug === "json-formatter" ? (
      <JsonFormatterWidget />
    ) : tool.slug === "base64-tool" ? (
      <Base64Widget />
    ) : tool.slug === "case-converter" ? (
      <CaseConverterWidget />
    ) : tool.slug === "color-converter" ? (
      <ColorConverterWidget />
    ) : tool.slug === "csv-json-converter" ? (
      <CsvJsonWidget />
    ) : tool.slug === "diff-checker" ? (
      <DiffCheckerWidget />
    ) : tool.slug === "hash-generator" ? (
      <HashGeneratorWidget />
    ) : tool.slug === "jwt-decoder" ? (
      <JwtDecoderWidget />
    ) : tool.slug === "lorem-ipsum-generator" ? (
      <LoremIpsumWidget />
    ) : tool.slug === "markdown-previewer" ? (
      <MarkdownPreviewerWidget />
    ) : tool.slug === "number-base-converter" ? (
      <NumberBaseConverterWidget />
    ) : tool.slug === "password-generator" ? (
      <PasswordGeneratorWidget />
    ) : tool.slug === "percentage-calculator" ? (
      <PercentageCalculatorWidget />
    ) : tool.slug === "qr-code-generator" ? (
      <QrCodeGeneratorWidget />
    ) : tool.slug === "regex-tester" ? (
      <RegexTesterWidget />
    ) : tool.slug === "slug-generator" ? (
      <SlugGeneratorWidget />
    ) : tool.slug === "timestamp-converter" ? (
      <TimestampConverterWidget />
    ) : tool.slug === "url-encoder-decoder" ? (
      <UrlEncoderDecoderWidget />
    ) : tool.slug === "uuid-generator" ? (
      <UuidGeneratorWidget />
    ) : tool.slug === "word-counter" ? (
      <WordCounterWidget />
    ) : (
      <div class="tool-widget-placeholder">
        <p>🔧 The working "{tool.name}" tool will go here.</p>
      </div>
    )}

    {tool.about && (
      <section class="tool-about">
        <h2>About this tool</h2>
        <p>{tool.about}</p>
      </section>
    )}

    <FaqSection faqs={tool.faqs || []} />
  </div>

  {faqSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}

  {relatedTools.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head"><h2>Related tools</h2></div>
        <div class="tool-grid">
          {relatedTools.map((t) => (
            <a href={`/${t.category}/${t.slug}/`} class="tool-card">
              <div class="tool-icon">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" set:html={categoryIcons[t.category as keyof typeof categoryIcons]} />
              </div>
              <div><h4>{t.name}</h4><p>{t.desc}</p></div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>

<style>
  .tool-widget-placeholder {
    border: 1px dashed var(--border);
    border-radius: 14px;
    padding: 48px 24px;
    text-align: center;
    color: var(--muted);
    background: var(--surface);
    margin-bottom: 16px;
  }
  .tool-about { margin: 32px 0; }
  .tool-about h2 { font-family: 'Space Grotesk', sans-serif; font-size: 20px; margin: 0 0 10px; }
  .tool-about p { color: var(--muted); font-size: 14.5px; line-height: 1.7; max-width: 720px; }
</style>

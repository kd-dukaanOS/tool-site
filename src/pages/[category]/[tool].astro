        data-slug={tool.slug}
        data-name={tool.name}
        data-url={`/${tool.category}/${tool.slug}/`}
        aria-label="Save this tool"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 17.3l-6.16 3.6 1.64-7.03L2 9.24l7.19-.61L12 2l2.81 6.63 7.19.61-5.48 4.63 1.64 7.03z"/></svg>

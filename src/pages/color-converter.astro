---
import Layout from '../layouts/Layout.astro';
import FaqSection from '../components/FaqSection.astro';
const faqs = [
  { question: "What's the difference between HEX, RGB, and HSL color formats?", answer: "HEX represents color as a 6-digit code, RGB expresses it as red/green/blue intensity values (0-255 each), and HSL uses hue, saturation, and lightness — all three represent the same colors, just in different formats." },
  { question: "Which color format should I use in CSS?", answer: "All three (HEX, RGB, HSL) are valid in modern CSS — HSL is often preferred when you want to easily adjust lightness or saturation without recalculating the whole color." },
  { question: "How do I find the HEX code of a color I see on a website?", answer: "Use your browser's DevTools color picker (right-click an element → Inspect) to sample the exact color, then paste that HEX value into this tool to see its RGB and HSL equivalents." },
  { question: "Can I convert a color by typing its RGB value instead of picking it?", answer: "Currently this tool converts from the color picker and HEX input — typing RGB or HSL directly to convert isn't yet supported in this version." },
  { question: "Are HEX color codes case-sensitive?", answer: "No, HEX codes work the same whether letters are uppercase or lowercase (#3B82F6 and #3b82f6 represent the same color)." },
];
---

<Layout title="Free Color Converter Online — HEX, RGB, HSL">
  <main class="max-w-4xl mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold text-gray-800 mb-2">Color Converter</h1>
    <p class="text-gray-600 mb-6">Convert colors between HEX, RGB, and HSL formats instantly.</p>

    <div class="flex items-center gap-4 mb-6">
      <input id="colorPicker" type="color" value="#3b82f6" class="w-16 h-16 rounded-lg border border-gray-300 cursor-pointer" />
      <div id="colorPreview" class="w-16 h-16 rounded-lg border border-gray-300" style="background-color:#3b82f6"></div>
    </div>

    <div class="space-y-3">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">HEX</label>
        <input id="hexValue" type="text" class="w-full p-2 border border-gray-300 rounded-lg font-mono text-sm focus:outline-none focus:ring-2 focus:ring-blue-400" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">RGB</label>
        <input id="rgbValue" type="text" class="w-full p-2 border border-gray-300 rounded-lg font-mono text-sm focus:outline-none focus:ring-2 focus:ring-blue-400" />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">HSL</label>
        <input id="hslValue" type="text" class="w-full p-2 border border-gray-300 rounded-lg font-mono text-sm focus:outline-none focus:ring-2 focus:ring-blue-400" />
      </div>
    </div>

    <section class="mt-12 text-gray-700 leading-relaxed">
      <h2 class="text-xl font-semibold mb-2">About This Color Converter</h2>
      <p>
        Colors on the web can be expressed in several formats: HEX codes (like #3b82f6) are common in CSS and
        design tools, RGB expresses color as red/green/blue intensity values, and HSL uses hue, saturation, and
        lightness for more intuitive color adjustments. Pick a color or type a value in any format, and this tool
        instantly converts it into the others.
      </p>
    </section>

    <FaqSection faqs={faqs} />
  </main>
</Layout>

<script>
  // @ts-nocheck
  const colorPicker = document.getElementById('colorPicker');
  const colorPreview = document.getElementById('colorPreview');
  const hexValue = document.getElementById('hexValue');
  const rgbValue = document.getElementById('rgbValue');
  const hslValue = document.getElementById('hslValue');

  function hexToRgb(hex) {
    const r = parseInt(hex.slice(1, 3), 16);
    const g = parseInt(hex.slice(3, 5), 16);
    const b = parseInt(hex.slice(5, 7), 16);
    return { r, g, b };
  }

  function rgbToHsl(r, g, b) {
    r /= 255; g /= 255; b /= 255;
    const max = Math.max(r, g, b), min = Math.min(r, g, b);
    let h = 0, s = 0, l = (max + min) / 2;

    if (max !== min) {
      const d = max - min;
      s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
      if (max === r) h = (g - b) / d + (g < b ? 6 : 0);
      else if (max === g) h = (b - r) / d + 2;
      else h = (r - g) / d + 4;
      h /= 6;
    }
    return { h: Math.round(h * 360), s: Math.round(s * 100), l: Math.round(l * 100) };
  }

  function updateFromHex(hex) {
    if (!/^#[0-9A-Fa-f]{6}$/.test(hex)) return;
    const { r, g, b } = hexToRgb(hex);
    const { h, s, l } = rgbToHsl(r, g, b);

    hexValue.value = hex;
    rgbValue.value = `rgb(${r}, ${g}, ${b})`;
    hslValue.value = `hsl(${h}, ${s}%, ${l}%)`;
    colorPreview.style.backgroundColor = hex;
    colorPicker.value = hex;
  }

  colorPicker?.addEventListener('input', () => updateFromHex(colorPicker.value));
  hexValue?.addEventListener('input', () => updateFromHex(hexValue.value));

  updateFromHex('#3b82f6');
</script>
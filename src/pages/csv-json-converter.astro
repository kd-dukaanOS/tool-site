---
import Layout from '../layouts/Layout.astro';
import FaqSection from '../components/FaqSection.astro';
const faqs = [
  { question: "Why would I need to convert CSV to JSON?", answer: "JSON is the standard format for web APIs and applications, so converting spreadsheet data (CSV) to JSON is a common step when importing data into a web app or database." },
  { question: "Does my CSV need headers for this to work?", answer: "Yes, this tool expects the first row of your CSV to be column headers, which become the property names in the resulting JSON." },
  { question: "Why does JSON to CSV conversion fail?", answer: "The JSON must be a non-empty array of objects with the same structure — if your JSON is a single object rather than an array, or has deeply nested data, conversion may not work as expected." },
  { question: "Can this tool handle commas inside CSV values?", answer: "This tool uses simple comma splitting, so values containing commas without proper quoting may not convert correctly — for complex CSV files, a dedicated CSV parser handles quoted fields more robustly." },
  { question: "Is my data uploaded anywhere during conversion?", answer: "No, all conversion happens locally in your browser." },
];
---

<Layout title="Free CSV to JSON and JSON to CSV Converter Online">
  <main class="max-w-4xl mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold text-gray-800 mb-2">CSV ↔ JSON Converter</h1>
    <p class="text-gray-600 mb-6">Convert CSV data to JSON, or JSON arrays back to CSV, instantly.</p>

    <div class="grid md:grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Input</label>
        <textarea id="csvJsonInput" class="w-full h-64 p-3 border border-gray-300 rounded-lg font-mono text-sm focus:outline-none focus:ring-2 focus:ring-blue-400" placeholder="Paste CSV or JSON here..."></textarea>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Output</label>
        <textarea id="csvJsonOutput" class="w-full h-64 p-3 border border-gray-300 rounded-lg font-mono text-sm bg-gray-100" readonly></textarea>
      </div>
    </div>

    <div class="flex flex-wrap gap-3 mt-4">
      <button id="csvToJsonBtn" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700">CSV → JSON</button>
      <button id="jsonToCsvBtn" class="bg-gray-600 text-white px-4 py-2 rounded-lg hover:bg-gray-700">JSON → CSV</button>
      <button id="csvJsonCopyBtn" class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700">Copy Output</button>
    </div>

    <p id="csvJsonError" class="text-red-600 mt-3 font-medium"></p>

    <section class="mt-12 text-gray-700 leading-relaxed">
      <h2 class="text-xl font-semibold mb-2">About This CSV/JSON Converter</h2>
      <p>
        CSV (Comma-Separated Values) is a simple tabular format used in spreadsheets, while JSON is the standard
        format for structured data in web applications and APIs. This tool converts between the two instantly,
        useful for developers importing spreadsheet data into an app, or exporting API data into a spreadsheet-friendly
        format.
      </p>
    </section>

    <FaqSection faqs={faqs} />
  </main>
</Layout>

<script>
  // @ts-nocheck
  const input = document.getElementById('csvJsonInput');
  const output = document.getElementById('csvJsonOutput');
  const errorEl = document.getElementById('csvJsonError');

  function csvToJson(csv) {
    const lines = csv.trim().split('\n');
    const headers = lines[0].split(',').map(h => h.trim());
    const result = lines.slice(1).map(line => {
      const values = line.split(',').map(v => v.trim());
      const obj = {};
      headers.forEach((h, i) => obj[h] = values[i] ?? '');
      return obj;
    });
    return JSON.stringify(result, null, 2);
  }

  function jsonToCsv(jsonStr) {
    const data = JSON.parse(jsonStr);
    if (!Array.isArray(data) || data.length === 0) throw new Error('JSON must be a non-empty array of objects');
    const headers = Object.keys(data[0]);
    const rows = data.map(obj => headers.map(h => obj[h] ?? '').join(','));
    return [headers.join(','), ...rows].join('\n');
  }

  document.getElementById('csvToJsonBtn')?.addEventListener('click', () => {
    try {
      output.value = csvToJson(input.value);
      errorEl.textContent = '';
    } catch (e) {
      errorEl.textContent = 'Error converting CSV: ' + e.message;
    }
  });

  document.getElementById('jsonToCsvBtn')?.addEventListener('click', () => {
    try {
      output.value = jsonToCsv(input.value);
      errorEl.textContent = '';
    } catch (e) {
      errorEl.textContent = 'Error converting JSON: ' + e.message;
    }
  });

  document.getElementById('csvJsonCopyBtn')?.addEventListener('click', () => {
    navigator.clipboard.writeText(output.value);
  });
</script>
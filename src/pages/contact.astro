---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us — ToolSite">
  <main class="max-w-3xl mx-auto px-4 py-10 prose prose-sm">
    <h1 class="text-3xl font-bold text-gray-800 mb-4">Contact Us</h1>
    <p>Have a question, found a bug, or want to suggest a new tool? Reach out at:</p>
    <p class="font-mono text-blue-600">your-email@example.com</p>
    <p class="text-sm text-gray-500">Replace this with your actual email address before going live.</p>
  </main>
</Layout>
---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found — TooManyToolz">
  <main class="max-w-2xl mx-auto px-4 py-24 text-center">
    <h1 class="text-4xl font-bold text-gray-800 mb-4">404 — Page Not Found</h1>
    <p class="text-gray-600 mb-6">The page you're looking for doesn't exist. Try one of our tools instead.</p>
    <a href="/" class="bg-blue-600 text-white px-5 py-2 rounded-lg hover:bg-blue-700">Back to Home</a>
  </main>
</Layout>
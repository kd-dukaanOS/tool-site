---
import Layout from '../layouts/Layout.astro';
import FaqSection from '../components/FaqSection.astro';
const faqs = [
  { question: "What does a diff checker actually compare?", answer: "This tool compares two blocks of text line by line, showing which lines were removed (in red) and which were added or changed (in green)." },
  { question: "Can I use this to compare code changes?", answer: "Yes, pasting two versions of code works well for spotting line-level differences, though for full syntax-aware code diffing, a dedicated code diff tool may show more detail." },
  { question: "Why does a single changed word show the whole line as different?", answer: "This tool compares differences at the line level, so if even one word in a line changes, the entire line is flagged as different rather than just the changed word." },
  { question: "Does this tool save or store the text I compare?", answer: "No, comparison happens entirely in your browser and nothing is sent to or stored on a server." },
  { question: "Can I compare two entire documents at once?", answer: "Yes, paste the full text of each document into the two boxes — there's no strict length limit, though very large documents may take a moment longer to process." },
];
---

<Layout title="Free Text Diff Checker Online — Compare Two Texts">
  <main class="max-w-5xl mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold text-gray-800 mb-2">Text Diff Checker</h1>
    <p class="text-gray-600 mb-6">Compare two blocks of text and instantly see the differences, line by line.</p>

    <div class="grid md:grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Original Text</label>
        <textarea id="diffInput1" class="w-full h-64 p-3 border border-gray-300 rounded-lg font-mono text-sm focus:outline-none focus:ring-2 focus:ring-blue-400" placeholder="Paste original text..."></textarea>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Changed Text</label>
        <textarea id="diffInput2" class="w-full h-64 p-3 border border-gray-300 rounded-lg font-mono text-sm focus:outline-none focus:ring-2 focus:ring-blue-400" placeholder="Paste changed text..."></textarea>
      </div>
    </div>

    <button id="compareBtn" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 mt-4">Compare</button>

    <div class="mt-6">
      <label class="block text-sm font-medium text-gray-700 mb-1">Result</label>
      <div id="diffResult" class="p-3 border border-gray-300 rounded-lg bg-gray-50 font-mono text-sm whitespace-pre-wrap min-h-[100px]"></div>
    </div>

    <section class="mt-12 text-gray-700 leading-relaxed">
      <h2 class="text-xl font-semibold mb-2">About This Diff Checker</h2>
      <p>
        This tool compares two blocks of text line by line and highlights what's been added, removed, or changed
        between them. Useful for comparing document revisions, code changes, or any two versions of text where
        you need to quickly spot what's different, without installing any software.
      </p>
    </section>

    <FaqSection faqs={faqs} />
  </main>
</Layout>

<script>
  // @ts-nocheck
  const input1 = document.getElementById('diffInput1');
  const input2 = document.getElementById('diffInput2');
  const result = document.getElementById('diffResult');
  const compareBtn = document.getElementById('compareBtn');

  function escapeHtml(str) {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  compareBtn?.addEventListener('click', () => {
    const lines1 = input1.value.split('\n');
    const lines2 = input2.value.split('\n');
    const maxLines = Math.max(lines1.length, lines2.length);
    let output = '';

    for (let i = 0; i < maxLines; i++) {
      const l1 = lines1[i] ?? '';
      const l2 = lines2[i] ?? '';

      if (l1 === l2) {
        output += `  ${escapeHtml(l1)}\n`;
      } else {
        if (l1) output += `<span class="bg-red-100 text-red-700">- ${escapeHtml(l1)}</span>\n`;
        if (l2) output += `<span class="bg-green-100 text-green-700">+ ${escapeHtml(l2)}</span>\n`;
      }
    }

    result.innerHTML = output || 'No differences found — texts are identical.';
  });
</script>
---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Free Markdown Previewer Online — Live Preview">
  <main class="max-w-5xl mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold text-gray-800 mb-2">Markdown Previewer</h1>
    <p class="text-gray-600 mb-6">Write Markdown on the left, see the live rendered preview on the right.</p>

    <div class="grid md:grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Markdown Input</label>
        <textarea
          id="markdownInput"
          class="w-full h-96 p-3 border border-gray-300 rounded-lg font-mono text-sm focus:outline-none focus:ring-2 focus:ring-blue-400"
          placeholder="# Heading&#10;&#10;Type **bold**, *italic*, - lists, and more..."
        ></textarea>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Live Preview</label>
        <div
          id="markdownPreview"
          class="w-full h-96 p-3 border border-gray-300 rounded-lg bg-white overflow-y-auto prose prose-sm max-w-none"
        ></div>
      </div>
    </div>

    <section class="mt-12 text-gray-700 leading-relaxed">
      <h2 class="text-xl font-semibold mb-2">About This Markdown Previewer</h2>
      <p>
        Markdown is a lightweight syntax for formatting text using plain characters, widely used in README files,
        documentation, blog posts, and messaging apps. This tool renders your Markdown into formatted HTML in
        real-time as you type, so you can preview headings, bold and italic text, lists, links, and code blocks
        before publishing them anywhere.
      </p>
    </section>
  </main>
</Layout>

<script>
  function simpleMarkdownToHtml(md: string) {
    let html = md;

    html = html.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

    html = html.replace(/^### (.*$)/gim, '<h3>$1</h3>');
    html = html.replace(/^## (.*$)/gim, '<h2>$1</h2>');
    html = html.replace(/^# (.*$)/gim, '<h1>$1</h1>');

    html = html.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
    html = html.replace(/\*(.*?)\*/g, '<em>$1</em>');

    html = html.replace(/`([^`]+)`/g, '<code class="bg-gray-100 px-1 rounded">$1</code>');

    html = html.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="text-blue-600 underline">$1</a>');

    html = html.replace(/^\- (.*$)/gim, '<li>$1</li>');
    html = html.replace(/(<li>.*<\/li>)/gims, '<ul class="list-disc pl-5">$1</ul>');

    html = html.split('\n\n').map(block => {
      if (block.match(/^<h[1-3]>|^<ul>/)) return block;
      return block.trim() ? `<p>${block}</p>` : '';
    }).join('');

    return html;
  }

  const input = document.getElementById('markdownInput');
  const preview = document.getElementById('markdownPreview');

  if (input instanceof HTMLTextAreaElement && preview) {
    const update = () => {
      preview.innerHTML = simpleMarkdownToHtml(input.value);
    };
    input.addEventListener('input', update);
    input.value = '# Hello World\n\nThis is **bold** and this is *italic*.\n\n- List item one\n- List item two';
    update();
  }
</script>
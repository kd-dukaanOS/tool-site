---
import Layout from '../layouts/Layout.astro';
import FaqSection from '../components/FaqSection.astro';
const faqs = [
  { question: "What is a URL slug?", answer: "A slug is the readable part of a URL that identifies a specific page, typically lowercase with hyphens instead of spaces, like 'my-blog-post-title'." },
  { question: "Why should URL slugs be lowercase with hyphens?", answer: "Lowercase with hyphens is the widely accepted convention because it's clean, readable, and avoids case-sensitivity issues across different servers and systems." },
  { question: "Does this tool remove special characters automatically?", answer: "Yes, punctuation and special characters are stripped out automatically, leaving only letters, numbers, and hyphens." },
  { question: "Can I use this for file names, not just URLs?", answer: "Yes, the same clean, hyphenated format works well for file names too, avoiding spaces and special characters that can cause issues in some systems." },
  { question: "Are slugs important for SEO?", answer: "Yes, a clean, keyword-relevant slug helps both users and search engines understand what a page is about at a glance." },
];
---

<Layout title="Free URL Slug Generator Online">
  <main class="max-w-4xl mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold text-gray-800 mb-2">Slug Generator</h1>
    <p class="text-gray-600 mb-6">Convert any title or text into a clean, URL-friendly slug instantly.</p>

    <label class="block text-sm font-medium text-gray-700 mb-1">Input Text</label>
    <input id="slugInput" type="text" placeholder="e.g. My Awesome Blog Post!" class="w-full p-3 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-400 mb-4" />

    <label class="block text-sm font-medium text-gray-700 mb-1">Generated Slug</label>
    <div class="flex gap-2">
      <input id="slugOutput" type="text" readonly class="flex-1 p-3 border border-gray-300 rounded-lg font-mono text-sm bg-gray-100" />
      <button id="copySlugBtn" class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700">Copy</button>
    </div>

    <section class="mt-12 text-gray-700 leading-relaxed">
      <h2 class="text-xl font-semibold mb-2">About This Slug Generator</h2>
      <p>
        A URL slug is the human-readable, SEO-friendly part of a web address that identifies a specific page,
        typically lowercase with words separated by hyphens instead of spaces. This tool converts any title or
        sentence into a properly formatted slug — removing special characters, converting spaces to hyphens, and
        lowercasing everything — ready to use in a blog post URL, CMS, or file name.
      </p>
    </section>

    <FaqSection faqs={faqs} />
  </main>
</Layout>

<script>
  // @ts-nocheck
  const input = document.getElementById('slugInput');
  const output = document.getElementById('slugOutput');
  const copyBtn = document.getElementById('copySlugBtn');

  function slugify(text) {
    return text
      .toString()
      .toLowerCase()
      .trim()
      .replace(/[^\w\s-]/g, '')
      .replace(/[\s_]+/g, '-')
      .replace(/^-+|-+$/g, '');
  }

  input?.addEventListener('input', () => {
    output.value = slugify(input.value);
  });

  copyBtn?.addEventListener('click', () => {
    navigator.clipboard.writeText(output.value);
  });
</script>
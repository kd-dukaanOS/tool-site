---
interface Props {
  id: string;
  title: string;
  height?: number;
}

const { id, title, height = 260 } = Astro.props as Props;
---

<div class="chart-card">

  <h3 class="chart-title">{title}</h3>

  <div class="chart-canvas-wrap" style={`height:${height}px`}>
    <canvas id={id}></canvas>
  </div>

</div>

<style>

.chart-card{

padding:22px;

border-radius:18px;

border:1px solid #E5E7EB;

background:#FFFFFF;

}

.chart-title{

margin:0 0 16px;

font-size:1rem;

font-weight:700;

color:#111827;

}

.chart-canvas-wrap{

position:relative;

width:100%;

}

:global(.dark) .chart-card{

background:#111217;

border-color:#27272A;

}

:global(.dark) .chart-title{

color:#FAFAFA;

}

</style>

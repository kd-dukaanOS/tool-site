---
interface Props {
  calculateId?: string;
  resetId?: string;
  copyId?: string;
  downloadId?: string;
  shareId?: string;

  showCopy?: boolean;
  showDownload?: boolean;
  showShare?: boolean;

  calculateText?: string;
  resetText?: string;
}

const {
  calculateId = "calculateBtn",
  resetId = "resetBtn",
  copyId = "copyBtn",
  downloadId = "downloadBtn",
  shareId = "shareBtn",

  showCopy = false,
  showDownload = false,
  showShare = false,

  calculateText = "Calculate",
  resetText = "Reset",
} = Astro.props as Props;
---

<div class="calculator-actions">
  <button id={calculateId} type="button" class="btn btn-primary">
    <span>⚡</span>
    <span>{calculateText}</span>
  </button>

  <button id={resetId} type="reset" class="btn btn-secondary">
    <span>↺</span>
    <span>{resetText}</span>
  </button>

  {showCopy && (
    <button id={copyId} type="button" class="btn btn-secondary">
      <span>📋</span>
      <span>Copy</span>
    </button>
  )}

  {showDownload && (
    <button id={downloadId} type="button" class="btn btn-ghost">
      <span>⬇</span>
      <span>Download</span>
    </button>
  )}

  {showShare && (
    <button id={shareId} type="button" class="btn btn-ghost">
      <span>🔗</span>
      <span>Share</span>
    </button>
  )}
</div>

<style>
  .calculator-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 28px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 48px;
    padding: 0 20px;
    border-radius: 14px;
    border: 1px solid transparent;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .btn:active {
    transform: translateY(0);
  }

  .btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.15);
  }

  .btn-primary {
    background: var(--color-primary);
    color: #fff;
    border-color: var(--color-primary);
  }

  .btn-primary:hover {
    background: var(--color-primary-dark);
  }

  .btn-secondary {
    background: var(--bg-card);
    color: var(--text-primary);
    border-color: var(--border-subtle);
  }

  .btn-secondary:hover {
    background: var(--bg-page);
  }

  .btn-ghost {
    background: transparent;
    color: var(--color-primary);
    border-color: var(--border-subtle);
  }

  .btn-ghost:hover {
    background: var(--color-primary-light);
  }

  @media (max-width: 640px) {
    .calculator-actions {
      display: grid;
      grid-template-columns: 1fr;
    }
    .btn {
      width: 100%;
    }
  }
</style>

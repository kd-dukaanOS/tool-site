---
interface Props {
  columns?: 1 | 2 | 3 | 4 | 5 | 6;
  gap?: "sm" | "md" | "lg";
  responsive?: boolean;
  class?: string;
}

const {
  columns = 3,
  gap = "md",
  responsive = true,
  class: className = "",
} = Astro.props as Props;
---

<div
  class:list={[
    "results-grid",
    `cols-${columns}`,
    `gap-${gap}`,
    responsive && "responsive",
    className,
  ]}
>
  <slot />
</div>

<style>

.results-grid{

display:grid;

width:100%;

align-items:stretch;

}

/* ===========================
   Columns
=========================== */

.cols-1{

grid-template-columns:1fr;

}

.cols-2{

grid-template-columns:
repeat(2,minmax(0,1fr));

}

.cols-3{

grid-template-columns:
repeat(3,minmax(0,1fr));

}

.cols-4{

grid-template-columns:
repeat(4,minmax(0,1fr));

}

.cols-5{

grid-template-columns:
repeat(5,minmax(0,1fr));

}

.cols-6{

grid-template-columns:
repeat(6,minmax(0,1fr));

}

/* ===========================
   Gap
=========================== */

.gap-sm{

gap:12px;

}

.gap-md{

gap:18px;

}

.gap-lg{

gap:26px;

}

/* ===========================
   Mobile
=========================== */

@media(max-width:1024px){

.responsive.cols-6,
.responsive.cols-5{

grid-template-columns:
repeat(3,minmax(0,1fr));

}

.responsive.cols-4{

grid-template-columns:
repeat(2,minmax(0,1fr));

}

}

@media(max-width:768px){

.responsive.cols-6,
.responsive.cols-5,
.responsive.cols-4,
.responsive.cols-3{

grid-template-columns:
repeat(2,minmax(0,1fr));

}

}

@media(max-width:640px){

.responsive{

grid-template-columns:1fr;

}

}

</style>
---
interface Props {
  id: string;
  label: string;
  type?: string;
  placeholder?: string;
  value?: string | number;
  helpText?: string;
  required?: boolean;
  min?: string | number;
  max?: string | number;
  step?: string | number;
  disabled?: boolean;
  autocomplete?: string;
}

const {
  id,
  label,
  type = "text",
  placeholder = "",
  value = "",
  helpText = "",
  required = false,
  min,
  max,
  step,
  disabled = false,
  autocomplete = "off",
} = Astro.props as Props;
---

<div class="calculator-field">

  <label
    for={id}
    class="calculator-label"
  >
    {label}

    {
      required && (
        <span class="required">*</span>
      )
    }

  </label>

  <input
    id={id}
    class="calculator-input"
    type={type}
    value={value}
    placeholder={placeholder}
    required={required}
    min={min}
    max={max}
    step={step}
    disabled={disabled}
    autocomplete={autocomplete}
  />

  {
    helpText && (
      <p class="calculator-help">
        {helpText}
      </p>
    )
  }

</div>

<style>

.calculator-field{

display:flex;

flex-direction:column;

gap:.55rem;

margin-bottom:1.25rem;

}

.calculator-label{

font-size:.95rem;

font-weight:600;

color:var(--color-text,#111827);

}

.required{

color:#EF4444;

margin-left:4px;

}

.calculator-input{

width:100%;

height:48px;

padding:0 .95rem;

border:1px solid var(--color-border,#D1D5DB);

border-radius:14px;

background:var(--color-surface,#FFFFFF);

font-size:.95rem;

color:var(--color-text,#111827);

transition:
border-color .2s,
box-shadow .2s;

}

.calculator-input:hover{

border-color:#A5B4FC;

}

.calculator-input:focus{

outline:none;

border-color:#4F46E5;

box-shadow:0 0 0 4px rgba(79,70,229,.12);

}

.calculator-input:disabled{

opacity:.6;

cursor:not-allowed;

}

.calculator-help{

font-size:.82rem;

line-height:1.5;

color:#6B7280;

margin:0;

}

:global(.dark) .calculator-input{

background:#18181B;

border-color:#27272A;

color:#FAFAFA;

}

:global(.dark) .calculator-label{

color:#F4F4F5;

}

:global(.dark) .calculator-help{

color:#A1A1AA;

}

@media(max-width:640px){

.calculator-input{

height:46px;

}

}

</style>
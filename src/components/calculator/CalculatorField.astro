---
interface Props {
  id: string;
  label: string;
  type?: "text" | "number" | "email" | "password" | "search" | "tel" | "url" | "date" | "time" | "datetime-local" | "month" | "week" | "color" | "range" | "hidden" | "select" | "textarea";
  placeholder?: string;
  value?: string | number;
  helpText?: string;
  required?: boolean;
  min?: string | number;
  max?: string | number;
  step?: string | number;
  disabled?: boolean;
  autocomplete?: string;
}

const {
  id,
  label,
  type = "text",
  placeholder = "",
  value = "",
  helpText = "",
  required = false,
  min,
  max,
  step,
  disabled = false,
  autocomplete = "off",
} = Astro.props as Props;
---

<div class="calculator-field">
  <label for={id} class="calculator-label">
    {label}
    {required && <span class="required">*</span>}
  </label>

  {type === "select" ? (
    <select id={id} class="calculator-input" required={required} disabled={disabled}>
      <slot />
    </select>
  ) : type === "textarea" ? (
    <textarea id={id} class="calculator-input" placeholder={placeholder} required={required} disabled={disabled}>{value}</textarea>
  ) : (
    <input
      id={id}
      class="calculator-input"
      type={type}
      value={value}
      placeholder={placeholder}
      required={required}
      min={min}
      max={max}
      step={step}
      disabled={disabled}
      autocomplete={autocomplete}
    />
  )}

  {helpText && <p class="calculator-help">{helpText}</p>}
</div>

<style>
  .calculator-field {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin-bottom: 1.25rem;
  }

  .calculator-label {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .required {
    color: #EF4444;
    margin-left: 4px;
  }

  .calculator-input {
    width: 100%;
    height: 48px;
    padding: 0 0.95rem;
    border: 1px solid var(--border-subtle);
    border-radius: 14px;
    background: var(--bg-card);
    font-size: 0.95rem;
    color: var(--text-primary);
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .calculator-input:hover {
    border-color: #A5B4FC;
  }

  .calculator-input:focus {
    outline: none;
    border-color: #4F46E5;
    box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.12);
  }

  .calculator-input:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  select.calculator-input {
    cursor: pointer;
  }

  textarea.calculator-input {
    height: auto;
    min-height: 120px;
    padding: 0.7rem 0.95rem;
    line-height: 1.5;
    resize: vertical;
    font-family: inherit;
  }

  .calculator-help {
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--text-secondary);
    margin: 0;
  }

  @media (max-width: 640px) {
    .calculator-input {
      height: 46px;
    }
  }
</style>

---
interface Props {
  id: string;
  headers: string[];
  caption?: string;
}

const { id, headers, caption = "" } = Astro.props as Props;
---

<div class="schedule-wrap">
  {caption && <p class="schedule-caption">{caption}</p>}

  <div class="schedule-scroll">
    <table class="schedule-table">
      <thead>
        <tr>
          {headers.map((h) => <th>{h}</th>)}
        </tr>
      </thead>
      <tbody id={id}></tbody>
    </table>
  </div>
</div>

<style>
  .schedule-wrap {
    padding: 22px;
    border-radius: 18px;
    border: 1px solid var(--border-subtle);
    background: var(--bg-card);
  }

  .schedule-caption {
    margin: 0 0 16px;
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .schedule-scroll {
    width: 100%;
    overflow-x: auto;
  }

  .schedule-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .schedule-table th {
    text-align: left;
    padding: 10px 14px;
    background: var(--bg-page);
    color: var(--text-secondary);
    font-weight: 600;
    white-space: nowrap;
  }

  .schedule-table td {
    padding: 10px 14px;
    border-top: 1px solid var(--border-subtle);
    white-space: nowrap;
    color: var(--text-primary);
  }
</style>

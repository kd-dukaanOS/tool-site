---
interface Props {
  lang?: "en" | "es";
}
const { lang = "en" } = Astro.props as Props;

const countries = lang === "es" ? [
  { flagCode: "us", name: "Estados Unidos", desc: "Impuesto federal, FICA y salario neto", href: "/us" },
  { flagCode: "ca", name: "Canadá", desc: "Impuesto federal + provincial, CPP y EI", href: "/canada" },
  { flagCode: "gb", name: "Reino Unido", desc: "Impuesto sobre la Renta y Seguro Nacional", href: "/uk" },
] : [
  { flagCode: "us", name: "United States", desc: "Federal tax, FICA & take-home pay", href: "/us" },
  { flagCode: "ca", name: "Canada", desc: "Federal + provincial tax, CPP & EI", href: "/canada" },
  { flagCode: "gb", name: "United Kingdom", desc: "Income Tax & National Insurance", href: "/uk" },
];

const title = lang === "es" ? "🌍 Herramientas que hablan tu idioma fiscal." : "🌍 Tools that speak your country.";
---
<section class="ts-country-section">
  <div class="ts-country-inner">
    <div class="ts-country-head">
      <h2 class="ts-country-title">{title}</h2>
    </div>
    <div class="ts-country-grid">
      {countries.map((c) => (
        <a class="ts-country-card" href={c.href}>
          <img
            class="ts-country-flag"
            src={`https://flagcdn.com/48x36/${c.flagCode}.png`}
            srcset={`https://flagcdn.com/96x72/${c.flagCode}.png 2x`}
            width="48" height="36"
            alt={`${c.name} flag`}
            loading="lazy"
          />
          <div>
            <h3>{c.name}</h3>
            <p>{c.desc}</p>
          </div>
          <span class="ts-country-arrow">→</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .ts-country-section { padding: 0 var(--space-6) var(--space-12); }
  .ts-country-inner { max-width: 1280px; margin: 0 auto; }
  .ts-country-head { margin-bottom: var(--space-6); }
  .ts-country-title {
    font-family: var(--font-sans);
    font-size: var(--fs-h2);
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }
  .ts-country-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }
  .ts-country-card {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
    text-decoration: none;
    transition: border-color var(--duration-fast) var(--ease-standard),
                transform var(--duration-fast) var(--ease-standard);
  }
  .ts-country-card:hover {
    border-color: var(--border-hover);
    transform: translateY(-2px);
  }
  .ts-country-flag { width: 48px; height: 36px; border-radius: 6px; object-fit: cover; flex-shrink: 0; border: 1px solid var(--border-subtle); }
  .ts-country-card h3 {
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 4px;
  }
  .ts-country-card p {
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    color: var(--text-secondary);
    margin: 0;
  }
  .ts-country-arrow {
    margin-left: auto;
    color: var(--text-muted);
    font-size: var(--fs-body);
    flex-shrink: 0;
  }
  @media (max-width: 900px) {
    .ts-country-grid { grid-template-columns: 1fr; }
  }
</style>
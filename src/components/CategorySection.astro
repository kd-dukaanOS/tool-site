---
import CategoryCard from './ui/CategoryCard.astro';
import { tools } from '../data/tools.js';
import { SPANISH_CATEGORIES, SPANISH_TOOLS } from '../utils/i18n';

interface Props {
  lang?: "en" | "es";
}
const { lang = "en" } = Astro.props as Props;
const prefix = lang === "es" ? "/es" : "";

interface CategoryItem {
  icon: string;
  title: string;
  accent: "purple" | "violet" | "teal" | "red" | "green" | "orange" | "blue" | "yellow";
  description: string;
  tools: string[];
  href: string;
}

const categoryDefs: CategoryItem[] = [
  { icon: '≡', title: 'Text Tools', accent: 'purple',
    description: 'Word counting, case conversion, diffing, and other everyday text utilities.',
    tools: ['Case Converter', 'Markdown Previewer'], href: '/text-tools' },
  { icon: '{}', title: 'Developer Tools', accent: 'violet',
    description: 'JSON, regex, tokens, and data-format helpers for day-to-day dev work.',
    tools: ['JWT Decoder', 'CSV ↔ JSON Converter'], href: '/developer-tools' },
  { icon: '⇄', title: 'Converters', accent: 'teal',
    description: 'Convert between encodings, timestamps, and color formats.',
    tools: ['Base64 Tool', 'Currency Converter', 'Data Storage Converter'], href: '/converters' },
  { icon: '🛡', title: 'Security Tools', accent: 'red',
    description: 'Generate IDs, passwords, and hashes — all done locally in your browser.',
    tools: ['Password Generator', 'Hash Generator'], href: '/security-tools' },
  { icon: '$', title: 'Finance Calculators', accent: 'green',
    description: 'Loans, deposits, investments, and everyday finance math.',
    tools: ['Payroll Calculator', 'Salary Calculator', 'Break-Even Calculator'], href: '/finance' },
  { icon: '÷', title: 'Math & Numbers', accent: 'orange',
    description: 'Solve equations, percentages, ratios, and more.',
    tools: ['Percentage Increase Calculator', 'Ratio Calculator', 'Average Calculator'], href: '/math-stats' },
  { icon: '📅', title: 'Date & Time', accent: 'blue',
    description: 'Work with dates, durations, and time conversions.',
    tools: ['Date Difference Calculator', 'Countdown Calculator', 'Birthday Calculator'], href: '/date-time' },
  { icon: '🩺', title: 'Health & Fitness', accent: 'yellow',
    description: 'BMI, calorie, macro, and other health calculators.',
    tools: ['Calorie Calculator', 'Macro Calculator', 'BMR Calculator'], href: '/health' },
  { icon: '💼', title: 'Business Tools', accent: 'purple',
    description: 'Calculators for pricing, margins, and profitability.',
    tools: ['Burn Rate Calculator', 'Cash Flow Calculator', 'Markup Calculator'], href: '/business' },
];

const categories = categoryDefs.map((cat) => {
  const slug = cat.href.slice(1);
  const count = tools.filter((t) => t.category === slug).length;

  if (lang === "es") {
    const esCat = SPANISH_CATEGORIES.find((c) => c.slug === slug);
    const esExamples = SPANISH_TOOLS.filter((t) => t.category === slug).slice(0, 3).map((t) => t.name);
    return {
      ...cat,
      title: esCat?.name ?? cat.title,
      description: esCat?.description ?? cat.description,
      tools: esExamples.length > 0 ? esExamples : cat.tools,
      count,
      href: `${prefix}${cat.href}`,
      lang,
    };
  }

  return { ...cat, count, href: `${prefix}${cat.href}`, lang };
});

const viewAllCopy = lang === "es" ? "Ver todas las herramientas →" : "View all tools →";
---
<section class="ts-cat-section">
  <div class="ts-cat-section-inner">
    <div class="ts-cat-section-head">
      <h2 class="ts-cat-section-title">✦ Find your kind of useful.</h2>
      <a href={`${prefix}/tools`} class="ts-cat-section-viewall">{viewAllCopy}</a>
    </div>

    <div class="ts-cat-grid reveal-stagger">
      {categories.map((cat) => <CategoryCard {...cat} />)}
    </div>
  </div>
</section>

<style>
  .ts-cat-section { padding: 0 var(--space-6) var(--space-12); }
  .ts-cat-section-inner { max-width: 1280px; margin: 0 auto; }
  .ts-cat-section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-6);
  }
  .ts-cat-section-title {
    font-family: var(--font-sans);
    font-size: var(--fs-h2);
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }
  .ts-cat-section-viewall {
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
  }

  .ts-cat-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
  }

  @media (max-width: 1100px) {
    .ts-cat-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .ts-cat-grid { grid-template-columns: 1fr; }
  }
</style>

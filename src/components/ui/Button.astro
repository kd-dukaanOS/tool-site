---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
}
const { variant = 'primary', href, type = 'button', class: className = '' } = Astro.props;
const Tag = href ? 'a' : 'button';
---
<Tag class={`ts-btn ts-btn-${variant} ${className}`} href={href} type={!href ? type : undefined}>
  <slot />
</Tag>

<style>
  .ts-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-lg);
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    font-weight: 600;
    border: 1px solid transparent;
    cursor: pointer;
    text-decoration: none;
    transition: transform var(--duration-fast) var(--ease-standard),
                box-shadow var(--duration-fast) var(--ease-standard),
                background var(--duration-fast) var(--ease-standard);
  }
  .ts-btn:hover { transform: translateY(-1px); }

  .ts-btn-primary {
    background: var(--color-primary);
    color: #fff;
    box-shadow: var(--shadow-md);
  }
  .ts-btn-primary:hover {
    background: var(--color-primary-dark);
    box-shadow: var(--shadow-glow-primary), var(--shadow-md);
  }

  .ts-btn-secondary {
    background: var(--bg-card);
    color: var(--text-primary);
    border-color: var(--border-subtle);
    box-shadow: var(--shadow-sm);
  }
  .ts-btn-secondary:hover { border-color: var(--border-hover); }

  .ts-btn-ghost {
    background: transparent;
    color: var(--text-secondary);
  }
  .ts-btn-ghost:hover { color: var(--text-primary); }
</style>
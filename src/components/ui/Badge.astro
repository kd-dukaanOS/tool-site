---
interface Props {
  tone?: 'neutral' | 'primary' | 'new' | 'popular';
  class?: string;
}
const { tone = 'neutral', class: className = '' } = Astro.props;
---
<span class={`ts-badge ts-badge-${tone} ${className}`}>
  <slot />
</span>

<style>
  .ts-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-2xl);
    font-size: var(--fs-small);
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
  }
  .ts-badge-neutral {
    background: var(--bg-card);
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
  }
  .ts-badge-primary {
    background: var(--color-primary-light);
    color: var(--color-primary-dark);
  }
  .ts-badge-new {
    background: var(--accent-green-bg);
    color: var(--accent-green-icon);
  }
  .ts-badge-popular {
    background: var(--accent-orange-bg);
    color: var(--accent-orange-icon);
  }
</style>
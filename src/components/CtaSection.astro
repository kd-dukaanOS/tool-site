---
import Button from './ui/Button.astro';
---
<section class="ts-cta">
  <div class="ts-cta-inner">
    <div>
      <h2>You've got the problem.<br />We've got the tool.</h2>
      <p>Search it. Open it. Get it done.</p>
    </div>
    <div class="ts-cta-action">
      <a href="/tools" class="ts-cta-link">
        <Button variant="secondary">Explore TooManyToolz →</Button>
      </a>
      <span class="ts-cta-note">99+ free tools · No account required</span>
    </div>
  </div>
</section>

<style>
  .ts-cta {
    margin: var(--space-8) var(--space-6);
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
    border-radius: var(--radius-2xl);
    padding: var(--space-8);
    box-shadow: var(--shadow-lg);
  }
  .ts-cta-inner {
    max-width: 1120px; margin: 0 auto;
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-6);
    flex-wrap: wrap;
  }
  .ts-cta h2 { font-family: var(--font-sans); font-size: var(--fs-h2); color: #fff; margin: 0 0 6px; }
  .ts-cta p { font-size: var(--fs-body); color: rgba(255,255,255,0.85); margin: 0; }
  .ts-cta-link { text-decoration: none; flex-shrink: 0; }
  .ts-cta-link :global(.ts-btn-secondary) { background: #fff; color: var(--color-primary-dark); border-color: transparent; white-space: nowrap; }
  .ts-cta-action { display: flex; flex-direction: column; align-items: flex-end; gap: var(--space-2); flex-shrink: 0; }
  .ts-cta-note { font-size: 12px; color: rgba(255,255,255,0.75); }

  @media (max-width: 640px) {
    .ts-cta-inner { flex-direction: column; align-items: stretch; text-align: center; }
    .ts-cta-action { align-items: center; align-self: center; }
  }
</style>
---
import type { CalculatorContentData } from "../../types/calculator-content";

type Props = CalculatorContentData & { allTools?: any[]; lang?: "en" | "es" };

const { about, formula, steps, examples, practicalUses, expertTips, commonMistakes, faq, relatedCalculators, allTools, lang = "en" } = Astro.props;

const tips = expertTips || practicalUses;
const prefix = lang === "es" ? "/es" : "";

const labels = {
  en: { about: "About this tool", formula: "Formula", steps: "How It Works", examples: "Examples", inputs: "Inputs:", result: "Result:", tips: "Tips", mistakes: "Common Mistakes", faq: "Frequently Asked Questions", related: "Related Calculators" },
  es: { about: "Acerca de esta herramienta", formula: "Fórmula", steps: "Cómo Funciona", examples: "Ejemplos", inputs: "Datos:", result: "Resultado:", tips: "Consejos", mistakes: "Errores Comunes", faq: "Preguntas Frecuentes", related: "Calculadoras Relacionadas" },
}[lang];

function findToolByName(name: string) {
  return allTools?.find((t: any) => t.name === name);
}
---

<section class="calc-content">
  {about?.text && (
    <div class="calc-block">
       <h2 class="calc-heading">{labels.about}</h2>
      <p class="calc-text">{about.text}</p>
    </div>
  )}

  {formula && (
    <div class="calc-block">
      <h2 class="calc-heading">{labels.formula}</h2>
      <div class="calc-card calc-formula"><code>{formula.formula}</code></div>
      {formula.variables && formula.variables.length > 0 && (
        <ul class="calc-variables">
          {formula.variables.map((v: any) => <li><strong>{v.symbol}</strong> — {v.meaning}</li>)}
        </ul>
      )}
      {formula.explanation && <p class="calc-note">{formula.explanation}</p>}
      {formula.interpretation && <p class="calc-note">{formula.interpretation}</p>}
    </div>
  )}

  {steps && steps.length > 0 && (
    <div class="calc-block">
     <h2 class="calc-heading">{labels.steps}</h2>
      <ol class="calc-steps">{steps.map((s: string) => <li>{s}</li>)}</ol>
    </div>
  )}

  {examples && examples.length > 0 && (
    <div class="calc-block">
       <h2 class="calc-heading">{labels.examples}</h2>
      <div class="calc-examples-grid">
        {examples.map((ex: any) => (
          <div class="calc-card calc-example">
           <p><strong>{labels.inputs}</strong> {ex.inputs}</p>
            <p><strong>{labels.result}</strong> {ex.result}</p>
            {ex.explanation && <p class="calc-text">{ex.explanation}</p>}
          </div>
        ))}
      </div>
    </div>
  )}

  {tips && tips.length > 0 && (
    <div class="calc-block">
         <h2 class="calc-heading">{labels.tips}</h2>
      <ul class="calc-tips">{tips.map((t: string) => <li>{t}</li>)}</ul>
    </div>
  )}

  {commonMistakes && commonMistakes.length > 0 && (
    <div class="calc-block">
      <h2 class="calc-heading">{labels.mistakes}</h2>
      <ul class="calc-mistakes">
        {commonMistakes.map((m: any) => <li><strong>{m.mistake}</strong> — {m.fix}</li>)}
      </ul>
    </div>
  )}

  {faq && faq.length > 0 && (
    <div class="calc-block">
       <h2 class="calc-heading">{labels.faq}</h2>
      <div class="calc-faq-list">
        {faq.map((f: any) => (
          <details class="calc-card calc-faq-item">
            <summary class="calc-subheading">{f.q}</summary>
            <p class="calc-text">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  )}

  {relatedCalculators && relatedCalculators.length > 0 && (
    <div class="calc-block">
        <h2 class="calc-heading">{labels.related}</h2>
      <div class="calc-related-grid">
        {relatedCalculators.map((name: string) => {
          const match = findToolByName(name);
          return match ? (
            <a href={`${prefix}/${match.category}/${match.slug}/`} class="calc-card calc-related-card">{name}</a>
          ) : (
            <span class="calc-card calc-related-card">{name}</span>
          );
        })}
      </div>
    </div>
  )}
</section>

<style>
  .calc-content { display: flex; flex-direction: column; gap: var(--space-lg, 2rem); margin-top: var(--space-xl, 3rem); }
  .calc-block { display: flex; flex-direction: column; gap: var(--space-sm, 0.75rem); }
  .calc-heading { font-size: var(--font-lg, 1.5rem); font-weight: 700; color: var(--text-primary, #0f172a); }
  .calc-subheading { font-size: var(--font-md, 1.1rem); font-weight: 600; cursor: pointer; color: var(--text-primary, #0f172a); }
  .calc-text { line-height: 1.6; color: var(--text-secondary, #475569); }
  .calc-card { background: var(--bg-card, #fff); border: 1px solid var(--border-subtle, #e5e7eb); border-radius: var(--radius-md, 12px); padding: var(--space-md, 1.25rem); }
  .calc-variables, .calc-steps, .calc-tips, .calc-mistakes { padding-left: 1.25rem; line-height: 1.7; }
  .calc-examples-grid, .calc-related-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-md, 1rem); }
  .calc-faq-list { display: flex; flex-direction: column; gap: var(--space-sm, 0.75rem); }
  .calc-related-card { text-decoration: none; color: inherit; }
</style>

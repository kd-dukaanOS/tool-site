---
interface Props {
  lang?: "en" | "es";
}
const { lang = "en" } = Astro.props as Props;
const prefix = lang === "es" ? "/es" : "";
const viewAllLabel = lang === "es" ? "Ver todo →" : "View all →";

const blocksEn = [
  {
    title: "What's getting clicked", href: '/tools/',
    items: [
      { icon: '%', name: 'Discount Calculator', desc: 'Calculate discounted price', tag: '', href: '/finance/discount-calculator/' },
      { icon: '⚖', name: 'Weight Converter', desc: 'Convert between weight units', tag: '', href: '/converters/weight-converter/' },
      { icon: '💧', name: 'Water Intake Calculator', desc: 'Daily water intake target', tag: '', href: '/health/water-intake-calculator/' },
      { icon: '🕐', name: 'Timezone Calculator', desc: 'Convert between timezones', tag: '', href: '/date-time/timezone-calculator/' },
      { icon: '📈', name: 'Simple Interest Calculator', desc: 'Calculate simple interest', tag: '', href: '/finance/simple-interest-calculator/' },
    ],
  },
  {
    title: 'Fresh from the toolbox', href: '/finance/',
    items: [
      { icon: '≠', name: 'Diff Checker', desc: 'Compare two blocks of text', tag: 'NEW', href: '/text-tools/diff-checker/' },
      { icon: '/', name: 'Slug Generator', desc: 'Turn text into URL slugs', tag: 'NEW', href: '/text-tools/slug-generator/' },
      { icon: '🎯', name: 'Customer Acquisition Cost Calculator', desc: 'Calculate CAC from marketing spend', tag: 'NEW', href: '/finance/customer-acquisition-cost-calculator/' },
      { icon: '⬆', name: 'Raise Calculator', desc: 'Calculate new salary after a raise', tag: 'NEW', href: '/finance/raise-calculator/' },
      { icon: '📣', name: 'ROAS Calculator', desc: 'Calculate return on ad spend', tag: 'NEW', href: '/finance/roas-calculator/' },
    ],
  },
  {
    title: 'Having a moment', href: '/finance/',
    items: [
      { icon: '1', name: 'SIP Calculator', desc: 'Project mutual fund SIP returns', tag: '↑ 9%', href: '/finance/sip-calculator/' },
      { icon: '2', name: 'ROI Calculator', desc: 'Return on investment', tag: '↑ 7%', href: '/finance/roi-calculator/' },
      { icon: '3', name: 'Mortgage Calculator', desc: 'Estimate monthly mortgage payment', tag: '↑ 6%', href: '/finance/mortgage-calculator/' },
      { icon: '4', name: 'Compound Interest Calculator', desc: 'Calculate compound interest growth', tag: '↑ 5%', href: '/finance/compound-interest-calculator/' },
      { icon: '5', name: 'CAGR Calculator', desc: 'Compound annual growth rate', tag: '↑ 4%', href: '/finance/cagr-calculator/' },
    ],
  },
  {
    title: 'For people who live in VS Code', href: '/developer-tools/',
    items: [
      { icon: '⚙', name: 'Regex Tester', desc: 'Test regex patterns live', tag: '', href: '/developer-tools/regex-tester/' },
      { icon: '{}', name: 'Number Base Converter', desc: 'Convert between number bases', tag: '', href: '/developer-tools/number-base-converter/' },
      { icon: '🔗', name: 'URL Encoder/Decoder', desc: 'Encode or decode URLs', tag: '', href: '/converters/url-encoder-decoder/' },
      { icon: '🎨', name: 'Color Converter', desc: 'Convert HEX, RGB, HSL', tag: '', href: '/converters/color-converter/' },
      { icon: '⏱', name: 'Timestamp Converter', desc: 'Convert Unix timestamps', tag: '', href: '/converters/timestamp-converter/' },
    ],
  },
];

const blocksEs = [
  {
    title: "Lo más clickeado", href: '/tools/',
    items: [
      { icon: '%', name: 'Calculadora de Descuento', desc: 'Calcula el precio con descuento', tag: '', href: '/finance/discount-calculator/' },
      { icon: '⚖', name: 'Conversor de Peso', desc: 'Convierte entre unidades de peso', tag: '', href: '/converters/weight-calculator/' },
      { icon: '💧', name: 'Calculadora de Ingesta de Agua', desc: 'Meta diaria de agua', tag: '', href: '/health/water-intake-calculator/' },
      { icon: '🕐', name: 'Calculadora de Zona Horaria', desc: 'Convierte entre zonas horarias', tag: '', href: '/date-time/timezone-calculator/' },
      { icon: '📈', name: 'Calculadora de Interés Simple', desc: 'Calcula el interés simple', tag: '', href: '/finance/simple-interest-calculator/' },
    ],
  },
  {
    title: 'Recién agregado', href: '/finance/',
    items: [
      { icon: '≠', name: 'Comparador de Textos', desc: 'Compara dos bloques de texto', tag: 'NUEVO', href: '/text-tools/diff-checker/' },
      { icon: '/', name: 'Generador de Slugs', desc: 'Convierte texto en slugs para URLs', tag: 'NUEVO', href: '/text-tools/slug-generator/' },
      { icon: '🎯', name: 'Calculadora de CAC', desc: 'Calcula el CAC a partir del gasto en marketing', tag: 'NUEVO', href: '/finance/customer-acquisition-cost-calculator/' },
      { icon: '⬆', name: 'Calculadora de Aumento de Salario', desc: 'Calcula tu nuevo salario tras un aumento', tag: 'NUEVO', href: '/finance/raise-calculator/' },
      { icon: '📣', name: 'Calculadora de ROAS', desc: 'Calcula el retorno del gasto publicitario', tag: 'NUEVO', href: '/finance/roas-calculator/' },
    ],
  },
  {
    title: 'Con mucho movimiento', href: '/finance/',
    items: [
      { icon: '1', name: 'Calculadora de SIP', desc: 'Proyecta el retorno de tu SIP', tag: '↑ 9%', href: '/finance/sip-calculator/' },
      { icon: '2', name: 'Calculadora de ROI', desc: 'Retorno sobre la inversión', tag: '↑ 7%', href: '/finance/roi-calculator/' },
      { icon: '3', name: 'Calculadora de Hipoteca', desc: 'Estima tu pago mensual de hipoteca', tag: '↑ 6%', href: '/finance/mortgage-calculator/' },
      { icon: '4', name: 'Calculadora de Interés Compuesto', desc: 'Calcula el crecimiento con interés compuesto', tag: '↑ 5%', href: '/finance/compound-interest-calculator/' },
      { icon: '5', name: 'Calculadora de CAGR', desc: 'Tasa de crecimiento anual compuesta', tag: '↑ 4%', href: '/finance/cagr-calculator/' },
    ],
  },
  {
    title: 'Para quienes viven en VS Code', href: '/developer-tools/',
    items: [
      { icon: '⚙', name: 'Probador de Regex', desc: 'Prueba patrones regex en vivo', tag: '', href: '/developer-tools/regex-tester/' },
      { icon: '{}', name: 'Conversor de Base Numérica', desc: 'Convierte entre bases numéricas', tag: '', href: '/developer-tools/number-base-converter/' },
      { icon: '📄', name: 'Herramienta Base64', desc: 'Codifica y decodifica en Base64', tag: '', href: '/converters/base64-tool/' },
      { icon: '🎨', name: 'Conversor de Color', desc: 'Convierte entre HEX, RGB, HSL', tag: '', href: '/converters/color-converter/' },
      { icon: '⏱', name: 'Conversor de Marca de Tiempo', desc: 'Convierte timestamps Unix', tag: '', href: '/converters/timestamp-converter/' },
    ],
  },
];

const blocks = (lang === "es" ? blocksEs : blocksEn).map((block) => ({
  ...block,
  href: `${prefix}${block.href}`,
  items: block.items.map((item) => ({ ...item, href: `${prefix}${item.href}` })),
}));
---
<section class="ts-feat">
  <div class="ts-feat-inner">
    {blocks.map((block) => (
      <div class="ts-feat-col">
        <div class="ts-feat-head">
          <h3 class="ts-feat-title">{block.title}</h3>
          <a href={block.href} class="ts-feat-viewall">{viewAllLabel}</a>
        </div>
        <ul class="ts-feat-list">
          {block.items.map((item) => (
            <li class="ts-feat-item">
              <a href={item.href} class="ts-feat-link">
                <span class="ts-feat-icon">{item.icon}</span>
                <div class="ts-feat-text">
                  <span class="ts-feat-name">{item.name}</span>
                  <span class="ts-feat-desc">{item.desc}</span>
                </div>
                {item.tag && <span class="ts-feat-tag">{item.tag}</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .ts-feat { padding: 0 var(--space-6) var(--space-12); }
  .ts-feat-inner {
    max-width: 1280px; margin: 0 auto;
    display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-4);
  }
  .ts-feat-col {
    background: var(--bg-card); border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl); padding: var(--space-4);
    box-shadow: var(--shadow-sm);
  }
  .ts-feat-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-3); }
  .ts-feat-title { font-family: var(--font-sans); font-size: var(--fs-body); font-weight: 700; color: var(--text-primary); margin: 0; }
  .ts-feat-viewall { font-family: var(--font-sans); font-size: 0.75rem; font-weight: 600; color: var(--color-primary); text-decoration: none; }
  .ts-feat-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .ts-feat-item { padding: 0; }
  .ts-feat-link { display: flex; align-items: center; gap: var(--space-2); padding: var(--space-2) 0; text-decoration: none; }
  .ts-feat-link:hover .ts-feat-name { color: var(--color-primary); }
  .ts-feat-icon {
    width: 28px; height: 28px; flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center;
    background: var(--color-primary-light); border-radius: var(--radius-sm); font-size: 0.75rem; font-weight: 700; color: var(--color-primary-dark);
  }
  .ts-feat-text { display: flex; flex-direction: column; min-width: 0; flex: 1; }
  .ts-feat-name { font-family: var(--font-sans); font-size: var(--fs-small); font-weight: 600; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ts-feat-desc { font-family: var(--font-sans); font-size: 0.75rem; color: var(--text-muted); }
  .ts-feat-tag { font-family: var(--font-sans); font-size: 0.7rem; font-weight: 700; color: var(--accent-green-icon); flex-shrink: 0; }

  @media (max-width: 1100px) { .ts-feat-inner { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .ts-feat-inner { grid-template-columns: 1fr; } }
</style>
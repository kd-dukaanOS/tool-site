---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Clock, TrendingDown, PiggyBank, Home } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { currentLoan:"Current Loan", balance:"Current Loan Balance", rate:"Interest Rate (%)", months:"Months Remaining", overpaymentGroup:"Overpayment", extra:"Extra Monthly Payment", emptyTitle:"Mortgage Overpayment Calculator", emptyDesc:"See how extra monthly payments cut years off your mortgage and save on interest.", tip1:"New Payoff Time", tip2:"Time Saved", tip3:"Interest Saved", payoffTime:"New Payoff Time", timeSaved:"Time Saved", interestSaved:"Interest Saved", newPayment:"New Monthly Payment", aboutTitle:"About this Calculator", aboutText:"Shows how adding a fixed extra amount to your monthly mortgage payment shortens your payoff time and reduces total interest paid, by simulating the amortization schedule month by month." },
  es: { currentLoan:"Préstamo Actual", balance:"Saldo Actual del Préstamo", rate:"Tasa de Interés (%)", months:"Meses Restantes", overpaymentGroup:"Pago Adicional", extra:"Pago Mensual Adicional", emptyTitle:"Calculadora de Pago Anticipado de Hipoteca", emptyDesc:"Descubre cómo pagos mensuales adicionales reducen años de tu hipoteca y ahorran interés.", tip1:"Nuevo Tiempo de Pago", tip2:"Tiempo Ahorrado", tip3:"Interés Ahorrado", payoffTime:"Nuevo Tiempo de Pago", timeSaved:"Tiempo Ahorrado", interestSaved:"Interés Ahorrado", newPayment:"Nuevo Pago Mensual", aboutTitle:"Acerca de esta Calculadora", aboutText:"Muestra cómo agregar un monto fijo adicional a tu pago hipotecario mensual reduce tu tiempo de pago y disminuye el interés total pagado, simulando el cronograma de amortización mes a mes." },
}[lang];
---
<section class="mo-calculator">
  <div class="mo-layout">
    <aside class="mo-sidebar">
      <div class="mo-group">
        <h3>{copy.currentLoan}</h3>
        <CalculatorField id="currentBalance" label={copy.balance} type="number" placeholder="e.g. 250000" min="0" step="1" />
        <CalculatorField id="interestRate" label={copy.rate} type="number" placeholder="e.g. 6" min="0" step="0.01" />
        <CalculatorField id="remainingTermMonths" label={copy.months} type="number" placeholder="e.g. 300" min="1" step="1" />
      </div>
      <div class="mo-group">
        <h3>{copy.overpaymentGroup}</h3>
        <CalculatorField id="extraMonthlyPayment" label={copy.extra} type="number" placeholder="e.g. 200" min="0" step="1" />
      </div>
      <CalculatorActions lang={lang} calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="mo-content">
      <div id="emptyState">
        <EmptyState icon="🏡" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="payoffTimeResult" title={copy.payoffTime} icon={Clock} accent="success" subtitle=" " />
          <ResultCard id="timeSavedResult" title={copy.timeSaved} icon={TrendingDown} />
          <ResultCard id="interestSavedResult" title={copy.interestSaved} icon={PiggyBank} />
          <ResultCard id="newPaymentResult" title={copy.newPayment} icon={Home} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/mortgage-overpayment-calculator";
</script>
<style>
.mo-calculator{width:100%;}
.mo-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.mo-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;}
.mo-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.mo-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.mo-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.mo-layout{grid-template-columns:1fr;}.mo-sidebar{position:static;}}
@media(max-width:768px){.mo-layout{gap:24px;}.mo-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";

import { Clock, ArrowLeftRight } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { dateTimeLabel:"Date & Time", dateTimeHelp:"Select the date and time in the source timezone.", fromLabel:"From Timezone", toLabel:"To Timezone", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"Timezone Calculator", emptyDesc:"Convert a date and time between any two timezones instantly.", tip1:"Converted Date & Time", tip2:"Hour Difference", tip3:"Any IANA Timezone", tip4:"DST-Aware Conversion", convertedTitle:"Converted Time", diffTitle:"Time Difference", aboutTitle:"About this Calculator", aboutText:"Convert any date and time from one timezone to another. The conversion accounts for daylight saving time automatically, so the hour difference shown reflects the actual offset on that specific date.", vsSource:"vs source timezone" },
  es: { dateTimeLabel:"Fecha y Hora", dateTimeHelp:"Selecciona la fecha y hora en la zona horaria de origen.", fromLabel:"Zona Horaria de Origen", toLabel:"Zona Horaria de Destino", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora de Zona Horaria", emptyDesc:"Convierte una fecha y hora entre dos zonas horarias al instante.", tip1:"Fecha y Hora Convertida", tip2:"Diferencia de Horas", tip3:"Cualquier Zona Horaria IANA", tip4:"Conversión con Horario de Verano", convertedTitle:"Hora Convertida", diffTitle:"Diferencia de Hora", aboutTitle:"Acerca de esta Calculadora", aboutText:"Convierte cualquier fecha y hora de una zona horaria a otra. La conversión considera automáticamente el horario de verano, por lo que la diferencia de horas mostrada refleja el desfase real en esa fecha específica.", vsSource:"vs zona horaria de origen" },
}[lang];

const timezones = [
  "Asia/Kolkata",
  "America/New_York",
  "America/Los_Angeles",
  "Europe/London",
  "Europe/Berlin",
  "Asia/Dubai",
  "Asia/Singapore",
  "Asia/Tokyo",
  "Australia/Sydney",
  "UTC",
];
---

<section class="timezone-calculator">

  <div class="timezone-layout">

    <!-- Sidebar -->

    <aside class="timezone-sidebar">

      <CalculatorField
        id="dateTime"
        label={copy.dateTimeLabel}
        type="datetime-local"
        required={true}
        helpText={copy.dateTimeHelp}
      />

      <CalculatorField
        id="fromTimezone"
        label={copy.fromLabel}
        type="select"
        required={true}
      >
        {timezones.map((tz) => <option value={tz}>{tz}</option>)}
      </CalculatorField>

      <CalculatorField
        id="toTimezone"
        label={copy.toLabel}
        type="select"
        required={true}
      >
        {timezones.map((tz) => (
          <option value={tz} selected={tz === "America/New_York"}>{tz}</option>
        ))}
      </CalculatorField>

      <CalculatorActions lang={lang}
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
        calculateText={copy.calculate}
        resetText={copy.reset}
        copyText={copy.copy}
      />

      <div
        id="errorBox"
        class="error-box"
        role="alert"
        hidden
      ></div>

    </aside>

    <!-- Results -->

    <main class="timezone-content">

      <div id="emptyState">

        <EmptyState
          icon="🌐"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={[
            copy.tip1,
            copy.tip2,
            copy.tip3,
            copy.tip4
          ]}
        />

      </div>

      <div
        id="resultsContainer"
        hidden
      >

        <ResultsGrid columns={2}>

          <ResultCard
            id="convertedResult"
            title={copy.convertedTitle}
            icon={Clock}
            accent="primary"
            size="lg"
          />

          <ResultCard
            id="differenceResult"
            title={copy.diffTitle}
            icon={ArrowLeftRight}
            accent="neutral"
          />

        </ResultsGrid>

        <section class="calculator-info">

          <h2>{copy.aboutTitle}</h2>

          <p>{copy.aboutText}</p>

        </section>

      </div>

    </main>

  </div>

</section>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/timezone-calculator";
</script>

<style>

.timezone-calculator{

width:100%;

}

.timezone-layout{

display:grid;

grid-template-columns:340px minmax(0,1fr);

gap:32px;

align-items:start;

}

.timezone-sidebar{

position:sticky;

top:24px;

display:flex;

flex-direction:column;

gap:20px;

}

.timezone-content{

display:flex;

flex-direction:column;

gap:28px;

min-width:0;

}

.calculator-info{

padding:24px;

border:1px solid var(--border-subtle);

border-radius:18px;

background:var(--bg-card);

margin-top:28px;

}

.calculator-info h2{

margin:0 0 12px;

font-size:1.15rem;

font-weight:700;

color:var(--text-primary);

}

.calculator-info p{

margin:0;

line-height:1.8;

font-size:.95rem;

color:var(--text-secondary);

}

.error-box{

display:flex;

align-items:center;

padding:14px 16px;

border-radius:14px;

background:#FEF2F2;

border:1px solid #FCA5A5;

color:#B91C1C;

font-size:.92rem;

font-weight:600;

}



:global(.dark) .error-box{

background:#2A1111;

border-color:#7F1D1D;

color:#FECACA;

}

@media(max-width:1024px){

.timezone-layout{

grid-template-columns:1fr;

}

.timezone-sidebar{

position:static;

}

}

@media(max-width:768px){

.timezone-layout{

gap:24px;

}

.timezone-content{

gap:20px;

}

}

@media(max-width:640px){

.calculator-info{

padding:18px;

}

}

</style>

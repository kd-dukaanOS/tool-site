---
import CalculatorField from "../calculator/CalculatorField.astro";
import ActionButtons from "../calculator/ActionButtons.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import EmptyState from "../calculator/EmptyState.astro";
import { Flame, Activity, Target } from "@lucide/astro";

interface Props {
  lang?: "en" | "es";
}
const { lang = "en" } = Astro.props as Props;

const copy = {
  en: {
    gender: "Gender", male: "Male", female: "Female",
    age: "Age", height: "Height (cm)", weight: "Weight (kg)",
    activity: "Activity Level",
    sedentary: "Sedentary (little/no exercise)", light: "Light (1-3 days/week)",
    moderate: "Moderate (3-5 days/week)", active: "Active (6-7 days/week)", veryActive: "Very Active (physical job)",
    goal: "Goal", lose: "Lose Weight", maintain: "Maintain Weight", gain: "Gain Weight",
    emptyTitle: "Enter details to calculate calories", emptyDesc: "Your BMR and daily calorie targets will appear here.",
    bmr: "BMR", maintenance: "Maintenance Calories", target: "Target Calories",
    calculate: "Calculate", reset: "Reset", copy: "Copy",
  },
  es: {
    gender: "Género", male: "Hombre", female: "Mujer",
    age: "Edad", height: "Estatura (cm)", weight: "Peso (kg)",
    activity: "Nivel de Actividad",
    sedentary: "Sedentario (poco o nada de ejercicio)", light: "Ligero (1-3 días/semana)",
    moderate: "Moderado (3-5 días/semana)", active: "Activo (6-7 días/semana)", veryActive: "Muy Activo (trabajo físico)",
    goal: "Objetivo", lose: "Perder Peso", maintain: "Mantener Peso", gain: "Ganar Peso",
    emptyTitle: "Ingresa tus datos para calcular calorías", emptyDesc: "Tu TMB y objetivos diarios de calorías aparecerán aquí.",
    bmr: "TMB", maintenance: "Calorías de Mantenimiento", target: "Calorías Objetivo",
    calculate: "Calcular", reset: "Restablecer", copy: "Copiar",
  },
}[lang];
---

<div class="calculator-widget">
  <div class="calculator-inputs">
    <CalculatorField id="gender" label={copy.gender} type="select">
      <option value="male">{copy.male}</option>
      <option value="female">{copy.female}</option>
    </CalculatorField>

    <CalculatorField id="age" label={copy.age} type="number" placeholder="e.g. 28" />
    <CalculatorField id="heightCm" label={copy.height} type="number" placeholder="e.g. 170" />
    <CalculatorField id="weightKg" label={copy.weight} type="number" placeholder="e.g. 65" />

    <CalculatorField id="activityLevel" label={copy.activity} type="select">
      <option value="sedentary">{copy.sedentary}</option>
      <option value="light">{copy.light}</option>
      <option value="moderate" selected>{copy.moderate}</option>
      <option value="active">{copy.active}</option>
      <option value="veryActive">{copy.veryActive}</option>
    </CalculatorField>

    <CalculatorField id="goal" label={copy.goal} type="select">
      <option value="lose">{copy.lose}</option>
      <option value="maintain" selected>{copy.maintain}</option>
      <option value="gain">{copy.gain}</option>
    </CalculatorField>

    <div id="errorBox" class="error-box" role="alert" hidden></div>

    <ActionButtons
      calculateId="calculateBtn"
      resetId="resetBtn"
      copyId="copyBtn"
      showDownload={false}
      showShare={false}
      calculateText={copy.calculate}
      resetText={copy.reset}
      copyText={copy.copy}
    />
  </div>

  <div class="calculator-output">
    <EmptyState
      id="emptyState"
      title={copy.emptyTitle}
      description={copy.emptyDesc}
    />

    <ResultsGrid id="resultsContainer" hidden>
      <ResultCard id="bmrResult" title={copy.bmr} icon={Flame} accent="neutral" />
      <ResultCard id="maintenanceResult" title={copy.maintenance} icon={Activity} accent="primary" size="lg" />
      <ResultCard id="targetResult" title={copy.target} icon={Target} accent="success" />
    </ResultsGrid>
  </div>
</div>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script src="../../scripts/calorie-calculator.ts"></script>

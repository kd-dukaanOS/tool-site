---
import CalculatorField from "../calculator/CalculatorField.astro";
import ActionButtons from "../calculator/ActionButtons.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import EmptyState from "../calculator/EmptyState.astro";
import { Flame, Activity, Target } from "@lucide/astro";
---

<div class="calculator-widget">
  <div class="calculator-inputs">
    <CalculatorField id="gender" label="Gender" type="select">
      <option value="male">Male</option>
      <option value="female">Female</option>
    </CalculatorField>

    <CalculatorField id="age" label="Age" type="number" placeholder="e.g. 28" />
    <CalculatorField id="heightCm" label="Height (cm)" type="number" placeholder="e.g. 170" />
    <CalculatorField id="weightKg" label="Weight (kg)" type="number" placeholder="e.g. 65" />

    <CalculatorField id="activityLevel" label="Activity Level" type="select">
      <option value="sedentary">Sedentary (little/no exercise)</option>
      <option value="light">Light (1-3 days/week)</option>
      <option value="moderate" selected>Moderate (3-5 days/week)</option>
      <option value="active">Active (6-7 days/week)</option>
      <option value="veryActive">Very Active (physical job)</option>
    </CalculatorField>

    <CalculatorField id="goal" label="Goal" type="select">
      <option value="lose">Lose Weight</option>
      <option value="maintain" selected>Maintain Weight</option>
      <option value="gain">Gain Weight</option>
    </CalculatorField>

    <div id="errorBox" class="error-box" role="alert" hidden></div>

    <ActionButtons
      calculateId="calculateBtn"
      resetId="resetBtn"
      copyId="copyBtn"
      showDownload={false}
      showShare={false}
    />
  </div>

  <div class="calculator-output">
    <EmptyState
      id="emptyState"
      title="Enter details to calculate calories"
      description="Your BMR and daily calorie targets will appear here."
    />

    <ResultsGrid id="resultsContainer" hidden>
      <ResultCard id="bmrResult" title="BMR" icon={Flame} accent="neutral" />
      <ResultCard id="maintenanceResult" title="Maintenance Calories" icon={Activity} accent="primary" size="lg" />
      <ResultCard id="targetResult" title="Target Calories" icon={Target} accent="success" />
    </ResultsGrid>
  </div>
</div>

<script src="../../scripts/calorie-calculator.ts"></script>

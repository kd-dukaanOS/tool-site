---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import ScheduleTable from "../calculator/ScheduleTable.astro";

import {
  Wallet,
  TrendingUp,
  Coins
} from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { investment:"Annual Investment (₹)", investmentHelp:"Max ₹1,50,000 per year as per PPF rules.", rate:"Interest Rate (% p.a.)", rateHelp:"Current PPF rate, revised quarterly by the govt.", tenure:"Tenure (Years)", tenureHelp:"Minimum lock-in is 15 years.", emptyTitle:"PPF Calculator", emptyDesc:"Calculate your Public Provident Fund maturity value.", tip1:"Maturity Value", tip2:"Total Invested", tip3:"Total Interest Earned", tip4:"Year-wise Growth", maturity:"Maturity Value", interest:"Total Interest Earned", invested:"Total Invested", scheduleCaption:"Year-wise Growth Schedule", headers:["Year","Opening Balance","Investment","Interest Earned","Closing Balance"], aboutTitle:"About this Calculator", aboutText:"PPF compounds annually, with each year's deposit assumed to be made at the start of the year. Interest is calculated on the running balance, and the account has a mandatory 15-year lock-in (extendable in blocks of 5 years).", yearLabel:"Year" },
  es: { investment:"Inversión Anual (₹)", investmentHelp:"Máximo ₹1,50,000 por año según las reglas del PPF.", rate:"Tasa de Interés (% anual)", rateHelp:"Tasa actual del PPF, revisada trimestralmente por el gobierno.", tenure:"Plazo (Años)", tenureHelp:"El bloqueo mínimo es de 15 años.", emptyTitle:"Calculadora de PPF", emptyDesc:"Calcula el valor de vencimiento de tu Fondo Público de Previsión.", tip1:"Valor de Vencimiento", tip2:"Total Invertido", tip3:"Interés Total Ganado", tip4:"Crecimiento Anual", maturity:"Valor de Vencimiento", interest:"Interés Total Ganado", invested:"Total Invertido", scheduleCaption:"Cronograma de Crecimiento Anual", headers:["Año","Saldo Inicial","Inversión","Interés Ganado","Saldo Final"], aboutTitle:"Acerca de esta Calculadora", aboutText:"El PPF capitaliza anualmente, asumiendo que el depósito de cada año se realiza al inicio del año. El interés se calcula sobre el saldo acumulado, y la cuenta tiene un bloqueo obligatorio de 15 años (ampliable en bloques de 5 años).", yearLabel:"Año" },
}[lang];
---

<section class="ppf-calculator">

  <div class="ppf-layout">

    <aside class="ppf-sidebar">

      <CalculatorField
        id="annualInvestment"
        label={copy.investment}
        type="number"
        placeholder="e.g. 150000"
        required={true}
        min="0"
        max="150000"
        step="1"
        helpText={copy.investmentHelp}
      />

      <CalculatorField
        id="annualRate"
        label={copy.rate}
        type="number"
        placeholder="e.g. 7.1"
        required={true}
        min="0"
        step="0.01"
        helpText={copy.rateHelp}
      />

      <CalculatorField
        id="tenureYears"
        label={copy.tenure}
        type="number"
        value="15"
        required={true}
        min="15"
        step="1"
        helpText={copy.tenureHelp}
      />

      <CalculatorActions lang={lang}
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
      />

      <div
        id="errorBox"
        class="error-box"
        hidden
      ></div>

    </aside>

    <main class="ppf-content">

      <div id="emptyState">

        <EmptyState
          icon="🛡️"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={[
            copy.tip1,
            copy.tip2,
            copy.tip3,
            copy.tip4
          ]}
        />

      </div>

      <div
        id="resultsContainer"
        hidden
      >

        <ResultsGrid columns={3}>

          <ResultCard
            id="maturityResult"
            title={copy.maturity}
            icon={Wallet}
            accent="success"
          />

          <ResultCard
            id="interestResult"
            title={copy.interest}
            icon={TrendingUp}
          />

          <ResultCard
            id="investedResult"
            title={copy.invested}
            icon={Coins}
          />

        </ResultsGrid>

        <ScheduleTable
          id="scheduleBody"
          headers={copy.headers}
          caption={copy.scheduleCaption}
        />

        <section class="calculator-info">

          <h2>{copy.aboutTitle}</h2>

          <p>{copy.aboutText}</p>

        </section>

      </div>

    </main>

  </div>

</section>

<script define:vars={{ calcLang: lang, yearLabel: copy.yearLabel }}>
  window.calcLang = calcLang;
  window.ppfYearLabel = yearLabel;
</script>
<script>
  import "../../scripts/ppf-calculator";
</script>

<style>

.ppf-calculator{

width:100%;

}

.ppf-layout{

display:grid;

grid-template-columns:340px minmax(0,1fr);

gap:32px;

align-items:start;

}

.ppf-sidebar{

position:sticky;

top:24px;

display:flex;

flex-direction:column;

gap:20px;

}

.ppf-content{

display:flex;

flex-direction:column;

gap:28px;

min-width:0;

}

.error-box{

display:flex;

align-items:center;

padding:14px 16px;

border-radius:14px;

background:#FEF2F2;

border:1px solid #FCA5A5;

color:#B91C1C;

font-size:.92rem;

font-weight:600;

}

.calculator-info{

padding:24px;

border:1px solid var(--border-subtle);

border-radius:18px;

background:var(--bg-card);

}

.calculator-info h2{

margin:0 0 12px;

font-size:1.15rem;

font-weight:700;

color:var(--text-primary);

}

.calculator-info p{

margin:0;

line-height:1.8;

font-size:.95rem;

color:var(--text-secondary);

}

:global(.dark) .error-box{

background:#2A1111;

border-color:#7F1D1D;

color:#FECACA;

}

@media(max-width:1024px){

.ppf-layout{

grid-template-columns:1fr;

}

.ppf-sidebar{

position:static;

}

}

@media(max-width:768px){

.ppf-layout{

gap:24px;

}

.ppf-content{

gap:20px;

}

}

@media(max-width:640px){

.calculator-info{

padding:18px;

}

}

</style>

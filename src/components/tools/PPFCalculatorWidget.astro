---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import ScheduleTable from "../calculator/ScheduleTable.astro";

import {
  Wallet,
  TrendingUp,
  Coins
} from "@lucide/astro";
---

<section class="ppf-calculator">

  <div class="ppf-layout">

    <aside class="ppf-sidebar">

      <CalculatorField
        id="annualInvestment"
        label="Annual Investment (₹)"
        type="number"
        placeholder="e.g. 150000"
        required={true}
        min="0"
        max="150000"
        step="1"
        helpText="Max ₹1,50,000 per year as per PPF rules."
      />

      <CalculatorField
        id="annualRate"
        label="Interest Rate (% p.a.)"
        type="number"
        placeholder="e.g. 7.1"
        required={true}
        min="0"
        step="0.01"
        helpText="Current PPF rate, revised quarterly by the govt."
      />

      <CalculatorField
        id="tenureYears"
        label="Tenure (Years)"
        type="number"
        value="15"
        required={true}
        min="15"
        step="1"
        helpText="Minimum lock-in is 15 years."
      />

      <CalculatorActions
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
      />

      <div
        id="errorBox"
        class="error-box"
        hidden
      ></div>

    </aside>

    <main class="ppf-content">

      <div id="emptyState">

        <EmptyState
          icon="🛡️"
          title="PPF Calculator"
          description="Calculate your Public Provident Fund maturity value."
          tips={[
            "Maturity Value",
            "Total Invested",
            "Total Interest Earned",
            "Year-wise Growth"
          ]}
        />

      </div>

      <div
        id="resultsContainer"
        hidden
      >

        <ResultsGrid columns={3}>

          <ResultCard
            id="maturityResult"
            title="Maturity Value"
            icon={Wallet}
            accent="success"
          />

          <ResultCard
            id="interestResult"
            title="Total Interest Earned"
            icon={TrendingUp}
          />

          <ResultCard
            id="investedResult"
            title="Total Invested"
            icon={Coins}
          />

        </ResultsGrid>

        <ScheduleTable
          id="scheduleBody"
          headers={["Year", "Opening Balance", "Investment", "Interest Earned", "Closing Balance"]}
          caption="Year-wise Growth Schedule"
        />

        <section class="calculator-info">

          <h2>About this Calculator</h2>

          <p>
            PPF compounds annually, with each year's deposit assumed
            to be made at the start of the year. Interest is calculated
            on the running balance, and the account has a mandatory
            15-year lock-in (extendable in blocks of 5 years).
          </p>

        </section>

      </div>

    </main>

  </div>

</section>

<script>
  import "../../scripts/ppf-calculator";
</script>

<style>

.ppf-calculator{

width:100%;

}

.ppf-layout{

display:grid;

grid-template-columns:340px minmax(0,1fr);

gap:32px;

align-items:start;

}

.ppf-sidebar{

position:sticky;

top:24px;

display:flex;

flex-direction:column;

gap:20px;

}

.ppf-content{

display:flex;

flex-direction:column;

gap:28px;

min-width:0;

}

.error-box{

display:flex;

align-items:center;

padding:14px 16px;

border-radius:14px;

background:#FEF2F2;

border:1px solid #FCA5A5;

color:#B91C1C;

font-size:.92rem;

font-weight:600;

}

.calculator-info{

padding:24px;

border:1px solid var(--border-subtle);

border-radius:18px;

background:var(--bg-card);

}

.calculator-info h2{

margin:0 0 12px;

font-size:1.15rem;

font-weight:700;

color:var(--text-primary);

}

.calculator-info p{

margin:0;

line-height:1.8;

font-size:.95rem;

color:var(--text-secondary);

}

:global(.dark) .error-box{

background:#2A1111;

border-color:#7F1D1D;

color:#FECACA;

}

@media(max-width:1024px){

.ppf-layout{

grid-template-columns:1fr;

}

.ppf-sidebar{

position:static;

}

}

@media(max-width:768px){

.ppf-layout{

gap:24px;

}

.ppf-content{

gap:20px;

}

}

@media(max-width:640px){

.calculator-info{

padding:18px;

}

}

</style>

---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Home, Percent, Wallet, Receipt } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { groupTitle:"Property Details", priceLabel:"Purchase Price (£)", buyerTypeLabel:"Buyer Type", standard:"Standard (home mover)", firstTime:"First-time buyer", additional:"Additional property (2nd home/buy-to-let)", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"UK Stamp Duty Calculator", emptyDesc:"Calculate SDLT owed on your property purchase.", tip1:"Stamp Duty Owed", tip2:"Effective Rate", tip3:"Total Cost", dutyTitle:"Stamp Duty Owed", rateTitle:"Effective Rate", totalCostTitle:"Total Cost", priceTitle:"Purchase Price", aboutTitle:"About this Calculator", aboutText:"Applies the current SDLT bands progressively to your purchase price, adjusting for first-time buyer relief or the 5% additional dwellings surcharge based on your buyer type.", surcharge:"Includes 5% surcharge" },
  es: { groupTitle:"Detalles de la Propiedad", priceLabel:"Precio de Compra (£)", buyerTypeLabel:"Tipo de Comprador", standard:"Estándar (cambio de vivienda)", firstTime:"Comprador primerizo", additional:"Propiedad adicional (2da vivienda/alquiler)", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora de Impuesto de Timbre del Reino Unido", emptyDesc:"Calcula el SDLT adeudado en tu compra de propiedad.", tip1:"Impuesto de Timbre Adeudado", tip2:"Tasa Efectiva", tip3:"Costo Total", dutyTitle:"Impuesto de Timbre Adeudado", rateTitle:"Tasa Efectiva", totalCostTitle:"Costo Total", priceTitle:"Precio de Compra", aboutTitle:"Acerca de esta Calculadora", aboutText:"Aplica progresivamente las bandas SDLT actuales a tu precio de compra, ajustando por el alivio de comprador primerizo o el recargo del 5% de viviendas adicionales según tu tipo de comprador.", surcharge:"Incluye recargo del 5%" },
}[lang];
---
<section class="uksd-calculator">
  <div class="uksd-layout">
    <aside class="uksd-sidebar">
      <div class="uksd-group">
        <h3>{copy.groupTitle}</h3>
        <CalculatorField id="purchasePrice" label={copy.priceLabel} type="number" placeholder="e.g. 350000" min="0" step="1" />
        <CalculatorField type="select" id="buyerType" label={copy.buyerTypeLabel}>
          <option value="standard">{copy.standard}</option>
          <option value="first-time">{copy.firstTime}</option>
          <option value="additional">{copy.additional}</option>
        </CalculatorField>
      </div>
      <CalculatorActions lang={lang} calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} calculateText={copy.calculate} resetText={copy.reset} copyText={copy.copy} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="uksd-content">
      <div id="emptyState">
        <EmptyState icon="🏠" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="stampDutyOwedResult" title={copy.dutyTitle} icon={Receipt} accent="success" subtitle=" " />
          <ResultCard id="effectiveRateResult" title={copy.rateTitle} icon={Percent} />
          <ResultCard id="totalCostResult" title={copy.totalCostTitle} icon={Wallet} />
          <ResultCard id="purchasePriceResult" title={copy.priceTitle} icon={Home} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/uk-stamp-duty-calculator";
</script>
<style>
.uksd-calculator{width:100%;}
.uksd-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.uksd-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.uksd-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.uksd-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.uksd-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.uksd-layout{grid-template-columns:1fr;}.uksd-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.uksd-layout{gap:24px;}.uksd-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
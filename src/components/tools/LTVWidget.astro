---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Percent, Layers, Home, ShieldCheck } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { groupTitle:"Property & Loan", homeValue:"Home Value", loanBalance:"Current Loan Balance", secondLien:"Second Lien / HELOC (optional)", emptyTitle:"LTV Calculator", emptyDesc:"Find your loan-to-value ratio, equity, and PMI status.", tip1:"LTV Ratio", tip2:"Home Equity", tip3:"PMI Status", ltvRatio:"LTV Ratio", combinedLtv:"Combined LTV", homeEquity:"Home Equity", pmiStatus:"PMI Status", aboutTitle:"About this Calculator", aboutText:"Calculates your loan-to-value ratio, combined LTV, home equity, and PMI status based on current home value and loan balances." },
  es: { groupTitle:"Propiedad y Préstamo", homeValue:"Valor de la Vivienda", loanBalance:"Saldo Actual del Préstamo", secondLien:"Segunda Hipoteca / HELOC (opcional)", emptyTitle:"Calculadora LTV", emptyDesc:"Calcula tu relación préstamo-valor, capital y estado del PMI.", tip1:"Ratio LTV", tip2:"Capital de Vivienda", tip3:"Estado del PMI", ltvRatio:"Ratio LTV", combinedLtv:"LTV Combinado", homeEquity:"Capital de Vivienda", pmiStatus:"Estado del PMI", aboutTitle:"Acerca de esta Calculadora", aboutText:"Calcula tu relación préstamo-valor, LTV combinado, capital de vivienda y estado del PMI según el valor actual de la vivienda y los saldos del préstamo." },
}[lang];
---
<section class="ltv-calculator">
  <div class="ltv-layout">
    <aside class="ltv-sidebar">
      <div class="ltv-group">
        <h3>{copy.groupTitle}</h3>
        <CalculatorField id="homeValue" label={copy.homeValue} type="number" placeholder="e.g. 400000" min="0" step="1" />
        <CalculatorField id="loanBalance" label={copy.loanBalance} type="number" placeholder="e.g. 280000" min="0" step="1" />
        <CalculatorField id="secondLienBalance" label={copy.secondLien} type="number" placeholder="e.g. 0" min="0" step="1" />
      </div>
      <CalculatorActions lang={lang} calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="ltv-content">
      <div id="emptyState">
        <EmptyState icon="📊" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="ltvResult" title={copy.ltvRatio} icon={Percent} accent="success" />
          <ResultCard id="cltvResult" title={copy.combinedLtv} icon={Layers} />
          <ResultCard id="equityResult" title={copy.homeEquity} icon={Home} subtitle=" " />
          <ResultCard id="pmiStatusResult" title={copy.pmiStatus} icon={ShieldCheck} subtitle=" " />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/ltv-calculator";
</script>
<style>
.ltv-calculator{width:100%;}
.ltv-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.ltv-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.ltv-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.ltv-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.ltv-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.ltv-layout{grid-template-columns:1fr;}.ltv-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.ltv-layout{gap:24px;}.ltv-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
---
import CalculatorField from "../calculator/CalculatorField.astro";
import ActionButtons from "../calculator/ActionButtons.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import EmptyState from "../calculator/EmptyState.astro";
import { PartyPopper, CalendarDays, Cake } from "@lucide/astro";

interface Props {
  lang?: "en" | "es";
}
const { lang = "en" } = Astro.props as Props;

const copy = {
  en: { dob: "Date of Birth", emptyTitle: "Enter your date of birth", emptyDesc: "Your next birthday details will appear here.", nextBirthday: "Next Birthday", daysRemaining: "Days Remaining", turningAge: "Turning Age" },
  es: { dob: "Fecha de Nacimiento", emptyTitle: "Ingresa tu fecha de nacimiento", emptyDesc: "Aquí verás los detalles de tu próximo cumpleaños.", nextBirthday: "Próximo Cumpleaños", daysRemaining: "Días Restantes", turningAge: "Edad que Cumplirás" },
}[lang];
---

<div class="calculator-widget">
  <div class="calculator-inputs">
    <CalculatorField id="birthDate" label={copy.dob} type="date" />

    <div id="errorBox" class="error-box" role="alert" hidden></div>

    <ActionButtons
      calculateId="calculateBtn"
      resetId="resetBtn"
      copyId="copyBtn"
      showDownload={false}
      showShare={false}
    />
  </div>

  <div class="calculator-output">
    <EmptyState
      id="emptyState"
      title={copy.emptyTitle}
      description={copy.emptyDesc}
    />

    <ResultsGrid id="resultsContainer" hidden>
      <ResultCard id="nextBirthdayResult" title={copy.nextBirthday} icon={PartyPopper} accent="primary" size="lg" />
      <ResultCard id="daysRemainingResult" title={copy.daysRemaining} icon={CalendarDays} accent="neutral" />
      <ResultCard id="turningAgeResult" title={copy.turningAge} icon={Cake} accent="neutral" />
    </ResultsGrid>
  </div>
</div>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script src="../../scripts/birthday-calculator.ts"></script>

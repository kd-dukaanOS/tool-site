---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";

import {
  Banknote,
  ArrowLeftRight,
  Repeat
} from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { amount:"Amount", amountHelp:"Amount you want to convert.", from:"From Currency", to:"To Currency", codeHelp:"3-letter code, e.g. USD, INR, EUR.", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"Currency Converter", emptyDesc:"Convert between currencies using live exchange rates.", tip1:"Live Exchange Rate", tip2:"Converted Amount", tip3:"Inverse Rate", converted:"Converted Amount", rate:"Exchange Rate", inverse:"Inverse Rate", aboutTitle:"About this Calculator", aboutText:"Converts an amount from one currency to another using a live exchange rate. Rates update automatically each time you calculate.", convertedSub:" converted" },
  es: { amount:"Monto", amountHelp:"Monto que deseas convertir.", from:"De Moneda", to:"A Moneda", codeHelp:"Código de 3 letras, ej. USD, INR, EUR.", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Convertidor de Moneda", emptyDesc:"Convierte entre monedas usando tipos de cambio en vivo.", tip1:"Tipo de Cambio en Vivo", tip2:"Monto Convertido", tip3:"Tasa Inversa", converted:"Monto Convertido", rate:"Tipo de Cambio", inverse:"Tasa Inversa", aboutTitle:"Acerca de esta Calculadora", aboutText:"Convierte un monto de una moneda a otra usando un tipo de cambio en vivo. Las tasas se actualizan automáticamente cada vez que calculas.", convertedSub:" convertido" },
}[lang];
---

<section class="cur-calculator">

  <div class="cur-layout">

    <aside class="cur-sidebar">

      <CalculatorField
        id="amount"
        label={copy.amount}
        type="number"
        placeholder="e.g. 100"
        required={true}
        min="0"
        step="0.01"
        helpText={copy.amountHelp}
      />

      <CalculatorField
        id="fromCurrency"
        label={copy.from}
        type="text"
        value="USD"
        required={true}
        helpText={copy.codeHelp}
      />

      <CalculatorField
        id="toCurrency"
        label={copy.to}
        type="text"
        value="INR"
        required={true}
        helpText={copy.codeHelp}
      />

      <CalculatorActions
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
        calculateText={copy.calculate}
        resetText={copy.reset}
        copyText={copy.copy}
      />

      <div
        id="errorBox"
        class="error-box"
        hidden
      ></div>

    </aside>

    <main class="cur-content">

      <div id="emptyState">

        <EmptyState
          icon="💱"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={[copy.tip1, copy.tip2, copy.tip3]}
        />

      </div>

      <div
        id="resultsContainer"
        hidden
      >

        <ResultsGrid columns={3}>

          <ResultCard
            id="convertedResult"
            title={copy.converted}
            icon={Banknote}
            accent="success"
            subtitle=" "
          />

          <ResultCard
            id="rateResult"
            title={copy.rate}
            icon={ArrowLeftRight}
          />

          <ResultCard
            id="inverseRateResult"
            title={copy.inverse}
            icon={Repeat}
          />

        </ResultsGrid>

        <section class="calculator-info">

          <h2>{copy.aboutTitle}</h2>

          <p>
            {copy.aboutText}
          </p>

        </section>

      </div>

    </main>

  </div>

</section>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/currency-converter";
</script>

<style>

.cur-calculator{

width:100%;

}

.cur-layout{

display:grid;

grid-template-columns:340px minmax(0,1fr);

gap:32px;

align-items:start;

}

.cur-sidebar{

position:sticky;

top:24px;

display:flex;

flex-direction:column;

gap:20px;

}

.cur-content{

display:flex;

flex-direction:column;

gap:28px;

min-width:0;

}

.calculator-info{

padding:24px;

border:1px solid var(--border-subtle);

border-radius:18px;

background:var(--bg-card);

}

.calculator-info h2{

margin:0 0 12px;

font-size:1.15rem;

font-weight:700;

color:var(--text-primary);

}

.calculator-info p{

margin:0;

line-height:1.8;

font-size:.95rem;

color:var(--text-secondary);

}

.error-box{

display:flex;

align-items:center;

padding:14px 16px;

border-radius:14px;

background:#FEF2F2;

border:1px solid #FCA5A5;

color:#B91C1C;

font-size:.92rem;

font-weight:600;

}

:global(.dark) .error-box{

background:#2A1111;

border-color:#7F1D1D;

color:#FECACA;

}

@media(max-width:1024px){

.cur-layout{

grid-template-columns:1fr;

}

.cur-sidebar{

position:static;

}

}

@media(max-width:768px){

.cur-layout{

gap:24px;

}

.cur-content{

gap:20px;

}

}

@media(max-width:640px){

.calculator-info{

padding:18px;

}

}

</style>

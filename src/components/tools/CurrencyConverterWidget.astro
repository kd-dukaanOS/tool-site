---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";

import {
  Banknote,
  ArrowLeftRight,
  Repeat
} from "@lucide/astro";
---

<section class="cur-calculator">

  <div class="cur-layout">

    <aside class="cur-sidebar">

      <CalculatorField
        id="amount"
        label="Amount"
        type="number"
        placeholder="e.g. 100"
        required={true}
        min="0"
        step="0.01"
        helpText="Amount you want to convert."
      />

      <CalculatorField
        id="fromCurrency"
        label="From Currency"
        type="text"
        value="USD"
        required={true}
        helpText="3-letter code, e.g. USD, INR, EUR."
      />

      <CalculatorField
        id="toCurrency"
        label="To Currency"
        type="text"
        value="INR"
        required={true}
        helpText="3-letter code, e.g. USD, INR, EUR."
      />

      <CalculatorActions
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
      />

      <div
        id="errorBox"
        class="error-box"
        hidden
      ></div>

    </aside>

    <main class="cur-content">

      <div id="emptyState">

        <EmptyState
          icon="💱"
          title="Currency Converter"
          description="Convert between currencies using live exchange rates."
          tips={[
            "Live Exchange Rate",
            "Converted Amount",
            "Inverse Rate"
          ]}
        />

      </div>

      <div
        id="resultsContainer"
        hidden
      >

        <ResultsGrid columns={3}>

          <ResultCard
            id="convertedResult"
            title="Converted Amount"
            icon={Banknote}
            accent="success"
            subtitle=" "
          />

          <ResultCard
            id="rateResult"
            title="Exchange Rate"
            icon={ArrowLeftRight}
          />

          <ResultCard
            id="inverseRateResult"
            title="Inverse Rate"
            icon={Repeat}
          />

        </ResultsGrid>

        <section class="calculator-info">

          <h2>About this Calculator</h2>

          <p>
            Converts an amount from one currency to another using a
            live exchange rate. Rates update automatically each time
            you calculate.
          </p>

        </section>

      </div>

    </main>

  </div>

</section>

<script>
  import "../../scripts/currency-converter";
</script>

<style>

.cur-calculator{

width:100%;

}

.cur-layout{

display:grid;

grid-template-columns:340px minmax(0,1fr);

gap:32px;

align-items:start;

}

.cur-sidebar{

position:sticky;

top:24px;

display:flex;

flex-direction:column;

gap:20px;

}

.cur-content{

display:flex;

flex-direction:column;

gap:28px;

min-width:0;

}

.calculator-info{

padding:24px;

border:1px solid #E5E7EB;

border-radius:18px;

background:#FFFFFF;

}

.calculator-info h2{

margin:0 0 12px;

font-size:1.15rem;

font-weight:700;

color:#111827;

}

.calculator-info p{

margin:0;

line-height:1.8;

font-size:.95rem;

color:#6B7280;

}

.error-box{

display:flex;

align-items:center;

padding:14px 16px;

border-radius:14px;

background:#FEF2F2;

border:1px solid #FCA5A5;

color:#B91C1C;

font-size:.92rem;

font-weight:600;

}

:global(.dark) .calculator-info{

background:#111217;

border-color:#27272A;

}

:global(.dark) .calculator-info h2{

color:#FAFAFA;

}

:global(.dark) .calculator-info p{

color:#A1A1AA;

}

:global(.dark) .error-box{

background:#2A1111;

border-color:#7F1D1D;

color:#FECACA;

}

@media(max-width:1024px){

.cur-layout{

grid-template-columns:1fr;

}

.cur-sidebar{

position:static;

}

}

@media(max-width:768px){

.cur-layout{

gap:24px;

}

.cur-content{

gap:20px;

}

}

@media(max-width:640px){

.calculator-info{

padding:18px;

}

}

</style>

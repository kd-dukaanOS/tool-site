---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import CurrencySelector from "../calculator/CurrencySelector.astro";
import {
  Gem,
  TrendingUp,
  Repeat,
  Wallet
} from "@lucide/astro";

interface Props {
  lang?: "en" | "es";
}
const { lang = "en" } = Astro.props as Props;

const copy = {
  en: {
    avgOrderValue: "Average Order Value", avgOrderHelp: "Average amount spent per purchase.",
    purchaseFrequency: "Purchase Frequency (per year)", purchaseFreqHelp: "Average number of purchases per year.",
    lifespanYears: "Customer Lifespan (years)", lifespanHelp: "Average number of years a customer stays active.",
    grossMargin: "Gross Margin (%)", grossMarginHelp: "Optional — leave blank to use 100% (revenue-based CLV).",
    calculate: "Calculate", reset: "Reset", copy: "Copy",
    emptyTitle: "Customer Lifetime Value Calculator", emptyDesc: "Estimate how much revenue and profit a typical customer generates.",
    tip1: "Gross CLV", tip2: "Net (Profit) CLV", tip3: "Annual Customer Value",
    clvGross: "Gross CLV", clvNet: "Net CLV", annualValue: "Annual Customer Value",
    aboutTitle: "About this Calculator",
    aboutText: "Estimate Customer Lifetime Value (CLV) from average order value, purchase frequency and customer lifespan. Apply a gross margin percentage to see net, profit-based CLV, and compare it against your Customer Acquisition Cost.",
  },
  es: {
    avgOrderValue: "Valor Promedio del Pedido", avgOrderHelp: "Monto promedio gastado por compra.",
    purchaseFrequency: "Frecuencia de Compra (por año)", purchaseFreqHelp: "Número promedio de compras por año.",
    lifespanYears: "Vida del Cliente (años)", lifespanHelp: "Número promedio de años que un cliente permanece activo.",
    grossMargin: "Margen Bruto (%)", grossMarginHelp: "Opcional — deja en blanco para usar 100% (CLV basado en ingresos).",
    calculate: "Calcular", reset: "Restablecer", copy: "Copiar",
    emptyTitle: "Calculadora de Valor de Vida del Cliente", emptyDesc: "Estima cuántos ingresos y ganancias genera un cliente típico.",
    tip1: "CLV Bruto", tip2: "CLV Neto (Ganancia)", tip3: "Valor Anual del Cliente",
    clvGross: "CLV Bruto", clvNet: "CLV Neto", annualValue: "Valor Anual del Cliente",
    aboutTitle: "Acerca de esta Calculadora",
    aboutText: "Estima el Valor de Vida del Cliente (CLV) a partir del valor promedio del pedido, la frecuencia de compra y la vida del cliente. Aplica un porcentaje de margen bruto para ver el CLV neto basado en ganancias, y compáralo con tu Costo de Adquisición de Clientes.",
  },
}[lang];
---

<section class="clv-calculator">

  <div class="clv-layout">

    <aside class="clv-sidebar">
      <CurrencySelector />

      <CalculatorField
        id="avgOrderValue"
        label={copy.avgOrderValue}
        type="number"
        required={true}
        helpText={copy.avgOrderHelp}
      />

      <CalculatorField
        id="purchaseFrequency"
        label={copy.purchaseFrequency}
        type="number"
        required={true}
        helpText={copy.purchaseFreqHelp}
      />

      <CalculatorField
        id="lifespanYears"
        label={copy.lifespanYears}
        type="number"
        required={true}
        helpText={copy.lifespanHelp}
      />

      <CalculatorField
        id="grossMargin"
        label={copy.grossMargin}
        type="number"
        helpText={copy.grossMarginHelp}
      />

      <CalculatorActions
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
        calculateText={copy.calculate}
        resetText={copy.reset}
        copyText={copy.copy}
      />

      <div id="errorBox" class="error-box" hidden></div>

    </aside>

    <main class="clv-content">

      <div id="emptyState">

        <EmptyState
          icon="💎"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={[
            copy.tip1,
            copy.tip2,
            copy.tip3
          ]}
        />

      </div>

      <div id="resultsContainer" hidden>

        <ResultsGrid columns={3}>

          <ResultCard
            id="clvGrossResult"
            title={copy.clvGross}
            icon={Gem}
          />

          <ResultCard
            id="clvNetResult"
            title={copy.clvNet}
            icon={TrendingUp}
            subtitle=" "
          />

          <ResultCard
            id="annualValueResult"
            title={copy.annualValue}
            icon={Repeat}
          />

        </ResultsGrid>

        <section class="calculator-info">

          <h2>{copy.aboutTitle}</h2>

          <p>
            {copy.aboutText}
          </p>

        </section>

      </div>

    </main>

  </div>

</section>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/customer-lifetime-value";
</script>

<style>

.clv-calculator{

width:100%;

}

.clv-layout{

display:grid;

grid-template-columns:340px minmax(0,1fr);

gap:32px;

align-items:start;

}

.clv-sidebar{

position:sticky;

top:24px;

display:flex;

flex-direction:column;

gap:20px;

}

.clv-content{

display:flex;

flex-direction:column;

gap:28px;

min-width:0;

}

.calculator-info{

padding:24px;

border:1px solid var(--border-subtle);

border-radius:18px;

background:var(--bg-card);

}

.calculator-info h2{

margin:0 0 12px;

font-size:1.15rem;

font-weight:700;

color:var(--text-primary);

}

.calculator-info p{

margin:0;

line-height:1.8;

font-size:.95rem;

color:var(--text-secondary);

}

.error-box{

display:flex;

align-items:center;

padding:14px 16px;

border-radius:14px;

background:#FEF2F2;

border:1px solid #FCA5A5;

color:#B91C1C;

font-size:.92rem;

font-weight:600;

}

:global(.dark) .error-box{

background:#2A1111;

border-color:#7F1D1D;

color:#FECACA;

}

@media(max-width:1024px){

.clv-layout{

grid-template-columns:1fr;

}

.clv-sidebar{

position:static;

}

}

@media(max-width:768px){

.clv-layout{

gap:24px;

}

.clv-content{

gap:20px;

}

}

@media(max-width:640px){

.calculator-info{

padding:18px;

}

}

</style>

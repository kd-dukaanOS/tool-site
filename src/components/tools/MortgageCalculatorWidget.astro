---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import CurrencySelector from "../calculator/CurrencySelector.astro";

import {
  House,
  Landmark,
  Percent,
  ShieldCheck,
  Building2,
  Receipt,
  TrendingUp,
  Wallet
} from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { housePrice:"House Price (₹)", housePriceHelp:"Total purchase price of the House.", downPayment:"Down Payment (₹)", downPaymentHelp:"Amount paid upfront.", loanYears:"Loan Term (Years)", loanYearsHelp:"Repayment period.", annualRate:"Interest Rate (%)", annualRateHelp:"Annual interest rate.", propertyTax:"Property Tax (% of price/year)", propertyTaxHelp:"Optional. Leave blank if unknown.", homeInsurance:"House Insurance (₹/year)", homeInsuranceHelp:"Optional annual insurance premium.", pmi:"PMI (% of loan/year)", pmiHelp:"Applies only if down payment is under 20%.", hoa:"HOA / Maintenance (₹/month)", hoaHelp:"Optional monthly society/maintenance fee.", emptyTitle:"Mortgage Calculator", emptyDesc:"Estimate your full monthly House loan payment, including taxes and insurance.", tip1:"Monthly Principal + Interest", tip2:"Property Tax & Insurance", tip3:"PMI (if applicable)", tip4:"Total Monthly Payment", totalMonthly:"Total Monthly Payment", principalInterest:"Principal + Interest", loanAmount:"Loan Amount", propertyTaxTitle:"Monthly Property Tax", insuranceTitle:"Monthly House Insurance", pmiTitle:"Monthly PMI", hoaTitle:"Monthly HOA", totalInterestTitle:"Total Interest Paid", aboutTitle:"About this Calculator", aboutText:"Estimates your full monthly mortgage payment (PITI): Principal, Interest, Taxes and Insurance, plus PMI and HOA fees where applicable. All calculations run locally — no external data or paid service is required." },
  es: { housePrice:"Precio de la Vivienda (₹)", housePriceHelp:"Precio total de compra de la vivienda.", downPayment:"Pago Inicial (₹)", downPaymentHelp:"Monto pagado por adelantado.", loanYears:"Plazo del Préstamo (Años)", loanYearsHelp:"Período de reembolso.", annualRate:"Tasa de Interés (%)", annualRateHelp:"Tasa de interés anual.", propertyTax:"Impuesto Predial (% del precio/año)", propertyTaxHelp:"Opcional. Déjalo en blanco si no lo sabes.", homeInsurance:"Seguro de Vivienda (₹/año)", homeInsuranceHelp:"Prima de seguro anual opcional.", pmi:"PMI (% del préstamo/año)", pmiHelp:"Solo aplica si el pago inicial es menor al 20%.", hoa:"HOA / Mantenimiento (₹/mes)", hoaHelp:"Cuota mensual opcional de mantenimiento/comunidad.", emptyTitle:"Calculadora de Hipoteca", emptyDesc:"Calcula tu pago mensual completo del préstamo hipotecario, incluyendo impuestos y seguro.", tip1:"Capital + Interés Mensual", tip2:"Impuesto Predial y Seguro", tip3:"PMI (si aplica)", tip4:"Pago Mensual Total", totalMonthly:"Pago Mensual Total", principalInterest:"Capital + Interés", loanAmount:"Monto del Préstamo", propertyTaxTitle:"Impuesto Predial Mensual", insuranceTitle:"Seguro de Vivienda Mensual", pmiTitle:"PMI Mensual", hoaTitle:"HOA Mensual", totalInterestTitle:"Interés Total Pagado", aboutTitle:"Acerca de esta Calculadora", aboutText:"Calcula tu pago hipotecario mensual completo (PITI): Capital, Interés, Impuestos y Seguro, más PMI y cuotas de HOA cuando apliquen. Todos los cálculos se ejecutan localmente — no se requiere ningún servicio externo ni de pago." },
}[lang];
---

<section class="mort-calculator">

  <div class="mort-layout">

    <aside class="mort-sidebar">

      <CurrencySelector />

      <CalculatorField
        id="homePrice"
        label={copy.housePrice}
        type="number"
        placeholder="e.g. 5000000"
        required={true}
        min="0"
        step="1"
        helpText={copy.housePriceHelp}
      />

      <CalculatorField
        id="downPayment"
        label={copy.downPayment}
        type="number"
        placeholder="e.g. 1000000"
        min="0"
        step="1"
        helpText={copy.downPaymentHelp}
      />

      <CalculatorField
        id="loanYears"
        label={copy.loanYears}
        type="number"
        placeholder="e.g. 20"
        required={true}
        min="0"
        step="1"
        helpText={copy.loanYearsHelp}
      />

      <CalculatorField
        id="annualRate"
        label={copy.annualRate}
        type="number"
        placeholder="e.g. 8.5"
        required={true}
        min="0"
        step="0.01"
        helpText={copy.annualRateHelp}
      />

      <CalculatorField
        id="propertyTaxAnnual"
        label={copy.propertyTax}
        type="number"
        placeholder="e.g. 1"
        min="0"
        step="0.01"
        helpText={copy.propertyTaxHelp}
      />

      <CalculatorField
        id="homeInsuranceAnnual"
        label={copy.homeInsurance}
        type="number"
        placeholder="e.g. 8000"
        min="0"
        step="1"
        helpText={copy.homeInsuranceHelp}
      />

      <CalculatorField
        id="pmiAnnual"
        label={copy.pmi}
        type="number"
        placeholder="e.g. 0.5"
        min="0"
        step="0.01"
        helpText={copy.pmiHelp}
      />

      <CalculatorField
        id="hoaMonthly"
        label={copy.hoa}
        type="number"
        placeholder="e.g. 1500"
        min="0"
        step="1"
        helpText={copy.hoaHelp}
      />

      <CalculatorActions lang={lang}
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
      />

      <div
        id="errorBox"
        class="error-box"
        hidden
      ></div>

    </aside>

    <main class="mort-content">

      <div id="emptyState">

        <EmptyState
          icon="🏠"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={[
            copy.tip1,
            copy.tip2,
            copy.tip3,
            copy.tip4
          ]}
        />

      </div>

      <div
        id="resultsContainer"
        hidden
      >

        <ResultsGrid columns={3}>

          <ResultCard
            id="totalMonthlyResult"
            title={copy.totalMonthly}
            icon={Wallet}
            accent="success"
          />

          <ResultCard
            id="principalInterestResult"
            title={copy.principalInterest}
            icon={House}
          />

          <ResultCard
            id="loanAmountResult"
            title={copy.loanAmount}
            icon={Landmark}
          />

          <ResultCard
            id="propertyTaxResult"
            title={copy.propertyTaxTitle}
            icon={Receipt}
          />

          <ResultCard
            id="insuranceResult"
            title={copy.insuranceTitle}
            icon={ShieldCheck}
          />

          <ResultCard
            id="pmiResult"
            title={copy.pmiTitle}
            icon={Percent}
          />

          <ResultCard
            id="hoaResult"
            title={copy.hoaTitle}
            icon={Building2}
          />

          <ResultCard
            id="totalInterestResult"
            title={copy.totalInterestTitle}
            icon={TrendingUp}
          />

        </ResultsGrid>

        <section class="calculator-info">

          <h2>{copy.aboutTitle}</h2>

          <p>{copy.aboutText}</p>

        </section>

      </div>

    </main>

  </div>

</section>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/mortgage-calculator";
</script>

<style>

.mort-calculator{

width:100%;

}

.mort-layout{

display:grid;

grid-template-columns:340px minmax(0,1fr);

gap:32px;

align-items:start;

}

.mort-sidebar{

position:sticky;

top:24px;

display:flex;

flex-direction:column;

gap:20px;

}

.mort-content{

display:flex;

flex-direction:column;

gap:28px;

min-width:0;

}

.calculator-info{

padding:24px;

border:1px solid var(--border-subtle);

border-radius:18px;

background:var(--bg-card);

}

.calculator-info h2{

margin:0 0 12px;

font-size:1.15rem;

font-weight:700;

color:var(--text-primary);

}

.calculator-info p{

margin:0;

line-height:1.8;

font-size:.95rem;

color:var(--text-secondary);

}

.error-box{

display:flex;

align-items:center;

padding:14px 16px;

border-radius:14px;

background:#FEF2F2;

border:1px solid #FCA5A5;

color:#B91C1C;

font-size:.92rem;

font-weight:600;

}



:global(.dark) .error-box{

background:#2A1111;

border-color:#7F1D1D;

color:#FECACA;

}

@media(max-width:1024px){

.mort-layout{

grid-template-columns:1fr;

}

.mort-sidebar{

position:static;

}

}

@media(max-width:768px){

.mort-layout{

gap:24px;

}

.mort-content{

gap:20px;

}

}

@media(max-width:640px){

.calculator-info{

padding:18px;

}

}

</style>


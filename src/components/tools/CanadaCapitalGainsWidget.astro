---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { TrendingUp, Percent, DollarSign, Landmark } from "@lucide/astro";
---
<section class="ccg-calculator">
  <div class="ccg-layout">
    <aside class="ccg-sidebar">
      <div class="ccg-group">
        <h3>Sale Details</h3>
        <CalculatorField id="proceedsOfDisposition" label="Proceeds of Disposition ($)" type="number" placeholder="e.g. 150000" min="0" step="1" />
        <CalculatorField id="adjustedCostBase" label="Adjusted Cost Base ($)" type="number" placeholder="e.g. 90000" min="0" step="1" />
        <CalculatorField id="outlaysAndExpenses" label="Outlays & Expenses ($)" type="number" placeholder="e.g. 2000" min="0" step="1" />
      </div>
      <div class="ccg-group">
        <h3>Tax Rate</h3>
        <CalculatorField id="marginalTaxRate" label="Marginal Tax Rate (%)" type="number" placeholder="e.g. 30" min="0" step="0.1" />
      </div>
      <CalculatorActions calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="ccg-content">
      <div id="emptyState">
        <EmptyState icon="📈" title="Canada Capital Gains Tax Calculator" description="Estimate tax owed on a capital gain using the current inclusion rate." tips={["Capital Gain", "Taxable Gain", "Estimated Tax"]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="capitalGainResult" title="Capital Gain" icon={DollarSign} />
          <ResultCard id="inclusionRateResult" title="Inclusion Rate" icon={Percent} />
          <ResultCard id="taxableCapitalGainResult" title="Taxable Capital Gain" icon={Landmark} />
          <ResultCard id="estimatedTaxResult" title="Estimated Tax Owed" icon={TrendingUp} accent="success" subtitle=" " />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>About this Calculator</h2>
          <p>Estimates the tax owed on a capital gain by applying Canada's current 50% inclusion rate and your marginal tax rate to the gain from your proceeds, cost base, and expenses.</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script>
  import "../../scripts/canada-capital-gains-calculator";
</script>
<style>
.ccg-calculator{width:100%;}
.ccg-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.ccg-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.ccg-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.ccg-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.ccg-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.ccg-layout{grid-template-columns:1fr;}.ccg-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.ccg-layout{gap:24px;}.ccg-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
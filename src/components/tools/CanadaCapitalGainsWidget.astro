---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { TrendingUp, Percent, DollarSign, Landmark } from "@lucide/astro";

interface Props {
  lang?: "en" | "es";
}
const { lang = "en" } = Astro.props as Props;

const copy = {
  en: {
    saleDetails: "Sale Details", proceeds: "Proceeds of Disposition ($)", costBase: "Adjusted Cost Base ($)", expenses: "Outlays & Expenses ($)",
    taxRateGroup: "Tax Rate", marginalRate: "Marginal Tax Rate (%)",
    calculate: "Calculate", reset: "Reset", copy: "Copy",
    emptyTitle: "Canada Capital Gains Tax Calculator", emptyDesc: "Estimate tax owed on a capital gain using the current inclusion rate.",
    tip1: "Capital Gain", tip2: "Taxable Gain", tip3: "Estimated Tax",
    capitalGain: "Capital Gain", inclusionRate: "Inclusion Rate", taxableCapitalGain: "Taxable Capital Gain", estimatedTax: "Estimated Tax Owed",
    aboutTitle: "About this Calculator",
    aboutText: "Estimates the tax owed on a capital gain by applying Canada's current 50% inclusion rate and your marginal tax rate to the gain from your proceeds, cost base, and expenses.",
  },
  es: {
    saleDetails: "Detalles de la Venta", proceeds: "Producto de la Disposición ($)", costBase: "Base de Costo Ajustada ($)", expenses: "Gastos y Desembolsos ($)",
    taxRateGroup: "Tasa de Impuesto", marginalRate: "Tasa de Impuesto Marginal (%)",
    calculate: "Calcular", reset: "Restablecer", copy: "Copiar",
    emptyTitle: "Calculadora de Ganancias de Capital de Canadá", emptyDesc: "Estima el impuesto adeudado sobre una ganancia de capital usando la tasa de inclusión actual.",
    tip1: "Ganancia de Capital", tip2: "Ganancia Imponible", tip3: "Impuesto Estimado",
    capitalGain: "Ganancia de Capital", inclusionRate: "Tasa de Inclusión", taxableCapitalGain: "Ganancia de Capital Imponible", estimatedTax: "Impuesto Estimado Adeudado",
    aboutTitle: "Acerca de esta Calculadora",
    aboutText: "Estima el impuesto adeudado sobre una ganancia de capital aplicando la tasa de inclusión actual del 50% de Canadá y tu tasa de impuesto marginal a la ganancia de tus ingresos, base de costo y gastos.",
  },
}[lang];
---
<section class="ccg-calculator">
  <div class="ccg-layout">
    <aside class="ccg-sidebar">
      <div class="ccg-group">
        <h3>{copy.saleDetails}</h3>
        <CalculatorField id="proceedsOfDisposition" label={copy.proceeds} type="number" placeholder="e.g. 150000" min="0" step="1" />
        <CalculatorField id="adjustedCostBase" label={copy.costBase} type="number" placeholder="e.g. 90000" min="0" step="1" />
        <CalculatorField id="outlaysAndExpenses" label={copy.expenses} type="number" placeholder="e.g. 2000" min="0" step="1" />
      </div>
      <div class="ccg-group">
        <h3>{copy.taxRateGroup}</h3>
        <CalculatorField id="marginalTaxRate" label={copy.marginalRate} type="number" placeholder="e.g. 30" min="0" step="0.1" />
      </div>
      <CalculatorActions lang={lang} calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} calculateText={copy.calculate} resetText={copy.reset} copyText={copy.copy} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="ccg-content">
      <div id="emptyState">
        <EmptyState icon="📈" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="capitalGainResult" title={copy.capitalGain} icon={DollarSign} />
          <ResultCard id="inclusionRateResult" title={copy.inclusionRate} icon={Percent} />
          <ResultCard id="taxableCapitalGainResult" title={copy.taxableCapitalGain} icon={Landmark} />
          <ResultCard id="estimatedTaxResult" title={copy.estimatedTax} icon={TrendingUp} accent="success" subtitle=" " />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/canada-capital-gains-calculator";
</script>
<style>
.ccg-calculator{width:100%;}
.ccg-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.ccg-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.ccg-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.ccg-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.ccg-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.ccg-layout{grid-template-columns:1fr;}.ccg-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.ccg-layout{gap:24px;}.ccg-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
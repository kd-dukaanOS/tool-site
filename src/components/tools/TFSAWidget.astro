---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { PiggyBank, Landmark, TrendingUp, AlertTriangle } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { eligibilityGroup:"Eligibility", eligibleYear:"Year You Became Eligible", currentYear:"Current Tax Year", historyGroup:"Contribution History", totalContributed:"Total Contributed to Date", withdrawals:"Withdrawals This Year", newGroup:"New Contribution", planned:"Planned New Contribution", expectedReturn:"Expected Return (%/yr)", years:"Years to Grow", emptyTitle:"TFSA Calculator", emptyDesc:"Find your TFSA contribution room and projected tax-free growth.", tip1:"Available Room", tip2:"Total Room", tip3:"Projected Balance", availableRoom:"Available Room", totalRoom:"Total Room Since Eligible", projectedBalance:"Projected Balance", penaltyTax:"Penalty Tax", overContribution:"Over-contribution detected", withinLimit:"Within limit", none:"None", aboutTitle:"About this Calculator", aboutText:"Calculates your total and available TFSA contribution room since your eligibility year, flags over-contribution penalties, and projects tax-free growth.", totalRoomSince:"Total Room Since", availableRoomThisYear:"Available Room This Year", monthlyPenalty:"Monthly Penalty Tax (if over-contributed)" },
  es: { eligibilityGroup:"Elegibilidad", eligibleYear:"Año en que Fuiste Elegible", currentYear:"Año Fiscal Actual", historyGroup:"Historial de Aportaciones", totalContributed:"Total Aportado a la Fecha", withdrawals:"Retiros Este Año", newGroup:"Nueva Aportación", planned:"Nueva Aportación Planeada", expectedReturn:"Rendimiento Esperado (%/año)", years:"Años de Crecimiento", emptyTitle:"Calculadora de TFSA", emptyDesc:"Calcula tu margen de aportación TFSA y el crecimiento libre de impuestos proyectado.", tip1:"Margen Disponible", tip2:"Margen Total", tip3:"Saldo Proyectado", availableRoom:"Margen Disponible", totalRoom:"Margen Total Desde Elegibilidad", projectedBalance:"Saldo Proyectado", penaltyTax:"Impuesto de Penalización", overContribution:"Exceso de aportación detectado", withinLimit:"Dentro del límite", none:"Ninguno", aboutTitle:"Acerca de esta Calculadora", aboutText:"Calcula tu margen de aportación TFSA total y disponible desde tu año de elegibilidad, señala penalizaciones por exceso de aportación y proyecta el crecimiento libre de impuestos.", totalRoomSince:"Margen Total Desde", availableRoomThisYear:"Margen Disponible Este Año", monthlyPenalty:"Impuesto de Penalización Mensual (si hay exceso)" },
}[lang];
---
<section class="tfsa-calculator">
  <div class="tfsa-layout">
    <aside class="tfsa-sidebar">
      <div class="tfsa-group">
        <h3>{copy.eligibilityGroup}</h3>
        <CalculatorField id="eligibleYear" label={copy.eligibleYear} type="number" placeholder="e.g. 2009" min="2009" step="1" />
        <CalculatorField id="currentYear" label={copy.currentYear} type="number" placeholder="e.g. 2026" min="2009" step="1" />
      </div>
      <div class="tfsa-group">
        <h3>{copy.historyGroup}</h3>
        <CalculatorField id="totalContributedToDate" label={copy.totalContributed} type="number" placeholder="e.g. 50000" min="0" step="1" />
        <CalculatorField id="withdrawalsThisYear" label={copy.withdrawals} type="number" placeholder="e.g. 0" min="0" step="1" />
      </div>
      <div class="tfsa-group">
        <h3>{copy.newGroup}</h3>
        <CalculatorField id="plannedContribution" label={copy.planned} type="number" placeholder="e.g. 7000" min="0" step="1" />
        <CalculatorField id="expectedReturn" label={copy.expectedReturn} type="number" placeholder="e.g. 6" min="0" step="0.1" />
        <CalculatorField id="yearsToGrow" label={copy.years} type="number" placeholder="e.g. 10" min="1" step="1" />
      </div>
      <CalculatorActions calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="tfsa-content">
      <div id="emptyState">
        <EmptyState icon="🍁" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="availableRoomResult" title={copy.availableRoom} icon={PiggyBank} accent="success" />
          <ResultCard id="totalRoomResult" title={copy.totalRoom} icon={Landmark} />
          <ResultCard id="projectedBalanceResult" title={copy.projectedBalance} icon={TrendingUp} />
          <ResultCard id="penaltyTaxResult" title={copy.penaltyTax} icon={AlertTriangle} subtitle=" " />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang, overContributionLabel: copy.overContribution, withinLimitLabel: copy.withinLimit, noneLabel: copy.none, totalRoomSinceLabel: copy.totalRoomSince, availableRoomThisYearLabel: copy.availableRoomThisYear, monthlyPenaltyLabel: copy.monthlyPenalty, projectedBalanceLabel: copy.projectedBalance }}>
  window.calcLang = calcLang;
  window.tfsaOverContributionLabel = overContributionLabel;
  window.tfsaWithinLimitLabel = withinLimitLabel;
  window.tfsaNoneLabel = noneLabel;
  window.tfsaTotalRoomSinceLabel = totalRoomSinceLabel;
  window.tfsaAvailableRoomThisYearLabel = availableRoomThisYearLabel;
  window.tfsaMonthlyPenaltyLabel = monthlyPenaltyLabel;
  window.tfsaProjectedBalanceLabel = projectedBalanceLabel;
</script>
<script>
  import "../../scripts/tfsa-calculator";
</script>
<style>
.tfsa-calculator{width:100%;}
.tfsa-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.tfsa-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.tfsa-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.tfsa-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.tfsa-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.tfsa-layout{grid-template-columns:1fr;}.tfsa-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.tfsa-layout{gap:24px;}.tfsa-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
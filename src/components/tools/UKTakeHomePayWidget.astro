---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Wallet, CalendarDays, Repeat, MinusCircle } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { grossLabel:"Gross Annual Salary", grossHelp:"Your gross salary before deductions (GBP).", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"UK Take-Home Pay Calculator", emptyDesc:"See your net salary after Income Tax and National Insurance.", tip1:"Net Annual Pay", tip2:"Income Tax", tip3:"National Insurance", netAnnualTitle:"Net Annual Pay", netMonthlyTitle:"Net Monthly", netWeeklyTitle:"Net Weekly", totalDeductionsTitle:"Total Deductions", aboutTitle:"About this Calculator", aboutText:"Estimates net pay after Income Tax and National Insurance (England/Wales/NI rates). Results are estimates — verify against current HMRC figures.", effectiveRateSuffix:"effective rate" },
  es: { grossLabel:"Salario Anual Bruto", grossHelp:"Tu salario bruto antes de deducciones (GBP).", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora de Salario Neto del Reino Unido", emptyDesc:"Observa tu salario neto después del Impuesto sobre la Renta y el Seguro Nacional.", tip1:"Pago Anual Neto", tip2:"Impuesto sobre la Renta", tip3:"Seguro Nacional", netAnnualTitle:"Pago Anual Neto", netMonthlyTitle:"Neto Mensual", netWeeklyTitle:"Neto Semanal", totalDeductionsTitle:"Deducciones Totales", aboutTitle:"Acerca de esta Calculadora", aboutText:"Estima el salario neto después del Impuesto sobre la Renta y el Seguro Nacional (tasas de Inglaterra/Gales/Irlanda del Norte). Los resultados son estimaciones — verifica con las cifras actuales de HMRC.", effectiveRateSuffix:"tasa efectiva" },
}[lang];
---
<section class="ukts-calculator">
  <div class="ukts-layout">
    <aside class="ukts-sidebar">
      <CalculatorField id="grossIncome" label={copy.grossLabel} type="number" required={true} helpText={copy.grossHelp} />
      <CalculatorActions calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} calculateText={copy.calculate} resetText={copy.reset} copyText={copy.copy} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="ukts-content">
      <div id="emptyState">
        <EmptyState icon="🇬🇧" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={3}>
          <ResultCard id="netAnnualResult" title={copy.netAnnualTitle} icon={Wallet} subtitle=" " />
          <ResultCard id="netMonthlyResult" title={copy.netMonthlyTitle} icon={CalendarDays} />
          <ResultCard id="netWeeklyResult" title={copy.netWeeklyTitle} icon={Repeat} />
          <ResultCard id="totalDeductionsResult" title={copy.totalDeductionsTitle} icon={MinusCircle} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/uk-take-home-pay";
</script>
<style>
.ukts-calculator{width:100%;}
.ukts-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.ukts-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;}
.ukts-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.ukts-layout{grid-template-columns:1fr;}.ukts-sidebar{position:static;}}
@media(max-width:768px){.ukts-layout{gap:24px;}.ukts-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
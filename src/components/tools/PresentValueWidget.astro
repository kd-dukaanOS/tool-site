---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Landmark, TrendingDown, DollarSign } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { futureGroup:"Future Amount", futureValue:"Future Value", years:"Years Until Received", discountGroup:"Discount Rate", discountRate:"Discount Rate (%)", compounding:"Compounding Frequency", annually:"Annually", monthly:"Monthly", quarterly:"Quarterly", daily:"Daily", emptyTitle:"Present Value Calculator", emptyDesc:"Find what a future sum of money is worth today.", tip1:"Present Value", tip2:"Future Value", tip3:"Discount Amount", presentValue:"Present Value", futureValueOut:"Future Value", discountAmount:"Discount Amount", discountedOver:"Discounted over", yearsLabel:"years", aboutTitle:"About this Calculator", aboutText:"Discounts a future sum of money back to its equivalent value today, based on your chosen discount rate and compounding frequency." },
  es: { futureGroup:"Monto Futuro", futureValue:"Valor Futuro", years:"Años Hasta Recibirlo", discountGroup:"Tasa de Descuento", discountRate:"Tasa de Descuento (%)", compounding:"Frecuencia de Capitalización", annually:"Anual", monthly:"Mensual", quarterly:"Trimestral", daily:"Diaria", emptyTitle:"Calculadora de Valor Presente", emptyDesc:"Calcula cuánto vale hoy una suma de dinero futura.", tip1:"Valor Presente", tip2:"Valor Futuro", tip3:"Monto de Descuento", presentValue:"Valor Presente", futureValueOut:"Valor Futuro", discountAmount:"Monto de Descuento", discountedOver:"Descontado a lo largo de", yearsLabel:"años", aboutTitle:"Acerca de esta Calculadora", aboutText:"Descuenta una suma de dinero futura a su valor equivalente hoy, según la tasa de descuento y la frecuencia de capitalización elegidas." },
}[lang];
---
<section class="pv-calculator">
  <div class="pv-layout">
    <aside class="pv-sidebar">
      <div class="pv-group">
        <h3>{copy.futureGroup}</h3>
        <CalculatorField id="futureValue" label={copy.futureValue} type="number" placeholder="e.g. 50000" min="0" step="1" />
        <CalculatorField id="years" label={copy.years} type="number" placeholder="e.g. 10" min="1" step="1" />
      </div>
      <div class="pv-group">
        <h3>{copy.discountGroup}</h3>
        <CalculatorField id="discountRate" label={copy.discountRate} type="number" placeholder="e.g. 6" min="-100" step="0.1" />
        <CalculatorField type="select" id="compoundingFrequency" label={copy.compounding}>
  <option value="1">{copy.annually}</option>
  <option value="12">{copy.monthly}</option>
  <option value="4">{copy.quarterly}</option>
  <option value="365">{copy.daily}</option>
</CalculatorField>
      </div>
      <CalculatorActions calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="pv-content">
      <div id="emptyState">
        <EmptyState icon="⏳" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={3}>
          <ResultCard id="presentValueResult" title={copy.presentValue} icon={Landmark} accent="success" subtitle=" " />
          <ResultCard id="futureValueOutResult" title={copy.futureValueOut} icon={DollarSign} />
          <ResultCard id="discountAmountResult" title={copy.discountAmount} icon={TrendingDown} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang, discountedOverLabel: copy.discountedOver, yearsLabel: copy.yearsLabel }}>
  window.calcLang = calcLang;
  window.pvDiscountedOverLabel = discountedOverLabel;
  window.pvYearsLabel = yearsLabel;
</script>
<script>
  import "../../scripts/present-value-calculator";
</script>
<style>
.pv-calculator{width:100%;}
.pv-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.pv-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.pv-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.pv-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.pv-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.pv-layout{grid-template-columns:1fr;}.pv-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.pv-layout{gap:24px;}.pv-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";

import {
  Wallet,
  TrendingUp,
  Coins,
  Percent
} from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { monthlyDeposit:"Monthly Deposit (₹)", monthlyDepositHelp:"Amount deposited every month.", annualRate:"Interest Rate (% p.a.)", annualRateHelp:"Rate offered by the bank.", tenure:"Tenure (Months)", tenureHelp:"RD duration in months, usually a multiple of 3.", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"RD Calculator", emptyDesc:"Calculate the maturity value of your Recurring Deposit.", tip1:"Maturity Value", tip2:"Total Deposited", tip3:"Total Interest Earned", tip4:"Effective Yield", maturity:"Maturity Value", interest:"Total Interest Earned", deposited:"Total Deposited", yield:"Effective Annual Yield", aboutTitle:"About this Calculator", aboutText:"Uses the standard bank RD formula with quarterly compounding on monthly deposits: M = P × [(1+i)^n − 1] / (1 − (1+i)^(−1/3)), where i is the quarterly rate and n is the number of quarters." },
  es: { monthlyDeposit:"Depósito Mensual (₹)", monthlyDepositHelp:"Monto depositado cada mes.", annualRate:"Tasa de Interés (% anual)", annualRateHelp:"Tasa ofrecida por el banco.", tenure:"Plazo (Meses)", tenureHelp:"Duración del RD en meses, usualmente múltiplo de 3.", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora de Depósito Recurrente", emptyDesc:"Calcula el valor de vencimiento de tu Depósito Recurrente.", tip1:"Valor de Vencimiento", tip2:"Total Depositado", tip3:"Interés Total Ganado", tip4:"Rendimiento Efectivo", maturity:"Valor de Vencimiento", interest:"Interés Total Ganado", deposited:"Total Depositado", yield:"Rendimiento Anual Efectivo", aboutTitle:"Acerca de esta Calculadora", aboutText:"Usa la fórmula bancaria estándar de RD con capitalización trimestral sobre depósitos mensuales: M = P × [(1+i)^n − 1] / (1 − (1+i)^(−1/3)), donde i es la tasa trimestral y n es el número de trimestres." },
}[lang];
---

<section class="rd-calculator">

  <div class="rd-layout">

    <aside class="rd-sidebar">

      <CalculatorField
        id="monthlyDeposit"
        label={copy.monthlyDeposit}
        type="number"
        placeholder="e.g. 5000"
        required={true}
        min="0"
        step="1"
        helpText={copy.monthlyDepositHelp}
      />

      <CalculatorField
        id="annualRate"
        label={copy.annualRate}
        type="number"
        placeholder="e.g. 7"
        required={true}
        min="0"
        step="0.01"
        helpText={copy.annualRateHelp}
      />

      <CalculatorField
        id="tenureMonths"
        label={copy.tenure}
        type="number"
        placeholder="e.g. 24"
        required={true}
        min="0"
        step="1"
        helpText={copy.tenureHelp}
      />

      <CalculatorActions lang={lang}
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
        calculateText={copy.calculate}
        resetText={copy.reset}
        copyText={copy.copy}
      />

      <div
        id="errorBox"
        class="error-box"
        hidden
      ></div>

    </aside>

    <main class="rd-content">

      <div id="emptyState">

        <EmptyState
          icon="📆"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={[copy.tip1, copy.tip2, copy.tip3, copy.tip4]}
        />

      </div>

      <div
        id="resultsContainer"
        hidden
      >

        <ResultsGrid columns={2}>

          <ResultCard
            id="maturityResult"
            title={copy.maturity}
            icon={Wallet}
            accent="success"
          />

          <ResultCard
            id="interestResult"
            title={copy.interest}
            icon={TrendingUp}
          />

          <ResultCard
            id="depositedResult"
            title={copy.deposited}
            icon={Coins}
          />

          <ResultCard
            id="yieldResult"
            title={copy.yield}
            icon={Percent}
          />

        </ResultsGrid>

        <section class="calculator-info">

          <h2>{copy.aboutTitle}</h2>

          <p>{copy.aboutText}</p>

        </section>

      </div>

    </main>

  </div>

</section>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/rd-calculator";
</script>

<style>

.rd-calculator{

width:100%;

}

.rd-layout{

display:grid;

grid-template-columns:340px minmax(0,1fr);

gap:32px;

align-items:start;

}

.rd-sidebar{

position:sticky;

top:24px;

display:flex;

flex-direction:column;

gap:20px;

}

.rd-content{

display:flex;

flex-direction:column;

gap:28px;

min-width:0;

}

.error-box{

display:flex;

align-items:center;

padding:14px 16px;

border-radius:14px;

background:#FEF2F2;

border:1px solid #FCA5A5;

color:#B91C1C;

font-size:.92rem;

font-weight:600;

}

.calculator-info{

padding:24px;

border:1px solid var(--border-subtle);

border-radius:18px;

background:var(--bg-card);

}

.calculator-info h2{

margin:0 0 12px;

font-size:1.15rem;

font-weight:700;

color:var(--text-primary);

}

.calculator-info p{

margin:0;

line-height:1.8;

font-size:.95rem;

color:var(--text-secondary);

}

:global(.dark) .error-box{

background:#2A1111;

border-color:#7F1D1D;

color:#FECACA;

}

@media(max-width:1024px){

.rd-layout{

grid-template-columns:1fr;

}

.rd-sidebar{

position:static;

}

}

@media(max-width:768px){

.rd-layout{

gap:24px;

}

.rd-content{

gap:20px;

}

}

@media(max-width:640px){

.calculator-info{

padding:18px;

}

}

</style>

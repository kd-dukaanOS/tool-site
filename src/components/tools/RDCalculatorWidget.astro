---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";

import {
  Wallet,
  TrendingUp,
  Coins,
  Percent
} from "@lucide/astro";
---

<section class="rd-calculator">

  <div class="rd-layout">

    <aside class="rd-sidebar">

      <CalculatorField
        id="monthlyDeposit"
        label="Monthly Deposit (₹)"
        type="number"
        placeholder="e.g. 5000"
        required={true}
        min="0"
        step="1"
        helpText="Amount deposited every month."
      />

      <CalculatorField
        id="annualRate"
        label="Interest Rate (% p.a.)"
        type="number"
        placeholder="e.g. 7"
        required={true}
        min="0"
        step="0.01"
        helpText="Rate offered by the bank."
      />

      <CalculatorField
        id="tenureMonths"
        label="Tenure (Months)"
        type="number"
        placeholder="e.g. 24"
        required={true}
        min="0"
        step="1"
        helpText="RD duration in months, usually a multiple of 3."
      />

      <CalculatorActions
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
      />

      <div
        id="errorBox"
        class="error-box"
        hidden
      ></div>

    </aside>

    <main class="rd-content">

      <div id="emptyState">

        <EmptyState
          icon="📆"
          title="RD Calculator"
          description="Calculate the maturity value of your Recurring Deposit."
          tips={[
            "Maturity Value",
            "Total Deposited",
            "Total Interest Earned",
            "Effective Yield"
          ]}
        />

      </div>

      <div
        id="resultsContainer"
        hidden
      >

        <ResultsGrid columns={2}>

          <ResultCard
            id="maturityResult"
            title="Maturity Value"
            icon={Wallet}
            accent="success"
          />

          <ResultCard
            id="interestResult"
            title="Total Interest Earned"
            icon={TrendingUp}
          />

          <ResultCard
            id="depositedResult"
            title="Total Deposited"
            icon={Coins}
          />

          <ResultCard
            id="yieldResult"
            title="Effective Annual Yield"
            icon={Percent}
          />

        </ResultsGrid>

        <section class="calculator-info">

          <h2>About this Calculator</h2>

          <p>
            Uses the standard bank RD formula with quarterly
            compounding on monthly deposits:
            M = P × [(1+i)^n − 1] / (1 − (1+i)^(−1/3)), where i is
            the quarterly rate and n is the number of quarters.
          </p>

        </section>

      </div>

    </main>

  </div>

</section>

<script>
  import "../../scripts/rd-calculator";
</script>

<style>

.rd-calculator{

width:100%;

}

.rd-layout{

display:grid;

grid-template-columns:340px minmax(0,1fr);

gap:32px;

align-items:start;

}

.rd-sidebar{

position:sticky;

top:24px;

display:flex;

flex-direction:column;

gap:20px;

}

.rd-content{

display:flex;

flex-direction:column;

gap:28px;

min-width:0;

}

.error-box{

display:flex;

align-items:center;

padding:14px 16px;

border-radius:14px;

background:#FEF2F2;

border:1px solid #FCA5A5;

color:#B91C1C;

font-size:.92rem;

font-weight:600;

}

.calculator-info{

padding:24px;

border:1px solid var(--border-subtle);

border-radius:18px;

background:var(--bg-card);

}

.calculator-info h2{

margin:0 0 12px;

font-size:1.15rem;

font-weight:700;

color:var(--text-primary);

}

.calculator-info p{

margin:0;

line-height:1.8;

font-size:.95rem;

color:var(--text-secondary);

}

:global(.dark) .error-box{

background:#2A1111;

border-color:#7F1D1D;

color:#FECACA;

}

@media(max-width:1024px){

.rd-layout{

grid-template-columns:1fr;

}

.rd-sidebar{

position:static;

}

}

@media(max-width:768px){

.rd-layout{

gap:24px;

}

.rd-content{

gap:20px;

}

}

@media(max-width:640px){

.calculator-info{

padding:18px;

}

}

</style>

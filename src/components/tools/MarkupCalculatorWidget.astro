---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";

import { DollarSign, TrendingUp, Tag } from "@lucide/astro";
---

<section class="markup-calculator">
  <div class="markup-layout">

    <aside class="markup-sidebar">
      <CalculatorField
        id="cost"
        label="Cost ($)"
        type="number"
        placeholder="e.g. 40"
        required={true}
        min="0"
        step="0.01"
        helpText="What you paid for the item."
      />

      <CalculatorField
        id="markupPercent"
        label="Markup (%)"
        type="number"
        placeholder="e.g. 25"
        required={true}
        min="0"
        step="0.01"
        helpText="Percentage added on top of cost."
      />

      <CalculatorActions
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
      />

      <div id="errorBox" class="error-box" hidden></div>
    </aside>

    <main class="markup-content">
      <div id="emptyState">
        <EmptyState
          icon="🏷️"
          title="Markup Calculator"
          description="Find your sale price and profit from cost and markup percentage."
          tips={["Sale Price", "Profit", "Margin %"]}
        />
      </div>

      <div id="resultsContainer" hidden>
        <ResultsGrid columns={2}>
          <ResultCard id="salePriceResult" title="Sale Price" icon={DollarSign} accent="success" size="lg" />
          <ResultCard id="profitResult" title="Profit" icon={TrendingUp} accent="primary" />
          <ResultCard id="marginResult" title="Resulting Margin" icon={Tag} />
        </ResultsGrid>

        <section class="calculator-info">
          <h2>About this Calculator</h2>
          <p>
            Calculates your sale price and profit from cost and a markup percentage.
            All calculations run locally — no external data or paid service is required.
          </p>
        </section>
      </div>
    </main>

  </div>
</section>

<script>
  import "../../scripts/markup-calculator";
</script>

<style>
.markup-calculator{ width:100%; }
.markup-layout{ display:grid; grid-template-columns:340px minmax(0,1fr); gap:32px; align-items:start; }
.markup-sidebar{ position:sticky; top:24px; display:flex; flex-direction:column; gap:20px; }
.markup-content{ display:flex; flex-direction:column; gap:28px; min-width:0; }
.calculator-info{ padding:24px; border:1px solid #E5E7EB; border-radius:18px; background:#FFFFFF; }
.calculator-info h2{ margin:0 0 12px; font-size:1.15rem; font-weight:700; color:#111827; }
.calculator-info p{ margin:0; line-height:1.8; font-size:.95rem; color:#6B7280; }
.error-box{ display:flex; align-items:center; padding:14px 16px; border-radius:14px; background:#FEF2F2; border:1px solid #FCA5A5; color:#B91C1C; font-size:.92rem; font-weight:600; }
:global(.dark) .calculator-info{ background:#111217; border-color:#27272A; }
:global(.dark) .calculator-info h2{ color:#FAFAFA; }
:global(.dark) .calculator-info p{ color:#A1A1AA; }
:global(.dark) .error-box{ background:#2A1111; border-color:#7F1D1D; color:#FECACA; }
@media(max-width:1024px){ .markup-layout{ grid-template-columns:1fr; } .markup-sidebar{ position:static; } }
@media(max-width:768px){ .markup-layout{ gap:24px; } .markup-content{ gap:20px; } }
@media(max-width:640px){ .calculator-info{ padding:18px; } }
</style>
---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Home, Key, Scale, Calendar } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { buyingGroup:"Buying", homePrice:"Home Price", downPayment:"Down Payment (%)", mortgageRate:"Mortgage Rate (%)", loanTerm:"Loan Term (years)", ownershipGroup:"Ownership Costs", propertyTax:"Property Tax Rate (% / yr)", insurance:"Annual Insurance", maintenance:"Maintenance Rate (% / yr)", closingCost:"Closing Costs (%)", sellingCost:"Selling Costs (%)", appreciation:"Home Appreciation (%/yr)", rentingGroup:"Renting", monthlyRent:"Monthly Rent", rentGrowth:"Annual Rent Growth (%)", investmentReturn:"Investment Return (%/yr)", timeframeGroup:"Timeframe", comparisonYears:"Years to Compare", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"Rent vs Buy Calculator", emptyDesc:"Compare the long-term net worth impact of renting versus buying.", tip1:"Buying Net Worth", tip2:"Renting Net Worth", tip3:"Break-Even Year", betterOption:"Better Option", buyNetWorth:"Net Worth if Buying", rentNetWorth:"Net Worth if Renting", breakEven:"Break-Even Year", buying:"Buying", renting:"Renting", beyondRange:"Beyond range", yearPrefix:"Year", overYears:"Over", years:"years", aboutTitle:"About this Calculator", aboutText:"Compares the projected net worth of buying a home versus renting and investing the difference, accounting for equity, appreciation, ownership costs, and investment growth over your chosen timeframe." },
  es: { buyingGroup:"Comprar", homePrice:"Precio de la Vivienda", downPayment:"Pago Inicial (%)", mortgageRate:"Tasa Hipotecaria (%)", loanTerm:"Plazo del Préstamo (años)", ownershipGroup:"Costos de Propiedad", propertyTax:"Tasa de Impuesto Predial (% / año)", insurance:"Seguro Anual", maintenance:"Tasa de Mantenimiento (% / año)", closingCost:"Costos de Cierre (%)", sellingCost:"Costos de Venta (%)", appreciation:"Apreciación de Vivienda (%/año)", rentingGroup:"Alquilar", monthlyRent:"Renta Mensual", rentGrowth:"Crecimiento Anual de Renta (%)", investmentReturn:"Retorno de Inversión (%/año)", timeframeGroup:"Plazo", comparisonYears:"Años a Comparar", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora de Alquilar vs Comprar", emptyDesc:"Compara el impacto en el patrimonio neto a largo plazo de alquilar versus comprar.", tip1:"Patrimonio al Comprar", tip2:"Patrimonio al Alquilar", tip3:"Año de Equilibrio", betterOption:"Mejor Opción", buyNetWorth:"Patrimonio Neto al Comprar", rentNetWorth:"Patrimonio Neto al Alquilar", breakEven:"Año de Equilibrio", buying:"Comprar", renting:"Alquilar", beyondRange:"Fuera del rango", yearPrefix:"Año", overYears:"Durante", years:"años", aboutTitle:"Acerca de esta Calculadora", aboutText:"Compara el patrimonio neto proyectado de comprar una vivienda versus alquilar e invertir la diferencia, considerando el capital, la apreciación, los costos de propiedad y el crecimiento de la inversión durante el plazo elegido." },
}[lang];
---
<section class="rvb-calculator">
  <div class="rvb-layout">
    <aside class="rvb-sidebar">
      <div class="rvb-group">
        <h3>{copy.buyingGroup}</h3>
        <CalculatorField id="homePrice" label={copy.homePrice} type="number" placeholder="e.g. 350000" min="0" step="1" />
        <CalculatorField id="downPaymentPercent" label={copy.downPayment} type="number" placeholder="e.g. 20" min="0" step="0.1" />
        <CalculatorField id="mortgageRate" label={copy.mortgageRate} type="number" placeholder="e.g. 6.5" min="0" step="0.01" />
        <CalculatorField id="loanTermYears" label={copy.loanTerm} type="number" placeholder="e.g. 30" min="1" step="1" />
      </div>
      <div class="rvb-group">
        <h3>{copy.ownershipGroup}</h3>
        <CalculatorField id="propertyTaxRate" label={copy.propertyTax} type="number" placeholder="e.g. 1.1" min="0" step="0.01" />
        <CalculatorField id="annualInsurance" label={copy.insurance} type="number" placeholder="e.g. 1400" min="0" step="1" />
        <CalculatorField id="maintenanceRate" label={copy.maintenance} type="number" placeholder="e.g. 1" min="0" step="0.1" />
        <CalculatorField id="closingCostPercent" label={copy.closingCost} type="number" placeholder="e.g. 3" min="0" step="0.1" />
        <CalculatorField id="sellingCostPercent" label={copy.sellingCost} type="number" placeholder="e.g. 7" min="0" step="0.1" />
        <CalculatorField id="appreciationRate" label={copy.appreciation} type="number" placeholder="e.g. 3.5" min="0" step="0.1" />
      </div>
      <div class="rvb-group">
        <h3>{copy.rentingGroup}</h3>
        <CalculatorField id="monthlyRent" label={copy.monthlyRent} type="number" placeholder="e.g. 1800" min="0" step="1" />
        <CalculatorField id="rentGrowthRate" label={copy.rentGrowth} type="number" placeholder="e.g. 3" min="0" step="0.1" />
        <CalculatorField id="investmentReturnRate" label={copy.investmentReturn} type="number" placeholder="e.g. 6" min="0" step="0.1" />
      </div>
      <div class="rvb-group">
        <h3>{copy.timeframeGroup}</h3>
        <CalculatorField id="comparisonYears" label={copy.comparisonYears} type="number" placeholder="e.g. 10" min="1" step="1" />
      </div>
      <CalculatorActions calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} calculateText={copy.calculate} resetText={copy.reset} copyText={copy.copy} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="rvb-content">
      <div id="emptyState">
        <EmptyState icon="⚖️" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="betterOptionResult" title={copy.betterOption} icon={Scale} accent="success" subtitle=" " />
          <ResultCard id="buyNetWorthResult" title={copy.buyNetWorth} icon={Home} />
          <ResultCard id="rentNetWorthResult" title={copy.rentNetWorth} icon={Key} />
          <ResultCard id="breakEvenResult" title={copy.breakEven} icon={Calendar} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/rent-vs-buy-calculator";
</script>
<style>
.rvb-calculator{width:100%;}
.rvb-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.rvb-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.rvb-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.rvb-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.rvb-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.rvb-layout{grid-template-columns:1fr;}.rvb-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.rvb-layout{gap:24px;}.rvb-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
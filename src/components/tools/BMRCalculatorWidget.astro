---
import CalculatorField from "../calculator/CalculatorField.astro";
import ActionButtons from "../calculator/ActionButtons.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import EmptyState from "../calculator/EmptyState.astro";
import { Flame } from "@lucide/astro";
---

<div class="calculator-widget">
  <div class="calculator-inputs">
    <CalculatorField id="gender" label="Gender" type="select">
      <option value="male">Male</option>
      <option value="female">Female</option>
    </CalculatorField>

    <CalculatorField id="age" label="Age" type="number" placeholder="e.g. 28" />
    <CalculatorField id="heightCm" label="Height (cm)" type="number" placeholder="e.g. 170" />
    <CalculatorField id="weightKg" label="Weight (kg)" type="number" placeholder="e.g. 65" />

    <div id="errorBox" class="error-box" role="alert" hidden></div>

    <ActionButtons
      calculateId="calculateBtn"
      resetId="resetBtn"
      copyId="copyBtn"
      showDownload={false}
      showShare={false}
    />
  </div>

  <div class="calculator-output">
    <EmptyState
      id="emptyState"
      title="Enter details to calculate BMR"
      description="Your basal metabolic rate will appear here."
    />

    <ResultsGrid id="resultsContainer" hidden>
      <ResultCard id="bmrResult" title="BMR" icon={Flame} accent="primary" size="lg" />
    </ResultsGrid>
  </div>
</div>

<script src="../../scripts/bmr-calculator.ts"></script>

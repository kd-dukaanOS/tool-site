---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { CalendarClock, Percent, Wallet, TrendingDown } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { debt1:"Debt 1", debt2:"Debt 2", debt3:"Debt 3 (optional)", balance:"Balance", apr:"APR (%)", minPayment:"Min. Payment", extraPayment:"Extra Monthly Payment", extraHelp:"Amount beyond all minimums.", strategy:"Strategy", avalancheOpt:"Avalanche (highest APR first)", snowballOpt:"Snowball (smallest balance first)", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"Debt Payoff Calculator", emptyDesc:"Compare the snowball and avalanche methods across all your debts.", tip1:"Payoff Time", tip2:"Total Interest", tip3:"Payoff Order", payoffTime:"Payoff Time", totalInterest:"Total Interest", totalPaid:"Total Paid", methodDifference:"Method Difference", payoffOrderTitle:"Payoff Order", aboutTitle:"About this Calculator", aboutText:"Simulates month-by-month payoff across all your debts, applying minimums to every debt and directing your extra payment to the top debt in the chosen strategy's order. Once a debt is cleared, its payment automatically rolls into the next one." },
  es: { debt1:"Deuda 1", debt2:"Deuda 2", debt3:"Deuda 3 (opcional)", balance:"Saldo", apr:"TAE (%)", minPayment:"Pago Mín.", extraPayment:"Pago Mensual Extra", extraHelp:"Monto por encima de todos los mínimos.", strategy:"Estrategia", avalancheOpt:"Avalancha (mayor TAE primero)", snowballOpt:"Bola de Nieve (menor saldo primero)", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora de Pago de Deudas", emptyDesc:"Compara los métodos bola de nieve y avalancha en todas tus deudas.", tip1:"Tiempo de Pago", tip2:"Interés Total", tip3:"Orden de Pago", payoffTime:"Tiempo de Pago", totalInterest:"Interés Total", totalPaid:"Total Pagado", methodDifference:"Diferencia de Método", payoffOrderTitle:"Orden de Pago", aboutTitle:"Acerca de esta Calculadora", aboutText:"Simula el pago mes a mes de todas tus deudas, aplicando los mínimos a cada deuda y dirigiendo tu pago extra a la deuda principal según el orden de la estrategia elegida. Una vez que se salda una deuda, su pago pasa automáticamente a la siguiente." },
}[lang];
---
<section class="dpo-calculator">
  <div class="dpo-layout">
    <aside class="dpo-sidebar">
      <div class="debt-group">
        <h3>{copy.debt1}</h3>
        <CalculatorField id="debt1Balance" label={copy.balance} type="number" placeholder="e.g. 3000" min="0" step="1" />
        <CalculatorField id="debt1Apr" label={copy.apr} type="number" placeholder="e.g. 22" min="0" step="0.01" />
        <CalculatorField id="debt1Min" label={copy.minPayment} type="number" placeholder="e.g. 75" min="0" step="1" />
      </div>
      <div class="debt-group">
        <h3>{copy.debt2}</h3>
        <CalculatorField id="debt2Balance" label={copy.balance} type="number" placeholder="e.g. 8000" min="0" step="1" />
        <CalculatorField id="debt2Apr" label={copy.apr} type="number" placeholder="e.g. 9" min="0" step="0.01" />
        <CalculatorField id="debt2Min" label={copy.minPayment} type="number" placeholder="e.g. 150" min="0" step="1" />
      </div>
      <div class="debt-group">
        <h3>{copy.debt3}</h3>
        <CalculatorField id="debt3Balance" label={copy.balance} type="number" placeholder="e.g. 0" min="0" step="1" />
        <CalculatorField id="debt3Apr" label={copy.apr} type="number" placeholder="e.g. 0" min="0" step="0.01" />
        <CalculatorField id="debt3Min" label={copy.minPayment} type="number" placeholder="e.g. 0" min="0" step="1" />
      </div>
      <CalculatorField id="extraPayment" label={copy.extraPayment} type="number" placeholder="e.g. 200" min="0" step="1" helpText={copy.extraHelp} />
      <div class="field-wrap">
        <label for="strategy">{copy.strategy}</label>
        <select id="strategy">
          <option value="avalanche">{copy.avalancheOpt}</option>
          <option value="snowball">{copy.snowballOpt}</option>
        </select>
      </div>
      <CalculatorActions lang={lang} calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} calculateText={copy.calculate} resetText={copy.reset} copyText={copy.copy} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="dpo-content">
      <div id="emptyState">
        <EmptyState icon="🧾" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="payoffTimeResult" title={copy.payoffTime} icon={CalendarClock} accent="success" />
          <ResultCard id="totalInterestResult" title={copy.totalInterest} icon={Percent} />
          <ResultCard id="totalPaidResult" title={copy.totalPaid} icon={Wallet} />
          <ResultCard id="avalancheSavingsResult" title={copy.methodDifference} icon={TrendingDown} subtitle=" " />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.payoffOrderTitle}</h2>
          <ul id="payoffOrderList" class="payoff-order-list"></ul>
        </section>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/debt-payoff-calculator";
</script>
<style>
.dpo-calculator{width:100%;}
.dpo-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.dpo-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;}
.dpo-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.debt-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.debt-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.field-wrap{display:flex;flex-direction:column;gap:6px;}
.field-wrap label{font-size:.85rem;font-weight:600;color:var(--text-primary);}
.field-wrap select{padding:10px 12px;border-radius:10px;border:1px solid var(--border-subtle);background:var(--bg-card);color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.payoff-order-list{margin:0;padding-left:20px;line-height:1.9;font-size:.92rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.dpo-layout{grid-template-columns:1fr;}.dpo-sidebar{position:static;}}
@media(max-width:768px){.dpo-layout{gap:24px;}.dpo-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
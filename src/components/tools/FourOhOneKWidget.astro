---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { PiggyBank, Wallet, Users, TrendingUp } from "@lucide/astro";
---
<section class="fk-calculator">
  <div class="fk-layout">
    <aside class="fk-sidebar">
      <div class="fk-group">
        <h3>You</h3>
        <CalculatorField id="currentAge" label="Current Age" type="number" placeholder="e.g. 30" min="1" step="1" />
        <CalculatorField id="retirementAge" label="Retirement Age" type="number" placeholder="e.g. 65" min="1" step="1" />
        <CalculatorField id="currentBalance" label="Current 401(k) Balance" type="number" placeholder="e.g. 25000" min="0" step="1" />
        <CalculatorField id="annualSalary" label="Annual Salary" type="number" placeholder="e.g. 75000" min="0" step="1" />
      </div>
      <div class="fk-group">
        <h3>Contributions</h3>
        <CalculatorField id="contributionPercent" label="Your Contribution (%)" type="number" placeholder="e.g. 8" min="0" step="0.1" />
        <CalculatorField id="employerMatchPercent" label="Employer Match (%)" type="number" placeholder="e.g. 50" min="0" step="1" />
        <CalculatorField id="employerMatchLimit" label="Match Limit (% of salary)" type="number" placeholder="e.g. 6" min="0" step="0.1" />
      </div>
      <div class="fk-group">
        <h3>Growth Assumptions</h3>
        <CalculatorField id="salaryGrowthRate" label="Annual Salary Growth (%)" type="number" placeholder="e.g. 3" min="0" step="0.1" />
        <CalculatorField id="expectedReturn" label="Expected Annual Return (%)" type="number" placeholder="e.g. 7" min="0" step="0.1" />
      </div>
      <CalculatorActions calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="fk-content">
      <div id="emptyState">
        <EmptyState icon="🏦" title="401(k) Calculator" description="Project your 401(k) balance at retirement with employer match and compound growth." tips={["Projected Balance", "Employer Match", "Investment Growth"]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="projectedBalanceResult" title="Projected Balance" icon={PiggyBank} accent="success" subtitle=" " />
          <ResultCard id="employeeContributionsResult" title="Your Contributions" icon={Wallet} />
          <ResultCard id="employerMatchResult" title="Employer Match" icon={Users} />
          <ResultCard id="totalGrowthResult" title="Investment Growth" icon={TrendingUp} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>About this Calculator</h2>
          <p>Projects your 401(k) balance at retirement using your current balance, salary, contribution rate, employer match, salary growth, and expected annual return, compounded year by year.</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script>
  import "../../scripts/401k-calculator";
</script>
<style>
.fk-calculator{width:100%;}
.fk-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.fk-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;}
.fk-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.fk-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.fk-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.fk-layout{grid-template-columns:1fr;}.fk-sidebar{position:static;}}
@media(max-width:768px){.fk-layout{gap:24px;}.fk-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
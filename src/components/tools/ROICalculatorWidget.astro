---
import CalculatorField from "../calculator/CalculatorField.astro";
import ActionButtons from "../calculator/ActionButtons.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import EmptyState from "../calculator/EmptyState.astro";
import CurrencySelector from "../calculator/CurrencySelector.astro";
import { Wallet, Percent, TrendingUp } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { invested:"Invested Amount", currentValue:"Current Value", years:"Time Period (Years, optional)", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"Enter values to calculate ROI", emptyDesc:"Your return on investment will appear here.", netProfit:"Net Profit", roi:"ROI", annualized:"Annualized ROI", perYear:"per year", addTime:"add time period" },
  es: { invested:"Monto Invertido", currentValue:"Valor Actual", years:"Período de Tiempo (Años, opcional)", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Ingresa valores para calcular el ROI", emptyDesc:"Tu retorno de inversión aparecerá aquí.", netProfit:"Ganancia Neta", roi:"ROI", annualized:"ROI Anualizado", perYear:"por año", addTime:"agrega un período de tiempo" },
}[lang];
---

<div class="calculator-widget">
  <div class="calculator-inputs">
    <CurrencySelector />
    <CalculatorField id="investedAmount" label={copy.invested} type="number" placeholder="e.g. 50000" />
    <CalculatorField id="currentValue" label={copy.currentValue} type="number" placeholder="e.g. 75000" />
    <CalculatorField id="years" label={copy.years} type="number" placeholder="e.g. 3" />

    <div id="errorBox" class="error-box" role="alert" hidden></div>

    <ActionButtons lang={lang}
      calculateId="calculateBtn"
      resetId="resetBtn"
      copyId="copyBtn"
      showDownload={false}
      showShare={false}
      calculateText={copy.calculate}
      resetText={copy.reset}
      copyText={copy.copy}
    />
  </div>

  <div class="calculator-output">
    <EmptyState
      id="emptyState"
      title={copy.emptyTitle}
      description={copy.emptyDesc}
    />

    <ResultsGrid id="resultsContainer" hidden>
      <ResultCard id="netProfitResult" title={copy.netProfit} icon={Wallet} accent="success" size="lg" />
      <ResultCard id="roiPercentResult" title={copy.roi} icon={Percent} accent="primary" />
      <ResultCard id="annualizedResult" title={copy.annualized} icon={TrendingUp} accent="neutral" />
    </ResultsGrid>
  </div>
</div>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script src="../../scripts/roi-calculator.ts"></script>

---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Snowflake, Calendar, Receipt, ListOrdered } from "@lucide/astro";
---
<section class="dsb-calculator">
  <div class="dsb-layout">
    <aside class="dsb-sidebar">
      <div class="dsb-group">
        <h3>Your Debts</h3>
        <div id="debtList" class="debt-list"></div>
        <button type="button" id="addDebtBtn" class="add-debt-btn">+ Add Debt</button>
      </div>
      <div class="dsb-group">
        <h3>Extra Payment</h3>
        <CalculatorField id="extraMonthlyPayment" label="Extra Monthly Payment" type="number" placeholder="e.g. 150" min="0" step="1" />
      </div>
      <CalculatorActions calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="dsb-content">
      <div id="emptyState">
        <EmptyState icon="⛄" title="Debt Snowball Calculator" description="Pay off debt smallest-balance-first and see your timeline." tips={["Debt-Free Timeline", "Total Interest", "Payoff Order"]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="totalMonthsResult" title="Debt-Free In" icon={Calendar} accent="success" subtitle=" " />
          <ResultCard id="totalInterestResult" title="Total Interest" icon={Receipt} />
          <ResultCard id="totalPaidResult" title="Total Paid" icon={Snowflake} />
          <ResultCard id="debtCountResult" title="Debts" icon={ListOrdered} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>Payoff Order</h2>
          <table class="order-table">
            <thead><tr><th>Debt</th><th>Paid Off In</th><th>Interest Paid</th></tr></thead>
            <tbody id="orderBody"></tbody>
          </table>
        </section>
      </div>
    </main>
  </div>
</section>
<script>
  import "../../scripts/debt-snowball-calculator";
</script>
<style>
.dsb-calculator{width:100%;}
.dsb-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.dsb-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.dsb-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.dsb-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.dsb-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.debt-list{display:flex;flex-direction:column;gap:8px;}
.debt-row{display:grid;grid-template-columns:1fr 1fr;gap:6px;padding:10px;border:1px solid var(--border-subtle);border-radius:10px;position:relative;}
.debt-row input{padding:6px 8px;border:1px solid var(--border-subtle);border-radius:8px;font-size:.85rem;background:var(--bg-primary,#fff);color:var(--text-primary);}
.debt-row .debt-name{grid-column:1 / -1;}
.debt-remove{position:absolute;top:4px;right:4px;background:none;border:none;font-size:1rem;cursor:pointer;color:var(--text-secondary);line-height:1;}
.add-debt-btn{padding:8px 12px;border:1px dashed var(--border-subtle);border-radius:10px;background:none;cursor:pointer;font-size:.85rem;color:var(--text-primary);font-weight:600;}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.order-table{width:100%;border-collapse:collapse;font-size:.9rem;}
.order-table th{text-align:left;padding:8px 12px;border-bottom:2px solid var(--border-subtle);color:var(--text-secondary);font-weight:600;}
.order-table td{padding:8px 12px;border-bottom:1px solid var(--border-subtle);color:var(--text-primary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.dsb-layout{grid-template-columns:1fr;}.dsb-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.dsb-layout{gap:24px;}.dsb-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
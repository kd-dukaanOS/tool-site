---
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Type, Hash, AlignLeft, BookOpen, Mic, Ruler } from "@lucide/astro";
---
<section class="word-counter">
  <div class="wc-layout">
    <aside class="wc-sidebar">
      <div class="tool-field">
        <label class="tool-label" for="wcInput">Text</label>
        <textarea id="wcInput" class="tool-textarea" placeholder="Paste or type your text here..."></textarea>
      </div>

      <CalculatorActions calculateId="analyzeBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>

    <main class="wc-content">
      <div id="emptyState">
        <EmptyState
          icon="📊"
          title="Word Counter"
          description="Count words, characters, sentences and estimate reading time."
          tips={["Live Word Count", "Reading & Speaking Time", "Sentence & Paragraph Count", "Copy Summary"]}
        />
      </div>

      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="wordsResult" title="Words" icon={Type} />
          <ResultCard id="charactersResult" title="Characters" icon={Hash} />
          <ResultCard id="noSpacesResult" title="No Spaces" icon={Hash} />
          <ResultCard id="sentencesResult" title="Sentences" icon={AlignLeft} />
          <ResultCard id="paragraphsResult" title="Paragraphs" icon={AlignLeft} />
          <ResultCard id="avgWordLengthResult" title="Avg Word Length" icon={Ruler} />
          <ResultCard id="readingTimeResult" title="Reading Time" icon={BookOpen} />
          <ResultCard id="speakingTimeResult" title="Speaking Time" icon={Mic} />
        </ResultsGrid>

        <section class="calculator-info">
          <h2>About this Tool</h2>
          <p>Count words, characters, sentences and paragraphs, with estimated reading and speaking time — updates live as you type.</p>
        </section>
      </div>
    </main>
  </div>
</section>

<script>
  import "../../scripts/word-counter";
</script>

<style>
.word-counter{width:100%;}
.wc-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.wc-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;}
.tool-field{display:flex;flex-direction:column;gap:8px;}
.wc-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.wc-layout{grid-template-columns:1fr;}.wc-sidebar{position:static;}}
</style>

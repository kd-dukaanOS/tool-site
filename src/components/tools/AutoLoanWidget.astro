---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Car, Wallet, TrendingDown, Receipt } from "@lucide/astro";

interface Props {
  lang?: "en" | "es";
}
const { lang = "en" } = Astro.props as Props;

const copy = {
  en: {
    groupVehicle: "Vehicle & Payment", vehiclePrice: "Vehicle Price", downPayment: "Down Payment", tradeInValue: "Trade-In Value",
    groupTerms: "Loan Terms", salesTaxRate: "Sales Tax Rate (%)", apr: "Interest Rate / APR (%)", termMonths: "Loan Term (months)",
    emptyTitle: "Auto Loan Calculator", emptyDesc: "Enter vehicle price and loan terms to see your monthly payment.",
    tips: ["Monthly Payment", "Total Interest", "Total Cost"],
    monthlyPayment: "Monthly Payment", loanAmount: "Loan Amount", totalInterest: "Total Interest", totalCost: "Total Cost",
    aboutTitle: "About this Calculator",
    aboutText: "Calculates your monthly car payment from vehicle price, down payment, trade-in value, sales tax, interest rate, and loan term, along with total interest and total cost over the loan.",
  },
  es: {
    groupVehicle: "Vehículo y Pago", vehiclePrice: "Precio del Vehículo", downPayment: "Enganche", tradeInValue: "Entrega a Cuenta",
    groupTerms: "Términos del Préstamo", salesTaxRate: "Tasa de Impuesto sobre Venta (%)", apr: "Tasa de Interés / APR (%)", termMonths: "Plazo del Préstamo (meses)",
    emptyTitle: "Calculadora de Préstamo de Auto", emptyDesc: "Ingresa el precio del vehículo y los términos del préstamo para ver tu pago mensual.",
    tips: ["Pago Mensual", "Interés Total", "Costo Total"],
    monthlyPayment: "Pago Mensual", loanAmount: "Monto del Préstamo", totalInterest: "Interés Total", totalCost: "Costo Total",
    aboutTitle: "Acerca de esta Calculadora",
    aboutText: "Calcula tu pago mensual del auto a partir del precio del vehículo, enganche, valor de entrega a cuenta, impuesto sobre venta, tasa de interés y plazo del préstamo, junto con el interés total y el costo total del préstamo.",
  },
}[lang];
---
<section class="al-calculator">
  <div class="al-layout">
    <aside class="al-sidebar">
      <div class="al-group">
        <h3>{copy.groupVehicle}</h3>
        <CalculatorField id="vehiclePrice" label={copy.vehiclePrice} type="number" placeholder="e.g. 32000" min="0" step="1" />
        <CalculatorField id="downPayment" label={copy.downPayment} type="number" placeholder="e.g. 4000" min="0" step="1" />
        <CalculatorField id="tradeInValue" label={copy.tradeInValue} type="number" placeholder="e.g. 2000" min="0" step="1" />
      </div>
      <div class="al-group">
        <h3>{copy.groupTerms}</h3>
        <CalculatorField id="salesTaxRate" label={copy.salesTaxRate} type="number" placeholder="e.g. 7" min="0" step="0.01" />
        <CalculatorField id="apr" label={copy.apr} type="number" placeholder="e.g. 6.5" min="0" step="0.01" />
        <CalculatorField id="termMonths" label={copy.termMonths} type="number" placeholder="e.g. 60" min="1" step="1" />
      </div>
      <CalculatorActions lang={lang} calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="al-content">
      <div id="emptyState">
        <EmptyState icon="🚗" title={copy.emptyTitle} description={copy.emptyDesc} tips={copy.tips} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="monthlyPaymentResult" title={copy.monthlyPayment} icon={Car} accent="success" subtitle=" " />
          <ResultCard id="loanAmountResult" title={copy.loanAmount} icon={Wallet} />
          <ResultCard id="totalInterestResult" title={copy.totalInterest} icon={TrendingDown} />
          <ResultCard id="totalCostResult" title={copy.totalCost} icon={Receipt} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/auto-loan-calculator";
</script>
<style>
.al-calculator{width:100%;}
.al-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.al-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;}
.al-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.al-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.al-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.al-layout{grid-template-columns:1fr;}.al-sidebar{position:static;}}
@media(max-width:768px){.al-layout{gap:24px;}.al-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
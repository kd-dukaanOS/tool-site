---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Repeat, TrendingUp, CalendarClock, TrendingDown } from "@lucide/astro";
---
<section class="mrr-calculator">
  <div class="mrr-layout">
    <aside class="mrr-sidebar">
      <div class="mrr-group">
        <h3>Starting Point</h3>
        <CalculatorField id="existingMrr" label="Existing MRR (start of month)" type="number" placeholder="e.g. 50000" min="0" step="1" />
      </div>
      <div class="mrr-group">
        <h3>Movement This Month</h3>
        <CalculatorField id="newCustomerMrr" label="New Customer MRR" type="number" placeholder="e.g. 8000" min="0" step="1" />
        <CalculatorField id="expansionMrr" label="Expansion MRR (upgrades)" type="number" placeholder="e.g. 3000" min="0" step="1" />
        <CalculatorField id="churnedMrr" label="Churned MRR (lost customers)" type="number" placeholder="e.g. 2000" min="0" step="1" />
        <CalculatorField id="contractionMrr" label="Contraction MRR (downgrades)" type="number" placeholder="e.g. 1000" min="0" step="1" />
      </div>
      <CalculatorActions calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="mrr-content">
      <div id="emptyState">
        <EmptyState icon="🔁" title="MRR Calculator" description="Track your Monthly Recurring Revenue movement and projected ARR." tips={["Total MRR", "Net New MRR", "Projected ARR"]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="totalMrrResult" title="Total MRR" icon={Repeat} accent="success" subtitle=" " />
          <ResultCard id="netNewMrrResult" title="Net New MRR" icon={TrendingUp} />
          <ResultCard id="arrResult" title="Projected ARR" icon={CalendarClock} />
          <ResultCard id="churnedMrrResult" title="Churned + Contraction" icon={TrendingDown} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>About this Calculator</h2>
          <p>Breaks down your Monthly Recurring Revenue movement — new, expansion, churned, and contraction MRR — to find your net new MRR, updated total MRR, and projected Annual Recurring Revenue.</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script>
  import "../../scripts/mrr-calculator";
</script>
<style>
.mrr-calculator{width:100%;}
.mrr-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.mrr-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.mrr-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.mrr-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.mrr-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.mrr-layout{grid-template-columns:1fr;}.mrr-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.mrr-layout{gap:24px;}.mrr-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
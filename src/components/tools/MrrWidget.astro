---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Repeat, TrendingUp, CalendarClock, TrendingDown } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { startGroup:"Starting Point", existingMrr:"Existing MRR (start of month)", moveGroup:"Movement This Month", newCustomerMrr:"New Customer MRR", expansionMrr:"Expansion MRR (upgrades)", churnedMrr:"Churned MRR (lost customers)", contractionMrr:"Contraction MRR (downgrades)", emptyTitle:"MRR Calculator", emptyDesc:"Track your Monthly Recurring Revenue movement and projected ARR.", tip1:"Total MRR", tip2:"Net New MRR", tip3:"Projected ARR", totalMrr:"Total MRR", netNewMrr:"Net New MRR", arr:"Projected ARR", churnedContraction:"Churned + Contraction", growing:"Growing", shrinking:"Shrinking", aboutTitle:"About this Calculator", aboutText:"Breaks down your Monthly Recurring Revenue movement — new, expansion, churned, and contraction MRR — to find your net new MRR, updated total MRR, and projected Annual Recurring Revenue." },
  es: { startGroup:"Punto de Partida", existingMrr:"MRR Existente (inicio de mes)", moveGroup:"Movimiento de Este Mes", newCustomerMrr:"MRR de Nuevos Clientes", expansionMrr:"MRR de Expansión (mejoras)", churnedMrr:"MRR Perdido (clientes cancelados)", contractionMrr:"MRR de Contracción (bajas de plan)", emptyTitle:"Calculadora de MRR", emptyDesc:"Rastrea el movimiento de tus Ingresos Recurrentes Mensuales y el ARR proyectado.", tip1:"MRR Total", tip2:"MRR Neto Nuevo", tip3:"ARR Proyectado", totalMrr:"MRR Total", netNewMrr:"MRR Neto Nuevo", arr:"ARR Proyectado", churnedContraction:"Perdido + Contracción", growing:"Creciendo", shrinking:"Disminuyendo", aboutTitle:"Acerca de esta Calculadora", aboutText:"Desglosa el movimiento de tus Ingresos Recurrentes Mensuales — nuevo, expansión, perdido y contracción — para encontrar tu MRR neto nuevo, el MRR total actualizado y los Ingresos Recurrentes Anuales proyectados." },
}[lang];
---
<section class="mrr-calculator">
  <div class="mrr-layout">
    <aside class="mrr-sidebar">
      <div class="mrr-group">
        <h3>{copy.startGroup}</h3>
        <CalculatorField id="existingMrr" label={copy.existingMrr} type="number" placeholder="e.g. 50000" min="0" step="1" />
      </div>
      <div class="mrr-group">
        <h3>{copy.moveGroup}</h3>
        <CalculatorField id="newCustomerMrr" label={copy.newCustomerMrr} type="number" placeholder="e.g. 8000" min="0" step="1" />
        <CalculatorField id="expansionMrr" label={copy.expansionMrr} type="number" placeholder="e.g. 3000" min="0" step="1" />
        <CalculatorField id="churnedMrr" label={copy.churnedMrr} type="number" placeholder="e.g. 2000" min="0" step="1" />
        <CalculatorField id="contractionMrr" label={copy.contractionMrr} type="number" placeholder="e.g. 1000" min="0" step="1" />
      </div>
      <CalculatorActions lang={lang} calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="mrr-content">
      <div id="emptyState">
        <EmptyState icon="🔁" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="totalMrrResult" title={copy.totalMrr} icon={Repeat} accent="success" subtitle=" " />
          <ResultCard id="netNewMrrResult" title={copy.netNewMrr} icon={TrendingUp} />
          <ResultCard id="arrResult" title={copy.arr} icon={CalendarClock} />
          <ResultCard id="churnedMrrResult" title={copy.churnedContraction} icon={TrendingDown} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/mrr-calculator";
</script>
<style>
.mrr-calculator{width:100%;}
.mrr-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.mrr-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.mrr-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.mrr-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.mrr-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.mrr-layout{grid-template-columns:1fr;}.mrr-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.mrr-layout{gap:24px;}.mrr-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
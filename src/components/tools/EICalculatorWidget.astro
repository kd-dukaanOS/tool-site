---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { ShieldCheck, Users, Building2, Coins } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { grossIncome:"Gross Annual Income", grossIncomeHelp:"Your gross annual income (CAD).", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"EI Calculator", emptyDesc:"Estimate your Employment Insurance premium.", tip1:"Insurable Earnings", tip2:"Employee Portion", tip3:"Employer Portion", insurable:"Insurable Earnings", employee:"Employee Premium", employer:"Employer Premium", total:"Total Premium", aboutTitle:"About this Calculator", aboutText:"Estimates your EI premium capped at maximum insurable earnings. Quebec uses a separate rate not covered here. Verify against current federal figures." },
  es: { grossIncome:"Ingreso Bruto Anual", grossIncomeHelp:"Tu ingreso bruto anual (CAD).", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora de EI", emptyDesc:"Estima tu prima del Seguro de Empleo.", tip1:"Ingresos Asegurables", tip2:"Parte del Empleado", tip3:"Parte del Empleador", insurable:"Ingresos Asegurables", employee:"Prima del Empleado", employer:"Prima del Empleador", total:"Prima Total", aboutTitle:"Acerca de esta Calculadora", aboutText:"Estima tu prima de EI limitada a los ingresos asegurables máximos. Quebec usa una tasa separada no cubierta aquí. Verifica con las cifras federales actuales." },
}[lang];
---
<section class="ei-calculator">
  <div class="ei-layout">
    <aside class="ei-sidebar">
      <CalculatorField id="grossIncome" label={copy.grossIncome} type="number" required={true} helpText={copy.grossIncomeHelp} />
      <CalculatorActions calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} calculateText={copy.calculate} resetText={copy.reset} copyText={copy.copy} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="ei-content">
      <div id="emptyState">
        <EmptyState icon="🛡️" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={2}>
          <ResultCard id="insurableResult" title={copy.insurable} icon={ShieldCheck} />
          <ResultCard id="employeeResult" title={copy.employee} icon={Users} subtitle=" " />
          <ResultCard id="employerResult" title={copy.employer} icon={Building2} />
          <ResultCard id="totalResult" title={copy.total} icon={Coins} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/ca-ei-calculator";
</script>
<style>
.ei-calculator{width:100%;}
.ei-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.ei-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;}
.ei-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.ei-layout{grid-template-columns:1fr;}.ei-sidebar{position:static;}}
@media(max-width:768px){.ei-layout{gap:24px;}.ei-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
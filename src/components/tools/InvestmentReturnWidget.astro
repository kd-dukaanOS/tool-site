---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { TrendingUp, DollarSign, Percent, PiggyBank } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { groupTitle:"Investment", initial:"Initial Investment ($)", monthly:"Monthly Contribution ($)", years:"Years Invested", ending:"Ending Value ($)", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"Investment Return Calculator", emptyDesc:"Find your total gain and true annualized return, including contributions.", tip1:"Annualized Return", tip2:"Total Gain", tip3:"Total Return %", annualizedReturn:"Annualized Return", totalGain:"Total Gain", totalReturnPct:"Total Return", totalContributed:"Total Contributed", aboutTitle:"About this Calculator", aboutText:"Solves for your true annualized return (CAGR-equivalent) by reconciling your initial investment, contribution schedule, and ending balance — the correct way to compare performance across investments." },
  es: { groupTitle:"Inversión", initial:"Inversión Inicial ($)", monthly:"Aporte Mensual ($)", years:"Años Invertidos", ending:"Valor Final ($)", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora de Retorno de Inversión", emptyDesc:"Encuentra tu ganancia total y el retorno anualizado real, incluyendo aportes.", tip1:"Retorno Anualizado", tip2:"Ganancia Total", tip3:"Retorno Total %", annualizedReturn:"Retorno Anualizado", totalGain:"Ganancia Total", totalReturnPct:"Retorno Total", totalContributed:"Total Aportado", aboutTitle:"Acerca de esta Calculadora", aboutText:"Calcula tu retorno anualizado real (equivalente a CAGR) conciliando tu inversión inicial, calendario de aportes y saldo final — la forma correcta de comparar el rendimiento entre inversiones." },
}[lang];
---
<section class="irc-calculator">
  <div class="irc-layout">
    <aside class="irc-sidebar">
      <div class="irc-group">
        <h3>{copy.groupTitle}</h3>
        <CalculatorField id="initialInvestment" label={copy.initial} type="number" placeholder="e.g. 10000" min="0" step="1" />
        <CalculatorField id="monthlyContribution" label={copy.monthly} type="number" placeholder="e.g. 200" min="0" step="1" />
        <CalculatorField id="years" label={copy.years} type="number" placeholder="e.g. 10" min="0.1" step="0.1" />
        <CalculatorField id="endingValue" label={copy.ending} type="number" placeholder="e.g. 60000" min="0" step="1" />
      </div>
      <CalculatorActions lang={lang} calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} calculateText={copy.calculate} resetText={copy.reset} copyText={copy.copy} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="irc-content">
      <div id="emptyState">
        <EmptyState icon="📈" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="annualizedReturnResult" title={copy.annualizedReturn} icon={TrendingUp} accent="success" subtitle=" " />
          <ResultCard id="totalGainResult" title={copy.totalGain} icon={DollarSign} />
          <ResultCard id="totalReturnPercentResult" title={copy.totalReturnPct} icon={Percent} />
          <ResultCard id="totalContributedResult" title={copy.totalContributed} icon={PiggyBank} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/investment-return-calculator";
</script>
<style>
.irc-calculator{width:100%;}
.irc-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.irc-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.irc-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.irc-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.irc-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.irc-layout{grid-template-columns:1fr;}.irc-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.irc-layout{gap:24px;}.irc-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
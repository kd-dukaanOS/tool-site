---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { TrendingUp, DollarSign, Percent, PiggyBank } from "@lucide/astro";
---
<section class="irc-calculator">
  <div class="irc-layout">
    <aside class="irc-sidebar">
      <div class="irc-group">
        <h3>Investment</h3>
        <CalculatorField id="initialInvestment" label="Initial Investment ($)" type="number" placeholder="e.g. 10000" min="0" step="1" />
        <CalculatorField id="monthlyContribution" label="Monthly Contribution ($)" type="number" placeholder="e.g. 200" min="0" step="1" />
        <CalculatorField id="years" label="Years Invested" type="number" placeholder="e.g. 10" min="0.1" step="0.1" />
        <CalculatorField id="endingValue" label="Ending Value ($)" type="number" placeholder="e.g. 60000" min="0" step="1" />
      </div>
      <CalculatorActions calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="irc-content">
      <div id="emptyState">
        <EmptyState icon="📈" title="Investment Return Calculator" description="Find your total gain and true annualized return, including contributions." tips={["Annualized Return", "Total Gain", "Total Return %"]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="annualizedReturnResult" title="Annualized Return" icon={TrendingUp} accent="success" subtitle=" " />
          <ResultCard id="totalGainResult" title="Total Gain" icon={DollarSign} />
          <ResultCard id="totalReturnPercentResult" title="Total Return" icon={Percent} />
          <ResultCard id="totalContributedResult" title="Total Contributed" icon={PiggyBank} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>About this Calculator</h2>
          <p>Solves for your true annualized return (CAGR-equivalent) by reconciling your initial investment, contribution schedule, and ending balance — the correct way to compare performance across investments.</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script>
  import "../../scripts/investment-return-calculator";
</script>
<style>
.irc-calculator{width:100%;}
.irc-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.irc-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.irc-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.irc-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.irc-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.irc-layout{grid-template-columns:1fr;}.irc-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.irc-layout{gap:24px;}.irc-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
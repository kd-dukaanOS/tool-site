---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Wallet, Percent, FileText, Receipt } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { incomeGroup:"Income", filingStatus:"Filing Status", single:"Single or Married Filing Separately", married:"Married Filing Jointly", hoh:"Head of Household", grossIncome:"Annual Gross Income", otherIncome:"Other Income (annual)", adjustments:"Adjustments (annual)", deductionsGroup:"Deductions & Credits", itemized:"Itemized Deductions (0 if standard)", credits:"Tax Credits (annual)", paymentsGroup:"Payments Made", withheld:"Federal Tax Withheld (annual)", estimated:"Estimated Payments (annual)", emptyTitle:"Tax Refund Calculator", emptyDesc:"Estimate your federal tax refund or amount owed.", tip1:"Refund or Owed", tip2:"Tax Liability", tip3:"Taxable Income", refundOwed:"Refund / Owed", taxLiability:"Tax Liability", taxableIncome:"Taxable Income", effectiveRate:"Effective Tax Rate", estRefund:"Estimated Refund", estOwed:"Estimated Amount Owed", aboutTitle:"About this Calculator", aboutText:"Estimates your federal tax refund or balance due by comparing your calculated tax liability against total withholding and estimated payments made during the year." },
  es: { incomeGroup:"Ingresos", filingStatus:"Estado Civil Tributario", single:"Soltero o Casado Declarando por Separado", married:"Casado Declarando en Conjunto", hoh:"Cabeza de Familia", grossIncome:"Ingreso Bruto Anual", otherIncome:"Otros Ingresos (anual)", adjustments:"Ajustes (anual)", deductionsGroup:"Deducciones y Créditos", itemized:"Deducciones Detalladas (0 si es estándar)", credits:"Créditos Fiscales (anual)", paymentsGroup:"Pagos Realizados", withheld:"Impuesto Federal Retenido (anual)", estimated:"Pagos Estimados (anual)", emptyTitle:"Calculadora de Reembolso de Impuestos", emptyDesc:"Calcula tu reembolso de impuestos federal estimado o el monto adeudado.", tip1:"Reembolso o Adeudado", tip2:"Obligación Fiscal", tip3:"Ingreso Gravable", refundOwed:"Reembolso / Adeudado", taxLiability:"Obligación Fiscal", taxableIncome:"Ingreso Gravable", effectiveRate:"Tasa Impositiva Efectiva", estRefund:"Reembolso Estimado", estOwed:"Monto Adeudado Estimado", aboutTitle:"Acerca de esta Calculadora", aboutText:"Calcula tu reembolso de impuestos federal estimado o saldo adeudado comparando tu obligación fiscal calculada con la retención total y los pagos estimados realizados durante el año." },
}[lang];
---
<section class="trf-calculator">
  <div class="trf-layout">
    <aside class="trf-sidebar">
      <div class="trf-group">
        <h3>{copy.incomeGroup}</h3>
        <CalculatorField id="filingStatus" label={copy.filingStatus} type="select">
          <option value="single">{copy.single}</option>
          <option value="married">{copy.married}</option>
          <option value="headOfHousehold">{copy.hoh}</option>
        </CalculatorField>
        <CalculatorField id="annualGrossIncome" label={copy.grossIncome} type="number" placeholder="e.g. 70000" min="0" step="1" />
        <CalculatorField id="otherIncome" label={copy.otherIncome} type="number" placeholder="e.g. 0" min="0" step="1" />
        <CalculatorField id="adjustments" label={copy.adjustments} type="number" placeholder="e.g. 0" min="0" step="1" />
      </div>
      <div class="trf-group">
        <h3>{copy.deductionsGroup}</h3>
        <CalculatorField id="itemizedDeductions" label={copy.itemized} type="number" placeholder="e.g. 0" min="0" step="1" />
        <CalculatorField id="taxCreditsAnnual" label={copy.credits} type="number" placeholder="e.g. 0" min="0" step="1" />
      </div>
      <div class="trf-group">
        <h3>{copy.paymentsGroup}</h3>
        <CalculatorField id="federalTaxWithheldAnnual" label={copy.withheld} type="number" placeholder="e.g. 9500" min="0" step="1" />
        <CalculatorField id="estimatedPaymentsAnnual" label={copy.estimated} type="number" placeholder="e.g. 0" min="0" step="1" />
      </div>
      <CalculatorActions lang={lang} calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="trf-content">
      <div id="emptyState">
        <EmptyState icon="💰" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="refundOrOwedResult" title={copy.refundOwed} icon={Wallet} accent="success" subtitle=" " />
          <ResultCard id="taxLiabilityResult" title={copy.taxLiability} icon={Receipt} />
          <ResultCard id="taxableIncomeResult" title={copy.taxableIncome} icon={FileText} />
          <ResultCard id="effectiveRateResult" title={copy.effectiveRate} icon={Percent} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang, estRefundLabel: copy.estRefund, estOwedLabel: copy.estOwed }}>
  window.calcLang = calcLang;
  window.trfEstRefundLabel = estRefundLabel;
  window.trfEstOwedLabel = estOwedLabel;
</script>
<script>
  import "../../scripts/tax-refund-calculator";
</script>
<style>
.trf-calculator{width:100%;}
.trf-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.trf-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.trf-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.trf-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.trf-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.trf-layout{grid-template-columns:1fr;}.trf-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.trf-layout{gap:24px;}.trf-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
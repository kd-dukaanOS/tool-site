---
import CalculatorField from "../calculator/CalculatorField.astro";
import ActionButtons from "../calculator/ActionButtons.astro";
import ResultCard from "../calculator/ResultCard.astro";
import EmptyState from "../calculator/EmptyState.astro";
import { Ruler } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { value:"Value", from:"From", to:"To", emptyTitle:"Length Converter", emptyDesc:"Enter a value to convert.", converted:"Converted Value" },
  es: { value:"Valor", from:"Desde", to:"Hasta", emptyTitle:"Conversor de Longitud", emptyDesc:"Ingresa un valor para convertir.", converted:"Valor Convertido" },
}[lang];
---

<div class="calculator-widget">
  <div class="calculator-form">
    <CalculatorField id="value" label={copy.value} type="number" placeholder="Enter value" />

    <CalculatorField id="fromUnit" label={copy.from} type="select">
      <option value="mm">Millimeter</option>
      <option value="cm">Centimeter</option>
      <option value="m" selected>Meter</option>
      <option value="km">Kilometer</option>
      <option value="in">Inch</option>
      <option value="ft">Foot</option>
      <option value="yd">Yard</option>
      <option value="mi">Mile</option>
    </CalculatorField>

    <CalculatorField id="toUnit" label={copy.to} type="select">
      <option value="mm">Millimeter</option>
      <option value="cm">Centimeter</option>
      <option value="m">Meter</option>
      <option value="km" selected>Kilometer</option>
      <option value="in">Inch</option>
      <option value="ft">Foot</option>
      <option value="yd">Yard</option>
      <option value="mi">Mile</option>
    </CalculatorField>

    <div id="errorBox" class="error-box" hidden></div>

    <ActionButtons calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" />
  </div>

  <div class="calculator-results">
    <div id="emptyState">
      <EmptyState icon="📏" title={copy.emptyTitle} description={copy.emptyDesc} />
    </div>

    <div id="resultsContainer" hidden>
      <ResultCard id="convertedResult" title={copy.converted} icon={Ruler} />
    </div>
  </div>
</div>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script src="../../scripts/length-calculator.ts"></script>


---
{/* src/components/tools/SalaryToHourlyCalculatorWidget.astro */}
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import CurrencySelector from "../calculator/CurrencySelector.astro";

import { Clock, CalendarDays, Wallet, Sun } from "@lucide/astro";---

<section class="sth-calculator">
  <div class="sth-layout">

   <aside class="sth-sidebar">
      <CurrencySelector />

      <CalculatorField
        id="annualSalary"        label="Annual Salary ($)"
        type="number"
        placeholder="e.g. 52000"
        required={true}
        min="0"
        step="1"
        helpText="Your total yearly salary before tax."
      />

      <CalculatorField
        id="hoursPerWeek"
        label="Hours per Week"
        type="number"
        placeholder="e.g. 40"
        required={true}
        min="1"
        max="168"
        step="1"
        helpText="Typical hours worked each week."
      />

      <CalculatorField
        id="weeksPerYear"
        label="Weeks per Year"
        type="number"
        placeholder="e.g. 52"
        required={true}
        min="1"
        max="52"
        step="1"
        helpText="Weeks worked per year (52 for no unpaid time off)."
      />

      <CalculatorActions
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
      />

      <div id="errorBox" class="error-box" hidden></div>
    </aside>

    <main class="sth-content">
      <div id="emptyState">
        <EmptyState
          icon="🕐"
          title="Salary to Hourly Calculator"
          description="Convert your annual salary into an hourly, daily, weekly and monthly rate."
          tips={["Hourly Rate", "Daily Rate", "Weekly Rate", "Monthly Rate"]}
        />
      </div>

      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="hourlyRateResult" title="Hourly Rate" icon={Clock} accent="success" size="lg" />
          <ResultCard id="dailyRateResult" title="Daily Rate" icon={Sun} accent="primary" />
          <ResultCard id="weeklyRateResult" title="Weekly Rate" icon={CalendarDays} />
          <ResultCard id="monthlyRateResult" title="Monthly Rate" icon={Wallet} />
        </ResultsGrid>

        <section class="calculator-info">
          <h2>About this Calculator</h2>
          <p>
            Converts your annual salary into hourly, daily, weekly and monthly rates based on
            hours worked per week and weeks worked per year. All calculations run locally —
            no external data or paid service is required.
          </p>
        </section>
      </div>
    </main>

  </div>
</section>

<script>
  import "../../scripts/salary-to-hourly-calculator";
</script>

<style>
.sth-calculator{ width:100%; }
.sth-layout{ display:grid; grid-template-columns:340px minmax(0,1fr); gap:32px; align-items:start; }
.sth-sidebar{ position:sticky; top:24px; display:flex; flex-direction:column; gap:20px; }
.sth-content{ display:flex; flex-direction:column; gap:28px; min-width:0; }
.calculator-info{ padding:24px; border:1px solid var(--border-subtle); border-radius:18px; background:var(--bg-card); }
.calculator-info h2{ margin:0 0 12px; font-size:1.15rem; font-weight:700; color:var(--text-primary); }
.calculator-info p{ margin:0; line-height:1.8; font-size:.95rem; color:var(--text-secondary); }
.error-box{ display:flex; align-items:center; padding:14px 16px; border-radius:14px; background:#FEF2F2; border:1px solid #FCA5A5; color:#B91C1C; font-size:.92rem; font-weight:600; }
:global(.dark) .error-box{ background:#2A1111; border-color:#7F1D1D; color:#FECACA; }
@media(max-width:1024px){ .sth-layout{ grid-template-columns:1fr; } .sth-sidebar{ position:static; } }
@media(max-width:768px){ .sth-layout{ gap:24px; } .sth-content{ gap:20px; } }
@media(max-width:640px){ .calculator-info{ padding:18px; } }
</style>

---
{/* src/components/tools/SalaryToHourlyCalculatorWidget.astro */}
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import CurrencySelector from "../calculator/CurrencySelector.astro";

import { Clock, CalendarDays, Wallet, Sun } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { annualSalary:"Annual Salary ($)", annualSalaryHelp:"Your total yearly salary before tax.", hoursPerWeek:"Hours per Week", hoursPerWeekHelp:"Typical hours worked each week.", weeksPerYear:"Weeks per Year", weeksPerYearHelp:"Weeks worked per year (52 for no unpaid time off).", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"Salary to Hourly Calculator", emptyDesc:"Convert your annual salary into an hourly, daily, weekly and monthly rate.", tip1:"Hourly Rate", tip2:"Daily Rate", tip3:"Weekly Rate", tip4:"Monthly Rate", hourlyRate:"Hourly Rate", dailyRate:"Daily Rate", weeklyRate:"Weekly Rate", monthlyRate:"Monthly Rate", aboutTitle:"About this Calculator", aboutText:"Converts your annual salary into hourly, daily, weekly and monthly rates based on hours worked per week and weeks worked per year. All calculations run locally — no external data or paid service is required." },
  es: { annualSalary:"Salario Anual ($)", annualSalaryHelp:"Tu salario total anual antes de impuestos.", hoursPerWeek:"Horas por Semana", hoursPerWeekHelp:"Horas típicas trabajadas cada semana.", weeksPerYear:"Semanas por Año", weeksPerYearHelp:"Semanas trabajadas por año (52 si no hay tiempo libre no pagado).", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora de Salario a Hora", emptyDesc:"Convierte tu salario anual en una tarifa por hora, diaria, semanal y mensual.", tip1:"Tarifa por Hora", tip2:"Tarifa Diaria", tip3:"Tarifa Semanal", tip4:"Tarifa Mensual", hourlyRate:"Tarifa por Hora", dailyRate:"Tarifa Diaria", weeklyRate:"Tarifa Semanal", monthlyRate:"Tarifa Mensual", aboutTitle:"Acerca de esta Calculadora", aboutText:"Convierte tu salario anual en tarifas por hora, diaria, semanal y mensual según las horas trabajadas por semana y las semanas trabajadas por año. Todos los cálculos se ejecutan localmente — no se requieren datos externos ni servicios pagados." },
}[lang];
---

<section class="sth-calculator">
  <div class="sth-layout">

   <aside class="sth-sidebar">
      <CurrencySelector />

      <CalculatorField
        id="annualSalary"
        label={copy.annualSalary}
        type="number"
        placeholder="e.g. 52000"
        required={true}
        min="0"
        step="1"
        helpText={copy.annualSalaryHelp}
      />

      <CalculatorField
        id="hoursPerWeek"
        label={copy.hoursPerWeek}
        type="number"
        placeholder="e.g. 40"
        required={true}
        min="1"
        max="168"
        step="1"
        helpText={copy.hoursPerWeekHelp}
      />

      <CalculatorField
        id="weeksPerYear"
        label={copy.weeksPerYear}
        type="number"
        placeholder="e.g. 52"
        required={true}
        min="1"
        max="52"
        step="1"
        helpText={copy.weeksPerYearHelp}
      />

      <CalculatorActions lang={lang}
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
        calculateText={copy.calculate}
        resetText={copy.reset}
        copyText={copy.copy}
      />

      <div id="errorBox" class="error-box" hidden></div>
    </aside>

    <main class="sth-content">
      <div id="emptyState">
        <EmptyState
          icon="🕐"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={[copy.tip1, copy.tip2, copy.tip3, copy.tip4]}
        />
      </div>

      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="hourlyRateResult" title={copy.hourlyRate} icon={Clock} accent="success" size="lg" />
          <ResultCard id="dailyRateResult" title={copy.dailyRate} icon={Sun} accent="primary" />
          <ResultCard id="weeklyRateResult" title={copy.weeklyRate} icon={CalendarDays} />
          <ResultCard id="monthlyRateResult" title={copy.monthlyRate} icon={Wallet} />
        </ResultsGrid>

        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>

  </div>
</section>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/salary-to-hourly-calculator";
</script>

<style>
.sth-calculator{ width:100%; }
.sth-layout{ display:grid; grid-template-columns:340px minmax(0,1fr); gap:32px; align-items:start; }
.sth-sidebar{ position:sticky; top:24px; display:flex; flex-direction:column; gap:20px; }
.sth-content{ display:flex; flex-direction:column; gap:28px; min-width:0; }
.calculator-info{ padding:24px; border:1px solid var(--border-subtle); border-radius:18px; background:var(--bg-card); }
.calculator-info h2{ margin:0 0 12px; font-size:1.15rem; font-weight:700; color:var(--text-primary); }
.calculator-info p{ margin:0; line-height:1.8; font-size:.95rem; color:var(--text-secondary); }
.error-box{ display:flex; align-items:center; padding:14px 16px; border-radius:14px; background:#FEF2F2; border:1px solid #FCA5A5; color:#B91C1C; font-size:.92rem; font-weight:600; }
:global(.dark) .error-box{ background:#2A1111; border-color:#7F1D1D; color:#FECACA; }
@media(max-width:1024px){ .sth-layout{ grid-template-columns:1fr; } .sth-sidebar{ position:static; } }
@media(max-width:768px){ .sth-layout{ gap:24px; } .sth-content{ gap:20px; } }
@media(max-width:640px){ .calculator-info{ padding:18px; } }
</style>
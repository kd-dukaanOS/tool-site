---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { TrendingDown, Home, Clock, PiggyBank } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { currentLoan:"Current Loan", balance:"Current Loan Balance", currentRate:"Current Interest Rate (%)", months:"Months Remaining", newLoan:"New Loan", newRate:"New Interest Rate (%)", newTerm:"New Loan Term (months)", closingCosts:"Closing Costs", emptyTitle:"Mortgage Refinance Calculator", emptyDesc:"Compare your current and new loan terms to see monthly savings and break-even point.", tip1:"Monthly Savings", tip2:"Break-Even Point", tip3:"Lifetime Savings", monthlySavings:"Monthly Savings", newPayment:"New Payment", breakEven:"Break-Even Point", lifetimeSavings:"Lifetime Interest Savings", aboutTitle:"About this Calculator", aboutText:"Compares your current mortgage payment against a new refinanced loan, factoring in closing costs, to show monthly savings, break-even point, and total interest saved over the life of the loan.", lowerPayment:"Lower payment", higherPayment:"Higher payment", noSavings:"No savings" },
  es: { currentLoan:"Préstamo Actual", balance:"Saldo Actual del Préstamo", currentRate:"Tasa de Interés Actual (%)", months:"Meses Restantes", newLoan:"Nuevo Préstamo", newRate:"Nueva Tasa de Interés (%)", newTerm:"Nuevo Plazo del Préstamo (meses)", closingCosts:"Costos de Cierre", emptyTitle:"Calculadora de Refinanciamiento Hipotecario", emptyDesc:"Compara tu préstamo actual y el nuevo para ver ahorros mensuales y el punto de equilibrio.", tip1:"Ahorro Mensual", tip2:"Punto de Equilibrio", tip3:"Ahorro Total", monthlySavings:"Ahorro Mensual", newPayment:"Nuevo Pago", breakEven:"Punto de Equilibrio", lifetimeSavings:"Ahorro Total de Interés", aboutTitle:"Acerca de esta Calculadora", aboutText:"Compara tu pago hipotecario actual contra un nuevo préstamo refinanciado, considerando los costos de cierre, para mostrar el ahorro mensual, el punto de equilibrio y el interés total ahorrado durante la vida del préstamo.", lowerPayment:"Pago menor", higherPayment:"Pago mayor", noSavings:"Sin ahorros" },
}[lang];
---
<section class="mr-calculator">
  <div class="mr-layout">
    <aside class="mr-sidebar">
      <div class="mr-group">
        <h3>{copy.currentLoan}</h3>
        <CalculatorField id="currentBalance" label={copy.balance} type="number" placeholder="e.g. 300000" min="0" step="1" />
        <CalculatorField id="currentRate" label={copy.currentRate} type="number" placeholder="e.g. 6.5" min="0" step="0.01" />
        <CalculatorField id="currentTermRemainingMonths" label={copy.months} type="number" placeholder="e.g. 300" min="1" step="1" />
      </div>
      <div class="mr-group">
        <h3>{copy.newLoan}</h3>
        <CalculatorField id="newRate" label={copy.newRate} type="number" placeholder="e.g. 5.5" min="0" step="0.01" />
        <CalculatorField id="newTermMonths" label={copy.newTerm} type="number" placeholder="e.g. 360" min="1" step="1" />
        <CalculatorField id="closingCosts" label={copy.closingCosts} type="number" placeholder="e.g. 4000" min="0" step="1" />
      </div>
      <CalculatorActions lang={lang} calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="mr-content">
      <div id="emptyState">
        <EmptyState icon="🏠" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="monthlySavingsResult" title={copy.monthlySavings} icon={TrendingDown} accent="success" subtitle=" " />
          <ResultCard id="newPaymentResult" title={copy.newPayment} icon={Home} />
          <ResultCard id="breakEvenResult" title={copy.breakEven} icon={Clock} />
          <ResultCard id="lifetimeSavingsResult" title={copy.lifetimeSavings} icon={PiggyBank} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/mortgage-refinance-calculator";
</script>
<style>
.mr-calculator{width:100%;}
.mr-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.mr-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;}
.mr-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.mr-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.mr-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.mr-layout{grid-template-columns:1fr;}.mr-sidebar{position:static;}}
@media(max-width:768px){.mr-layout{gap:24px;}.mr-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
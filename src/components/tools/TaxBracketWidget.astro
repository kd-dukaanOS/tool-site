---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Receipt, TrendingUp, Percent, FileText } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { incomeGroup:"Income", filingStatus:"Filing Status", single:"Single or Married Filing Separately", married:"Married Filing Jointly", hoh:"Head of Household", taxableIncome:"Taxable Income", emptyTitle:"Tax Bracket Calculator", emptyDesc:"Find your marginal and effective federal tax rate.", tip1:"Total Tax", tip2:"Marginal Rate", tip3:"Effective Rate", totalTax:"Total Tax", marginalRate:"Marginal Rate", effectiveRate:"Effective Rate", taxableIncomeResult:"Taxable Income", topBracket:"Top bracket rate", breakdownTitle:"Bracket Breakdown", rateHeader:"Rate", rangeHeader:"Income Range", taxHeader:"Tax in Bracket" },
  es: { incomeGroup:"Ingresos", filingStatus:"Estado Civil Tributario", single:"Soltero o Casado Declarando por Separado", married:"Casado Declarando en Conjunto", hoh:"Cabeza de Familia", taxableIncome:"Ingreso Gravable", emptyTitle:"Calculadora de Tramos Impositivos", emptyDesc:"Calcula tu tasa impositiva federal marginal y efectiva.", tip1:"Impuesto Total", tip2:"Tasa Marginal", tip3:"Tasa Efectiva", totalTax:"Impuesto Total", marginalRate:"Tasa Marginal", effectiveRate:"Tasa Efectiva", taxableIncomeResult:"Ingreso Gravable", topBracket:"Tasa del tramo más alto", breakdownTitle:"Desglose por Tramos", rateHeader:"Tasa", rangeHeader:"Rango de Ingresos", taxHeader:"Impuesto en el Tramo" },
}[lang];
---
<section class="tbk-calculator">
  <div class="tbk-layout">
    <aside class="tbk-sidebar">
      <div class="tbk-group">
        <h3>{copy.incomeGroup}</h3>
        <CalculatorField id="filingStatus" label={copy.filingStatus} type="select">
          <option value="single">{copy.single}</option>
          <option value="married">{copy.married}</option>
          <option value="headOfHousehold">{copy.hoh}</option>
        </CalculatorField>
        <CalculatorField id="taxableIncome" label={copy.taxableIncome} type="number" placeholder="e.g. 80000" min="0" step="1" />
      </div>
      <CalculatorActions lang={lang} calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="tbk-content">
      <div id="emptyState">
        <EmptyState icon="📊" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="totalTaxResult" title={copy.totalTax} icon={Receipt} accent="success" subtitle=" " />
          <ResultCard id="marginalRateResult" title={copy.marginalRate} icon={TrendingUp} />
          <ResultCard id="effectiveRateResult" title={copy.effectiveRate} icon={Percent} />
          <ResultCard id="taxableIncomeResult" title={copy.taxableIncomeResult} icon={FileText} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.breakdownTitle}</h2>
          <table class="breakdown-table">
            <thead><tr><th>{copy.rateHeader}</th><th>{copy.rangeHeader}</th><th>{copy.taxHeader}</th></tr></thead>
            <tbody id="breakdownBody"></tbody>
          </table>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang, topBracketLabel: copy.topBracket }}>
  window.calcLang = calcLang;
  window.tbkTopBracketLabel = topBracketLabel;
</script>
<script>
  import "../../scripts/tax-bracket-calculator";
</script>
<style>
.tbk-calculator{width:100%;}
.tbk-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.tbk-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.tbk-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.tbk-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.tbk-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.breakdown-table{width:100%;border-collapse:collapse;font-size:.9rem;}
.breakdown-table th{text-align:left;padding:8px 12px;border-bottom:2px solid var(--border-subtle);color:var(--text-secondary);font-weight:600;}
.breakdown-table td{padding:8px 12px;border-bottom:1px solid var(--border-subtle);color:var(--text-primary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.tbk-layout{grid-template-columns:1fr;}.tbk-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.tbk-layout{gap:24px;}.tbk-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
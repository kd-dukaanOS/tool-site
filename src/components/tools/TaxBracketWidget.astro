---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Receipt, TrendingUp, Percent, FileText } from "@lucide/astro";
---
<section class="tbk-calculator">
  <div class="tbk-layout">
    <aside class="tbk-sidebar">
      <div class="tbk-group">
        <h3>Income</h3>
        <CalculatorField id="filingStatus" label="Filing Status" type="select" options={[
          { value: "single", label: "Single or Married Filing Separately" },
          { value: "married", label: "Married Filing Jointly" },
          { value: "headOfHousehold", label: "Head of Household" },
        ]} />
        <CalculatorField id="taxableIncome" label="Taxable Income" type="number" placeholder="e.g. 80000" min="0" step="1" />
      </div>
      <CalculatorActions calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="tbk-content">
      <div id="emptyState">
        <EmptyState icon="📊" title="Tax Bracket Calculator" description="Find your marginal and effective federal tax rate." tips={["Total Tax", "Marginal Rate", "Effective Rate"]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="totalTaxResult" title="Total Tax" icon={Receipt} accent="success" subtitle=" " />
          <ResultCard id="marginalRateResult" title="Marginal Rate" icon={TrendingUp} />
          <ResultCard id="effectiveRateResult" title="Effective Rate" icon={Percent} />
          <ResultCard id="taxableIncomeResult" title="Taxable Income" icon={FileText} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>Bracket Breakdown</h2>
          <table class="breakdown-table">
            <thead><tr><th>Rate</th><th>Income Range</th><th>Tax in Bracket</th></tr></thead>
            <tbody id="breakdownBody"></tbody>
          </table>
        </section>
      </div>
    </main>
  </div>
</section>
<script>
  import "../../scripts/tax-bracket-calculator";
</script>
<style>
.tbk-calculator{width:100%;}
.tbk-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.tbk-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.tbk-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.tbk-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.tbk-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.breakdown-table{width:100%;border-collapse:collapse;font-size:.9rem;}
.breakdown-table th{text-align:left;padding:8px 12px;border-bottom:2px solid var(--border-subtle);color:var(--text-secondary);font-weight:600;}
.breakdown-table td{padding:8px 12px;border-bottom:1px solid var(--border-subtle);color:var(--text-primary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.tbk-layout{grid-template-columns:1fr;}.tbk-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.tbk-layout{gap:24px;}.tbk-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Percent, Layers, Wallet, Gauge } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { incomeGroup:"Income", grossIncome:"Gross Monthly Income", housingGroup:"Housing", housingPayment:"Total Housing Payment", otherDebtsGroup:"Other Debts", carLoan:"Car Loan Payment", studentLoan:"Student Loan Payment", creditCardMin:"Credit Card Min. Payments", otherDebt:"Other Debt Payments", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"Debt-to-Income Calculator", emptyDesc:"Find your front-end and back-end DTI ratio for mortgage qualification.", tip1:"Front-End DTI", tip2:"Back-End DTI", tip3:"Lender Rating", frontEnd:"Front-End DTI", backEnd:"Back-End DTI", totalDebt:"Total Monthly Debt", rating:"Overall Rating", aboutTitle:"About this Calculator", aboutText:"Calculates your front-end (housing-only) and back-end (total debt) DTI ratios against gross monthly income, using lender-standard thresholds." },
  es: { incomeGroup:"Ingresos", grossIncome:"Ingreso Mensual Bruto", housingGroup:"Vivienda", housingPayment:"Pago Total de Vivienda", otherDebtsGroup:"Otras Deudas", carLoan:"Pago de Préstamo de Auto", studentLoan:"Pago de Préstamo Estudiantil", creditCardMin:"Pagos Mín. de Tarjeta de Crédito", otherDebt:"Otros Pagos de Deuda", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora de Deuda a Ingresos", emptyDesc:"Encuentra tu relación DTI inicial y total para calificar una hipoteca.", tip1:"DTI Inicial", tip2:"DTI Total", tip3:"Calificación del Prestamista", frontEnd:"DTI Inicial", backEnd:"DTI Total", totalDebt:"Deuda Mensual Total", rating:"Calificación General", aboutTitle:"Acerca de esta Calculadora", aboutText:"Calcula tus relaciones DTI inicial (solo vivienda) y total (toda la deuda) frente al ingreso mensual bruto, usando los umbrales estándar de los prestamistas." },
}[lang];
---
<section class="dti-calculator">
  <div class="dti-layout">
    <aside class="dti-sidebar">
      <div class="dti-group">
        <h3>{copy.incomeGroup}</h3>
        <CalculatorField id="grossMonthlyIncome" label={copy.grossIncome} type="number" placeholder="e.g. 6000" min="0" step="1" />
      </div>
      <div class="dti-group">
        <h3>{copy.housingGroup}</h3>
        <CalculatorField id="housingPayment" label={copy.housingPayment} type="number" placeholder="e.g. 1500" min="0" step="1" />
      </div>
      <div class="dti-group">
        <h3>{copy.otherDebtsGroup}</h3>
        <CalculatorField id="carLoanPayment" label={copy.carLoan} type="number" placeholder="e.g. 350" min="0" step="1" />
        <CalculatorField id="studentLoanPayment" label={copy.studentLoan} type="number" placeholder="e.g. 200" min="0" step="1" />
        <CalculatorField id="creditCardMinPayments" label={copy.creditCardMin} type="number" placeholder="e.g. 150" min="0" step="1" />
        <CalculatorField id="otherDebtPayments" label={copy.otherDebt} type="number" placeholder="e.g. 0" min="0" step="1" />
      </div>
      <CalculatorActions calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} calculateText={copy.calculate} resetText={copy.reset} copyText={copy.copy} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="dti-content">
      <div id="emptyState">
        <EmptyState icon="⚖️" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="frontEndResult" title={copy.frontEnd} icon={Percent} accent="success" subtitle=" " />
          <ResultCard id="backEndResult" title={copy.backEnd} icon={Layers} subtitle=" " />
          <ResultCard id="totalDebtResult" title={copy.totalDebt} icon={Wallet} />
          <ResultCard id="ratingResult" title={copy.rating} icon={Gauge} subtitle=" " />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/debt-to-income-calculator";
</script>
<style>
.dti-calculator{width:100%;}
.dti-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.dti-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.dti-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.dti-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.dti-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.dti-layout{grid-template-columns:1fr;}.dti-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.dti-layout{gap:24px;}.dti-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
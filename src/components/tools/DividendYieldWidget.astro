---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Percent, DollarSign, Wallet, TrendingUp } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { stockInfo:"Stock Info", sharePrice:"Current Share Price", annualDividend:"Annual Dividend per Share", numberOfShares:"Number of Shares", yieldOnCostGroup:"Yield on Cost (Optional)", purchasePrice:"Your Purchase Price", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"Dividend Yield Calculator", emptyDesc:"Find your dividend yield and projected income.", tip1:"Dividend Yield", tip2:"Annual Income", tip3:"Yield on Cost", dividendYield:"Dividend Yield", annualIncome:"Annual Dividend Income", monthlyIncome:"Monthly Dividend Income", yieldOnCost:"Yield on Cost", aboutTitle:"About this Calculator", aboutText:"Calculates a stock's dividend yield, your projected annual and monthly dividend income, and yield on cost based on your original purchase price." },
  es: { stockInfo:"Información de la Acción", sharePrice:"Precio Actual de la Acción", annualDividend:"Dividendo Anual por Acción", numberOfShares:"Número de Acciones", yieldOnCostGroup:"Rendimiento sobre Costo (Opcional)", purchasePrice:"Tu Precio de Compra", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora de Rendimiento de Dividendos", emptyDesc:"Encuentra tu rendimiento de dividendos e ingreso proyectado.", tip1:"Rendimiento de Dividendos", tip2:"Ingreso Anual", tip3:"Rendimiento sobre Costo", dividendYield:"Rendimiento de Dividendos", annualIncome:"Ingreso Anual por Dividendos", monthlyIncome:"Ingreso Mensual por Dividendos", yieldOnCost:"Rendimiento sobre Costo", aboutTitle:"Acerca de esta Calculadora", aboutText:"Calcula el rendimiento de dividendos de una acción, tu ingreso anual y mensual proyectado por dividendos, y el rendimiento sobre costo según tu precio de compra original." },
}[lang];
---
<section class="dy-calculator">
  <div class="dy-layout">
    <aside class="dy-sidebar">
      <div class="dy-group">
        <h3>{copy.stockInfo}</h3>
        <CalculatorField id="sharePrice" label={copy.sharePrice} type="number" placeholder="e.g. 50" min="0" step="0.01" />
        <CalculatorField id="annualDividendPerShare" label={copy.annualDividend} type="number" placeholder="e.g. 2.00" min="0" step="0.01" />
        <CalculatorField id="numberOfShares" label={copy.numberOfShares} type="number" placeholder="e.g. 100" min="0" step="1" />
      </div>
      <div class="dy-group">
        <h3>{copy.yieldOnCostGroup}</h3>
        <CalculatorField id="purchasePrice" label={copy.purchasePrice} type="number" placeholder="e.g. 40" min="0" step="0.01" />
      </div>
      <CalculatorActions lang={lang} calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} calculateText={copy.calculate} resetText={copy.reset} copyText={copy.copy} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="dy-content">
      <div id="emptyState">
        <EmptyState icon="💵" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="dividendYieldResult" title={copy.dividendYield} icon={Percent} accent="success" />
          <ResultCard id="annualIncomeResult" title={copy.annualIncome} icon={DollarSign} />
          <ResultCard id="monthlyIncomeResult" title={copy.monthlyIncome} icon={Wallet} />
          <ResultCard id="yieldOnCostResult" title={copy.yieldOnCost} icon={TrendingUp} subtitle=" " />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/dividend-yield-calculator";
</script>
<style>
.dy-calculator{width:100%;}
.dy-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.dy-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.dy-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.dy-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.dy-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.dy-layout{grid-template-columns:1fr;}.dy-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.dy-layout{gap:24px;}.dy-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { PiggyBank, Landmark, Wallet, CreditCard } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { homeLoanGroup:"Home & Loan", homePrice:"Home Price", downPaymentPercent:"Down Payment (%)", mortgageRate:"Mortgage Rate (%)", loanTermYears:"Loan Term (years)", costsGroup:"Costs", propertyTaxRate:"Property Tax Rate (% / yr)", annualInsurance:"Annual Insurance", closingCostPercent:"Closing Costs (%)", pmiRate:"PMI Rate (% / yr)", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"Down Payment Calculator", emptyDesc:"Find your required down payment, loan amount, and cash needed at closing.", tip1:"Down Payment", tip2:"Loan Amount", tip3:"Cash at Closing", downPayment:"Down Payment", loanAmount:"Loan Amount", cashNeeded:"Cash Needed at Closing", monthlyPayment:"Total Monthly Payment", aboutTitle:"About this Calculator", aboutText:"Calculates your down payment amount, resulting loan size, PMI requirement, and total cash needed at closing based on home price and loan terms.", inclClosing:(c:string)=>`Incl. ${c} closing costs`, inclPmi:(p:string)=>`Incl. ${p} PMI/mo`, noPmi:"No PMI required", pmiYes:"Yes", pmiNo:"No" },
  es: { homeLoanGroup:"Vivienda y Préstamo", homePrice:"Precio de la Vivienda", downPaymentPercent:"Pago Inicial (%)", mortgageRate:"Tasa Hipotecaria (%)", loanTermYears:"Plazo del Préstamo (años)", costsGroup:"Costos", propertyTaxRate:"Tasa de Impuesto Predial (% / año)", annualInsurance:"Seguro Anual", closingCostPercent:"Costos de Cierre (%)", pmiRate:"Tasa PMI (% / año)", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora de Pago Inicial", emptyDesc:"Encuentra tu pago inicial requerido, monto del préstamo y efectivo necesario al cierre.", tip1:"Pago Inicial", tip2:"Monto del Préstamo", tip3:"Efectivo al Cierre", downPayment:"Pago Inicial", loanAmount:"Monto del Préstamo", cashNeeded:"Efectivo Necesario al Cierre", monthlyPayment:"Pago Mensual Total", aboutTitle:"Acerca de esta Calculadora", aboutText:"Calcula tu monto de pago inicial, el tamaño resultante del préstamo, el requisito de PMI y el efectivo total necesario al cierre según el precio de la vivienda y los términos del préstamo.", inclClosing:(c:string)=>`Incl. ${c} en costos de cierre`, inclPmi:(p:string)=>`Incl. ${p} PMI/mes`, noPmi:"No se requiere PMI", pmiYes:"Sí", pmiNo:"No" },
}[lang];
---
<section class="dp-calculator">
  <div class="dp-layout">
    <aside class="dp-sidebar">
      <div class="dp-group">
        <h3>{copy.homeLoanGroup}</h3>
        <CalculatorField id="homePrice" label={copy.homePrice} type="number" placeholder="e.g. 400000" min="0" step="1" />
        <CalculatorField id="downPaymentPercent" label={copy.downPaymentPercent} type="number" placeholder="e.g. 10" min="0" step="0.1" />
        <CalculatorField id="mortgageRate" label={copy.mortgageRate} type="number" placeholder="e.g. 6.5" min="0" step="0.01" />
        <CalculatorField id="loanTermYears" label={copy.loanTermYears} type="number" placeholder="e.g. 30" min="1" step="1" />
      </div>
      <div class="dp-group">
        <h3>{copy.costsGroup}</h3>
        <CalculatorField id="propertyTaxRate" label={copy.propertyTaxRate} type="number" placeholder="e.g. 1.1" min="0" step="0.01" />
        <CalculatorField id="annualInsurance" label={copy.annualInsurance} type="number" placeholder="e.g. 1400" min="0" step="1" />
        <CalculatorField id="closingCostPercent" label={copy.closingCostPercent} type="number" placeholder="e.g. 3" min="0" step="0.1" />
        <CalculatorField id="pmiRate" label={copy.pmiRate} type="number" placeholder="e.g. 0.5" min="0" step="0.01" />
      </div>
      <CalculatorActions calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} calculateText={copy.calculate} resetText={copy.reset} copyText={copy.copy} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="dp-content">
      <div id="emptyState">
        <EmptyState icon="🏡" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="downPaymentResult" title={copy.downPayment} icon={PiggyBank} accent="success" />
          <ResultCard id="loanAmountResult" title={copy.loanAmount} icon={Landmark} />
          <ResultCard id="cashNeededResult" title={copy.cashNeeded} icon={Wallet} subtitle=" " />
          <ResultCard id="monthlyPaymentResult" title={copy.monthlyPayment} icon={CreditCard} subtitle=" " />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/down-payment-calculator";
</script>
<style>
.dp-calculator{width:100%;}
.dp-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.dp-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.dp-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.dp-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.dp-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.dp-layout{grid-template-columns:1fr;}.dp-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.dp-layout{gap:24px;}.dp-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
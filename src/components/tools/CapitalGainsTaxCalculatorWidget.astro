---
{/* src/components/tools/CapitalGainsTaxCalculatorWidget.astro */}
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";

import { TrendingUp, Landmark, Wallet, Percent } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { purchasePrice:"Purchase Price ($)", salePrice:"Sale Price ($)", holdingPeriod:"Holding Period", longTerm:"Long-Term (over 1 year)", shortTerm:"Short-Term (1 year or less)", otherIncome:"Other Annual Income ($)", otherIncomeHelp:"Your income excluding this gain — determines your bracket.", filingStatus:"Filing Status", single:"Single", mfj:"Married Filing Jointly", mfs:"Married Filing Separately", hoh:"Head of Household", taxYear:"Tax Year", deduction:"Deduction", standardDeduction:"Standard Deduction", itemizedDeduction:"Itemized Deduction", itemizedDeductionAmt:"Itemized Deduction ($)", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"Capital Gains Tax Calculator", emptyDesc:"Estimate federal tax owed on a short-term or long-term capital gain based on your income and filing status.", tip1:"Capital Gains Tax", tip2:"After-Tax Gain", gain:"Capital Gain", tax:"Capital Gains Tax", rate:"Effective Rate on Gain", afterTax:"After-Tax Gain", aboutTitle:"About this Calculator", aboutText:"Estimates federal capital gains tax by stacking your gain on top of your other taxable income, using current IRS ordinary tax brackets (short-term) or long-term capital gains brackets (0%/15%/20%) for 2025 and 2026. Does not include state tax or the Net Investment Income Tax." },
  es: { purchasePrice:"Precio de Compra ($)", salePrice:"Precio de Venta ($)", holdingPeriod:"Período de Tenencia", longTerm:"Largo Plazo (más de 1 año)", shortTerm:"Corto Plazo (1 año o menos)", otherIncome:"Otros Ingresos Anuales ($)", otherIncomeHelp:"Tu ingreso excluyendo esta ganancia — determina tu tramo.", filingStatus:"Estado Civil Tributario", single:"Soltero", mfj:"Casado Declarando Conjuntamente", mfs:"Casado Declarando por Separado", hoh:"Cabeza de Familia", taxYear:"Año Fiscal", deduction:"Deducción", standardDeduction:"Deducción Estándar", itemizedDeduction:"Deducción Detallada", itemizedDeductionAmt:"Deducción Detallada ($)", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora de Impuesto sobre Ganancias de Capital", emptyDesc:"Estima el impuesto federal adeudado sobre una ganancia de capital a corto o largo plazo según tu ingreso y estado civil tributario.", tip1:"Impuesto sobre Ganancias", tip2:"Ganancia Después de Impuestos", gain:"Ganancia de Capital", tax:"Impuesto sobre Ganancias de Capital", rate:"Tasa Efectiva sobre la Ganancia", afterTax:"Ganancia Después de Impuestos", aboutTitle:"Acerca de esta Calculadora", aboutText:"Estima el impuesto federal sobre ganancias de capital apilando tu ganancia sobre tu otro ingreso imponible, usando los tramos ordinarios actuales del IRS (corto plazo) o los tramos de ganancias de capital a largo plazo (0%/15%/20%) para 2025 y 2026. No incluye impuesto estatal ni el Impuesto sobre Ingresos Netos de Inversión." },
}[lang];
---

<section class="cgt-calculator">
  <div class="cgt-layout">

    <aside class="cgt-sidebar">
      <CalculatorField
        id="purchasePrice"
        label={copy.purchasePrice}
        type="number"
        placeholder="e.g. 10000"
        required={true}
        min="0"
        step="0.01"
      />

      <CalculatorField
        id="salePrice"
        label={copy.salePrice}
        type="number"
        placeholder="e.g. 15000"
        required={true}
        min="0"
        step="0.01"
      />

      <CalculatorField
        id="holdingPeriod"
        label={copy.holdingPeriod}
        type="select"
        required={true}
      >
        <option value="long">{copy.longTerm}</option>
        <option value="short">{copy.shortTerm}</option>
      </CalculatorField>

      <CalculatorField
        id="otherIncome"
        label={copy.otherIncome}
        type="number"
        placeholder="e.g. 75000"
        min="0"
        step="0.01"
        helpText={copy.otherIncomeHelp}
      />

      <CalculatorField
        id="filingStatus"
        label={copy.filingStatus}
        type="select"
        required={true}
      >
        <option value="single">{copy.single}</option>
        <option value="marriedJointly">{copy.mfj}</option>
        <option value="marriedSeparately">{copy.mfs}</option>
        <option value="headOfHousehold">{copy.hoh}</option>
      </CalculatorField>

      <CalculatorField
        id="taxYear"
        label={copy.taxYear}
        type="select"
        required={true}
      >
        <option value="2026">2026</option>
        <option value="2025">2025</option>
      </CalculatorField>

      <CalculatorField
        id="deductionMode"
        label={copy.deduction}
        type="select"
        required={true}
      >
        <option value="standard">{copy.standardDeduction}</option>
        <option value="itemized">{copy.itemizedDeduction}</option>
      </CalculatorField>

      <div id="itemizedRow" hidden>
        <CalculatorField
          id="itemizedDeduction"
          label={copy.itemizedDeductionAmt}
          type="number"
          placeholder="e.g. 18000"
          min="0"
          step="0.01"
        />
      </div>

      <CalculatorActions lang={lang}
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
        calculateText={copy.calculate}
        resetText={copy.reset}
        copyText={copy.copy}
      />

      <div id="errorBox" class="error-box" hidden></div>
    </aside>

    <main class="cgt-content">
      <div id="emptyState">
        <EmptyState
          icon="📈"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={[copy.tip1, copy.tip2]}
        />
      </div>

      <div id="resultsContainer" hidden>
        <ResultsGrid columns={2}>
          <ResultCard id="gainResult" title={copy.gain} icon={TrendingUp} accent="neutral" size="lg" />
          <ResultCard id="taxResult" title={copy.tax} icon={Landmark} accent="primary" size="lg" />
          <ResultCard id="rateResult" title={copy.rate} icon={Percent} accent="primary" />
          <ResultCard id="afterTaxResult" title={copy.afterTax} icon={Wallet} accent="success" />
        </ResultsGrid>

        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>
            {copy.aboutText}
          </p>
        </section>
      </div>
    </main>

  </div>
</section>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/capital-gains-calculator";
</script>

<style>
.cgt-calculator{ width:100%; }
.cgt-layout{ display:grid; grid-template-columns:340px minmax(0,1fr); gap:32px; align-items:start; }
.cgt-sidebar{ position:sticky; top:24px; display:flex; flex-direction:column; gap:20px; }
.cgt-content{ display:flex; flex-direction:column; gap:28px; min-width:0; }
.calculator-info{ padding:24px; border:1px solid var(--border-subtle); border-radius:18px; background:var(--bg-card); }
.calculator-info h2{ margin:0 0 12px; font-size:1.15rem; font-weight:700; color:var(--text-primary); }
.calculator-info p{ margin:0; line-height:1.8; font-size:.95rem; color:var(--text-secondary); }
.error-box{ display:flex; align-items:center; padding:14px 16px; border-radius:14px; background:#FEF2F2; border:1px solid #FCA5A5; color:#B91C1C; font-size:.92rem; font-weight:600; }
:global(.dark) .error-box{ background:#2A1111; border-color:#7F1D1D; color:#FECACA; }
@media(max-width:1024px){ .cgt-layout{ grid-template-columns:1fr; } .cgt-sidebar{ position:static; } }
@media(max-width:768px){ .cgt-layout{ gap:24px; } .cgt-content{ gap:20px; } }
@media(max-width:640px){ .calculator-info{ padding:18px; } }
</style>
---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Mountain, Calendar, Receipt, ListOrdered } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { yourDebts:"Your Debts", addDebt:"+ Add Debt", extraPaymentGroup:"Extra Payment", extraPayment:"Extra Monthly Payment", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"Debt Avalanche Calculator", emptyDesc:"Pay off debt highest-interest-first to minimize total interest.", tip1:"Debt-Free Timeline", tip2:"Total Interest", tip3:"Payoff Order", debtFreeIn:"Debt-Free In", totalInterest:"Total Interest", totalPaid:"Total Paid", debts:"Debts", payoffOrderTitle:"Payoff Order", debtCol:"Debt", paidOffCol:"Paid Off In", interestCol:"Interest Paid" },
  es: { yourDebts:"Tus Deudas", addDebt:"+ Agregar Deuda", extraPaymentGroup:"Pago Extra", extraPayment:"Pago Mensual Extra", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora de Avalancha de Deudas", emptyDesc:"Paga primero las deudas con mayor interés para minimizar el interés total.", tip1:"Cronograma Sin Deudas", tip2:"Interés Total", tip3:"Orden de Pago", debtFreeIn:"Libre de Deudas En", totalInterest:"Interés Total", totalPaid:"Total Pagado", debts:"Deudas", payoffOrderTitle:"Orden de Pago", debtCol:"Deuda", paidOffCol:"Pagada En", interestCol:"Interés Pagado" },
}[lang];
---
<section class="dav-calculator">
  <div class="dav-layout">
    <aside class="dav-sidebar">
      <div class="dav-group">
        <h3>{copy.yourDebts}</h3>
        <div id="debtList" class="debt-list"></div>
        <button type="button" id="addDebtBtn" class="add-debt-btn">{copy.addDebt}</button>
      </div>
      <div class="dav-group">
        <h3>{copy.extraPaymentGroup}</h3>
        <CalculatorField id="extraMonthlyPayment" label={copy.extraPayment} type="number" placeholder="e.g. 150" min="0" step="1" />
      </div>
      <CalculatorActions lang={lang} calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} calculateText={copy.calculate} resetText={copy.reset} copyText={copy.copy} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="dav-content">
      <div id="emptyState">
        <EmptyState icon="🏔️" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="totalMonthsResult" title={copy.debtFreeIn} icon={Calendar} accent="success" subtitle=" " />
          <ResultCard id="totalInterestResult" title={copy.totalInterest} icon={Receipt} />
          <ResultCard id="totalPaidResult" title={copy.totalPaid} icon={Mountain} />
          <ResultCard id="debtCountResult" title={copy.debts} icon={ListOrdered} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.payoffOrderTitle}</h2>
          <table class="order-table">
            <thead><tr><th>{copy.debtCol}</th><th>{copy.paidOffCol}</th><th>{copy.interestCol}</th></tr></thead>
            <tbody id="orderBody"></tbody>
          </table>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/debt-avalanche-calculator";
</script>
<style>
.dav-calculator{width:100%;}
.dav-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.dav-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.dav-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.dav-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.dav-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.debt-list{display:flex;flex-direction:column;gap:8px;}
.debt-row{display:grid;grid-template-columns:1fr 1fr;gap:6px;padding:10px;border:1px solid var(--border-subtle);border-radius:10px;position:relative;}
.debt-row input{padding:6px 8px;border:1px solid var(--border-subtle);border-radius:8px;font-size:.85rem;background:var(--bg-primary,#fff);color:var(--text-primary);}
.debt-row .debt-name{grid-column:1 / -1;}
.debt-remove{position:absolute;top:4px;right:4px;background:none;border:none;font-size:1rem;cursor:pointer;color:var(--text-secondary);line-height:1;}
.add-debt-btn{padding:8px 12px;border:1px dashed var(--border-subtle);border-radius:10px;background:none;cursor:pointer;font-size:.85rem;color:var(--text-primary);font-weight:600;}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.order-table{width:100%;border-collapse:collapse;font-size:.9rem;}
.order-table th{text-align:left;padding:8px 12px;border-bottom:2px solid var(--border-subtle);color:var(--text-secondary);font-weight:600;}
.order-table td{padding:8px 12px;border-bottom:1px solid var(--border-subtle);color:var(--text-primary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.dav-layout{grid-template-columns:1fr;}.dav-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.dav-layout{gap:24px;}.dav-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
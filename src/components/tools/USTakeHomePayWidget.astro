---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Wallet, CalendarDays, Repeat, MinusCircle } from "@lucide/astro";
---
<section class="usts-calculator">
  <div class="usts-layout">
    <aside class="usts-sidebar">
      <CalculatorField id="grossIncome" label="Gross Annual Income" type="number" required={true} helpText="Your gross salary before deductions (USD)." />
      <CalculatorActions calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="usts-content">
      <div id="emptyState">
        <EmptyState icon="🇺🇸" title="US Take-Home Pay Calculator" description="See your net salary after federal tax, Social Security and Medicare." tips={["Net Annual Pay", "Federal Tax", "FICA"]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={3}>
          <ResultCard id="netAnnualResult" title="Net Annual Pay" icon={Wallet} subtitle=" " />
          <ResultCard id="netMonthlyResult" title="Net Monthly" icon={CalendarDays} />
          <ResultCard id="netBiweeklyResult" title="Net Biweekly" icon={Repeat} />
          <ResultCard id="totalDeductionsResult" title="Total Deductions" icon={MinusCircle} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>About this Calculator</h2>
          <p>Estimates net pay after federal income tax, Social Security and Medicare (federal only — state tax not included). Verify against current IRS figures.</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script>
  import "../../scripts/us-take-home-pay";
</script>
<style>
.usts-calculator{width:100%;}
.usts-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.usts-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;}
.usts-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.usts-layout{grid-template-columns:1fr;}.usts-sidebar{position:static;}}
@media(max-width:768px){.usts-layout{gap:24px;}.usts-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
---
import CalculatorField from "../calculator/CalculatorField.astro";
import ActionButtons from "../calculator/ActionButtons.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import EmptyState from "../calculator/EmptyState.astro";
import { CalendarDays, Hash } from "@lucide/astro";
---

<div class="calculator-widget">
  <div class="calculator-inputs">
    <CalculatorField id="startDate" label="Start Date" type="date" />
    <CalculatorField id="endDate" label="End Date" type="date" />

    <div id="errorBox" class="error-box" role="alert" hidden></div>

    <ActionButtons
      calculateId="calculateBtn"
      resetId="resetBtn"
      copyId="copyBtn"
      showDownload={false}
      showShare={false}
    />
  </div>

  <div class="calculator-output">
    <EmptyState
      id="emptyState"
      title="Select dates to calculate difference"
      description="Years, months, and days between the dates will appear here."
    />

    <ResultsGrid id="resultsContainer" hidden>
      <ResultCard id="yearsResult" title="Years" icon={CalendarDays} accent="primary" size="lg" />
      <ResultCard id="monthsResult" title="Months" icon={CalendarDays} accent="neutral" />
      <ResultCard id="daysResult" title="Days" icon={CalendarDays} accent="neutral" />
      <ResultCard id="totalDaysResult" title="Total Days" icon={Hash} accent="neutral" />
      <ResultCard id="totalWeeksResult" title="Total Weeks" icon={Hash} accent="neutral" />
    </ResultsGrid>
  </div>
</div>

<script src="../../scripts/date-difference-calculator.ts"></script>

---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { House, Landmark, Wallet, Scale, TrendingUp } from "@lucide/astro";
---
<section class="morta-calculator">
  <div class="morta-layout">
    <aside class="morta-sidebar">
      <CalculatorField id="annualIncome" label="Annual Gross Income" type="number" placeholder="e.g. 85000" required={true} min="0" step="1" helpText="Your total gross income before tax." />
      <CalculatorField id="monthlyDebts" label="Monthly Debt Payments" type="number" placeholder="e.g. 400" min="0" step="1" helpText="Car loans, student loans, credit cards, etc. Leave blank if none." />
      <CalculatorField id="downPayment" label="Down Payment" type="number" placeholder="e.g. 40000" min="0" step="1" helpText="Amount you plan to pay upfront." />
      <CalculatorField id="annualRate" label="Interest Rate (%)" type="number" placeholder="e.g. 6.5" required={true} min="0" step="0.01" helpText="Expected annual mortgage rate." />
      <CalculatorField id="loanYears" label="Loan Term (Years)" type="number" placeholder="e.g. 30" required={true} min="1" step="1" helpText="Typical terms are 15, 20, or 30 years." />
      <CalculatorField id="monthlyTaxesInsurance" label="Est. Monthly Tax + Insurance" type="number" placeholder="e.g. 350" min="0" step="1" helpText="Optional. Rough monthly property tax + home insurance estimate." />
      <CalculatorActions calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="morta-content">
      <div id="emptyState">
        <EmptyState icon="🏠" title="Mortgage Affordability Calculator" description="Find out how much home you can realistically afford based on your income and debts." tips={["Max Home Price", "Max Loan Amount", "Debt-to-Income Ratios"]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={3}>
          <ResultCard id="maxHomePriceResult" title="Max Home Price" icon={House} accent="success" subtitle=" " />
          <ResultCard id="maxLoanAmountResult" title="Max Loan Amount" icon={Landmark} />
          <ResultCard id="maxMonthlyPaymentResult" title="Max Monthly Payment" icon={Wallet} />
          <ResultCard id="frontEndRatioResult" title="Front-End DTI Ratio" icon={Scale} />
          <ResultCard id="backEndRatioResult" title="Back-End DTI Ratio" icon={TrendingUp} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>About this Calculator</h2>
          <p>Estimates the maximum home price you can afford using the standard 28/36 debt-to-income guideline lenders commonly use: housing costs at or under 28% of gross income, and total debts at or under 36%. This is a general guideline, not a lending decision — actual approval depends on your specific lender, credit profile, and other factors.</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script>
  import "../../scripts/mortgage-affordability-calculator";
</script>
<style>
.morta-calculator{width:100%;}
.morta-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.morta-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;}
.morta-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.morta-layout{grid-template-columns:1fr;}.morta-sidebar{position:static;}}
@media(max-width:768px){.morta-layout{gap:24px;}.morta-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
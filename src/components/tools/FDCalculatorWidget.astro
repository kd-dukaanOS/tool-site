---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";

import {
  Wallet,
  TrendingUp,
  Coins,
  Percent,
  Receipt,
  PiggyBank
} from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { deposit:"Deposit Amount (₹)", depositHelp:"Lump sum amount you're depositing.", rate:"Interest Rate (% p.a.)", rateHelp:"Rate offered by the bank.", tenure:"Tenure (Years)", tenureHelp:"Deposit duration, e.g. 1.5 for 1 year 6 months.", frequency:"Compounding Frequency (times/year)", frequencyHelp:"Most Indian FDs compound quarterly (4).", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"FD Calculator", emptyDesc:"Calculate your Fixed Deposit maturity value and estimated TDS.", tip1:"Maturity Value", tip2:"Total Interest Earned", tip3:"Effective Annual Yield", tip4:"Estimated TDS", maturity:"Maturity Value", interest:"Total Interest Earned", principal:"Principal Invested", yield:"Effective Annual Yield", tds:"Estimated TDS", netInterest:"Net Interest After TDS", aboutTitle:"About this Calculator", aboutText:"Calculates your Fixed Deposit maturity value using compound interest, plus an estimated TDS deduction (10% flat, applied when annualised interest exceeds ₹40,000 as per general Indian tax rules). This is an estimate only — actual TDS depends on your PAN status, Form 15G/15H, and total taxable income." },
  es: { deposit:"Monto del Depósito (₹)", depositHelp:"Suma global que estás depositando.", rate:"Tasa de Interés (% anual)", rateHelp:"Tasa ofrecida por el banco.", tenure:"Plazo (Años)", tenureHelp:"Duración del depósito, ej. 1.5 para 1 año 6 meses.", frequency:"Frecuencia de Capitalización (veces/año)", frequencyHelp:"La mayoría de los FD indios capitalizan trimestralmente (4).", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora de FD", emptyDesc:"Calcula el valor de vencimiento de tu Depósito Fijo y el TDS estimado.", tip1:"Valor de Vencimiento", tip2:"Interés Total Ganado", tip3:"Rendimiento Anual Efectivo", tip4:"TDS Estimado", maturity:"Valor de Vencimiento", interest:"Interés Total Ganado", principal:"Capital Invertido", yield:"Rendimiento Anual Efectivo", tds:"TDS Estimado", netInterest:"Interés Neto Después de TDS", aboutTitle:"Acerca de esta Calculadora", aboutText:"Calcula el valor de vencimiento de tu Depósito Fijo usando interés compuesto, más una deducción TDS estimada (10% fijo, aplicado cuando el interés anualizado excede ₹40,000 según las reglas fiscales generales de India). Esto es solo una estimación — el TDS real depende de tu estado PAN, Formulario 15G/15H, e ingreso imponible total." },
}[lang];
---

<section class="fd-calculator">

  <div class="fd-layout">

    <aside class="fd-sidebar">

      <CalculatorField
        id="principal"
        label={copy.deposit}
        type="number"
        placeholder="e.g. 100000"
        required={true}
        min="0"
        step="1"
        helpText={copy.depositHelp}
      />

      <CalculatorField
        id="annualRate"
        label={copy.rate}
        type="number"
        placeholder="e.g. 7.5"
        required={true}
        min="0"
        step="0.01"
        helpText={copy.rateHelp}
      />

      <CalculatorField
        id="tenureYears"
        label={copy.tenure}
        type="number"
        placeholder="e.g. 5"
        required={true}
        min="0"
        step="0.25"
        helpText={copy.tenureHelp}
      />

      <CalculatorField
        id="compoundingFrequency"
        label={copy.frequency}
        type="number"
        value="4"
        required={true}
        min="1"
        step="1"
        helpText={copy.frequencyHelp}
      />

      <CalculatorActions
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
        calculateText={copy.calculate}
        resetText={copy.reset}
        copyText={copy.copy}
      />

      <div
        id="errorBox"
        class="error-box"
        hidden
      ></div>

    </aside>

    <main class="fd-content">

      <div id="emptyState">

        <EmptyState
          icon="🏦"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={[copy.tip1, copy.tip2, copy.tip3, copy.tip4]}
        />

      </div>

      <div
        id="resultsContainer"
        hidden
      >

        <ResultsGrid columns={3}>

          <ResultCard
            id="maturityResult"
            title={copy.maturity}
            icon={Wallet}
            accent="success"
          />

          <ResultCard
            id="interestResult"
            title={copy.interest}
            icon={TrendingUp}
          />

          <ResultCard
            id="principalResult"
            title={copy.principal}
            icon={Coins}
          />

          <ResultCard
            id="yieldResult"
            title={copy.yield}
            icon={Percent}
          />

          <ResultCard
            id="tdsResult"
            title={copy.tds}
            icon={Receipt}
            accent="warning"
          />

          <ResultCard
            id="netInterestResult"
            title={copy.netInterest}
            icon={PiggyBank}
          />

        </ResultsGrid>

        <section class="calculator-info">

          <h2>{copy.aboutTitle}</h2>

          <p>
            {copy.aboutText}
          </p>

        </section>

      </div>

    </main>

  </div>

</section>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/fd-calculator";
</script>

<style>

.fd-calculator{

width:100%;

}

.fd-layout{

display:grid;

grid-template-columns:340px minmax(0,1fr);

gap:32px;

align-items:start;

}

.fd-sidebar{

position:sticky;

top:24px;

display:flex;

flex-direction:column;

gap:20px;

}

.fd-content{

display:flex;

flex-direction:column;

gap:28px;

min-width:0;

}

.calculator-info{

padding:24px;

border:1px solid var(--border-subtle);

border-radius:18px;

background:var(--bg-card);

}

.calculator-info h2{

margin:0 0 12px;

font-size:1.15rem;

font-weight:700;

color:var(--text-primary);

}

.calculator-info p{

margin:0;

line-height:1.8;

font-size:.95rem;

color:var(--text-secondary);

}

.error-box{

display:flex;

align-items:center;

padding:14px 16px;

border-radius:14px;

background:#FEF2F2;

border:1px solid #FCA5A5;

color:#B91C1C;

font-size:.92rem;

font-weight:600;

}

:global(.dark) .error-box{

background:#2A1111;

border-color:#7F1D1D;

color:#FECACA;

}

@media(max-width:1024px){

.fd-layout{

grid-template-columns:1fr;

}

.fd-sidebar{

position:static;

}

}

@media(max-width:768px){

.fd-layout{

gap:24px;

}

.fd-content{

gap:20px;

}

}

@media(max-width:640px){

.calculator-info{

padding:18px;

}

}

</style>

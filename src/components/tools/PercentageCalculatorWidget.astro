---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";

import { Percent, Calculator } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { modePercentOf:"X% of Y", modeIsWhat:"X is what % of Y", modeChange:"% Change", modeFindBase:"Find the Base", emptyTitle:"Percentage Calculator", emptyDesc:"Pick a calculation type above, enter your values, and get an instant answer.", tip1:"4 Calculation Modes", tip2:"Instant Results", tip3:"Plain-English Explanation", result:"Result", calculation:"Calculation", aboutTitle:"About this Calculator", aboutText:"Percentages express a number as a fraction of 100. This calculator covers the four most common percentage questions — finding a percentage of a number, finding what percentage one number is of another, calculating percentage change, and working backward to find the original number." },
  es: { modePercentOf:"X% de Y", modeIsWhat:"X es qué % de Y", modeChange:"% Cambio", modeFindBase:"Encontrar la Base", emptyTitle:"Calculadora de Porcentajes", emptyDesc:"Elige un tipo de cálculo arriba, ingresa tus valores y obtén una respuesta instantánea.", tip1:"4 Modos de Cálculo", tip2:"Resultados Instantáneos", tip3:"Explicación en Lenguaje Sencillo", result:"Resultado", calculation:"Cálculo", aboutTitle:"Acerca de esta Calculadora", aboutText:"Los porcentajes expresan un número como una fracción de 100. Esta calculadora cubre las cuatro preguntas de porcentaje más comunes: encontrar un porcentaje de un número, encontrar qué porcentaje representa un número de otro, calcular el cambio porcentual y trabajar hacia atrás para encontrar el número original." },
}[lang];
---

<section class="percent-calculator">

  <div class="percent-layout">

    <aside class="percent-sidebar">

      <div class="mode-grid">
        <button type="button" class="mode-btn active" data-percent-mode="percentOf">{copy.modePercentOf}</button>
        <button type="button" class="mode-btn" data-percent-mode="isWhatPercent">{copy.modeIsWhat}</button>
        <button type="button" class="mode-btn" data-percent-mode="percentChange">{copy.modeChange}</button>
        <button type="button" class="mode-btn" data-percent-mode="findBase">{copy.modeFindBase}</button>
      </div>

      <p id="modeHint" class="mode-hint"></p>

      <CalculatorField
        id="value1"
        label="Value 1"
        type="number"
        placeholder="e.g. 20"
      />

      <CalculatorField
        id="value2"
        label="Value 2"
        type="number"
        placeholder="e.g. 200"
      />

      <CalculatorActions
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
      />

      <div
        id="errorBox"
        class="error-box"
        hidden
      ></div>

    </aside>

    <main class="percent-content">

      <div id="emptyState">

        <EmptyState
          icon="％"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={[
            copy.tip1,
            copy.tip2,
            copy.tip3
          ]}
        />

      </div>

      <div
        id="resultsContainer"
        hidden
      >

        <ResultsGrid columns={2}>

          <ResultCard id="percentResult" title={copy.result} icon={Percent} accent="primary" size="lg" />
          <ResultCard id="expressionResult" title={copy.calculation} icon={Calculator} accent="neutral" size="lg" />

        </ResultsGrid>

        <p
          id="insightBox"
          class="insight-box"
          hidden
        ></p>

        <section class="calculator-info">

          <h2>{copy.aboutTitle}</h2>

          <p>{copy.aboutText}</p>

        </section>

      </div>

    </main>

  </div>

</section>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/percentage-calculator";
</script>

<style>

.percent-calculator{

width:100%;

}

.percent-layout{

display:grid;

grid-template-columns:340px minmax(0,1fr);

gap:32px;

align-items:start;

}

.percent-sidebar{

position:sticky;

top:24px;

display:flex;

flex-direction:column;

gap:16px;

}

.percent-content{

display:flex;

flex-direction:column;

gap:28px;

min-width:0;

}

.mode-grid{

display:grid;

grid-template-columns:1fr 1fr;

gap:10px;

}

.mode-btn{

height:56px;

padding:0 10px;

border-radius:12px;

border:1px solid #D1D5DB;

background:#fff;

color:#374151;

font-size:.82rem;

font-weight:600;

line-height:1.3;

cursor:pointer;

transition:all .2s ease;

}

.mode-btn.active{

background:#4F46E5;

border-color:#4F46E5;

color:#fff;

}

.mode-hint{

margin:0;

font-size:.85rem;

color:#6B7280;

line-height:1.5;

}

.insight-box{

margin:0;

padding:18px 20px;

border-radius:16px;

background:#EEF2FF;

border:1px solid #C7D2FE;

color:#3730A3;

font-size:.92rem;

font-weight:600;

line-height:1.6;

}

.calculator-info{

padding:24px;

border:1px solid var(--border-subtle);

border-radius:18px;

background:var(--bg-card);

}

.calculator-info h2{

margin:0 0 12px;

font-size:1.15rem;

font-weight:700;

color:var(--text-primary);

}

.calculator-info p{

margin:0;

line-height:1.8;

font-size:.95rem;

color:var(--text-secondary);

}

.error-box{

display:flex;

align-items:center;

padding:14px 16px;

border-radius:14px;

background:#FEF2F2;

border:1px solid #FCA5A5;

color:#B91C1C;

font-size:.92rem;

font-weight:600;

}

:global(.dark) .mode-btn{

background:#18181B;

border-color:#27272A;

color:#D4D4D8;

}

:global(.dark) .mode-btn.active{

background:#4F46E5;

border-color:#4F46E5;

color:#fff;

}

:global(.dark) .mode-hint{

color:#A1A1AA;

}

:global(.dark) .insight-box{

background:#1E1B4B;

border-color:#3730A3;

color:#C7D2FE;

}



:global(.dark) .error-box{

background:#2A1111;

border-color:#7F1D1D;

color:#FECACA;

}

@media(max-width:1024px){

.percent-layout{

grid-template-columns:1fr;

}

.percent-sidebar{

position:static;

}

}

@media(max-width:640px){

.calculator-info{

padding:18px;

}

}

</style>

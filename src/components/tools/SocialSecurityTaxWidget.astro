---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Shield, Wallet, TrendingUp, Gauge } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { incomeGroup:"Income", annualWagesLabel:"Annual Wages / Net Earnings", employmentTypeLabel:"Employment Type", employee:"Employee", selfEmployed:"Self-Employed", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"Social Security Tax Calculator", emptyDesc:"Find your 2026 Social Security tax and wage base cap status.", tip1:"SS Tax Owed", tip2:"Taxable Wages", tip3:"Wage Base Cap", ssTaxTitle:"Social Security Tax", taxableWagesTitle:"Taxable Wages", wagesOverCapTitle:"Wages Over Cap", capStatusTitle:"Cap Status", aboutTitle:"About this Calculator", aboutText:"Calculates Social Security tax using the 2026 wage base cap of $184,500, for both employees (6.2%) and self-employed individuals (12.4%)." },
  es: { incomeGroup:"Ingresos", annualWagesLabel:"Salarios Anuales / Ingresos Netos", employmentTypeLabel:"Tipo de Empleo", employee:"Empleado", selfEmployed:"Trabajador Independiente", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora de Impuesto de Seguro Social", emptyDesc:"Encuentra tu impuesto de Seguro Social 2026 y el estado del tope salarial.", tip1:"Impuesto SS Adeudado", tip2:"Salarios Gravables", tip3:"Tope Salarial", ssTaxTitle:"Impuesto de Seguro Social", taxableWagesTitle:"Salarios Gravables", wagesOverCapTitle:"Salarios Sobre el Tope", capStatusTitle:"Estado del Tope", aboutTitle:"Acerca de esta Calculadora", aboutText:"Calcula el impuesto de Seguro Social utilizando el tope salarial 2026 de $184,500, tanto para empleados (6.2%) como para trabajadores independientes (12.4%)." },
}[lang];
---
<section class="sst-calculator">
  <div class="sst-layout">
    <aside class="sst-sidebar">
      <div class="sst-group">
        <h3>{copy.incomeGroup}</h3>
        <CalculatorField id="annualWages" label={copy.annualWagesLabel} type="number" placeholder="e.g. 80000" min="0" step="1" />
        <CalculatorField type="select" id="employmentType" label={copy.employmentTypeLabel}>
  <option value="employee">{copy.employee}</option>
  <option value="self">{copy.selfEmployed}</option>
</CalculatorField>
      </div>
      <CalculatorActions lang={lang} calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} calculateText={copy.calculate} resetText={copy.reset} copyText={copy.copy} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="sst-content">
      <div id="emptyState">
        <EmptyState icon="🛡️" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="primaryTaxResult" title={copy.ssTaxTitle} icon={Shield} accent="success" subtitle=" " />
          <ResultCard id="taxableWagesResult" title={copy.taxableWagesTitle} icon={Wallet} />
          <ResultCard id="wagesOverCapResult" title={copy.wagesOverCapTitle} icon={TrendingUp} />
          <ResultCard id="capStatusResult" title={copy.capStatusTitle} icon={Gauge} subtitle=" " />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/social-security-tax-calculator";
</script>
<style>
.sst-calculator{width:100%;}
.sst-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.sst-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.sst-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.sst-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.sst-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.sst-layout{grid-template-columns:1fr;}.sst-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.sst-layout{gap:24px;}.sst-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
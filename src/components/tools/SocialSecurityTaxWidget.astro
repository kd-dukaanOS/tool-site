---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Shield, Wallet, TrendingUp, Gauge } from "@lucide/astro";
---
<section class="sst-calculator">
  <div class="sst-layout">
    <aside class="sst-sidebar">
      <div class="sst-group">
        <h3>Income</h3>
        <CalculatorField id="annualWages" label="Annual Wages / Net Earnings" type="number" placeholder="e.g. 80000" min="0" step="1" />
        <CalculatorField type="select" id="employmentType" label="Employment Type">
  <option value="employee">Employee</option>
  <option value="self">Self-Employed</option>
</CalculatorField>
      </div>
      <CalculatorActions calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="sst-content">
      <div id="emptyState">
        <EmptyState icon="🛡️" title="Social Security Tax Calculator" description="Find your 2026 Social Security tax and wage base cap status." tips={["SS Tax Owed", "Taxable Wages", "Wage Base Cap"]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="primaryTaxResult" title="Social Security Tax" icon={Shield} accent="success" subtitle=" " />
          <ResultCard id="taxableWagesResult" title="Taxable Wages" icon={Wallet} />
          <ResultCard id="wagesOverCapResult" title="Wages Over Cap" icon={TrendingUp} />
          <ResultCard id="capStatusResult" title="Cap Status" icon={Gauge} subtitle=" " />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>About this Calculator</h2>
          <p>Calculates Social Security tax using the 2026 wage base cap of $184,500, for both employees (6.2%) and self-employed individuals (12.4%).</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script>
  import "../../scripts/social-security-tax-calculator";
</script>
<style>
.sst-calculator{width:100%;}
.sst-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.sst-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.sst-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.sst-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.sst-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.sst-layout{grid-template-columns:1fr;}.sst-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.sst-layout{gap:24px;}.sst-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
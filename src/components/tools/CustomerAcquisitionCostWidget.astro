---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import CurrencySelector from "../calculator/CurrencySelector.astro";

import {
  DollarSign,
  Users,
  Wallet,
  Target
} from "@lucide/astro";

interface Props {
  lang?: "en" | "es";
}
const { lang = "en" } = Astro.props as Props;

const copy = {
  en: {
    marketingCost: "Marketing Cost", marketingHelp: "Total marketing spend for the period.",
    salesCost: "Sales Cost", salesHelp: "Total sales team spend for the period (optional).",
    newCustomers: "New Customers", newCustomersHelp: "Number of new customers acquired in the period.",
    totalLeads: "Total Leads", totalLeadsHelp: "Total leads generated, to also see cost per lead (optional).",
    calculate: "Calculate", reset: "Reset", copy: "Copy",
    emptyTitle: "Customer Acquisition Cost Calculator", emptyDesc: "Find out how much it costs to acquire a new customer.",
    tip1: "CAC per Customer", tip2: "Total Spend", tip3: "Cost per Lead",
    cac: "Customer Acquisition Cost", totalSpend: "Total Spend", costPerLead: "Cost per Lead",
    aboutTitle: "About this Calculator",
    aboutText: "Calculate your Customer Acquisition Cost (CAC) by combining marketing and sales spend and dividing by the number of new customers acquired. Compare this against Customer Lifetime Value to check whether your acquisition spend is sustainable.",
  },
  es: {
    marketingCost: "Costo de Marketing", marketingHelp: "Gasto total de marketing durante el período.",
    salesCost: "Costo de Ventas", salesHelp: "Gasto total del equipo de ventas durante el período (opcional).",
    newCustomers: "Clientes Nuevos", newCustomersHelp: "Número de clientes nuevos adquiridos en el período.",
    totalLeads: "Leads Totales", totalLeadsHelp: "Total de leads generados, para también ver el costo por lead (opcional).",
    calculate: "Calcular", reset: "Restablecer", copy: "Copiar",
    emptyTitle: "Calculadora de Costo de Adquisición de Clientes", emptyDesc: "Descubre cuánto cuesta adquirir un nuevo cliente.",
    tip1: "CAC por Cliente", tip2: "Gasto Total", tip3: "Costo por Lead",
    cac: "Costo de Adquisición de Clientes", totalSpend: "Gasto Total", costPerLead: "Costo por Lead",
    aboutTitle: "Acerca de esta Calculadora",
    aboutText: "Calcula tu Costo de Adquisición de Clientes (CAC) combinando el gasto de marketing y ventas y dividiéndolo entre el número de clientes nuevos adquiridos. Compara esto con el Valor de Vida del Cliente para verificar si tu gasto de adquisición es sostenible.",
  },
}[lang];
---

<section class="cac-calculator">

  <div class="cac-layout">

     <aside class="cac-sidebar">
      <CurrencySelector />

      <CalculatorField
        id="marketingCost"        label={copy.marketingCost}
        type="number"
        required={true}
        helpText={copy.marketingHelp}
      />

      <CalculatorField
        id="salesCost"
        label={copy.salesCost}
        type="number"
        helpText={copy.salesHelp}
      />

      <CalculatorField
        id="newCustomers"
        label={copy.newCustomers}
        type="number"
        required={true}
        helpText={copy.newCustomersHelp}
      />

      <CalculatorField
        id="totalLeads"
        label={copy.totalLeads}
        type="number"
        helpText={copy.totalLeadsHelp}
      />

      <CalculatorActions
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
        calculateText={copy.calculate}
        resetText={copy.reset}
        copyText={copy.copy}
      />

      <div id="errorBox" class="error-box" hidden></div>

    </aside>

    <main class="cac-content">

      <div id="emptyState">

        <EmptyState
          icon="🎯"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={[
            copy.tip1,
            copy.tip2,
            copy.tip3
          ]}
        />

      </div>

      <div id="resultsContainer" hidden>

        <ResultsGrid columns={3}>

          <ResultCard
            id="cacResult"
            title={copy.cac}
            icon={Target}
            subtitle=" "
          />

          <ResultCard
            id="totalSpendResult"
            title={copy.totalSpend}
            icon={Wallet}
          />

          <ResultCard
            id="costPerLeadResult"
            title={copy.costPerLead}
            icon={Users}
          />

        </ResultsGrid>

        <section class="calculator-info">

          <h2>{copy.aboutTitle}</h2>

          <p>
            {copy.aboutText}
          </p>

        </section>

      </div>

    </main>

  </div>

</section>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/customer-acquisition-cost";
</script>

<style>

.cac-calculator{

width:100%;

}

.cac-layout{

display:grid;

grid-template-columns:340px minmax(0,1fr);

gap:32px;

align-items:start;

}

.cac-sidebar{

position:sticky;

top:24px;

display:flex;

flex-direction:column;

gap:20px;

}

.cac-content{

display:flex;

flex-direction:column;

gap:28px;

min-width:0;

}

.calculator-info{

padding:24px;

border:1px solid var(--border-subtle);

border-radius:18px;

background:var(--bg-card);

}

.calculator-info h2{

margin:0 0 12px;

font-size:1.15rem;

font-weight:700;

color:var(--text-primary);

}

.calculator-info p{

margin:0;

line-height:1.8;

font-size:.95rem;

color:var(--text-secondary);

}

.error-box{

display:flex;

align-items:center;

padding:14px 16px;

border-radius:14px;

background:#FEF2F2;

border:1px solid #FCA5A5;

color:#B91C1C;

font-size:.92rem;

font-weight:600;

}

:global(.dark) .error-box{

background:#2A1111;

border-color:#7F1D1D;

color:#FECACA;

}

@media(max-width:1024px){

.cac-layout{

grid-template-columns:1fr;

}

.cac-sidebar{

position:static;

}

}

@media(max-width:768px){

.cac-layout{

gap:24px;

}

.cac-content{

gap:20px;

}

}

@media(max-width:640px){

.calculator-info{

padding:18px;

}

}

</style>

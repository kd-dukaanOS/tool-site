---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Wallet, TrendingDown, Receipt, Calendar } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { loanDetails:"Loan Details", loanAmount:"Loan Amount", rate:"Interest Rate (%)", term:"Loan Term (years)", extra:"Extra Monthly Payment", emptyTitle:"Student Loan Calculator", emptyDesc:"Estimate your monthly payment, interest, and payoff time.", tip1:"Monthly Payment", tip2:"Total Interest", tip3:"Payoff Time", monthlyPayment:"Monthly Payment", totalInterest:"Total Interest", totalPaid:"Total Paid", payoffTime:"Payoff Time", withExtra:"With extra payments", standardTerm:"Standard term", aboutTitle:"About this Calculator", aboutText:"Estimates your monthly student loan payment and total interest using standard amortization, and shows how extra payments shorten your payoff time.", yLabel:"y", mLabel:"m" },
  es: { loanDetails:"Detalles del Préstamo", loanAmount:"Monto del Préstamo", rate:"Tasa de Interés (%)", term:"Plazo del Préstamo (años)", extra:"Pago Mensual Adicional", emptyTitle:"Calculadora de Préstamo Estudiantil", emptyDesc:"Calcula tu pago mensual, interés y tiempo de pago.", tip1:"Pago Mensual", tip2:"Interés Total", tip3:"Tiempo de Pago", monthlyPayment:"Pago Mensual", totalInterest:"Interés Total", totalPaid:"Total Pagado", payoffTime:"Tiempo de Pago", withExtra:"Con pagos adicionales", standardTerm:"Plazo estándar", aboutTitle:"Acerca de esta Calculadora", aboutText:"Calcula tu pago mensual de préstamo estudiantil e interés total usando amortización estándar, y muestra cómo los pagos adicionales acortan tu tiempo de pago.", yLabel:"a", mLabel:"m" },
}[lang];
---
<section class="stl-calculator">
  <div class="stl-layout">
    <aside class="stl-sidebar">
      <div class="stl-group">
        <h3>{copy.loanDetails}</h3>
        <CalculatorField id="loanAmount" label={copy.loanAmount} type="number" placeholder="e.g. 30000" min="0" step="1" />
        <CalculatorField id="interestRate" label={copy.rate} type="number" placeholder="e.g. 6" min="0" step="0.01" />
        <CalculatorField id="loanTermYears" label={copy.term} type="number" placeholder="e.g. 10" min="1" step="1" />
        <CalculatorField id="extraMonthlyPayment" label={copy.extra} type="number" placeholder="e.g. 0" min="0" step="1" />
      </div>
      <CalculatorActions calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="stl-content">
      <div id="emptyState">
        <EmptyState icon="🎓" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="monthlyPaymentResult" title={copy.monthlyPayment} icon={Wallet} accent="success" subtitle=" " />
          <ResultCard id="totalInterestResult" title={copy.totalInterest} icon={TrendingDown} />
          <ResultCard id="totalPaidResult" title={copy.totalPaid} icon={Receipt} />
          <ResultCard id="payoffTimeResult" title={copy.payoffTime} icon={Calendar} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang, withExtraLabel: copy.withExtra, standardTermLabel: copy.standardTerm, yLabel: copy.yLabel, mLabel: copy.mLabel }}>
  window.calcLang = calcLang;
  window.stlWithExtraLabel = withExtraLabel;
  window.stlStandardTermLabel = standardTermLabel;
  window.stlYLabel = yLabel;
  window.stlMLabel = mLabel;
</script>
<script>
  import "../../scripts/student-loan-calculator";
</script>
<style>
.stl-calculator{width:100%;}
.stl-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.stl-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.stl-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.stl-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.stl-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.stl-layout{grid-template-columns:1fr;}.stl-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.stl-layout{gap:24px;}.stl-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
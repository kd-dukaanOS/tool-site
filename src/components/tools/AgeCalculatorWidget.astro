---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";

import {
  Cake,
  CalendarDays,
  CalendarRange,
  Clock3,
  Timer,
  Hourglass,
  PartyPopper,
  Gem,
  Star,
  Baby,
  Sun,
  Orbit
} from "@lucide/astro";

interface Props {
  lang?: "en" | "es";
}
const { lang = "en" } = Astro.props as Props;

const copy = {
  en: {
    dobLabel: "Date of Birth", dobHelp: "Select your date of birth.",
    targetLabel: "Calculate Age On", targetHelp: "Leave blank to calculate today's age.",
    emptyTitle: "Age Calculator", emptyDesc: "Calculate your exact age instantly.",
    tips: ["Years, Months & Days", "Age on Any Date", "Birthday Countdown", "Birthstone", "Zodiac", "Generation"],
    years: "Years", months: "Months", days: "Days", weeks: "Weeks", hours: "Hours",
    minutes: "Minutes", seconds: "Seconds", nextBirthday: "Next Birthday",
    weekdayBorn: "Weekday Born", westernZodiac: "Western Zodiac", chineseZodiac: "Chinese Zodiac",
    birthstone: "Birthstone", generation: "Generation",
    aboutTitle: "About this Calculator",
    aboutText: "Calculate your exact age in years, months, weeks, days, hours, minutes and seconds. You can also calculate your age on any future or past date.",
  },
  es: {
    dobLabel: "Fecha de Nacimiento", dobHelp: "Selecciona tu fecha de nacimiento.",
    targetLabel: "Calcular Edad Al", targetHelp: "Déjalo en blanco para calcular tu edad de hoy.",
    emptyTitle: "Calculadora de Edad", emptyDesc: "Calcula tu edad exacta al instante.",
    tips: ["Años, Meses y Días", "Edad en Cualquier Fecha", "Cuenta Regresiva de Cumpleaños", "Piedra del Mes", "Zodiaco", "Generación"],
    years: "Años", months: "Meses", days: "Días", weeks: "Semanas", hours: "Horas",
    minutes: "Minutos", seconds: "Segundos", nextBirthday: "Próximo Cumpleaños",
    weekdayBorn: "Día de Nacimiento", westernZodiac: "Zodiaco Occidental", chineseZodiac: "Zodiaco Chino",
    birthstone: "Piedra del Mes", generation: "Generación",
    aboutTitle: "Sobre esta Calculadora",
    aboutText: "Calcula tu edad exacta en años, meses, semanas, días, horas, minutos y segundos. También puedes calcular tu edad en cualquier fecha futura o pasada.",
  },
}[lang];
---
---

<section class="age-calculator">

  <div class="age-layout">

    <!-- Sidebar -->

    <aside class="age-sidebar">

      <CalculatorField
        id="birthDate"
        label={copy.dobLabel}
        type="date"
        required={true}
        helpText={copy.dobHelp}
      />

      <CalculatorField
        id="targetDate"
        label={copy.targetLabel}
        type="date"
        helpText={copy.targetHelp}
      />

      <CalculatorActions
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
      />

      <div
        id="errorBox"
        class="error-box"
        hidden
      ></div>

    </aside>

    <!-- Results -->

    <main class="age-content">

      <div id="emptyState">

       <EmptyState
          icon="🎂"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={copy.tips}
        />

      </div>

      <div
        id="resultsContainer"
        hidden
      >

        <ResultsGrid columns={3}>

          <ResultCard id="yearsResult" title={copy.years} icon={Cake} />
          <ResultCard id="monthsResult" title={copy.months} icon={CalendarDays} />
          <ResultCard id="daysResult" title={copy.days} icon={CalendarRange} />
          <ResultCard id="weeksResult" title={copy.weeks} icon={CalendarRange} />
          <ResultCard id="hoursResult" title={copy.hours} icon={Clock3} />
          <ResultCard id="minutesResult" title={copy.minutes} icon={Timer} />
          <ResultCard id="secondsResult" title={copy.seconds} icon={Hourglass} />
          <ResultCard id="birthdayResult" title={copy.nextBirthday} icon={PartyPopper} subtitle=" " />
          <ResultCard id="weekdayResult" title={copy.weekdayBorn} icon={Sun} />
          <ResultCard id="zodiacResult" title={copy.westernZodiac} icon={Star} />
          <ResultCard id="chineseResult" title={copy.chineseZodiac} icon={Orbit} />
          <ResultCard id="birthstoneResult" title={copy.birthstone} icon={Gem} />
          <ResultCard id="generationResult" title={copy.generation} icon={Baby} />

        </ResultsGrid>
                <section class="calculator-info">

           <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>

        </section>

      </div>

    </main>

  </div>

</section>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/age-calculator";
</script>

<style>

.age-calculator{

width:100%;

}

.age-layout{

display:grid;

grid-template-columns:340px minmax(0,1fr);

gap:32px;

align-items:start;

}

.age-sidebar{

position:sticky;

top:24px;

display:flex;

flex-direction:column;

gap:20px;

}

.age-content{

display:flex;

flex-direction:column;

gap:28px;

min-width:0;

}

.calculator-info{

padding:24px;

border:1px solid var(--border-subtle);

border-radius:18px;

background:var(--bg-card);

}

.calculator-info h2{

margin:0 0 12px;

font-size:1.15rem;

font-weight:700;

color:var(--text-primary);

}

.calculator-info p{

margin:0;

line-height:1.8;

font-size:.95rem;

color:var(--text-secondary);

}

.error-box{

display:flex;

align-items:center;

padding:14px 16px;

border-radius:14px;

background:#FEF2F2;

border:1px solid #FCA5A5;

color:#B91C1C;

font-size:.92rem;

font-weight:600;

}

:global(.dark) .error-box{

background:#2A1111;

border-color:#7F1D1D;

color:#FECACA;

}

@media(max-width:1024px){

.age-layout{

grid-template-columns:1fr;

}

.age-sidebar{

position:static;

}

}

@media(max-width:768px){

.age-layout{

gap:24px;

}

.age-content{

gap:20px;

}

}

@media(max-width:640px){

.calculator-info{

padding:18px;

}

}

</style>

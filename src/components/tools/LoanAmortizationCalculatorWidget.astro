---
{/* src/components/tools/LoanAmortizationCalculatorWidget.astro */}
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";

import { Wallet, Landmark, Receipt, CalendarClock } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { amount:"Loan Amount ($)", rate:"Annual Interest Rate (%)", term:"Loan Term (Years)", extra:"Extra Monthly Payment ($)", extraHelp:"Optional — pay off the loan faster.", emptyTitle:"Loan Amortization Calculator", emptyDesc:"See your monthly payment, total interest, and full year-by-year payoff schedule.", tip1:"Monthly Payment", tip2:"Amortization Schedule", monthlyPayment:"Monthly Payment", totalInterest:"Total Interest", totalPayment:"Total Payment", payoffTime:"Payoff Time", scheduleTitle:"Yearly Amortization Schedule", year:"Year", principalPaid:"Principal Paid", interestPaid:"Interest Paid", endingBalance:"Ending Balance", aboutTitle:"About this Calculator", aboutText:"Calculates your monthly loan payment and full amortization schedule using the standard fixed-rate amortization formula. Add an optional extra monthly payment to see how much faster you'd pay off the loan and how much interest you'd save." },
  es: { amount:"Monto del Préstamo ($)", rate:"Tasa de Interés Anual (%)", term:"Plazo del Préstamo (Años)", extra:"Pago Mensual Extra ($)", extraHelp:"Opcional — paga el préstamo más rápido.", emptyTitle:"Calculadora de Amortización de Préstamo", emptyDesc:"Consulta tu pago mensual, interés total y el calendario de pago año por año.", tip1:"Pago Mensual", tip2:"Calendario de Amortización", monthlyPayment:"Pago Mensual", totalInterest:"Interés Total", totalPayment:"Pago Total", payoffTime:"Tiempo de Pago", scheduleTitle:"Calendario Anual de Amortización", year:"Año", principalPaid:"Capital Pagado", interestPaid:"Interés Pagado", endingBalance:"Saldo Final", aboutTitle:"Acerca de esta Calculadora", aboutText:"Calcula tu pago mensual del préstamo y el calendario completo de amortización usando la fórmula estándar de tasa fija. Agrega un pago mensual extra opcional para ver qué tan rápido pagarías el préstamo y cuánto interés ahorrarías." },
}[lang];
---

<section class="la-calculator">
  <div class="la-layout">

    <aside class="la-sidebar">
      <CalculatorField
        id="loanAmount"
        label={copy.amount}
        type="number"
        placeholder="e.g. 300000"
        required={true}
        min="0"
        step="0.01"
      />

      <CalculatorField
        id="interestRate"
        label={copy.rate}
        type="number"
        placeholder="e.g. 6.5"
        required={true}
        min="0"
        step="0.01"
      />

      <CalculatorField
        id="termYears"
        label={copy.term}
        type="number"
        placeholder="e.g. 30"
        required={true}
        min="1"
        step="1"
      />

      <CalculatorField
        id="extraMonthlyPayment"
        label={copy.extra}
        type="number"
        placeholder="e.g. 0"
        min="0"
        step="0.01"
        helpText={copy.extraHelp}
      />

      <CalculatorActions lang={lang}
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
      />

      <div id="errorBox" class="error-box" hidden></div>
    </aside>

    <main class="la-content">
      <div id="emptyState">
        <EmptyState
          icon="🏦"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={[copy.tip1, copy.tip2]}
        />
      </div>

      <div id="resultsContainer" hidden>
        <ResultsGrid columns={2}>
          <ResultCard id="monthlyPaymentResult" title={copy.monthlyPayment} icon={Wallet} accent="primary" size="lg" />
          <ResultCard id="totalInterestResult" title={copy.totalInterest} icon={Landmark} accent="neutral" size="lg" />
          <ResultCard id="totalPaymentResult" title={copy.totalPayment} icon={Receipt} accent="neutral" />
          <ResultCard id="payoffTimeResult" title={copy.payoffTime} icon={CalendarClock} accent="primary" />
        </ResultsGrid>

        <section class="amortization-table-section">
          <h2>{copy.scheduleTitle}</h2>
          <div class="table-scroll">
            <table class="amortization-table">
              <thead>
                <tr>
                  <th>{copy.year}</th>
                  <th>{copy.principalPaid}</th>
                  <th>{copy.interestPaid}</th>
                  <th>{copy.endingBalance}</th>
                </tr>
              </thead>
              <tbody id="scheduleTableBody"></tbody>
            </table>
          </div>
        </section>

        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>

  </div>
</section>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/loan-amortization-calculator";
</script>

<style>
.la-calculator{ width:100%; }
.la-layout{ display:grid; grid-template-columns:340px minmax(0,1fr); gap:32px; align-items:start; }
.la-sidebar{ position:sticky; top:24px; display:flex; flex-direction:column; gap:20px; }
.la-content{ display:flex; flex-direction:column; gap:28px; min-width:0; }
.amortization-table-section{ padding:24px; border:1px solid var(--border-subtle); border-radius:18px; background:var(--bg-card); }
.amortization-table-section h2{ margin:0 0 16px; font-size:1.15rem; font-weight:700; color:var(--text-primary); }
.table-scroll{ overflow-x:auto; max-height:420px; overflow-y:auto; }
.amortization-table{ width:100%; border-collapse:collapse; font-size:.9rem; }
.amortization-table th{ text-align:left; padding:10px 12px; border-bottom:2px solid var(--border-subtle); color:var(--text-secondary); position:sticky; top:0; background:var(--bg-card); }
.amortization-table td{ padding:10px 12px; border-bottom:1px solid var(--border-subtle); color:var(--text-primary); }
.calculator-info{ padding:24px; border:1px solid var(--border-subtle); border-radius:18px; background:var(--bg-card); }
.calculator-info h2{ margin:0 0 12px; font-size:1.15rem; font-weight:700; color:var(--text-primary); }
.calculator-info p{ margin:0; line-height:1.8; font-size:.95rem; color:var(--text-secondary); }
.error-box{ display:flex; align-items:center; padding:14px 16px; border-radius:14px; background:#FEF2F2; border:1px solid #FCA5A5; color:#B91C1C; font-size:.92rem; font-weight:600; }
:global(.dark) .error-box{ background:#2A1111; border-color:#7F1D1D; color:#FECACA; }
@media(max-width:1024px){ .la-layout{ grid-template-columns:1fr; } .la-sidebar{ position:static; } }
@media(max-width:768px){ .la-layout{ gap:24px; } .la-content{ gap:20px; } }
@media(max-width:640px){ .calculator-info, .amortization-table-section{ padding:18px; } }
</style>
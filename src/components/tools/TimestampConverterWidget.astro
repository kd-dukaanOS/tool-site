---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Clock, Globe, MapPin, History, Hash, Milestone } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { inputLabel:"Timestamp or Date", useNow:"Use Now", emptyTitle:"Timestamp Converter", emptyDesc:"Convert between Unix timestamps and human-readable dates.", tip1:"Unix Seconds & Millis", tip2:"ISO 8601", tip3:"UTC & Local Time", tip4:"Relative Time", unixSeconds:"Unix (seconds)", unixMillis:"Unix (millis)", relative:"Relative", iso:"ISO 8601", utc:"UTC", local:"Local Time", aboutTitle:"About this Tool", aboutText:"Convert Unix timestamps to human-readable dates, or dates to Unix time, with ISO 8601, UTC, local time and relative time formats.", parseError:"Could not parse timestamp or date.", emptyInputError:"Please enter a timestamp or date.", second:"second", minute:"minute", hour:"hour", day:"day", week:"week", month:"month", year:"year", fromNow:"from now", ago:"ago" },
  es: { inputLabel:"Marca de Tiempo o Fecha", useNow:"Usar Ahora", emptyTitle:"Convertidor de Marca de Tiempo", emptyDesc:"Convierte entre marcas de tiempo Unix y fechas legibles.", tip1:"Segundos y Milisegundos Unix", tip2:"ISO 8601", tip3:"UTC y Hora Local", tip4:"Tiempo Relativo", unixSeconds:"Unix (segundos)", unixMillis:"Unix (milisegundos)", relative:"Relativo", iso:"ISO 8601", utc:"UTC", local:"Hora Local", aboutTitle:"Acerca de esta Herramienta", aboutText:"Convierte marcas de tiempo Unix a fechas legibles, o fechas a tiempo Unix, con formatos ISO 8601, UTC, hora local y tiempo relativo.", parseError:"No se pudo interpretar la marca de tiempo o fecha.", emptyInputError:"Por favor ingresa una marca de tiempo o fecha.", second:"segundo", minute:"minuto", hour:"hora", day:"día", week:"semana", month:"mes", year:"año", fromNow:"a partir de ahora", ago:"hace" },
}[lang];
---
<section class="timestamp-converter">
  <div class="ts-layout">
    <aside class="ts-sidebar">

      <CalculatorField id="timestampInput" label={copy.inputLabel} type="text" placeholder="1735689600 or 2026-01-01" />

      <div class="tool-actions">
        <button id="nowBtn" class="tool-btn tool-btn-secondary">{copy.useNow}</button>
      </div>

      <CalculatorActions calculateId="convertBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>

    <main class="ts-content">
      <div id="emptyState">
        <EmptyState
          icon="🕒"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={[copy.tip1, copy.tip2, copy.tip3, copy.tip4]}
        />
      </div>

      <div id="resultsContainer" hidden>
        <ResultsGrid columns={3}>
          <ResultCard id="unixSecondsResult" title={copy.unixSeconds} icon={Hash} />
          <ResultCard id="unixMillisResult" title={copy.unixMillis} icon={Milestone} />
          <ResultCard id="relativeResult" title={copy.relative} icon={History} />
          <ResultCard id="isoResult" title={copy.iso} icon={Clock} />
          <ResultCard id="utcResult" title={copy.utc} icon={Globe} />
          <ResultCard id="localResult" title={copy.local} icon={MapPin} />
        </ResultsGrid>

        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>

<script define:vars={{ calcLang: lang, parseErrorMsg: copy.parseError }}>
  window.calcLang = calcLang;
  window.tsParseErrorMsg = parseErrorMsg;
</script>
<script>
  import "../../scripts/timestamp-converter";
</script>

<style>
.timestamp-converter{width:100%;}
.ts-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.ts-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:16px;}
.ts-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.ts-layout{grid-template-columns:1fr;}.ts-sidebar{position:static;}}
</style>

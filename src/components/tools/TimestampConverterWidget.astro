---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Clock, Globe, MapPin, History, Hash, Milestone } from "@lucide/astro";
---
<section class="timestamp-converter">
  <div class="ts-layout">
    <aside class="ts-sidebar">

      <CalculatorField id="timestampInput" label="Timestamp or Date" type="text" placeholder="1735689600 or 2026-01-01" />

      <div class="tool-actions">
        <button id="nowBtn" class="tool-btn tool-btn-secondary">Use Now</button>
      </div>

      <CalculatorActions calculateId="convertBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>

    <main class="ts-content">
      <div id="emptyState">
        <EmptyState
          icon="🕒"
          title="Timestamp Converter"
          description="Convert between Unix timestamps and human-readable dates."
          tips={["Unix Seconds & Millis", "ISO 8601", "UTC & Local Time", "Relative Time"]}
        />
      </div>

      <div id="resultsContainer" hidden>
        <ResultsGrid columns={3}>
          <ResultCard id="unixSecondsResult" title="Unix (seconds)" icon={Hash} />
          <ResultCard id="unixMillisResult" title="Unix (millis)" icon={Milestone} />
          <ResultCard id="relativeResult" title="Relative" icon={History} />
          <ResultCard id="isoResult" title="ISO 8601" icon={Clock} />
          <ResultCard id="utcResult" title="UTC" icon={Globe} />
          <ResultCard id="localResult" title="Local Time" icon={MapPin} />
        </ResultsGrid>

        <section class="calculator-info">
          <h2>About this Tool</h2>
          <p>Convert Unix timestamps to human-readable dates, or dates to Unix time, with ISO 8601, UTC, local time and relative time formats.</p>
        </section>
      </div>
    </main>
  </div>
</section>

<script>
  import "../../scripts/timestamp-converter";
</script>

<style>
.timestamp-converter{width:100%;}
.ts-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.ts-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:16px;}
.ts-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.ts-layout{grid-template-columns:1fr;}.ts-sidebar{position:static;}}
</style>

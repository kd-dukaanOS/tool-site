---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Wallet, Percent, Calendar, Receipt } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { basicsGroup:"W-4 Basics", filingStatus:"Filing Status", single:"Single or Married Filing Separately", married:"Married Filing Jointly", hoh:"Head of Household", payFrequency:"Pay Frequency", weekly:"Weekly", biweekly:"Biweekly", semimonthly:"Semimonthly", monthly:"Monthly", annual:"Annual", grossPay:"Gross Pay per Period", multipleJobs:"Multiple Jobs / Spouse Works", adjustmentsGroup:"W-4 Adjustments", dependents:"Dependents Credit (annual)", otherIncome:"Other Income (annual)", deductions:"Deductions (annual)", extra:"Extra Withholding (per paycheck)", emptyTitle:"Tax Withholding Calculator", emptyDesc:"Estimate your federal paycheck withholding based on your W-4.", tip1:"Withholding per Paycheck", tip2:"Annual Tax Withheld", tip3:"Effective Rate", perPaycheck:"Withholding per Paycheck", annualWithholding:"Annual Withholding", effectiveRate:"Effective Rate", annualGross:"Annual Gross Income", basedOn:"Based on", pay:"pay", aboutTitle:"About this Calculator", aboutText:"Estimates federal income tax withheld from each paycheck using the IRS Percentage Method, based on your filing status, pay frequency, dependents, and W-4 adjustments." },
  es: { basicsGroup:"Datos Básicos del W-4", filingStatus:"Estado Civil Tributario", single:"Soltero o Casado Declarando por Separado", married:"Casado Declarando en Conjunto", hoh:"Cabeza de Familia", payFrequency:"Frecuencia de Pago", weekly:"Semanal", biweekly:"Quincenal", semimonthly:"Bimensual", monthly:"Mensual", annual:"Anual", grossPay:"Pago Bruto por Período", multipleJobs:"Múltiples Empleos / Cónyuge Trabaja", adjustmentsGroup:"Ajustes del W-4", dependents:"Crédito por Dependientes (anual)", otherIncome:"Otros Ingresos (anual)", deductions:"Deducciones (anual)", extra:"Retención Adicional (por cheque)", emptyTitle:"Calculadora de Retención de Impuestos", emptyDesc:"Calcula la retención federal de tu cheque de pago según tu W-4.", tip1:"Retención por Cheque", tip2:"Retención Anual", tip3:"Tasa Efectiva", perPaycheck:"Retención por Cheque", annualWithholding:"Retención Anual", effectiveRate:"Tasa Efectiva", annualGross:"Ingreso Bruto Anual", basedOn:"Basado en pago", pay:"", aboutTitle:"Acerca de esta Calculadora", aboutText:"Calcula el impuesto federal retenido de cada cheque de pago usando el Método de Porcentaje del IRS, según tu estado civil tributario, frecuencia de pago, dependientes y ajustes del W-4." },
}[lang];
---
<section class="twh-calculator">
  <div class="twh-layout">
    <aside class="twh-sidebar">
      <div class="twh-group">
        <h3>{copy.basicsGroup}</h3>
        <CalculatorField id="filingStatus" label={copy.filingStatus} type="select">
          <option value="single">{copy.single}</option>
          <option value="married">{copy.married}</option>
          <option value="headOfHousehold">{copy.hoh}</option>
        </CalculatorField>
        <CalculatorField id="payFrequency" label={copy.payFrequency} type="select">
          <option value="weekly">{copy.weekly}</option>
          <option value="biweekly">{copy.biweekly}</option>
          <option value="semimonthly">{copy.semimonthly}</option>
          <option value="monthly">{copy.monthly}</option>
          <option value="annual">{copy.annual}</option>
        </CalculatorField>
        <CalculatorField id="grossPayPerPeriod" label={copy.grossPay} type="number" placeholder="e.g. 2500" min="0" step="1" />
        <CalculatorField id="multipleJobs" label={copy.multipleJobs} type="checkbox" />
      </div>
      <div class="twh-group">
        <h3>{copy.adjustmentsGroup}</h3>
        <CalculatorField id="dependentsAmountAnnual" label={copy.dependents} type="number" placeholder="e.g. 2000" min="0" step="1" />
        <CalculatorField id="otherIncomeAnnual" label={copy.otherIncome} type="number" placeholder="e.g. 0" min="0" step="1" />
        <CalculatorField id="deductionsAnnual" label={copy.deductions} type="number" placeholder="e.g. 0" min="0" step="1" />
        <CalculatorField id="extraWithholdingPerPeriod" label={copy.extra} type="number" placeholder="e.g. 0" min="0" step="1" />
      </div>
      <CalculatorActions calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="twh-content">
      <div id="emptyState">
        <EmptyState icon="🧾" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="perPeriodResult" title={copy.perPaycheck} icon={Wallet} accent="success" subtitle=" " />
          <ResultCard id="annualTaxResult" title={copy.annualWithholding} icon={Receipt} />
          <ResultCard id="effectiveRateResult" title={copy.effectiveRate} icon={Percent} />
          <ResultCard id="annualGrossResult" title={copy.annualGross} icon={Calendar} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang, basedOnLabel: copy.basedOn, payLabel: copy.pay }}>
  window.calcLang = calcLang;
  window.twhBasedOnLabel = basedOnLabel;
  window.twhPayLabel = payLabel;
</script>
<script>
  import "../../scripts/tax-withholding-calculator";
</script>
<style>
.twh-calculator{width:100%;}
.twh-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.twh-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.twh-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.twh-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.twh-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.twh-layout{grid-template-columns:1fr;}.twh-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.twh-layout{gap:24px;}.twh-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>

---
{/* src/components/tools/RoasCalculatorWidget.astro */}
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import CurrencySelector from "../calculator/CurrencySelector.astro";

import { TrendingUp, Percent, DollarSign } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { revenue:"Revenue from Ads ($)", revenueHelp:"Total revenue generated by the ad campaign.", adSpend:"Ad Spend ($)", adSpendHelp:"Total amount spent on the ad campaign.", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"ROAS Calculator", emptyDesc:"Find your Return on Ad Spend (ROAS) and campaign profit from revenue and ad cost.", tip1:"ROAS", tip2:"Return %", tip3:"Profit", roas:"ROAS", returnPct:"Return %", profit:"Profit", aboutTitle:"About this Calculator", aboutText:"Calculates Return on Ad Spend (ROAS) and campaign profit from ad revenue and ad spend. All calculations run locally — no external data or paid service is required." },
  es: { revenue:"Ingresos por Anuncios ($)", revenueHelp:"Ingresos totales generados por la campaña publicitaria.", adSpend:"Gasto Publicitario ($)", adSpendHelp:"Monto total gastado en la campaña publicitaria.", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora de ROAS", emptyDesc:"Encuentra tu Retorno de la Inversión Publicitaria (ROAS) y la ganancia de la campaña a partir de ingresos y costo publicitario.", tip1:"ROAS", tip2:"Retorno %", tip3:"Ganancia", roas:"ROAS", returnPct:"Retorno %", profit:"Ganancia", aboutTitle:"Acerca de esta Calculadora", aboutText:"Calcula el Retorno de la Inversión Publicitaria (ROAS) y la ganancia de la campaña a partir de los ingresos y el gasto publicitario. Todos los cálculos se ejecutan localmente — no se requieren datos externos ni servicios pagados." },
}[lang];
---

<section class="roas-calculator">
  <div class="roas-layout">

    <aside class="roas-sidebar">
      <CurrencySelector />

      <CalculatorField
        id="revenue"
        label={copy.revenue}
        type="number"
        placeholder="e.g. 5000"
        required={true}
        min="0"
        step="0.01"
        helpText={copy.revenueHelp}
      />

      <CalculatorField
        id="adSpend"
        label={copy.adSpend}
        type="number"
        placeholder="e.g. 1000"
        required={true}
        min="0"
        step="0.01"
        helpText={copy.adSpendHelp}
      />

      <CalculatorActions lang={lang}
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
        calculateText={copy.calculate}
        resetText={copy.reset}
        copyText={copy.copy}
      />

      <div id="errorBox" class="error-box" hidden></div>
    </aside>

    <main class="roas-content">
      <div id="emptyState">
        <EmptyState
          icon="📢"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={[copy.tip1, copy.tip2, copy.tip3]}
        />
      </div>

      <div id="resultsContainer" hidden>
        <ResultsGrid columns={3}>
          <ResultCard id="roasResult" title={copy.roas} icon={TrendingUp} accent="success" size="lg" />
          <ResultCard id="roasPercentResult" title={copy.returnPct} icon={Percent} accent="primary" />
          <ResultCard id="profitResult" title={copy.profit} icon={DollarSign} />
        </ResultsGrid>

        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>

  </div>
</section>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/roas-calculator";
</script>

<style>
.roas-calculator{ width:100%; }
.roas-layout{ display:grid; grid-template-columns:340px minmax(0,1fr); gap:32px; align-items:start; }
.roas-sidebar{ position:sticky; top:24px; display:flex; flex-direction:column; gap:20px; }
.roas-content{ display:flex; flex-direction:column; gap:28px; min-width:0; }
.calculator-info{ padding:24px; border:1px solid var(--border-subtle); border-radius:18px; background:var(--bg-card); }
.calculator-info h2{ margin:0 0 12px; font-size:1.15rem; font-weight:700; color:var(--text-primary); }
.calculator-info p{ margin:0; line-height:1.8; font-size:.95rem; color:var(--text-secondary); }
.error-box{ display:flex; align-items:center; padding:14px 16px; border-radius:14px; background:#FEF2F2; border:1px solid #FCA5A5; color:#B91C1C; font-size:.92rem; font-weight:600; }
:global(.dark) .error-box{ background:#2A1111; border-color:#7F1D1D; color:#FECACA; }
@media(max-width:1024px){ .roas-layout{ grid-template-columns:1fr; } .roas-sidebar{ position:static; } }
@media(max-width:768px){ .roas-layout{ gap:24px; } .roas-content{ gap:20px; } }
@media(max-width:640px){ .calculator-info{ padding:18px; } }
</style>
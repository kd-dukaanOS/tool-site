---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Wallet, Landmark, Building2, Percent } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { personalGroup:"Personal", currentAgeLabel:"Current Age", retirementAgeLabel:"Retirement Age", currentPotLabel:"Current Pension Pot (£)", salaryGroup:"Salary & Contributions", annualSalaryLabel:"Annual Salary (£)", employeePctLabel:"Employee Contribution (%)", employerPctLabel:"Employer Contribution (%)", assumptionsGroup:"Assumptions", returnLabel:"Expected Return (%/yr)", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"UK Pension Calculator", emptyDesc:"Project your pension pot including tax relief and employer contributions.", tip1:"Projected Pot", tip2:"Tax Relief", tip3:"Employer Contributions", projectedPotTitle:"Projected Pot", yourContribTitle:"Your Contributions", employerContribTitle:"Employer Contributions", taxReliefTitle:"Tax Relief Added", aboutTitle:"About this Calculator", aboutText:"Projects your UK pension pot by combining your contributions, automatic basic-rate tax relief, and employer contributions, then compounding the total at your expected return until retirement." },
  es: { personalGroup:"Personal", currentAgeLabel:"Edad Actual", retirementAgeLabel:"Edad de Jubilación", currentPotLabel:"Fondo de Pensión Actual (£)", salaryGroup:"Salario y Contribuciones", annualSalaryLabel:"Salario Anual (£)", employeePctLabel:"Contribución del Empleado (%)", employerPctLabel:"Contribución del Empleador (%)", assumptionsGroup:"Suposiciones", returnLabel:"Retorno Esperado (%/año)", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora de Pensión del Reino Unido", emptyDesc:"Proyecta tu fondo de pensión incluyendo el alivio fiscal y las contribuciones del empleador.", tip1:"Fondo Proyectado", tip2:"Alivio Fiscal", tip3:"Contribuciones del Empleador", projectedPotTitle:"Fondo Proyectado", yourContribTitle:"Tus Contribuciones", employerContribTitle:"Contribuciones del Empleador", taxReliefTitle:"Alivio Fiscal Agregado", aboutTitle:"Acerca de esta Calculadora", aboutText:"Proyecta tu fondo de pensión del Reino Unido combinando tus contribuciones, el alivio fiscal automático de tasa básica, y las contribuciones del empleador, luego capitalizando el total a tu retorno esperado hasta la jubilación." },
}[lang];
---
<section class="ukpen-calculator">
  <div class="ukpen-layout">
    <aside class="ukpen-sidebar">
      <div class="ukpen-group">
        <h3>{copy.personalGroup}</h3>
        <CalculatorField id="currentAge" label={copy.currentAgeLabel} type="number" placeholder="e.g. 30" min="1" step="1" />
        <CalculatorField id="retirementAge" label={copy.retirementAgeLabel} type="number" placeholder="e.g. 65" min="1" step="1" />
        <CalculatorField id="currentPot" label={copy.currentPotLabel} type="number" placeholder="e.g. 10000" min="0" step="1" />
      </div>
      <div class="ukpen-group">
        <h3>{copy.salaryGroup}</h3>
        <CalculatorField id="annualSalary" label={copy.annualSalaryLabel} type="number" placeholder="e.g. 35000" min="0" step="1" />
        <CalculatorField id="employeeContributionPercent" label={copy.employeePctLabel} type="number" placeholder="e.g. 5" min="0" step="0.1" />
        <CalculatorField id="employerContributionPercent" label={copy.employerPctLabel} type="number" placeholder="e.g. 3" min="0" step="0.1" />
      </div>
      <div class="ukpen-group">
        <h3>{copy.assumptionsGroup}</h3>
        <CalculatorField id="expectedReturn" label={copy.returnLabel} type="number" placeholder="e.g. 6" min="0" step="0.1" />
      </div>
      <CalculatorActions lang={lang} calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} calculateText={copy.calculate} resetText={copy.reset} copyText={copy.copy} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="ukpen-content">
      <div id="emptyState">
        <EmptyState icon="🇬🇧" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="projectedPotResult" title={copy.projectedPotTitle} icon={Wallet} accent="success" subtitle=" " />
          <ResultCard id="totalContributionsResult" title={copy.yourContribTitle} icon={Landmark} />
          <ResultCard id="employerContributionsResult" title={copy.employerContribTitle} icon={Building2} />
          <ResultCard id="taxReliefAddedResult" title={copy.taxReliefTitle} icon={Percent} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/uk-pension-calculator";
</script>
<style>
.ukpen-calculator{width:100%;}
.ukpen-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.ukpen-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.ukpen-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.ukpen-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.ukpen-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.ukpen-layout{grid-template-columns:1fr;}.ukpen-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.ukpen-layout{gap:24px;}.ukpen-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
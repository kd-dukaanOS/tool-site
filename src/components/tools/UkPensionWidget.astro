---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Wallet, Landmark, Building2, Percent } from "@lucide/astro";
---
<section class="ukpen-calculator">
  <div class="ukpen-layout">
    <aside class="ukpen-sidebar">
      <div class="ukpen-group">
        <h3>Personal</h3>
        <CalculatorField id="currentAge" label="Current Age" type="number" placeholder="e.g. 30" min="1" step="1" />
        <CalculatorField id="retirementAge" label="Retirement Age" type="number" placeholder="e.g. 65" min="1" step="1" />
        <CalculatorField id="currentPot" label="Current Pension Pot (£)" type="number" placeholder="e.g. 10000" min="0" step="1" />
      </div>
      <div class="ukpen-group">
        <h3>Salary & Contributions</h3>
        <CalculatorField id="annualSalary" label="Annual Salary (£)" type="number" placeholder="e.g. 35000" min="0" step="1" />
        <CalculatorField id="employeeContributionPercent" label="Employee Contribution (%)" type="number" placeholder="e.g. 5" min="0" step="0.1" />
        <CalculatorField id="employerContributionPercent" label="Employer Contribution (%)" type="number" placeholder="e.g. 3" min="0" step="0.1" />
      </div>
      <div class="ukpen-group">
        <h3>Assumptions</h3>
        <CalculatorField id="expectedReturn" label="Expected Return (%/yr)" type="number" placeholder="e.g. 6" min="0" step="0.1" />
      </div>
      <CalculatorActions calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="ukpen-content">
      <div id="emptyState">
        <EmptyState icon="🇬🇧" title="UK Pension Calculator" description="Project your pension pot including tax relief and employer contributions." tips={["Projected Pot", "Tax Relief", "Employer Contributions"]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="projectedPotResult" title="Projected Pot" icon={Wallet} accent="success" subtitle=" " />
          <ResultCard id="totalContributionsResult" title="Your Contributions" icon={Landmark} />
          <ResultCard id="employerContributionsResult" title="Employer Contributions" icon={Building2} />
          <ResultCard id="taxReliefAddedResult" title="Tax Relief Added" icon={Percent} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>About this Calculator</h2>
          <p>Projects your UK pension pot by combining your contributions, automatic basic-rate tax relief, and employer contributions, then compounding the total at your expected return until retirement.</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script>
  import "../../scripts/uk-pension-calculator";
</script>
<style>
.ukpen-calculator{width:100%;}
.ukpen-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.ukpen-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.ukpen-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.ukpen-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.ukpen-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.ukpen-layout{grid-template-columns:1fr;}.ukpen-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.ukpen-layout{gap:24px;}.ukpen-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
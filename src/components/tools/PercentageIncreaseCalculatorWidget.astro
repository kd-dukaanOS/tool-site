---
import CalculatorField from "../calculator/CalculatorField.astro";
import ActionButtons from "../calculator/ActionButtons.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import EmptyState from "../calculator/EmptyState.astro";
import { ArrowUpRight, Percent } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { original:"Original Value", newVal:"New Value", emptyTitle:"Enter values to calculate change", emptyDesc:"Percentage increase or decrease will appear here.", change:"Change", percentChange:"Percentage Change", fillAll:"Please fill all fields." },
  es: { original:"Valor Original", newVal:"Nuevo Valor", emptyTitle:"Ingresa los valores para calcular el cambio", emptyDesc:"El aumento o disminución porcentual aparecerá aquí.", change:"Cambio", percentChange:"Cambio Porcentual", fillAll:"Por favor completa todos los campos." },
}[lang];
---

<div class="calculator-widget">
  <div class="calculator-inputs">
    <CalculatorField id="originalValue" label={copy.original} type="number" placeholder="e.g. 200" />
    <CalculatorField id="newValue" label={copy.newVal} type="number" placeholder="e.g. 250" />

    <div id="errorBox" class="error-box" role="alert" hidden></div>

    <ActionButtons
      calculateId="calculateBtn"
      resetId="resetBtn"
      copyId="copyBtn"
      showDownload={false}
      showShare={false}
    />
  </div>

  <div class="calculator-output">
    <EmptyState
      id="emptyState"
      title={copy.emptyTitle}
      description={copy.emptyDesc}
    />

    <ResultsGrid id="resultsContainer" hidden>
      <ResultCard id="changeResult" title={copy.change} icon={ArrowUpRight} accent="neutral" />
      <ResultCard id="percentResult" title={copy.percentChange} icon={Percent} accent="primary" size="lg" />
    </ResultsGrid>
  </div>
</div>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script src="../../scripts/percentage-increase-calculator.ts"></script>

---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { ArrowRightLeft, Wallet, TrendingUp, Percent } from "@lucide/astro";
---
<section class="cfc-calculator">
  <div class="cfc-layout">
    <aside class="cfc-sidebar">
      <div class="cfc-group">
        <h3>Cash Position</h3>
        <CalculatorField id="beginningCashBalance" label="Beginning Cash Balance" type="number" placeholder="e.g. 50000" min="0" step="1" />
      </div>
      <div class="cfc-group">
        <h3>Operating Activities</h3>
        <CalculatorField id="operatingInflows" label="Operating Cash Inflows" type="number" placeholder="e.g. 40000" min="0" step="1" />
        <CalculatorField id="operatingOutflows" label="Operating Cash Outflows" type="number" placeholder="e.g. 28000" min="0" step="1" />
      </div>
      <div class="cfc-group">
        <h3>Other Activities</h3>
        <CalculatorField id="investingCashFlow" label="Investing Cash Flow (net, +/-)" type="number" placeholder="e.g. -5000" step="1" />
        <CalculatorField id="financingCashFlow" label="Financing Cash Flow (net, +/-)" type="number" placeholder="e.g. 10000" step="1" />
        <CalculatorField id="monthlyRevenue" label="Monthly Revenue (optional)" type="number" placeholder="e.g. 45000" min="0" step="1" />
      </div>
      <CalculatorActions calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="cfc-content">
      <div id="emptyState">
        <EmptyState icon="💵" title="Cash Flow Calculator" description="See your net cash flow, ending balance, and operating cash flow margin." tips={["Net Cash Flow", "Ending Balance", "Cash Flow Margin"]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="netCashFlowResult" title="Net Cash Flow" icon={ArrowRightLeft} accent="success" subtitle=" " />
          <ResultCard id="endingBalanceResult" title="Ending Cash Balance" icon={Wallet} />
          <ResultCard id="operatingCashFlowResult" title="Operating Cash Flow" icon={TrendingUp} />
          <ResultCard id="cashFlowMarginResult" title="Cash Flow Margin" icon={Percent} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>About this Calculator</h2>
          <p>Combines your operating, investing, and financing cash flows to show net cash flow and projected ending cash balance, plus an operating cash flow margin if you provide monthly revenue.</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script>
  import "../../scripts/cash-flow-calculator";
</script>
<style>
.cfc-calculator{width:100%;}
.cfc-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.cfc-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.cfc-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.cfc-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.cfc-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.cfc-layout{grid-template-columns:1fr;}.cfc-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.cfc-layout{gap:24px;}.cfc-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
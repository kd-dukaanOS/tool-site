---
import CalculatorField from "../calculator/CalculatorField.astro";
import ActionButtons from "../calculator/ActionButtons.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import EmptyState from "../calculator/EmptyState.astro";
import { Palette, Hash, Droplet } from "@lucide/astro";
---

<div class="calculator-widget">
  <div class="calculator-form">
    <CalculatorField id="inputFormat" label="Input Format" type="select">
      <option value="hex">HEX</option>
      <option value="rgb">RGB (r,g,b)</option>
    </CalculatorField>

    <CalculatorField id="color" label="Color Value" type="text" placeholder="#ff0000 or 255,0,0" />

    <div id="colorSwatch" class="color-swatch"></div>

    <div id="errorBox" class="error-box" hidden></div>

    <ActionButtons calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" />
  </div>

  <div class="calculator-results">
    <EmptyState id="emptyState" icon="🎨" title="Color Converter" description="Enter a color to convert." />

    <ResultsGrid id="resultsContainer" hidden>
      <ResultCard id="hexResult" title="HEX" icon={Hash} />
      <ResultCard id="rgbResult" title="RGB" icon={Palette} />
      <ResultCard id="hslResult" title="HSL" icon={Droplet} />
    </ResultsGrid>
  </div>
</div>

<script src="../../scripts/color-converter.ts"></script>

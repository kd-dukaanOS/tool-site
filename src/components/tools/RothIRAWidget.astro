---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { PiggyBank, Wallet, TrendingUp, Calendar } from "@lucide/astro";
---
<section class="ri-calculator">
  <div class="ri-layout">
    <aside class="ri-sidebar">
      <div class="ri-group">
        <h3>You</h3>
        <CalculatorField id="currentAge" label="Current Age" type="number" placeholder="e.g. 28" min="1" step="1" />
        <CalculatorField id="retirementAge" label="Retirement Age" type="number" placeholder="e.g. 65" min="1" step="1" />
        <CalculatorField id="currentBalance" label="Current Roth IRA Balance" type="number" placeholder="e.g. 8000" min="0" step="1" />
      </div>
      <div class="ri-group">
        <h3>Contributions & Growth</h3>
        <CalculatorField id="annualContribution" label="Annual Contribution" type="number" placeholder="e.g. 7000" min="0" step="1" />
        <CalculatorField id="expectedReturn" label="Expected Annual Return (%)" type="number" placeholder="e.g. 7" min="0" step="0.1" />
      </div>
      <CalculatorActions calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="ri-content">
      <div id="emptyState">
        <EmptyState icon="🌱" title="Roth IRA Calculator" description="Project your Roth IRA balance at retirement with tax-free growth." tips={["Projected Balance", "Total Contributions", "Investment Growth"]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="projectedBalanceResult" title="Projected Balance" icon={PiggyBank} accent="success" subtitle=" " />
          <ResultCard id="totalContributionsResult" title="Total Contributions" icon={Wallet} />
          <ResultCard id="investmentGrowthResult" title="Investment Growth" icon={TrendingUp} />
          <ResultCard id="yearsInvestedResult" title="Years Invested" icon={Calendar} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>About this Calculator</h2>
          <p>Projects your Roth IRA balance at retirement using your current balance, annual contribution, and expected return, compounded yearly until withdrawal — all growth is tax-free at qualified withdrawal.</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script>
  import "../../scripts/roth-ira-calculator";
</script>
<style>
.ri-calculator{width:100%;}
.ri-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.ri-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;}
.ri-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.ri-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.ri-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.ri-layout{grid-template-columns:1fr;}.ri-sidebar{position:static;}}
@media(max-width:768px){.ri-layout{gap:24px;}.ri-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { PiggyBank, Wallet, TrendingUp, Calendar } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { youGroup:"You", currentAge:"Current Age", retirementAge:"Retirement Age", currentBalance:"Current Roth IRA Balance", growthGroup:"Contributions & Growth", annualContribution:"Annual Contribution", expectedReturn:"Expected Annual Return (%)", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"Roth IRA Calculator", emptyDesc:"Project your Roth IRA balance at retirement with tax-free growth.", tip1:"Projected Balance", tip2:"Total Contributions", tip3:"Investment Growth", projectedBalance:"Projected Balance", totalContributions:"Total Contributions", investmentGrowth:"Investment Growth", yearsInvested:"Years Invested", yearsSuffix:"years", taxFreeNote:"Tax-free at withdrawal", aboutTitle:"About this Calculator", aboutText:"Projects your Roth IRA balance at retirement using your current balance, annual contribution, and expected return, compounded yearly until withdrawal — all growth is tax-free at qualified withdrawal." },
  es: { youGroup:"Tú", currentAge:"Edad Actual", retirementAge:"Edad de Jubilación", currentBalance:"Saldo Actual de Roth IRA", growthGroup:"Aportes y Crecimiento", annualContribution:"Aporte Anual", expectedReturn:"Retorno Anual Esperado (%)", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora de Roth IRA", emptyDesc:"Proyecta tu saldo de Roth IRA al jubilarte con crecimiento libre de impuestos.", tip1:"Saldo Proyectado", tip2:"Aportes Totales", tip3:"Crecimiento de Inversión", projectedBalance:"Saldo Proyectado", totalContributions:"Aportes Totales", investmentGrowth:"Crecimiento de Inversión", yearsInvested:"Años Invertidos", yearsSuffix:"años", taxFreeNote:"Libre de impuestos al retirar", aboutTitle:"Acerca de esta Calculadora", aboutText:"Proyecta tu saldo de Roth IRA al jubilarte usando tu saldo actual, aporte anual y retorno esperado, compuesto anualmente hasta el retiro — todo el crecimiento está libre de impuestos al retiro calificado." },
}[lang];
---
<section class="ri-calculator">
  <div class="ri-layout">
    <aside class="ri-sidebar">
      <div class="ri-group">
        <h3>{copy.youGroup}</h3>
        <CalculatorField id="currentAge" label={copy.currentAge} type="number" placeholder="e.g. 28" min="1" step="1" />
        <CalculatorField id="retirementAge" label={copy.retirementAge} type="number" placeholder="e.g. 65" min="1" step="1" />
        <CalculatorField id="currentBalance" label={copy.currentBalance} type="number" placeholder="e.g. 8000" min="0" step="1" />
      </div>
      <div class="ri-group">
        <h3>{copy.growthGroup}</h3>
        <CalculatorField id="annualContribution" label={copy.annualContribution} type="number" placeholder="e.g. 7000" min="0" step="1" />
        <CalculatorField id="expectedReturn" label={copy.expectedReturn} type="number" placeholder="e.g. 7" min="0" step="0.1" />
      </div>
      <CalculatorActions lang={lang} calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} calculateText={copy.calculate} resetText={copy.reset} copyText={copy.copy} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="ri-content">
      <div id="emptyState">
        <EmptyState icon="🌱" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="projectedBalanceResult" title={copy.projectedBalance} icon={PiggyBank} accent="success" subtitle=" " />
          <ResultCard id="totalContributionsResult" title={copy.totalContributions} icon={Wallet} />
          <ResultCard id="investmentGrowthResult" title={copy.investmentGrowth} icon={TrendingUp} />
          <ResultCard id="yearsInvestedResult" title={copy.yearsInvested} icon={Calendar} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/roth-ira-calculator";
</script>
<style>
.ri-calculator{width:100%;}
.ri-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.ri-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;}
.ri-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.ri-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.ri-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.ri-layout{grid-template-columns:1fr;}.ri-sidebar{position:static;}}
@media(max-width:768px){.ri-layout{gap:24px;}.ri-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
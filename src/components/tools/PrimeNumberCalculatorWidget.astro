---
import CalculatorField from "../calculator/CalculatorField.astro";
import ActionButtons from "../calculator/ActionButtons.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import EmptyState from "../calculator/EmptyState.astro";
import { CheckCircle2, Hash, ArrowLeft, ArrowRight } from "@lucide/astro";
---

<div class="calculator-widget">
  <div class="calculator-inputs">
    <CalculatorField id="number" label="Number" type="number" placeholder="e.g. 29" />

    <div id="errorBox" class="error-box" role="alert" hidden></div>

    <ActionButtons
      calculateId="calculateBtn"
      resetId="resetBtn"
      copyId="copyBtn"
      showDownload={false}
      showShare={false}
    />
  </div>

  <div class="calculator-output">
    <EmptyState
      id="emptyState"
      title="Enter a number to check"
      description="Whether it's prime, its factors, and nearby primes will appear here."
    />

    <ResultsGrid id="resultsContainer" hidden>
      <ResultCard id="isPrimeResult" title="Result" icon={CheckCircle2} accent="primary" size="lg" />
      <ResultCard id="factorsResult" title="Factors" icon={Hash} accent="neutral" />
      <ResultCard id="nearestBelowResult" title="Nearest Prime Below" icon={ArrowLeft} accent="neutral" />
      <ResultCard id="nearestAboveResult" title="Nearest Prime Above" icon={ArrowRight} accent="neutral" />
    </ResultsGrid>
  </div>
</div>

<script src="../../scripts/prime-number-calculator.ts"></script>

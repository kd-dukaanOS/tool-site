{/* src/components/tools/GrossMarginCalculatorWidget.astro */}
---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";

import { DollarSign, Percent } from "@lucide/astro";
---

<section class="gm-calculator">
  <div class="gm-layout">

    <aside class="gm-sidebar">
      <CalculatorField
        id="revenue"
        label="Revenue ($)"
        type="number"
        placeholder="e.g. 10000"
        required={true}
        min="0"
        step="0.01"
        helpText="Total sales revenue."
      />

      <CalculatorField
        id="cogs"
        label="Cost of Goods Sold ($)"
        type="number"
        placeholder="e.g. 6000"
        required={true}
        min="0"
        step="0.01"
        helpText="Direct cost of producing what you sold."
      />

      <CalculatorActions
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
      />

      <div id="errorBox" class="error-box" hidden></div>
    </aside>

    <main class="gm-content">
      <div id="emptyState">
        <EmptyState
          icon="📈"
          title="Gross Margin Calculator"
          description="Find your gross profit and gross margin percentage from revenue and cost of goods sold."
          tips={["Gross Profit", "Gross Margin %"]}
        />
      </div>

      <div id="resultsContainer" hidden>
        <ResultsGrid columns={2}>
          <ResultCard id="grossProfitResult" title="Gross Profit" icon={DollarSign} accent="success" size="lg" />
          <ResultCard id="grossMarginResult" title="Gross Margin" icon={Percent} accent="primary" />
        </ResultsGrid>

        <section class="calculator-info">
          <h2>About this Calculator</h2>
          <p>
            Calculates your gross profit and gross margin percentage from revenue and cost of goods sold (COGS).
            All calculations run locally — no external data or paid service is required.
          </p>
        </section>
      </div>
    </main>

  </div>
</section>

<script>
  import "../../scripts/gross-margin-calculator";
</script>

<style>
.gm-calculator{ width:100%; }
.gm-layout{ display:grid; grid-template-columns:340px minmax(0,1fr); gap:32px; align-items:start; }
.gm-sidebar{ position:sticky; top:24px; display:flex; flex-direction:column; gap:20px; }
.gm-content{ display:flex; flex-direction:column; gap:28px; min-width:0; }
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){ .gm-layout{ grid-template-columns:1fr; } .gm-sidebar{ position:static; } }
@media(max-width:768px){ .gm-layout{ gap:24px; } .gm-content{ gap:20px; } }
@media(max-width:640px){ .calculator-info{ padding:18px; } }
</style>
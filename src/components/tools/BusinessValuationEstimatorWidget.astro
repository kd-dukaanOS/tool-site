---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import CurrencySelector from "../calculator/CurrencySelector.astro";

import {
  Building2,
  TrendingUp,
  LineChart,
  Landmark
} from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;

const copy = {
  en: {
    revenueLabel: "Annual Revenue", revenueHelp: "Total revenue over the last 12 months.",
    profitLabel: "Annual Net Profit", profitHelp: "Net profit over the last 12 months.",
    revenueMultipleLabel: "Revenue Multiple", revenueMultipleHelp: "Industry-typical multiple applied to revenue, e.g. 2.",
    earningsMultipleLabel: "Earnings Multiple", earningsMultipleHelp: "Industry-typical multiple applied to profit, e.g. 4.",
    methodLabel: "Valuation Method",
    methodAvg: "Average of both methods", methodRevenue: "Revenue method only", methodEarnings: "Earnings method only",
    emptyTitle: "Business Valuation Estimator",
    emptyDesc: "Get a quick estimate of what your business might be worth.",
    tips: ["Revenue Method", "Earnings Method", "Blended Estimate"],
    finalValuation: "Estimated Valuation", revenueMethod: "Revenue Method", earningsMethod: "Earnings Method",
    aboutTitle: "About this Calculator",
    aboutText: "Get a quick, directional estimate of your business's value using revenue and earnings multiple methods. This is not a substitute for a formal valuation from a qualified financial professional.",
  },
  es: {
    revenueLabel: "Ingresos Anuales", revenueHelp: "Ingresos totales de los últimos 12 meses.",
    profitLabel: "Utilidad Neta Anual", profitHelp: "Utilidad neta de los últimos 12 meses.",
    revenueMultipleLabel: "Múltiplo de Ingresos", revenueMultipleHelp: "Múltiplo típico de la industria aplicado a los ingresos, ej. 2.",
    earningsMultipleLabel: "Múltiplo de Utilidad", earningsMultipleHelp: "Múltiplo típico de la industria aplicado a la utilidad, ej. 4.",
    methodLabel: "Método de Valoración",
    methodAvg: "Promedio de ambos métodos", methodRevenue: "Solo método de ingresos", methodEarnings: "Solo método de utilidad",
    emptyTitle: "Estimador de Valoración de Negocio",
    emptyDesc: "Obtén una estimación rápida de cuánto podría valer tu negocio.",
    tips: ["Método de Ingresos", "Método de Utilidad", "Estimación Combinada"],
    finalValuation: "Valoración Estimada", revenueMethod: "Método de Ingresos", earningsMethod: "Método de Utilidad",
    aboutTitle: "Acerca de esta Calculadora",
    aboutText: "Obtén una estimación rápida y orientativa del valor de tu negocio usando métodos de múltiplos de ingresos y utilidad. Esto no sustituye una valoración formal de un profesional financiero calificado.",
  },
}[lang];
---

<section class="valuation-calculator">

  <div class="valuation-layout">

    <aside class="valuation-sidebar">
      <CurrencySelector />

      <CalculatorField
        id="annualRevenue"
        label={copy.revenueLabel}
        type="number"
        required={true}
        helpText={copy.revenueHelp}
      />

      <CalculatorField
        id="annualProfit"
        label={copy.profitLabel}
        type="number"
        required={true}
        helpText={copy.profitHelp}
      />

      <CalculatorField
        id="revenueMultiple"
        label={copy.revenueMultipleLabel}
        type="number"
        required={true}
        helpText={copy.revenueMultipleHelp}
      />

      <CalculatorField
        id="earningsMultiple"
        label={copy.earningsMultipleLabel}
        type="number"
        required={true}
        helpText={copy.earningsMultipleHelp}
      />

      <label class="field-label" for="valuationMethod">{copy.methodLabel}</label>
      <select id="valuationMethod" class="field-select">
        <option value="average">{copy.methodAvg}</option>
        <option value="revenue">{copy.methodRevenue}</option>
        <option value="earnings">{copy.methodEarnings}</option>
      </select>

      <CalculatorActions
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
      />

      <div id="errorBox" class="error-box" hidden></div>

    </aside>

    <main class="valuation-content">

      <div id="emptyState">

        <EmptyState
          icon="🏢"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={copy.tips}
        />

      </div>

      <div id="resultsContainer" hidden>

        <ResultsGrid columns={3}>

          <ResultCard
            id="finalValuationResult"
            title={copy.finalValuation}
            icon={Building2}
            subtitle=" "
          />

          <ResultCard
            id="revenueValuationResult"
            title={copy.revenueMethod}
            icon={LineChart}
          />

          <ResultCard
            id="earningsValuationResult"
            title={copy.earningsMethod}
            icon={TrendingUp}
          />

        </ResultsGrid>

        <section class="calculator-info">

          <h2>{copy.aboutTitle}</h2>

          <p>{copy.aboutText}</p>

        </section>

      </div>

    </main>

  </div>

</section>

<script define:vars={{ calcLang: lang }}>window.calcLang = calcLang;</script>
<script>
  import "../../scripts/business-valuation-estimator";
</script>

<style>

.valuation-calculator{

width:100%;

}

.valuation-layout{

display:grid;

grid-template-columns:340px minmax(0,1fr);

gap:32px;

align-items:start;

}

.valuation-sidebar{

position:sticky;

top:24px;

display:flex;

flex-direction:column;

gap:20px;

}

.valuation-content{

display:flex;

flex-direction:column;

gap:28px;

min-width:0;

}

.field-label{

font-size:.85rem;

font-weight:600;

color:var(--text-secondary);

}

.field-select{

width:100%;

padding:10px 12px;

border-radius:12px;

border:1px solid var(--border-subtle);

background:var(--bg-card);

font-size:.92rem;

color:var(--text-primary);

}

.calculator-info{

padding:24px;

border:1px solid var(--border-subtle);

border-radius:18px;

background:var(--bg-card);

}

.calculator-info h2{

margin:0 0 12px;

font-size:1.15rem;

font-weight:700;

color:var(--text-primary);

}

.calculator-info p{

margin:0;

line-height:1.8;

font-size:.95rem;

color:var(--text-secondary);

}

.error-box{

display:flex;

align-items:center;

padding:14px 16px;

border-radius:14px;

background:#FEF2F2;

border:1px solid #FCA5A5;

color:#B91C1C;

font-size:.92rem;

font-weight:600;

}

:global(.dark) .error-box{

background:#2A1111;

border-color:#7F1D1D;

color:#FECACA;

}

@media(max-width:1024px){

.valuation-layout{

grid-template-columns:1fr;

}

.valuation-sidebar{

position:static;

}

}

@media(max-width:768px){

.valuation-layout{

gap:24px;

}

.valuation-content{

gap:20px;

}

}

@media(max-width:640px){

.calculator-info{

padding:18px;

}

}

</style>

---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Landmark, MapPin, TrendingUp, Wallet } from "@lucide/astro";

interface Props {
  lang?: "en" | "es";
}
const { lang = "en" } = Astro.props as Props;

const copy = {
  en: {
    grossIncomeLabel: "Gross Annual Income", grossIncomeHelp: "Your gross salary before deductions (CAD).",
    provinceLabel: "Province", ontario: "Ontario", alberta: "Alberta", britishColumbia: "British Columbia",
    calculate: "Calculate", reset: "Reset", copy: "Copy",
    emptyTitle: "Canada Income Tax Calculator", emptyDesc: "See your estimated federal + provincial income tax and combined marginal rate.",
    tip1: "Federal Tax", tip2: "Provincial Tax", tip3: "Marginal Rate",
    federalTax: "Federal Tax", provincialTax: "Provincial Tax", marginalRate: "Combined Marginal Rate", afterTax: "After-Tax Income",
    aboutTitle: "About this Calculator",
    aboutText: "Estimates combined federal and provincial income tax for Ontario, Alberta, and British Columbia. Does not include CPP or EI — use the Canada Take-Home Pay Calculator for a full paycheque breakdown. Verify against current CRA figures.",
  },
  es: {
    grossIncomeLabel: "Ingreso Bruto Anual", grossIncomeHelp: "Tu salario bruto antes de deducciones (CAD).",
    provinceLabel: "Provincia", ontario: "Ontario", alberta: "Alberta", britishColumbia: "Columbia Británica",
    calculate: "Calcular", reset: "Restablecer", copy: "Copiar",
    emptyTitle: "Calculadora de Impuesto sobre la Renta de Canadá", emptyDesc: "Consulta tu impuesto federal + provincial estimado y la tasa marginal combinada.",
    tip1: "Impuesto Federal", tip2: "Impuesto Provincial", tip3: "Tasa Marginal",
    federalTax: "Impuesto Federal", provincialTax: "Impuesto Provincial", marginalRate: "Tasa Marginal Combinada", afterTax: "Ingreso Después de Impuestos",
    aboutTitle: "Acerca de esta Calculadora",
    aboutText: "Estima el impuesto federal y provincial combinado para Ontario, Alberta y Columbia Británica. No incluye CPP ni EI — usa la Calculadora de Sueldo Neto de Canadá para un desglose completo de tu cheque de pago. Verifica con las cifras actuales de la CRA.",
  },
}[lang];
---
<section class="cait-calculator">
  <div class="cait-layout">
    <aside class="cait-sidebar">
      <CalculatorField id="grossIncome" label={copy.grossIncomeLabel} type="number" required={true} helpText={copy.grossIncomeHelp} />
      <div class="cait-province">
        <label for="province">{copy.provinceLabel}</label>
        <select id="province">
          <option value="ON">{copy.ontario}</option>
          <option value="AB">{copy.alberta}</option>
          <option value="BC">{copy.britishColumbia}</option>
        </select>
      </div>
      <CalculatorActions calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} calculateText={copy.calculate} resetText={copy.reset} copyText={copy.copy} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="cait-content">
      <div id="emptyState">
        <EmptyState icon="🇨🇦" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={2}>
          <ResultCard id="federalTaxResult" title={copy.federalTax} icon={Landmark} subtitle=" " />
          <ResultCard id="provincialTaxResult" title={copy.provincialTax} icon={MapPin} />
          <ResultCard id="marginalRateResult" title={copy.marginalRate} icon={TrendingUp} />
          <ResultCard id="afterTaxResult" title={copy.afterTax} icon={Wallet} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/ca-income-tax";
</script>
<style>
.cait-calculator{width:100%;}
.cait-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.cait-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;}
.cait-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.cait-province{display:flex;flex-direction:column;gap:6px;}
.cait-province label{font-size:.85rem;font-weight:600;color:var(--text-primary);}
.cait-province select{padding:10px 12px;border-radius:10px;border:1px solid var(--border-subtle);background:var(--bg-card);color:var(--text-primary);font-size:.9rem;}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.cait-layout{grid-template-columns:1fr;}.cait-sidebar{position:static;}}
@media(max-width:768px){.cait-layout{gap:24px;}.cait-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
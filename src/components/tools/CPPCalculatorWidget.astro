---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { PiggyBank, Users, Building2, Coins } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { grossIncome:"Gross Annual Income", grossIncomeHelp:"Your gross annual income (CAD).", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"CPP Calculator", emptyDesc:"Estimate your Canada Pension Plan contribution.", tip1:"Pensionable Earnings", tip2:"Employee Portion", tip3:"Employer Portion", pensionable:"Pensionable Earnings", employee:"Employee Contribution", employer:"Employer Contribution", total:"Total Contribution", aboutTitle:"About this Calculator", aboutText:"Estimates your CPP contribution after the basic exemption, capped at the yearly maximum pensionable earnings. Excludes CPP2. Verify against current CRA figures." },
  es: { grossIncome:"Ingreso Bruto Anual", grossIncomeHelp:"Tu ingreso bruto anual (CAD).", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora CPP", emptyDesc:"Estima tu contribución al Plan de Pensiones de Canadá.", tip1:"Ingresos Pensionables", tip2:"Parte del Empleado", tip3:"Parte del Empleador", pensionable:"Ingresos Pensionables", employee:"Contribución del Empleado", employer:"Contribución del Empleador", total:"Contribución Total", aboutTitle:"Acerca de esta Calculadora", aboutText:"Estima tu contribución al CPP después de la exención básica, limitada al máximo anual de ingresos pensionables. Excluye CPP2. Verifica con las cifras actuales de CRA." },
}[lang];
---
<section class="cpp-calculator">
  <div class="cpp-layout">
    <aside class="cpp-sidebar">
      <CalculatorField id="grossIncome" label={copy.grossIncome} type="number" required={true} helpText={copy.grossIncomeHelp} />
      <CalculatorActions calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} calculateText={copy.calculate} resetText={copy.reset} copyText={copy.copy} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="cpp-content">
      <div id="emptyState">
        <EmptyState icon="🏦" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={2}>
          <ResultCard id="pensionableResult" title={copy.pensionable} icon={PiggyBank} />
          <ResultCard id="employeeResult" title={copy.employee} icon={Users} subtitle=" " />
          <ResultCard id="employerResult" title={copy.employer} icon={Building2} />
          <ResultCard id="totalResult" title={copy.total} icon={Coins} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/ca-cpp-calculator";
</script>
<style>
.cpp-calculator{width:100%;}
.cpp-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.cpp-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;}
.cpp-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.cpp-layout{grid-template-columns:1fr;}.cpp-sidebar{position:static;}}
@media(max-width:768px){.cpp-layout{gap:24px;}.cpp-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>

---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import CurrencySelector from "../calculator/CurrencySelector.astro";

import { Wallet, Percent } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { revenue:"Revenue", revenueHelp:"Total sales revenue.", cost:"Cost", costHelp:"Total cost of goods sold.", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"Profit Margin Calculator", emptyDesc:"Find your profit and profit margin percentage from revenue and cost.", tip1:"Profit", tip2:"Profit Margin %", profit:"Profit", margin:"Profit Margin", aboutTitle:"About this Calculator", aboutText:"Calculates your profit and profit margin percentage from revenue and cost. All calculations run locally — no external data or paid service is required." },
  es: { revenue:"Ingresos", revenueHelp:"Ingresos totales por ventas.", cost:"Costo", costHelp:"Costo total de bienes vendidos.", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora de Margen de Ganancia", emptyDesc:"Encuentra tu ganancia y porcentaje de margen a partir de ingresos y costo.", tip1:"Ganancia", tip2:"Margen de Ganancia %", profit:"Ganancia", margin:"Margen de Ganancia", aboutTitle:"Acerca de esta Calculadora", aboutText:"Calcula tu ganancia y porcentaje de margen a partir de ingresos y costo. Todos los cálculos se ejecutan localmente — no se requieren datos externos ni servicios pagados." },
}[lang];
---

<section class="pm-calculator">
  <div class="pm-layout">

    <aside class="pm-sidebar">
      <CurrencySelector />

      <CalculatorField
        id="revenue"
        label={copy.revenue}
        type="number"
        placeholder="e.g. 1000"
        required={true}
        min="0"
        step="0.01"
        helpText={copy.revenueHelp}
      />

      <CalculatorField
        id="cost"
        label={copy.cost}
        type="number"
        placeholder="e.g. 600"
        required={true}
        min="0"
        step="0.01"
        helpText={copy.costHelp}
      />

      <CalculatorActions lang={lang}
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
        calculateText={copy.calculate}
        resetText={copy.reset}
        copyText={copy.copy}
      />

      <div id="errorBox" class="error-box" hidden></div>
    </aside>

    <main class="pm-content">
      <div id="emptyState">
        <EmptyState
          icon="📊"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={[copy.tip1, copy.tip2]}
        />
      </div>

      <div id="resultsContainer" hidden>
        <ResultsGrid columns={2}>
          <ResultCard id="profitResult" title={copy.profit} icon={Wallet} accent="success" size="lg" />
          <ResultCard id="marginResult" title={copy.margin} icon={Percent} accent="primary" />
        </ResultsGrid>

        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>

  </div>
</section>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/profit-margin-calculator";
</script>

<style>
.pm-calculator{ width:100%; }
.pm-layout{ display:grid; grid-template-columns:340px minmax(0,1fr); gap:32px; align-items:start; }
.pm-sidebar{ position:sticky; top:24px; display:flex; flex-direction:column; gap:20px; }
.pm-content{ display:flex; flex-direction:column; gap:28px; min-width:0; }
.calculator-info{ padding:24px; border:1px solid var(--border-subtle); border-radius:18px; background:var(--bg-card); }
.calculator-info h2{ margin:0 0 12px; font-size:1.15rem; font-weight:700; color:var(--text-primary); }
.calculator-info p{ margin:0; line-height:1.8; font-size:.95rem; color:var(--text-secondary); }
.error-box{ display:flex; align-items:center; padding:14px 16px; border-radius:14px; background:#FEF2F2; border:1px solid #FCA5A5; color:#B91C1C; font-size:.92rem; font-weight:600; }
:global(.dark) .error-box{ background:#2A1111; border-color:#7F1D1D; color:#FECACA; }
@media(max-width:1024px){ .pm-layout{ grid-template-columns:1fr; } .pm-sidebar{ position:static; } }
@media(max-width:768px){ .pm-layout{ gap:24px; } .pm-content{ gap:20px; } }
@media(max-width:640px){ .calculator-info{ padding:18px; } }
</style>
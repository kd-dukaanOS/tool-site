---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Clock, TrendingDown, Receipt, CreditCard } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { cardGroup:"Card Details", balance:"Current Balance", apr:"APR (%)", monthlyPayment:"Monthly Payment", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"Credit Card Interest Calculator", emptyDesc:"Enter your balance, APR and monthly payment to see how much interest you'll pay.", tip1:"Time to Payoff", tip2:"Total Interest", tip3:"Total Repayment", timeToPayoff:"Time to Payoff", totalInterest:"Total Interest", totalRepayment:"Total Repayment", aboutTitle:"About this Calculator", aboutText:"Calculates how long it will take to pay off a credit card balance at a fixed monthly payment, along with total interest charged and total amount repaid, based on your APR." },
  es: { cardGroup:"Detalles de la Tarjeta", balance:"Saldo Actual", apr:"TAE (%)", monthlyPayment:"Pago Mensual", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora de Interés de Tarjeta de Crédito", emptyDesc:"Ingresa tu saldo, TAE y pago mensual para ver cuánto interés pagarás.", tip1:"Tiempo para Pagar", tip2:"Interés Total", tip3:"Pago Total", timeToPayoff:"Tiempo para Pagar", totalInterest:"Interés Total", totalRepayment:"Pago Total", aboutTitle:"Acerca de esta Calculadora", aboutText:"Calcula cuánto tiempo tomará pagar el saldo de una tarjeta de crédito con un pago mensual fijo, junto con el interés total cobrado y el monto total pagado, según tu TAE." },
}[lang];
---
<section class="cci-calculator">
  <div class="cci-layout">
    <aside class="cci-sidebar">
      <div class="cci-group">
        <h3>{copy.cardGroup}</h3>
        <CalculatorField id="balance" label={copy.balance} type="number" placeholder="e.g. 5000" min="0" step="1" />
        <CalculatorField id="apr" label={copy.apr} type="number" placeholder="e.g. 22.9" min="0" step="0.01" />
        <CalculatorField id="monthlyPayment" label={copy.monthlyPayment} type="number" placeholder="e.g. 200" min="0" step="1" />
      </div>
      <CalculatorActions calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} calculateText={copy.calculate} resetText={copy.reset} copyText={copy.copy} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="cci-content">
      <div id="emptyState">
        <EmptyState icon="💳" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="timeToPayoffResult" title={copy.timeToPayoff} icon={Clock} accent="success" subtitle=" " />
          <ResultCard id="monthlyPaymentResult" title={copy.monthlyPayment} icon={CreditCard} />
          <ResultCard id="totalInterestResult" title={copy.totalInterest} icon={TrendingDown} />
          <ResultCard id="totalRepaymentResult" title={copy.totalRepayment} icon={Receipt} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/credit-card-interest-calculator";
</script>
<style>
.cci-calculator{width:100%;}
.cci-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.cci-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;}
.cci-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.cci-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.cci-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.cci-layout{grid-template-columns:1fr;}.cci-sidebar{position:static;}}
@media(max-width:768px){.cci-layout{gap:24px;}.cci-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
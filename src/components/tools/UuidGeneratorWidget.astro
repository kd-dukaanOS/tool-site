---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Fingerprint, Hash, Layers, Ruler } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { count:"Count", version:"Version", v4:"Version 4 (Random)", nil:"Nil UUID", hyphens:"Include hyphens", uppercase:"Uppercase", generate:"Generate", reset:"Reset", copy:"Copy", emptyTitle:"UUID Generator", emptyDesc:"Generate random UUID v4 identifiers instantly.", tip1:"Bulk Generation", tip2:"v4 & Nil UUID", tip3:"Custom Formatting", tip4:"Copy All", generated:"Generated", versionResult:"Version", length:"Length", generatedUuids:"Generated UUIDs", aboutTitle:"About this Tool", aboutText:"Generate cryptographically random UUID v4 identifiers in bulk, using your browser's native crypto.randomUUID()." },
  es: { count:"Cantidad", version:"Versión", v4:"Versión 4 (Aleatorio)", nil:"UUID Nulo", hyphens:"Incluir guiones", uppercase:"Mayúsculas", generate:"Generar", reset:"Restablecer", copy:"Copiar", emptyTitle:"Generador de UUID", emptyDesc:"Genera identificadores UUID v4 aleatorios al instante.", tip1:"Generación Masiva", tip2:"v4 y UUID Nulo", tip3:"Formato Personalizado", tip4:"Copiar Todo", generated:"Generados", versionResult:"Versión", length:"Longitud", generatedUuids:"UUIDs Generados", aboutTitle:"Acerca de esta Herramienta", aboutText:"Genera identificadores UUID v4 criptográficamente aleatorios en masa, usando crypto.randomUUID() nativo de tu navegador." },
}[lang];
---
<section class="uuid-generator">
  <div class="uuid-layout">
    <aside class="uuid-sidebar">

      <CalculatorField id="uuidCount" label={copy.count} type="number" value={5} min={1} max={1000} />

      <CalculatorField id="uuidVersion" label={copy.version} type="select">
        <option value="v4" selected>{copy.v4}</option>
        <option value="nil">{copy.nil}</option>
      </CalculatorField>

      <div class="tool-checkbox-field"><input id="uuidHyphens" type="checkbox" checked /><label for="uuidHyphens">{copy.hyphens}</label></div>
      <div class="tool-checkbox-field"><input id="uuidUppercase" type="checkbox" /><label for="uuidUppercase">{copy.uppercase}</label></div>

      <CalculatorActions calculateId="generateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} calculateText={copy.generate} resetText={copy.reset} copyText={copy.copy} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>

    <main class="uuid-content">
      <div id="emptyState">
        <EmptyState
          icon="🆔"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={[copy.tip1, copy.tip2, copy.tip3, copy.tip4]}
        />
      </div>

      <div id="resultsContainer" hidden>
        <ResultsGrid columns={3}>
          <ResultCard id="countResult" title={copy.generated} icon={Hash} />
          <ResultCard id="versionResult" title={copy.versionResult} icon={Layers} />
          <ResultCard id="lengthResult" title={copy.length} icon={Ruler} />
        </ResultsGrid>

        <div class="tool-field">
          <label class="tool-label"><Fingerprint size={16} /> {copy.generatedUuids}</label>
          <textarea id="uuidOutput" class="tool-textarea uuid-output" readonly></textarea>
        </div>

        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/uuid-generator";
</script>

<style>
.uuid-generator{width:100%;}
.uuid-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.uuid-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:4px;}
.tool-field{display:flex;flex-direction:column;gap:8px;margin-bottom:1.25rem;}
.tool-field .tool-label{display:flex;align-items:center;gap:6px;font-size:.95rem;font-weight:600;color:#111827;}
.tool-checkbox-field{display:flex;align-items:center;gap:8px;font-size:.9rem;color:#374151;margin-bottom:1rem;}
.uuid-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.uuid-output{font-family:ui-monospace,monospace;font-size:.85rem;min-height:200px;}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
:global(.dark) .tool-checkbox-field{color:#A1A1AA;}
:global(.dark) .tool-field .tool-label{color:#F4F4F5;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.uuid-layout{grid-template-columns:1fr;}.uuid-sidebar{position:static;}}
</style>

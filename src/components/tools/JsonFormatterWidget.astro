---
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Braces, Layers, HardDrive } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { input:"Input JSON", format:"Format", minify:"Minify", emptyTitle:"JSON Formatter", emptyDesc:"Format, minify and validate JSON instantly.", tip1:"Format", tip2:"Minify", tip3:"Validate", tip4:"Key & Depth Stats", keys:"Keys", depth:"Depth", size:"Size", output:"Output", aboutTitle:"About this Tool", aboutText:"Format, minify and validate JSON with key count, depth and size stats — all in your browser." },
  es: { input:"JSON de Entrada", format:"Formatear", minify:"Minificar", emptyTitle:"Formateador JSON", emptyDesc:"Formatea, minifica y valida JSON al instante.", tip1:"Formatear", tip2:"Minificar", tip3:"Validar", tip4:"Estadísticas de Claves y Profundidad", keys:"Claves", depth:"Profundidad", size:"Tamaño", output:"Salida", aboutTitle:"Acerca de esta Herramienta", aboutText:"Formatea, minifica y valida JSON con estadísticas de claves, profundidad y tamaño — todo en tu navegador." },
}[lang];
---
<section class="json-formatter">
  <div class="json-layout">
    <aside class="json-sidebar">
      <div class="tool-field">
        <label class="tool-label" for="jsonInput">{copy.input}</label>
        <textarea id="jsonInput" class="tool-textarea" placeholder='{"name": "example"}'></textarea>
      </div>

      <div class="tool-actions">
        <button id="formatBtn" class="tool-btn tool-btn-primary">{copy.format}</button>
        <button id="minifyBtn" class="tool-btn tool-btn-secondary">{copy.minify}</button>
      </div>

      <CalculatorActions lang={lang} calculateId="" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>

    <main class="json-content">
      <div id="emptyState">
        <EmptyState
          icon="{}"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={[copy.tip1, copy.tip2, copy.tip3, copy.tip4]}
        />
      </div>

      <div id="resultsContainer" hidden>
        <ResultsGrid columns={3}>
          <ResultCard id="keysResult" title="Keys" icon={Braces} />
          <ResultCard id="depthResult" title="Depth" icon={Layers} />
          <ResultCard id="sizeResult" title="Size" icon={HardDrive} />
        </ResultsGrid>

        <div class="tool-field">
          <label class="tool-label" for="jsonOutput">Output</label>
          <textarea id="jsonOutput" class="tool-textarea" readonly></textarea>
        </div>

        <section class="calculator-info">
          <h2>About this Tool</h2>
          <p>Format, minify and validate JSON with key count, depth and size stats — all in your browser.</p>
        </section>
      </div>
    </main>
  </div>
</section>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/json-formatter";
</script>

<style>
.json-formatter{width:100%;}
.json-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.json-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;}
.tool-field{display:flex;flex-direction:column;gap:8px;}
.json-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.json-layout{grid-template-columns:1fr;}.json-sidebar{position:static;}}
</style>


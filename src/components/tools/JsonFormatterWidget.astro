---
// src/components/tools/JsonFormatterWidget.astro
// Just the interactive part — no page shell, no Layout. This gets dropped
// into [category]/[tool].astro's placeholder spot for the json-formatter tool.
---
<div class="tool-panel">
  <div class="tool-grid-2">
    <div>
      <label class="tool-label" for="jsonInput">Input JSON</label>
      <textarea id="jsonInput" class="tool-textarea" placeholder='{"name": "example", "value": 123}'></textarea>
    </div>
    <div>
      <label class="tool-label" for="jsonOutput">Output</label>
      <textarea id="jsonOutput" class="tool-textarea" readonly></textarea>
    </div>
  </div>

  <div class="tool-actions">
    <button id="formatBtn" class="tool-btn tool-btn-primary">Format</button>
    <button id="minifyBtn" class="tool-btn tool-btn-secondary">Minify</button>
    <button id="copyBtn" class="tool-btn tool-btn-secondary">Copy Output</button>
    <button id="clearBtn" class="tool-btn tool-btn-danger">Clear</button>
  </div>

  <p id="errorMsg" class="tool-error"></p>
</div>

<script>
  const input = document.getElementById('jsonInput') as HTMLTextAreaElement;
  const output = document.getElementById('jsonOutput') as HTMLTextAreaElement;
  const errorMsg = document.getElementById('errorMsg') as HTMLParagraphElement;

  document.getElementById('formatBtn')?.addEventListener('click', () => {
    try {
      const parsed = JSON.parse(input.value);
      output.value = JSON.stringify(parsed, null, 2);
      errorMsg.textContent = '';
    } catch (e) {
      errorMsg.textContent = 'Invalid JSON: ' + (e as Error).message;
      output.value = '';
    }
  });

  document.getElementById('minifyBtn')?.addEventListener('click', () => {
    try {
      const parsed = JSON.parse(input.value);
      output.value = JSON.stringify(parsed);
      errorMsg.textContent = '';
    } catch (e) {
      errorMsg.textContent = 'Invalid JSON: ' + (e as Error).message;
      output.value = '';
    }
  });

  document.getElementById('copyBtn')?.addEventListener('click', () => {
    navigator.clipboard.writeText(output.value);
  });

  document.getElementById('clearBtn')?.addEventListener('click', () => {
    input.value = '';
    output.value = '';
    errorMsg.textContent = '';
  });
</script>

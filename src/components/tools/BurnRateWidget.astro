---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Flame, TrendingDown, Calendar, Wallet } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;

const copy = {
  en: {
    cashPosition: "Cash Position", currentCashLabel: "Current Cash Balance", currentCashPh: "e.g. 300000",
    monthlyNumbers: "Monthly Numbers", revenueLabel: "Monthly Revenue", revenuePh: "e.g. 15000",
    expensesLabel: "Monthly Operating Expenses", expensesPh: "e.g. 40000",
    emptyTitle: "Burn Rate Calculator",
    emptyDesc: "Find your gross and net burn rate and how many months of runway you have left.",
    tips: ["Gross Burn", "Net Burn", "Runway"],
    netBurn: "Net Burn Rate", grossBurn: "Gross Burn Rate", runway: "Runway", cashBalance: "Current Cash Balance",
    aboutTitle: "About this Calculator",
    aboutText: "Calculates gross burn rate (total monthly expenses) and net burn rate (expenses minus revenue), then estimates how many months of runway your current cash balance provides at that net burn rate.",
  },
  es: {
    cashPosition: "Posición de Caja", currentCashLabel: "Saldo de Caja Actual", currentCashPh: "ej. 300000",
    monthlyNumbers: "Cifras Mensuales", revenueLabel: "Ingresos Mensuales", revenuePh: "ej. 15000",
    expensesLabel: "Gastos Operativos Mensuales", expensesPh: "ej. 40000",
    emptyTitle: "Calculadora de Tasa de Consumo",
    emptyDesc: "Calcula tu tasa de consumo bruta y neta, y cuántos meses de reserva de caja te quedan.",
    tips: ["Consumo Bruto", "Consumo Neto", "Reserva de Caja"],
    netBurn: "Tasa de Consumo Neta", grossBurn: "Tasa de Consumo Bruta", runway: "Reserva de Caja", cashBalance: "Saldo de Caja Actual",
    aboutTitle: "Acerca de esta Calculadora",
    aboutText: "Calcula la tasa de consumo bruta (gastos mensuales totales) y la tasa de consumo neta (gastos menos ingresos), y estima cuántos meses de reserva de caja te ofrece tu saldo actual con esa tasa neta.",
  },
}[lang];
---
<section class="brc-calculator">
  <div class="brc-layout">
    <aside class="brc-sidebar">
      <div class="brc-group">
        <h3>{copy.cashPosition}</h3>
        <CalculatorField id="currentCashBalance" label={copy.currentCashLabel} type="number" placeholder={copy.currentCashPh} min="0" step="1" />
      </div>
      <div class="brc-group">
        <h3>{copy.monthlyNumbers}</h3>
        <CalculatorField id="monthlyRevenue" label={copy.revenueLabel} type="number" placeholder={copy.revenuePh} min="0" step="1" />
        <CalculatorField id="monthlyOperatingExpenses" label={copy.expensesLabel} type="number" placeholder={copy.expensesPh} min="0" step="1" />
      </div>
      <CalculatorActions lang={lang} calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="brc-content">
      <div id="emptyState">
        <EmptyState icon="🔥" title={copy.emptyTitle} description={copy.emptyDesc} tips={copy.tips} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="netBurnResult" title={copy.netBurn} icon={Flame} accent="warning" subtitle=" " />
          <ResultCard id="grossBurnResult" title={copy.grossBurn} icon={TrendingDown} />
          <ResultCard id="runwayResult" title={copy.runway} icon={Calendar} />
          <ResultCard id="cashBalanceResult" title={copy.cashBalance} icon={Wallet} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang }}>window.calcLang = calcLang;</script>
<script>
  import "../../scripts/burn-rate-calculator";
</script>
<style>
.brc-calculator{width:100%;}
.brc-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.brc-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.brc-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.brc-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.brc-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.brc-layout{grid-template-columns:1fr;}.brc-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.brc-layout{gap:24px;}.brc-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
---
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { QrCode, Type, Ruler, Download } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { textLabel:"Text or URL", sizeLabel:"Size (px)", eccLabel:"Error Correction", eccLow:"Low (L)", eccMed:"Medium (M)", eccQuart:"Quartile (Q)", eccHigh:"High (H)", fgLabel:"Foreground", bgLabel:"Background", generate:"Generate", reset:"Reset", emptyTitle:"QR Code Generator", emptyDesc:"Generate a QR code from any text, URL or email instantly.", tip1:"Custom Size", tip2:"Error Correction Level", tip3:"Custom Colors", tip4:"Download PNG", typeLabel:"Type", charsLabel:"Characters", sizeResultLabel:"Size", download:"Download PNG", aboutTitle:"About this Tool", aboutText:"Generate a scannable QR code from any text, URL, or email address, with adjustable size, colors and error correction level." },
  es: { textLabel:"Texto o URL", sizeLabel:"Tamaño (px)", eccLabel:"Corrección de Errores", eccLow:"Baja (L)", eccMed:"Media (M)", eccQuart:"Cuartil (Q)", eccHigh:"Alta (H)", fgLabel:"Primer Plano", bgLabel:"Fondo", generate:"Generar", reset:"Restablecer", emptyTitle:"Generador de Código QR", emptyDesc:"Genera un código QR desde cualquier texto, URL o correo al instante.", tip1:"Tamaño Personalizado", tip2:"Nivel de Corrección de Errores", tip3:"Colores Personalizados", tip4:"Descargar PNG", typeLabel:"Tipo", charsLabel:"Caracteres", sizeResultLabel:"Tamaño", download:"Descargar PNG", aboutTitle:"Acerca de esta Herramienta", aboutText:"Genera un código QR escaneable desde cualquier texto, URL o correo electrónico, con tamaño, colores y nivel de corrección de errores ajustables." },
}[lang];
---
<section class="qr-generator">
  <div class="qr-layout">
    <aside class="qr-sidebar">
      <div class="tool-field">
        <label class="tool-label" for="qrText">{copy.textLabel}</label>
        <textarea id="qrText" class="tool-textarea" placeholder="https://example.com"></textarea>
      </div>

      <div class="tool-field">
        <label class="tool-label" for="qrSize">{copy.sizeLabel}</label>
        <input id="qrSize" type="number" class="tool-input" value="300" min="100" max="1000" step="50" />
      </div>

      <div class="tool-field">
        <label class="tool-label" for="qrEcc">{copy.eccLabel}</label>
        <select id="qrEcc" class="tool-select">
          <option value="L">{copy.eccLow}</option>
          <option value="M" selected>{copy.eccMed}</option>
          <option value="Q">{copy.eccQuart}</option>
          <option value="H">{copy.eccHigh}</option>
        </select>
      </div>

      <div class="tool-grid-2">
        <div class="tool-field">
          <label class="tool-label" for="qrFgColor">{copy.fgLabel}</label>
          <input id="qrFgColor" type="color" class="tool-input" value="#000000" />
        </div>
        <div class="tool-field">
          <label class="tool-label" for="qrBgColor">{copy.bgLabel}</label>
          <input id="qrBgColor" type="color" class="tool-input" value="#ffffff" />
        </div>
      </div>

      <div class="tool-actions">
        <button id="generateBtn" class="tool-btn tool-btn-primary">{copy.generate}</button>
        <button id="resetBtn" class="tool-btn tool-btn-secondary">{copy.reset}</button>
      </div>
      <div id="errorBox" class="error-box" hidden></div>
    </aside>

    <main class="qr-content">
      <div id="emptyState">
        <EmptyState
          icon="⬜"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={[copy.tip1, copy.tip2, copy.tip3, copy.tip4]}
        />
      </div>

      <div id="resultsContainer" hidden>
        <div class="qr-preview">
          <img id="qrImage" alt="Generated QR code" />
        </div>

        <ResultsGrid columns={3}>
          <ResultCard id="typeResult" title={copy.typeLabel} icon={Type} />
          <ResultCard id="charsResult" title={copy.charsLabel} icon={QrCode} />
          <ResultCard id="sizeResult" title={copy.sizeResultLabel} icon={Ruler} />
        </ResultsGrid>

        <div class="tool-actions">
          <button id="downloadBtn" class="tool-btn tool-btn-primary"><Download size={16} /> {copy.download}</button>
        </div>

        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/qr-code-generator";
</script>

<style>
.qr-generator{width:100%;}
.qr-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.qr-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:16px;}
.tool-field{display:flex;flex-direction:column;gap:8px;}
.qr-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.qr-preview{display:flex;justify-content:center;padding:32px;border:1px solid #E5E7EB;border-radius:18px;background:#FFFFFF;}
.qr-preview img{max-width:100%;border-radius:8px;}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .qr-preview{background:#111217;border-color:#27272A;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.qr-layout{grid-template-columns:1fr;}.qr-sidebar{position:static;}.tool-grid-2{grid-template-columns:1fr;}}
</style>


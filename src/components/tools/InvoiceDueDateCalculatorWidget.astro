---
import CalculatorField from "../calculator/CalculatorField.astro";
import ActionButtons from "../calculator/ActionButtons.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import EmptyState from "../calculator/EmptyState.astro";
import { CalendarCheck, Clock } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { invoiceDate:"Invoice Date", terms:"Payment Terms (Days)", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"Enter invoice details to find due date", emptyDesc:"Your invoice due date and status will appear here.", dueDate:"Due Date", status:"Status" },
  es: { invoiceDate:"Fecha de Factura", terms:"Plazo de Pago (Días)", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Ingresa los datos de la factura para hallar la fecha de vencimiento", emptyDesc:"La fecha de vencimiento y el estado aparecerán aquí.", dueDate:"Fecha de Vencimiento", status:"Estado" },
}[lang];
---

<div class="calculator-widget">
  <div class="calculator-inputs">
    <CalculatorField id="invoiceDate" label={copy.invoiceDate} type="date" />
    <CalculatorField id="paymentTermsDays" label={copy.terms} type="number" placeholder="e.g. 30" />

    <div id="errorBox" class="error-box" role="alert" hidden></div>

    <ActionButtons
      calculateId="calculateBtn"
      resetId="resetBtn"
      copyId="copyBtn"
      showDownload={false}
      showShare={false}
      calculateText={copy.calculate}
      resetText={copy.reset}
      copyText={copy.copy}
    />
  </div>

  <div class="calculator-output">
    <EmptyState
      id="emptyState"
      title={copy.emptyTitle}
      description={copy.emptyDesc}
    />

    <ResultsGrid id="resultsContainer" hidden>
      <ResultCard id="dueDateResult" title={copy.dueDate} icon={CalendarCheck} accent="primary" size="lg" />
      <ResultCard id="statusResult" title={copy.status} icon={Clock} accent="warning" />
    </ResultsGrid>
  </div>
</div>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script src="../../scripts/invoice-due-date-calculator.ts"></script>

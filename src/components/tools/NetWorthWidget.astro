---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Landmark, Wallet, TrendingDown, Scale } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { assetsGroup:"Assets", cash:"Cash & Savings", investments:"Investments", realEstate:"Real Estate Value", otherAssets:"Other Assets", liabilitiesGroup:"Liabilities", mortgageDebt:"Mortgage Balance", loanDebt:"Other Loans", creditCardDebt:"Credit Card Debt", otherLiabilities:"Other Liabilities", emptyTitle:"Net Worth Calculator", emptyDesc:"Add up your assets and liabilities to see your total net worth.", tip1:"Total Assets", tip2:"Total Liabilities", tip3:"Net Worth", netWorth:"Net Worth", totalAssets:"Total Assets", totalLiabilities:"Total Liabilities", debtRatio:"Debt-to-Asset Ratio", positive:"Positive", negative:"Negative", aboutTitle:"About this Calculator", aboutText:"Totals your assets (cash, investments, real estate, other) and liabilities (mortgage, loans, credit cards, other), then subtracts to give your net worth and a debt-to-asset ratio showing how leveraged your position is." },
  es: { assetsGroup:"Activos", cash:"Efectivo y Ahorros", investments:"Inversiones", realEstate:"Valor de Bienes Raíces", otherAssets:"Otros Activos", liabilitiesGroup:"Pasivos", mortgageDebt:"Saldo Hipotecario", loanDebt:"Otros Préstamos", creditCardDebt:"Deuda de Tarjeta de Crédito", otherLiabilities:"Otros Pasivos", emptyTitle:"Calculadora de Patrimonio Neto", emptyDesc:"Suma tus activos y pasivos para ver tu patrimonio neto total.", tip1:"Activos Totales", tip2:"Pasivos Totales", tip3:"Patrimonio Neto", netWorth:"Patrimonio Neto", totalAssets:"Activos Totales", totalLiabilities:"Pasivos Totales", debtRatio:"Ratio Deuda-Activo", positive:"Positivo", negative:"Negativo", aboutTitle:"Acerca de esta Calculadora", aboutText:"Suma tus activos (efectivo, inversiones, bienes raíces, otros) y pasivos (hipoteca, préstamos, tarjetas de crédito, otros), luego resta para obtener tu patrimonio neto y un ratio deuda-activo que muestra qué tan apalancada está tu posición." },
}[lang];
---
<section class="nw-calculator">
  <div class="nw-layout">
    <aside class="nw-sidebar">
      <div class="nw-group">
        <h3>{copy.assetsGroup}</h3>
        <CalculatorField id="cash" label={copy.cash} type="number" placeholder="e.g. 15000" min="0" step="1" />
        <CalculatorField id="investments" label={copy.investments} type="number" placeholder="e.g. 60000" min="0" step="1" />
        <CalculatorField id="realEstate" label={copy.realEstate} type="number" placeholder="e.g. 300000" min="0" step="1" />
        <CalculatorField id="otherAssets" label={copy.otherAssets} type="number" placeholder="e.g. 10000" min="0" step="1" />
      </div>
      <div class="nw-group">
        <h3>{copy.liabilitiesGroup}</h3>
        <CalculatorField id="mortgageDebt" label={copy.mortgageDebt} type="number" placeholder="e.g. 220000" min="0" step="1" />
        <CalculatorField id="loanDebt" label={copy.loanDebt} type="number" placeholder="e.g. 12000" min="0" step="1" />
        <CalculatorField id="creditCardDebt" label={copy.creditCardDebt} type="number" placeholder="e.g. 3000" min="0" step="1" />
        <CalculatorField id="otherLiabilities" label={copy.otherLiabilities} type="number" placeholder="e.g. 0" min="0" step="1" />
      </div>
      <CalculatorActions lang={lang} calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="nw-content">
      <div id="emptyState">
        <EmptyState icon="💰" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="netWorthResult" title={copy.netWorth} icon={Landmark} accent="success" subtitle=" " />
          <ResultCard id="totalAssetsResult" title={copy.totalAssets} icon={Wallet} />
          <ResultCard id="totalLiabilitiesResult" title={copy.totalLiabilities} icon={TrendingDown} />
          <ResultCard id="debtRatioResult" title={copy.debtRatio} icon={Scale} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/net-worth-calculator";
</script>
<style>
.nw-calculator{width:100%;}
.nw-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.nw-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;}
.nw-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.nw-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.nw-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.nw-layout{grid-template-columns:1fr;}.nw-sidebar{position:static;}}
@media(max-width:768px){.nw-layout{gap:24px;}.nw-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
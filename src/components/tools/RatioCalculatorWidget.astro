---
import CalculatorField from "../calculator/CalculatorField.astro";
import ActionButtons from "../calculator/ActionButtons.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import EmptyState from "../calculator/EmptyState.astro";
import { Divide, Percent } from "@lucide/astro";
---

<div class="calculator-widget">
  <div class="calculator-inputs">
    <CalculatorField id="valueA" label="First Value" type="number" placeholder="e.g. 4" />
    <CalculatorField id="valueB" label="Second Value" type="number" placeholder="e.g. 6" />

    <div id="errorBox" class="error-box" role="alert" hidden></div>

    <ActionButtons
      calculateId="calculateBtn"
      resetId="resetBtn"
      copyId="copyBtn"
      showDownload={false}
      showShare={false}
    />
  </div>

  <div class="calculator-output">
    <EmptyState
      id="emptyState"
      title="Enter values to simplify ratio"
      description="Simplified ratio and percentage split will appear here."
    />

    <ResultsGrid id="resultsContainer" hidden>
      <ResultCard id="simplifiedResult" title="Simplified Ratio" icon={Divide} accent="primary" size="lg" />
      <ResultCard id="decimalResult" title="Decimal Ratio" icon={Divide} accent="neutral" />
      <ResultCard id="percentageResult" title="Percentage Split" icon={Percent} accent="neutral" />
    </ResultsGrid>
  </div>
</div>

<script src="../../scripts/ratio-calculator.ts"></script>

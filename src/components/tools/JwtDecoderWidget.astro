---
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { KeyRound, ShieldAlert, CalendarClock, CalendarX, CodeXml } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { token:"JWT Token", emptyTitle:"JWT Decoder", emptyDesc:"Decode and inspect JSON Web Tokens instantly.", tip1:"Header & Payload", tip2:"Expiry Check", tip3:"Algorithm", tip4:"Copy Summary", status:"Status", algorithm:"Algorithm", issued:"Issued At", expires:"Expires At", header:"Header", payload:"Payload", aboutTitle:"About this Tool", aboutText:"Decode JWT header and payload, check expiry status and algorithm — entirely client-side, your token never leaves your browser." },
  es: { token:"Token JWT", emptyTitle:"Decodificador JWT", emptyDesc:"Decodifica e inspecciona JSON Web Tokens al instante.", tip1:"Encabezado y Payload", tip2:"Verificación de Expiración", tip3:"Algoritmo", tip4:"Copiar Resumen", status:"Estado", algorithm:"Algoritmo", issued:"Emitido", expires:"Expira", header:"Encabezado", payload:"Payload", aboutTitle:"Acerca de esta Herramienta", aboutText:"Decodifica el encabezado y payload del JWT, verifica el estado de expiración y el algoritmo — todo del lado del cliente, tu token nunca sale de tu navegador." },
}[lang];
---
<section class="jwt-decoder">
  <div class="jwt-layout">
    <aside class="jwt-sidebar">
      <div class="tool-field">
        <label class="tool-label" for="jwtInput">{copy.token}</label>
        <textarea id="jwtInput" class="tool-textarea" placeholder="eyJhbGciOiJIUzI1NiIs..."></textarea>
      </div>
      <CalculatorActions calculateId="decodeBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>

    <main class="jwt-content">
      <div id="emptyState">
        <EmptyState
          icon="🔑"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={[copy.tip1, copy.tip2, copy.tip3, copy.tip4]}
        />
      </div>

      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="statusResult" title={copy.status} icon={ShieldAlert} />
          <ResultCard id="algResult" title={copy.algorithm} icon={KeyRound} />
          <ResultCard id="issuedResult" title={copy.issued} icon={CalendarClock} />
          <ResultCard id="expiresResult" title={copy.expires} icon={CalendarX} />
        </ResultsGrid>

        <div class="tool-grid-2">
          <div class="tool-field">
            <label class="tool-label"><CodeXml size={16} /> Header</label>
            <pre id="headerOutput" class="tool-textarea code-block"></pre>
          </div>
          <div class="tool-field">
            <label class="tool-label"><CodeXml size={16} /> Payload</label>
            <pre id="payloadOutput" class="tool-textarea code-block"></pre>
          </div>
        </div>

        <section class="calculator-info">
          <h2>About this Tool</h2>
          <p>Decode JWT header and payload, check expiry status and algorithm — entirely client-side, your token never leaves your browser.</p>
        </section>
      </div>
    </main>
  </div>
</section>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/jwt-decoder";
</script>

<style>
.jwt-decoder{width:100%;}
.jwt-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.jwt-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;}
.tool-field{display:flex;flex-direction:column;gap:8px;}
.tool-field .tool-label{display:flex;align-items:center;gap:6px;}
.jwt-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.code-block{white-space:pre-wrap;font-family:ui-monospace,monospace;font-size:.82rem;overflow:auto;}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.jwt-layout{grid-template-columns:1fr;}.jwt-sidebar{position:static;}.tool-grid-2{grid-template-columns:1fr;}}
</style>


---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";

import {
  Wallet,
  TrendingUp,
  Coins,
  CalendarDays,
  Clock3
} from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { principalLabel:"Principal Amount (₹)", principalHelp:"The initial amount you are investing or borrowing.", rateLabel:"Annual Interest Rate (%)", rateHelp:"The yearly interest rate.", yearsLabel:"Time Period (Years)", yearsHelp:"Duration of the loan or deposit.", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"Simple Interest Calculator", emptyDesc:"Calculate interest earned or paid on a fixed principal.", tip1:"Total Interest", tip2:"Total Amount", tip3:"Monthly Interest", tip4:"Daily Interest", amount:"Total Amount", interest:"Total Interest", principal:"Principal Invested", monthly:"Monthly Interest", daily:"Daily Interest", aboutTitle:"About this Calculator", aboutText:"Simple Interest is calculated only on the original principal, unlike compound interest where interest is added back and earns further interest. Formula used: SI = (P × R × T) / 100." },
  es: { principalLabel:"Monto Principal (₹)", principalHelp:"El monto inicial que estás invirtiendo o pidiendo prestado.", rateLabel:"Tasa de Interés Anual (%)", rateHelp:"La tasa de interés anual.", yearsLabel:"Plazo (Años)", yearsHelp:"Duración del préstamo o depósito.", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora de Interés Simple", emptyDesc:"Calcula el interés ganado o pagado sobre un principal fijo.", tip1:"Interés Total", tip2:"Monto Total", tip3:"Interés Mensual", tip4:"Interés Diario", amount:"Monto Total", interest:"Interés Total", principal:"Principal Invertido", monthly:"Interés Mensual", daily:"Interés Diario", aboutTitle:"Acerca de esta Calculadora", aboutText:"El Interés Simple se calcula solo sobre el principal original, a diferencia del interés compuesto donde el interés se reinvierte y genera más interés. Fórmula usada: SI = (P × R × T) / 100." },
}[lang];
---

<section class="si-calculator">

  <div class="si-layout">

    <aside class="si-sidebar">

      <CalculatorField
        id="principal"
        label={copy.principalLabel}
        type="number"
        placeholder="e.g. 100000"
        required={true}
        min="0"
        step="1"
        helpText={copy.principalHelp}
      />

      <CalculatorField
        id="annualRate"
        label={copy.rateLabel}
        type="number"
        placeholder="e.g. 8.5"
        required={true}
        min="0"
        step="0.01"
        helpText={copy.rateHelp}
      />

      <CalculatorField
        id="years"
        label={copy.yearsLabel}
        type="number"
        placeholder="e.g. 5"
        required={true}
        min="0"
        step="0.5"
        helpText={copy.yearsHelp}
      />

      <CalculatorActions lang={lang}
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
        calculateText={copy.calculate}
        resetText={copy.reset}
        copyText={copy.copy}
      />

      <div
        id="errorBox"
        class="error-box"
        hidden
      ></div>

    </aside>

    <main class="si-content">

      <div id="emptyState">

        <EmptyState
          icon="💵"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={[
            copy.tip1,
            copy.tip2,
            copy.tip3,
            copy.tip4
          ]}
        />

      </div>

      <div
        id="resultsContainer"
        hidden
      >

        <ResultsGrid columns={3}>

          <ResultCard
            id="amountResult"
            title={copy.amount}
            icon={Wallet}
            accent="success"
          />

          <ResultCard
            id="interestResult"
            title={copy.interest}
            icon={TrendingUp}
          />

          <ResultCard
            id="principalResult"
            title={copy.principal}
            icon={Coins}
          />

          <ResultCard
            id="monthlyResult"
            title={copy.monthly}
            icon={CalendarDays}
          />

          <ResultCard
            id="dailyResult"
            title={copy.daily}
            icon={Clock3}
          />

        </ResultsGrid>

        <section class="calculator-info">

          <h2>{copy.aboutTitle}</h2>

          <p>{copy.aboutText}</p>

        </section>

      </div>

    </main>

  </div>

</section>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/simple-interest-calculator";
</script>

<style>

.si-calculator{

width:100%;

}

.si-layout{

display:grid;

grid-template-columns:340px minmax(0,1fr);

gap:32px;

align-items:start;

}

.si-sidebar{

position:sticky;

top:24px;

display:flex;

flex-direction:column;

gap:20px;

}

.si-content{

display:flex;

flex-direction:column;

gap:28px;

min-width:0;

}

.calculator-info{

padding:24px;

border:1px solid var(--border-subtle);

border-radius:18px;

background:var(--bg-card);

}

.calculator-info h2{

margin:0 0 12px;

font-size:1.15rem;

font-weight:700;

color:var(--text-primary);

}

.calculator-info p{

margin:0;

line-height:1.8;

font-size:.95rem;

color:var(--text-secondary);

}

.error-box{

display:flex;

align-items:center;

padding:14px 16px;

border-radius:14px;

background:#FEF2F2;

border:1px solid #FCA5A5;

color:#B91C1C;

font-size:.92rem;

font-weight:600;

}


:global(.dark) .error-box{

background:#2A1111;

border-color:#7F1D1D;

color:#FECACA;

}

@media(max-width:1024px){

.si-layout{

grid-template-columns:1fr;

}

.si-sidebar{

position:static;

}

}

@media(max-width:768px){

.si-layout{

gap:24px;

}

.si-content{

gap:20px;

}

}

@media(max-width:640px){

.calculator-info{

padding:18px;

}

}

</style>

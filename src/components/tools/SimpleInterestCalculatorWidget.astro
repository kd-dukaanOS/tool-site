---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";

import {
  Wallet,
  TrendingUp,
  Coins,
  CalendarDays,
  Clock3
} from "@lucide/astro";
---

<section class="si-calculator">

  <div class="si-layout">

    <aside class="si-sidebar">

      <CalculatorField
        id="principal"
        label="Principal Amount (₹)"
        type="number"
        placeholder="e.g. 100000"
        required={true}
        min="0"
        step="1"
        helpText="The initial amount you are investing or borrowing."
      />

      <CalculatorField
        id="annualRate"
        label="Annual Interest Rate (%)"
        type="number"
        placeholder="e.g. 8.5"
        required={true}
        min="0"
        step="0.01"
        helpText="The yearly interest rate."
      />

      <CalculatorField
        id="years"
        label="Time Period (Years)"
        type="number"
        placeholder="e.g. 5"
        required={true}
        min="0"
        step="0.5"
        helpText="Duration of the loan or deposit."
      />

      <CalculatorActions
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
      />

      <div
        id="errorBox"
        class="error-box"
        hidden
      ></div>

    </aside>

    <main class="si-content">

      <div id="emptyState">

        <EmptyState
          icon="💵"
          title="Simple Interest Calculator"
          description="Calculate interest earned or paid on a fixed principal."
          tips={[
            "Total Interest",
            "Total Amount",
            "Monthly Interest",
            "Daily Interest"
          ]}
        />

      </div>

      <div
        id="resultsContainer"
        hidden
      >

        <ResultsGrid columns={3}>

          <ResultCard
            id="amountResult"
            title="Total Amount"
            icon={Wallet}
            accent="success"
          />

          <ResultCard
            id="interestResult"
            title="Total Interest"
            icon={TrendingUp}
          />

          <ResultCard
            id="principalResult"
            title="Principal Invested"
            icon={Coins}
          />

          <ResultCard
            id="monthlyResult"
            title="Monthly Interest"
            icon={CalendarDays}
          />

          <ResultCard
            id="dailyResult"
            title="Daily Interest"
            icon={Clock3}
          />

        </ResultsGrid>

        <section class="calculator-info">

          <h2>About this Calculator</h2>

          <p>
            Simple Interest is calculated only on the original principal,
            unlike compound interest where interest is added back and
            earns further interest. Formula used: SI = (P × R × T) / 100.
          </p>

        </section>

      </div>

    </main>

  </div>

</section>

<script>
  import "../../scripts/simple-interest-calculator";
</script>

<style>

.si-calculator{

width:100%;

}

.si-layout{

display:grid;

grid-template-columns:340px minmax(0,1fr);

gap:32px;

align-items:start;

}

.si-sidebar{

position:sticky;

top:24px;

display:flex;

flex-direction:column;

gap:20px;

}

.si-content{

display:flex;

flex-direction:column;

gap:28px;

min-width:0;

}

.calculator-info{

padding:24px;

border:1px solid var(--border-subtle);

border-radius:18px;

background:var(--bg-card);

}

.calculator-info h2{

margin:0 0 12px;

font-size:1.15rem;

font-weight:700;

color:var(--text-primary);

}

.calculator-info p{

margin:0;

line-height:1.8;

font-size:.95rem;

color:var(--text-secondary);

}

.error-box{

display:flex;

align-items:center;

padding:14px 16px;

border-radius:14px;

background:#FEF2F2;

border:1px solid #FCA5A5;

color:#B91C1C;

font-size:.92rem;

font-weight:600;

}


:global(.dark) .error-box{

background:#2A1111;

border-color:#7F1D1D;

color:#FECACA;

}

@media(max-width:1024px){

.si-layout{

grid-template-columns:1fr;

}

.si-sidebar{

position:static;

}

}

@media(max-width:768px){

.si-layout{

gap:24px;

}

.si-content{

gap:20px;

}

}

@media(max-width:640px){

.calculator-info{

padding:18px;

}

}

</style>


---
{/* src/components/tools/HourlyToSalaryCalculatorWidget.astro */}
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import CurrencySelector from "../calculator/CurrencySelector.astro";

import { Wallet, CalendarDays, Clock } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { hourlyRate:"Hourly Rate ($)", hourlyRateHelp:"Your pay per hour worked.", hoursPerWeek:"Hours per Week", hoursPerWeekHelp:"Typical hours worked each week.", weeksPerYear:"Weeks per Year", weeksPerYearHelp:"Weeks worked per year (52 for no unpaid time off).", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"Hourly to Salary Calculator", emptyDesc:"Convert your hourly rate into weekly, monthly and annual salary.", tip1:"Weekly Salary", tip2:"Monthly Salary", tip3:"Annual Salary", annualSalary:"Annual Salary", monthlySalary:"Monthly Salary", weeklySalary:"Weekly Salary", aboutTitle:"About this Calculator", aboutText:"Converts your hourly rate into weekly, monthly and annual salary based on hours worked per week and weeks worked per year. All calculations run locally — no external data or paid service is required." },
  es: { hourlyRate:"Tarifa por Hora ($)", hourlyRateHelp:"Tu pago por hora trabajada.", hoursPerWeek:"Horas por Semana", hoursPerWeekHelp:"Horas típicas trabajadas cada semana.", weeksPerYear:"Semanas por Año", weeksPerYearHelp:"Semanas trabajadas por año (52 si no hay tiempo libre no pagado).", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora de Salario por Hora", emptyDesc:"Convierte tu tarifa por hora en salario semanal, mensual y anual.", tip1:"Salario Semanal", tip2:"Salario Mensual", tip3:"Salario Anual", annualSalary:"Salario Anual", monthlySalary:"Salario Mensual", weeklySalary:"Salario Semanal", aboutTitle:"Acerca de esta Calculadora", aboutText:"Convierte tu tarifa por hora en salario semanal, mensual y anual según las horas trabajadas por semana y las semanas trabajadas por año. Todos los cálculos se ejecutan localmente — no se requieren datos externos ni servicios pagados." },
}[lang];
---

<section class="hts-calculator">
  <div class="hts-layout">

   <aside class="hts-sidebar">
      <CurrencySelector />

      <CalculatorField
        id="hourlyRate"
        label={copy.hourlyRate}
        type="number"
        placeholder="e.g. 25"
        required={true}
        min="0"
        step="0.01"
        helpText={copy.hourlyRateHelp}
      />

      <CalculatorField
        id="hoursPerWeek"
        label={copy.hoursPerWeek}
        type="number"
        placeholder="e.g. 40"
        required={true}
        min="1"
        max="168"
        step="1"
        helpText={copy.hoursPerWeekHelp}
      />

      <CalculatorField
        id="weeksPerYear"
        label={copy.weeksPerYear}
        type="number"
        placeholder="e.g. 52"
        required={true}
        min="1"
        max="52"
        step="1"
        helpText={copy.weeksPerYearHelp}
      />

      <CalculatorActions
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
        calculateText={copy.calculate}
        resetText={copy.reset}
        copyText={copy.copy}
      />

      <div id="errorBox" class="error-box" hidden></div>
    </aside>

    <main class="hts-content">
      <div id="emptyState">
        <EmptyState
          icon="💵"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={[copy.tip1, copy.tip2, copy.tip3]}
        />
      </div>

      <div id="resultsContainer" hidden>
        <ResultsGrid columns={3}>
          <ResultCard id="annualSalaryResult" title={copy.annualSalary} icon={Wallet} accent="success" size="lg" />
          <ResultCard id="monthlySalaryResult" title={copy.monthlySalary} icon={CalendarDays} accent="primary" />
          <ResultCard id="weeklySalaryResult" title={copy.weeklySalary} icon={Clock} />
        </ResultsGrid>

        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>

  </div>
</section>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/hourly-to-salary-calculator";
</script>

<style>
.hts-calculator{ width:100%; }
.hts-layout{ display:grid; grid-template-columns:340px minmax(0,1fr); gap:32px; align-items:start; }
.hts-sidebar{ position:sticky; top:24px; display:flex; flex-direction:column; gap:20px; }
.hts-content{ display:flex; flex-direction:column; gap:28px; min-width:0; }
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){ .hts-layout{ grid-template-columns:1fr; } .hts-sidebar{ position:static; } }
@media(max-width:768px){ .hts-layout{ gap:24px; } .hts-content{ gap:20px; } }
@media(max-width:640px){ .calculator-info{ padding:18px; } }
</style>
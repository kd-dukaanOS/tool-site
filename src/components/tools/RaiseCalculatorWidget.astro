
---
{/* src/components/tools/RaiseCalculatorWidget.astro */}
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import CurrencySelector from "../calculator/CurrencySelector.astro";

import { Wallet, TrendingUp, CalendarDays } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { currentSalary:"Current Salary ($)", currentSalaryHelp:"Your current annual salary.", raisePercent:"Raise (%)", raisePercentHelp:"Percentage increase you're getting or requesting.", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"Raise Calculator", emptyDesc:"Find your new salary and raise amount from your current salary and raise percentage.", tip1:"New Salary", tip2:"Raise Amount", tip3:"Monthly Increase", newSalary:"New Salary", raiseAmount:"Raise Amount", monthlyIncrease:"Monthly Increase", aboutTitle:"About this Calculator", aboutText:"Calculates your new salary and raise amount from your current salary and raise percentage. All calculations run locally — no external data or paid service is required." },
  es: { currentSalary:"Salario Actual ($)", currentSalaryHelp:"Tu salario anual actual.", raisePercent:"Aumento (%)", raisePercentHelp:"Porcentaje de aumento que recibirás o solicitarás.", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora de Aumento Salarial", emptyDesc:"Encuentra tu nuevo salario y el monto del aumento a partir de tu salario actual y el porcentaje de aumento.", tip1:"Nuevo Salario", tip2:"Monto del Aumento", tip3:"Incremento Mensual", newSalary:"Nuevo Salario", raiseAmount:"Monto del Aumento", monthlyIncrease:"Incremento Mensual", aboutTitle:"Acerca de esta Calculadora", aboutText:"Calcula tu nuevo salario y el monto del aumento a partir de tu salario actual y el porcentaje de aumento. Todos los cálculos se ejecutan localmente — no se requieren datos externos ni servicios pagados." },
}[lang];
---

<section class="raise-calculator">
  <div class="raise-layout">

    <aside class="raise-sidebar">
      <CurrencySelector />

      <CalculatorField
        id="currentSalary"
        label={copy.currentSalary}
        type="number"
        placeholder="e.g. 60000"
        required={true}
        min="0"
        step="1"
        helpText={copy.currentSalaryHelp}
      />

      <CalculatorField
        id="raisePercent"
        label={copy.raisePercent}
        type="number"
        placeholder="e.g. 5"
        required={true}
        step="0.1"
        helpText={copy.raisePercentHelp}
      />

      <CalculatorActions
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
        calculateText={copy.calculate}
        resetText={copy.reset}
        copyText={copy.copy}
      />

      <div id="errorBox" class="error-box" hidden></div>
    </aside>

    <main class="raise-content">
      <div id="emptyState">
        <EmptyState
          icon="📈"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={[copy.tip1, copy.tip2, copy.tip3]}
        />
      </div>

      <div id="resultsContainer" hidden>
        <ResultsGrid columns={3}>
          <ResultCard id="newSalaryResult" title={copy.newSalary} icon={Wallet} accent="success" size="lg" />
          <ResultCard id="raiseAmountResult" title={copy.raiseAmount} icon={TrendingUp} accent="primary" />
          <ResultCard id="monthlyIncreaseResult" title={copy.monthlyIncrease} icon={CalendarDays} />
        </ResultsGrid>

        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>

  </div>
</section>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/raise-calculator";
</script>

<style>
.raise-calculator{ width:100%; }
.raise-layout{ display:grid; grid-template-columns:340px minmax(0,1fr); gap:32px; align-items:start; }
.raise-sidebar{ position:sticky; top:24px; display:flex; flex-direction:column; gap:20px; }
.raise-content{ display:flex; flex-direction:column; gap:28px; min-width:0; }
.calculator-info{ padding:24px; border:1px solid var(--border-subtle); border-radius:18px; background:var(--bg-card); }
.calculator-info h2{ margin:0 0 12px; font-size:1.15rem; font-weight:700; color:var(--text-primary); }
.calculator-info p{ margin:0; line-height:1.8; font-size:.95rem; color:var(--text-secondary); }
.error-box{ display:flex; align-items:center; padding:14px 16px; border-radius:14px; background:#FEF2F2; border:1px solid #FCA5A5; color:#B91C1C; font-size:.92rem; font-weight:600; }
:global(.dark) .error-box{ background:#2A1111; border-color:#7F1D1D; color:#FECACA; }
@media(max-width:1024px){ .raise-layout{ grid-template-columns:1fr; } .raise-sidebar{ position:static; } }
@media(max-width:768px){ .raise-layout{ gap:24px; } .raise-content{ gap:20px; } }
@media(max-width:640px){ .calculator-info{ padding:18px; } }
</style>
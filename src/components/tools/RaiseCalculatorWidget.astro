
---
{/* src/components/tools/RaiseCalculatorWidget.astro */}
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import CurrencySelector from "../calculator/CurrencySelector.astro";

import { Wallet, TrendingUp, CalendarDays } from "@lucide/astro";
---

<section class="raise-calculator">
  <div class="raise-layout">

    <aside class="raise-sidebar">
      <CurrencySelector />

      <CalculatorField
        id="currentSalary"
        label="Current Salary ($)"
        type="number"
        placeholder="e.g. 60000"
        required={true}
        min="0"
        step="1"
        helpText="Your current annual salary."
      />

      <CalculatorField
        id="raisePercent"
        label="Raise (%)"
        type="number"
        placeholder="e.g. 5"
        required={true}
        step="0.1"
        helpText="Percentage increase you're getting or requesting."
      />

      <CalculatorActions
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
      />

      <div id="errorBox" class="error-box" hidden></div>
    </aside>

    <main class="raise-content">
      <div id="emptyState">
        <EmptyState
          icon="📈"
          title="Raise Calculator"
          description="Find your new salary and raise amount from your current salary and raise percentage."
          tips={["New Salary", "Raise Amount", "Monthly Increase"]}
        />
      </div>

      <div id="resultsContainer" hidden>
        <ResultsGrid columns={3}>
          <ResultCard id="newSalaryResult" title="New Salary" icon={Wallet} accent="success" size="lg" />
          <ResultCard id="raiseAmountResult" title="Raise Amount" icon={TrendingUp} accent="primary" />
          <ResultCard id="monthlyIncreaseResult" title="Monthly Increase" icon={CalendarDays} />
        </ResultsGrid>

        <section class="calculator-info">
          <h2>About this Calculator</h2>
          <p>
            Calculates your new salary and raise amount from your current salary and raise percentage.
            All calculations run locally — no external data or paid service is required.
          </p>
        </section>
      </div>
    </main>

  </div>
</section>

<script>
  import "../../scripts/raise-calculator";
</script>

<style>
.raise-calculator{ width:100%; }
.raise-layout{ display:grid; grid-template-columns:340px minmax(0,1fr); gap:32px; align-items:start; }
.raise-sidebar{ position:sticky; top:24px; display:flex; flex-direction:column; gap:20px; }
.raise-content{ display:flex; flex-direction:column; gap:28px; min-width:0; }
.calculator-info{ padding:24px; border:1px solid var(--border-subtle); border-radius:18px; background:var(--bg-card); }
.calculator-info h2{ margin:0 0 12px; font-size:1.15rem; font-weight:700; color:var(--text-primary); }
.calculator-info p{ margin:0; line-height:1.8; font-size:.95rem; color:var(--text-secondary); }
.error-box{ display:flex; align-items:center; padding:14px 16px; border-radius:14px; background:#FEF2F2; border:1px solid #FCA5A5; color:#B91C1C; font-size:.92rem; font-weight:600; }
:global(.dark) .error-box{ background:#2A1111; border-color:#7F1D1D; color:#FECACA; }
@media(max-width:1024px){ .raise-layout{ grid-template-columns:1fr; } .raise-sidebar{ position:static; } }
@media(max-width:768px){ .raise-layout{ gap:24px; } .raise-content{ gap:20px; } }
@media(max-width:640px){ .calculator-info{ padding:18px; } }
</style>
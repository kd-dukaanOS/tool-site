---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Timer, Gauge, Flame, Wallet } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { cashGroup:"Cash Position", currentCash:"Current Cash Balance", monthlyGroup:"Monthly Numbers", monthlyRevenue:"Monthly Revenue", monthlyExpenses:"Monthly Expenses", growthGroup:"Growth Assumptions", revenueGrowth:"Monthly Revenue Growth (%)", expenseGrowth:"Monthly Expense Growth (%)", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"Runway Calculator", emptyDesc:"Project your runway using current burn rate and revenue/expense growth trends.", tip1:"Dynamic Runway", tip2:"Static Runway", tip3:"6-Month Forecast", dynamicRunway:"Dynamic Runway", staticRunway:"Static Runway", netBurn:"Current Net Burn", balanceIn6Mo:"Balance in 6 Months", growthNote:"With revenue/expense growth applied", cashFlowPositive:"Cash flow positive", months:"mo", plus120:"120+ mo", aboutTitle:"About this Calculator", aboutText:"Projects runway two ways: a static estimate based on your current net burn rate, and a dynamic month-by-month simulation that applies your expected monthly revenue and expense growth rates." },
  es: { cashGroup:"Posición de Efectivo", currentCash:"Saldo de Efectivo Actual", monthlyGroup:"Cifras Mensuales", monthlyRevenue:"Ingresos Mensuales", monthlyExpenses:"Gastos Mensuales", growthGroup:"Supuestos de Crecimiento", revenueGrowth:"Crecimiento Mensual de Ingresos (%)", expenseGrowth:"Crecimiento Mensual de Gastos (%)", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora de Runway", emptyDesc:"Proyecta tu runway usando la tasa de quema actual y las tendencias de crecimiento de ingresos/gastos.", tip1:"Runway Dinámico", tip2:"Runway Estático", tip3:"Pronóstico de 6 Meses", dynamicRunway:"Runway Dinámico", staticRunway:"Runway Estático", netBurn:"Quema Neta Actual", balanceIn6Mo:"Saldo en 6 Meses", growthNote:"Con crecimiento de ingresos/gastos aplicado", cashFlowPositive:"Flujo de caja positivo", months:"mes", plus120:"120+ mes", aboutTitle:"Acerca de esta Calculadora", aboutText:"Proyecta el runway de dos formas: una estimación estática basada en tu tasa de quema neta actual, y una simulación mes a mes dinámica que aplica tus tasas esperadas de crecimiento de ingresos y gastos." },
}[lang];
---
<section class="rwc-calculator">
  <div class="rwc-layout">
    <aside class="rwc-sidebar">
      <div class="rwc-group">
        <h3>{copy.cashGroup}</h3>
        <CalculatorField id="currentCashBalance" label={copy.currentCash} type="number" placeholder="e.g. 300000" min="0" step="1" />
      </div>
      <div class="rwc-group">
        <h3>{copy.monthlyGroup}</h3>
        <CalculatorField id="monthlyRevenue" label={copy.monthlyRevenue} type="number" placeholder="e.g. 15000" min="0" step="1" />
        <CalculatorField id="monthlyExpenses" label={copy.monthlyExpenses} type="number" placeholder="e.g. 40000" min="0" step="1" />
      </div>
      <div class="rwc-group">
        <h3>{copy.growthGroup}</h3>
        <CalculatorField id="monthlyRevenueGrowthRate" label={copy.revenueGrowth} type="number" placeholder="e.g. 5" step="0.1" />
        <CalculatorField id="monthlyExpenseGrowthRate" label={copy.expenseGrowth} type="number" placeholder="e.g. 2" step="0.1" />
      </div>
      <CalculatorActions calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} calculateText={copy.calculate} resetText={copy.reset} copyText={copy.copy} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="rwc-content">
      <div id="emptyState">
        <EmptyState icon="⏳" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="dynamicRunwayResult" title={copy.dynamicRunway} icon={Timer} accent="warning" subtitle=" " />
          <ResultCard id="staticRunwayResult" title={copy.staticRunway} icon={Gauge} />
          <ResultCard id="netBurnResult" title={copy.netBurn} icon={Flame} />
          <ResultCard id="balanceIn6MoResult" title={copy.balanceIn6Mo} icon={Wallet} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/runway-calculator";
</script>
<style>
.rwc-calculator{width:100%;}
.rwc-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.rwc-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.rwc-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.rwc-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.rwc-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.rwc-layout{grid-template-columns:1fr;}.rwc-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.rwc-layout{gap:24px;}.rwc-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
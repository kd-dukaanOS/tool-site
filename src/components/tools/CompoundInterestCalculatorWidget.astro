---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import ScheduleTable from "../calculator/ScheduleTable.astro";

import {
  Wallet,
  TrendingUp,
  Coins,
  Percent,
  BarChart3,
  Repeat
} from "@lucide/astro";
---

<section class="ci-calculator">

  <div class="ci-layout">

    <!-- Sidebar -->

    <aside class="ci-sidebar">

      <CalculatorField
        id="principal"
        label="Principal Amount (₹)"
        type="number"
        placeholder="e.g. 100000"
        required={true}
        min="0"
        step="1"
        helpText="The initial amount you are investing or depositing."
      />

      <CalculatorField
        id="annualRate"
        label="Annual Interest Rate (%)"
        type="number"
        placeholder="e.g. 8.5"
        required={true}
        min="0"
        step="0.01"
        helpText="The yearly interest rate offered by the bank or scheme."
      />

      <CalculatorField
        id="years"
        label="Time Period (Years)"
        type="number"
        placeholder="e.g. 5"
        required={true}
        min="0"
        step="0.5"
        helpText="How long the money stays invested."
      />

      <CalculatorField
        id="frequency"
        label="Compounding Frequency (times/year)"
        type="number"
        value="1"
        required={true}
        min="1"
        step="1"
        helpText="1 = Annually, 2 = Semi-Annually, 4 = Quarterly, 12 = Monthly, 365 = Daily."
      />

      <CalculatorActions
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
      />

      <div
        id="errorBox"
        class="error-box"
        hidden
      ></div>

    </aside>

    <!-- Results -->

    <main class="ci-content">

      <div id="emptyState">

        <EmptyState
          icon="💰"
          title="Compound Interest Calculator"
          description="See how your money grows when interest is added back and starts earning interest itself."
          tips={[
            "Maturity Value",
            "Total Interest Earned",
            "Effective Annual Rate",
            "Growth Multiplier",
            "Year-wise Growth Schedule"
          ]}
        />

      </div>

      <div
        id="resultsContainer"
        hidden
      >

        <ResultsGrid columns={3}>

          <ResultCard
            id="maturityResult"
            title="Maturity Value"
            icon={Wallet}
            accent="success"
          />

          <ResultCard
            id="interestResult"
            title="Total Interest Earned"
            icon={TrendingUp}
          />

          <ResultCard
            id="principalResult"
            title="Principal Invested"
            icon={Coins}
          />

          <ResultCard
            id="earResult"
            title="Effective Annual Rate"
            icon={Percent}
            subtitle=" "
          />

          <ResultCard
            id="multiplierResult"
            title="Growth Multiplier"
            icon={BarChart3}
          />

          <ResultCard
            id="frequencyResult"
            title="Compounding Frequency"
            icon={Repeat}
          />

        </ResultsGrid>

        <ScheduleTable
          id="scheduleBody"
          headers={["Year", "Opening Balance", "Interest Earned", "Closing Balance"]}
          caption="Year-wise Growth Schedule"
        />

        <section class="calculator-info">

          <h2>About this Calculator</h2>

          <p>
            The Compound Interest Calculator shows how a lump sum grows
            over time when interest earned is added back to the principal
            and starts earning interest itself. Try changing the
            compounding frequency to see how monthly or quarterly
            compounding compares to yearly compounding — more frequent
            compounding always means slightly higher returns for the
            same stated rate.
          </p>

        </section>

      </div>

    </main>

  </div>

</section>

<script>
  import "../../scripts/compound-interest-calculator";
</script>

<style>

.ci-calculator{

width:100%;

}

.ci-layout{

display:grid;

grid-template-columns:340px minmax(0,1fr);

gap:32px;

align-items:start;

}

.ci-sidebar{

position:sticky;

top:24px;

display:flex;

flex-direction:column;

gap:20px;

}

.ci-content{

display:flex;

flex-direction:column;

gap:28px;

min-width:0;

}

.calculator-info{

padding:24px;

border:1px solid #E5E7EB;

border-radius:18px;

background:#FFFFFF;

}

.calculator-info h2{

margin:0 0 12px;

font-size:1.15rem;

font-weight:700;

color:#111827;

}

.calculator-info p{

margin:0;

line-height:1.8;

font-size:.95rem;

color:#6B7280;

}

.error-box{

display:flex;

align-items:center;

padding:14px 16px;

border-radius:14px;

background:#FEF2F2;

border:1px solid #FCA5A5;

color:#B91C1C;

font-size:.92rem;

font-weight:600;

}

:global(.dark) .calculator-info{

background:#111217;

border-color:#27272A;

}

:global(.dark) .calculator-info h2{

color:#FAFAFA;

}

:global(.dark) .calculator-info p{

color:#A1A1AA;

}

:global(.dark) .error-box{

background:#2A1111;

border-color:#7F1D1D;

color:#FECACA;

}

@media(max-width:1024px){

.ci-layout{

grid-template-columns:1fr;

}

.ci-sidebar{

position:static;

}

}

@media(max-width:768px){

.ci-layout{

gap:24px;

}

.ci-content{

gap:20px;

}

}

@media(max-width:640px){

.calculator-info{

padding:18px;

}

}

</style>

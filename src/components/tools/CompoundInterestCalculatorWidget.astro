---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import ScheduleTable from "../calculator/ScheduleTable.astro";

import {
  Wallet,
  TrendingUp,
  Coins,
  Percent,
  BarChart3,
  Repeat
} from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { principal:"Principal Amount (₹)", principalHelp:"The initial amount you are investing or depositing.", rate:"Annual Interest Rate (%)", rateHelp:"The yearly interest rate offered by the bank or scheme.", years:"Time Period (Years)", yearsHelp:"How long the money stays invested.", frequency:"Compounding Frequency (times/year)", frequencyHelp:"1 = Annually, 2 = Semi-Annually, 4 = Quarterly, 12 = Monthly, 365 = Daily.", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"Compound Interest Calculator", emptyDesc:"See how your money grows when interest is added back and starts earning interest itself.", tip1:"Maturity Value", tip2:"Total Interest Earned", tip3:"Effective Annual Rate", tip4:"Growth Multiplier", tip5:"Year-wise Growth Schedule", maturity:"Maturity Value", interest:"Total Interest Earned", principalInvested:"Principal Invested", ear:"Effective Annual Rate", multiplier:"Growth Multiplier", freqTitle:"Compounding Frequency", earSubtitle:"True yearly return once compounding is applied", scheduleHeaders:["Year", "Opening Balance", "Interest Earned", "Closing Balance"], scheduleCaption:"Year-wise Growth Schedule", aboutTitle:"About this Calculator", aboutText:"The Compound Interest Calculator shows how a lump sum grows over time when interest earned is added back to the principal and starts earning interest itself. Try changing the compounding frequency to see how monthly or quarterly compounding compares to yearly compounding — more frequent compounding always means slightly higher returns for the same stated rate." },
  es: { principal:"Monto del Capital (₹)", principalHelp:"El monto inicial que estás invirtiendo o depositando.", rate:"Tasa de Interés Anual (%)", rateHelp:"La tasa de interés anual ofrecida por el banco o plan.", years:"Período de Tiempo (Años)", yearsHelp:"Cuánto tiempo permanece invertido el dinero.", frequency:"Frecuencia de Capitalización (veces/año)", frequencyHelp:"1 = Anual, 2 = Semestral, 4 = Trimestral, 12 = Mensual, 365 = Diario.", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora de Interés Compuesto", emptyDesc:"Observa cómo crece tu dinero cuando el interés se reinvierte y comienza a generar más interés.", tip1:"Valor de Vencimiento", tip2:"Interés Total Ganado", tip3:"Tasa Anual Efectiva", tip4:"Multiplicador de Crecimiento", tip5:"Programa de Crecimiento Anual", maturity:"Valor de Vencimiento", interest:"Interés Total Ganado", principalInvested:"Capital Invertido", ear:"Tasa Anual Efectiva", multiplier:"Multiplicador de Crecimiento", freqTitle:"Frecuencia de Capitalización", earSubtitle:"Rendimiento anual real una vez aplicada la capitalización", scheduleHeaders:["Año", "Saldo Inicial", "Interés Ganado", "Saldo Final"], scheduleCaption:"Programa de Crecimiento Anual", aboutTitle:"Acerca de esta Calculadora", aboutText:"La Calculadora de Interés Compuesto muestra cómo crece una suma global con el tiempo cuando el interés ganado se reinvierte en el capital y comienza a generar más interés. Prueba cambiar la frecuencia de capitalización para ver cómo se compara la capitalización mensual o trimestral con la anual — una capitalización más frecuente siempre significa rendimientos ligeramente mayores para la misma tasa declarada." },
}[lang];
---

<section class="ci-calculator">

  <div class="ci-layout">

    <!-- Sidebar -->

    <aside class="ci-sidebar">

      <CalculatorField
        id="principal"
        label={copy.principal}
        type="number"
        placeholder="e.g. 100000"
        required={true}
        min="0"
        step="1"
        helpText={copy.principalHelp}
      />

      <CalculatorField
        id="annualRate"
        label={copy.rate}
        type="number"
        placeholder="e.g. 8.5"
        required={true}
        min="0"
        step="0.01"
        helpText={copy.rateHelp}
      />

      <CalculatorField
        id="years"
        label={copy.years}
        type="number"
        placeholder="e.g. 5"
        required={true}
        min="0"
        step="0.5"
        helpText={copy.yearsHelp}
      />

      <CalculatorField
        id="frequency"
        label={copy.frequency}
        type="number"
        value="1"
        required={true}
        min="1"
        step="1"
        helpText={copy.frequencyHelp}
      />

      <CalculatorActions
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
        calculateText={copy.calculate}
        resetText={copy.reset}
        copyText={copy.copy}
      />

      <div
        id="errorBox"
        class="error-box"
        hidden
      ></div>

    </aside>

    <!-- Results -->

    <main class="ci-content">

      <div id="emptyState">

        <EmptyState
          icon="💰"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={[copy.tip1, copy.tip2, copy.tip3, copy.tip4, copy.tip5]}
        />

      </div>

      <div
        id="resultsContainer"
        hidden
      >

        <ResultsGrid columns={3}>

          <ResultCard
            id="maturityResult"
            title={copy.maturity}
            icon={Wallet}
            accent="success"
          />

          <ResultCard
            id="interestResult"
            title={copy.interest}
            icon={TrendingUp}
          />

          <ResultCard
            id="principalResult"
            title={copy.principalInvested}
            icon={Coins}
          />

          <ResultCard
            id="earResult"
            title={copy.ear}
            icon={Percent}
            subtitle=" "
          />

          <ResultCard
            id="multiplierResult"
            title={copy.multiplier}
            icon={BarChart3}
          />

          <ResultCard
            id="frequencyResult"
            title={copy.freqTitle}
            icon={Repeat}
          />

        </ResultsGrid>

        <ScheduleTable
          id="scheduleBody"
          headers={copy.scheduleHeaders}
          caption={copy.scheduleCaption}
        />

        <section class="calculator-info">

          <h2>{copy.aboutTitle}</h2>

          <p>
            {copy.aboutText}
          </p>

        </section>

      </div>

    </main>

  </div>

</section>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/compound-interest-calculator";
</script>

<style>

.ci-calculator{

width:100%;

}

.ci-layout{

display:grid;

grid-template-columns:340px minmax(0,1fr);

gap:32px;

align-items:start;

}

.ci-sidebar{

position:sticky;

top:24px;

display:flex;

flex-direction:column;

gap:20px;

}

.ci-content{

display:flex;

flex-direction:column;

gap:28px;

min-width:0;

}

.calculator-info{ padding:24px; border:1px solid var(--border-subtle); border-radius:18px; background:var(--bg-card); }
.calculator-info h2{ margin:0 0 12px; font-size:1.15rem; font-weight:700; color:var(--text-primary); }
.calculator-info p{ margin:0; line-height:1.8; font-size:.95rem; color:var(--text-secondary); }
.error-box{ display:flex; align-items:center; padding:14px 16px; border-radius:14px; background:#FEF2F2; border:1px solid #FCA5A5; color:#B91C1C; font-size:.92rem; font-weight:600; }
:global(.dark) .error-box{ background:#2A1111; border-color:#7F1D1D; color:#FECACA; }

@media(max-width:1024px){

.ci-layout{

grid-template-columns:1fr;

}

.ci-sidebar{

position:static;

}

}

@media(max-width:768px){

.ci-layout{

gap:24px;

}

.ci-content{

gap:20px;

}

}

@media(max-width:640px){

.calculator-info{

padding:18px;

}

}

</style>

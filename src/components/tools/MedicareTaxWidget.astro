---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { HeartPulse, Wallet, TrendingUp, Gauge } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { groupTitle:"Income & Filing", wages:"Annual Wages / Net Earnings", filingStatus:"Filing Status", single:"Single", mfj:"Married Filing Jointly", mfs:"Married Filing Separately", hoh:"Head of Household", employmentType:"Employment Type", employee:"Employee", selfEmployed:"Self-Employed", emptyTitle:"Medicare Tax Calculator", emptyDesc:"Find your regular and Additional Medicare Tax for 2026.", tip1:"Total Medicare Tax", tip2:"Regular Tax", tip3:"Additional Tax", total:"Total Medicare Tax", regular:"Regular Medicare Tax", additional:"Additional Medicare Tax", threshold:"Your Threshold", aboutTitle:"About this Calculator", aboutText:"Calculates regular Medicare tax (1.45%/2.9%) plus the 0.9% Additional Medicare Tax above IRS income thresholds for 2026." },
  es: { groupTitle:"Ingresos y Declaración", wages:"Salario Anual / Ingresos Netos", filingStatus:"Estado Civil Tributario", single:"Soltero", mfj:"Casado Declarando en Conjunto", mfs:"Casado Declarando por Separado", hoh:"Cabeza de Familia", employmentType:"Tipo de Empleo", employee:"Empleado", selfEmployed:"Trabajador Independiente", emptyTitle:"Calculadora de Impuesto Medicare", emptyDesc:"Calcula tu Impuesto Medicare regular y adicional para 2026.", tip1:"Impuesto Medicare Total", tip2:"Impuesto Regular", tip3:"Impuesto Adicional", total:"Impuesto Medicare Total", regular:"Impuesto Medicare Regular", additional:"Impuesto Medicare Adicional", threshold:"Tu Umbral", aboutTitle:"Acerca de esta Calculadora", aboutText:"Calcula el impuesto Medicare regular (1.45%/2.9%) más el Impuesto Medicare Adicional de 0.9% por encima de los umbrales de ingresos del IRS para 2026." },
}[lang];
---
<section class="mct-calculator">
  <div class="mct-layout">
    <aside class="mct-sidebar">
      <div class="mct-group">
        <h3>{copy.groupTitle}</h3>
        <CalculatorField id="annualWages" label={copy.wages} type="number" placeholder="e.g. 220000" min="0" step="1" />
        <CalculatorField type="select" id="filingStatus" label={copy.filingStatus}>
  <option value="single">{copy.single}</option>
  <option value="mfj">{copy.mfj}</option>
  <option value="mfs">{copy.mfs}</option>
  <option value="hoh">{copy.hoh}</option>
</CalculatorField>
        <CalculatorField type="select" id="employmentType" label={copy.employmentType}>
  <option value="employee">{copy.employee}</option>
  <option value="self">{copy.selfEmployed}</option>
</CalculatorField>
      </div>
      <CalculatorActions calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="mct-content">
      <div id="emptyState">
        <EmptyState icon="🏥" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="totalMedicareResult" title={copy.total} icon={HeartPulse} accent="success" subtitle=" " />
          <ResultCard id="regularMedicareResult" title={copy.regular} icon={Wallet} />
          <ResultCard id="additionalMedicareResult" title={copy.additional} icon={TrendingUp} subtitle=" " />
          <ResultCard id="thresholdResult" title={copy.threshold} icon={Gauge} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/medicare-tax-calculator";
</script>
<style>
.mct-calculator{width:100%;}
.mct-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.mct-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.mct-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.mct-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.mct-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.mct-layout{grid-template-columns:1fr;}.mct-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.mct-layout{gap:24px;}.mct-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
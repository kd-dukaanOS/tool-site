---

<label class="block text-sm font-medium text-gray-700 mb-1">Input Text</label>
<input id="slugInput" type="text" placeholder="e.g. My Awesome Blog Post!" class="w-full p-3 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 mb-4" />

<label class="block text-sm font-medium text-gray-700 mb-1">Generated Slug</label>
<div class="flex gap-2">
  <input id="slugOutput" type="text" readonly class="flex-1 p-3 border border-gray-300 rounded-lg font-mono text-sm bg-gray-100" />
  <button id="copySlugBtn" class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700">Copy</button>
</div>

<script>
  // @ts-nocheck
  const input = document.getElementById('slugInput');
  const output = document.getElementById('slugOutput');
  const copyBtn = document.getElementById('copySlugBtn');

  function slugify(text) {
    return text
      .toString()
      .toLowerCase()
      .trim()
      .replace(/[^\w\s-]/g, '')
      .replace(/[\s_]+/g, '-')
      .replace(/^-+|-+$/g, '');
  }

  input?.addEventListener('input', () => {
    output.value = slugify(input.value);
  });

  copyBtn?.addEventListener('click', () => {
    navigator.clipboard.writeText(output.value);
  });
</script>

---
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Link2, Ruler, Type } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { textLabel:"Text / Title", textPlaceholder:"e.g. 10 Best Productivity Tips for 2026", separatorLabel:"Separator", hyphen:"Hyphen (-)", underscore:"Underscore (_)", maxLengthLabel:"Max Length", lowercase:"Lowercase", removeStopwords:"Remove stopwords (a, the, and...)", generate:"Generate", reset:"Reset", copy:"Copy", emptyTitle:"Slug Generator", emptyDesc:"Convert any text into a clean, SEO-friendly URL slug.", tip1:"Live Preview", tip2:"Custom Separator", tip3:"Stopword Removal", tip4:"Copy Slug", generatedSlug:"Generated Slug", length:"Length", words:"Words", aboutTitle:"About this Tool", aboutText:"Convert titles or text into clean, lowercase, SEO-friendly URL slugs with custom separators and stopword removal." },
  es: { textLabel:"Texto / Título", textPlaceholder:"ej. Los 10 Mejores Consejos de Productividad para 2026", separatorLabel:"Separador", hyphen:"Guion (-)", underscore:"Guion Bajo (_)", maxLengthLabel:"Longitud Máxima", lowercase:"Minúsculas", removeStopwords:"Quitar palabras vacías (el, la, y...)", generate:"Generar", reset:"Restablecer", copy:"Copiar", emptyTitle:"Generador de Slugs", emptyDesc:"Convierte cualquier texto en un slug de URL limpio y optimizado para SEO.", tip1:"Vista Previa en Vivo", tip2:"Separador Personalizado", tip3:"Eliminación de Palabras Vacías", tip4:"Copiar Slug", generatedSlug:"Slug Generado", length:"Longitud", words:"Palabras", aboutTitle:"Acerca de esta Herramienta", aboutText:"Convierte títulos o texto en slugs de URL limpios, en minúsculas y optimizados para SEO, con separadores personalizados y eliminación de palabras vacías." },
}[lang];
---
<section class="slug-generator">
  <div class="slug-layout">
    <aside class="slug-sidebar">
      <div class="tool-field">
        <label class="tool-label" for="slugText">{copy.textLabel}</label>
        <textarea id="slugText" class="tool-textarea" placeholder={copy.textPlaceholder}></textarea>
      </div>

      <div class="tool-field">
        <label class="tool-label" for="slugSeparator">{copy.separatorLabel}</label>
        <select id="slugSeparator" class="tool-select">
          <option value="-" selected>{copy.hyphen}</option>
          <option value="_">{copy.underscore}</option>
        </select>
      </div>

      <div class="tool-field">
        <label class="tool-label" for="slugMaxLength">{copy.maxLengthLabel}</label>
        <input id="slugMaxLength" type="number" class="tool-input" value="60" min="10" max="200" />
      </div>

      <div class="tool-checkbox-field"><input id="slugLowercase" type="checkbox" checked /><label for="slugLowercase">{copy.lowercase}</label></div>
      <div class="tool-checkbox-field"><input id="slugRemoveStopwords" type="checkbox" /><label for="slugRemoveStopwords">{copy.removeStopwords}</label></div>

      <CalculatorActions lang={lang} calculateId="generateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} calculateText={copy.generate} resetText={copy.reset} copyText={copy.copy} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>

    <main class="slug-content">
      <div id="emptyState">
        <EmptyState
          icon="🔗"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={[copy.tip1, copy.tip2, copy.tip3, copy.tip4]}
        />
      </div>

      <div id="resultsContainer" hidden>
        <div class="tool-field">
          <label class="tool-label"><Link2 size={16} /> {copy.generatedSlug}</label>
          <input id="slugOutput" type="text" class="tool-input slug-output" readonly />
        </div>

        <ResultsGrid columns={2}>
          <ResultCard id="lengthResult" title={copy.length} icon={Ruler} />
          <ResultCard id="wordsResult" title={copy.words} icon={Type} />
        </ResultsGrid>

        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/slug-generator";
</script>

<style>
.slug-generator{width:100%;}
.slug-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.slug-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:16px;}
.tool-field{display:flex;flex-direction:column;gap:8px;}
.tool-field .tool-label{display:flex;align-items:center;gap:6px;}
.tool-checkbox-field{display:flex;align-items:center;gap:8px;font-size:.9rem;color:#374151;}
.slug-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.slug-output{font-family:ui-monospace,monospace;}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
:global(.dark) .tool-checkbox-field{color:#A1A1AA;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.slug-layout{grid-template-columns:1fr;}.slug-sidebar{position:static;}}
</style>

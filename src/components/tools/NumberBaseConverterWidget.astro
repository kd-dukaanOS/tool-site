---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Binary, Hash, Calculator, Code } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { number:"Number", fromBase:"From Base", binaryOpt:"Binary (Base 2)", octalOpt:"Octal (Base 8)", decimalOpt:"Decimal (Base 10)", hexOpt:"Hexadecimal (Base 16)", emptyTitle:"Number Base Converter", emptyDesc:"Convert numbers between binary, octal, decimal and hexadecimal.", tip1:"Binary", tip2:"Octal", tip3:"Decimal", tip4:"Hexadecimal", binary:"Binary", octal:"Octal", decimal:"Decimal", hex:"Hexadecimal", aboutTitle:"About this Tool", aboutText:"Convert any number between binary, octal, decimal and hexadecimal bases instantly." },
  es: { number:"Número", fromBase:"Base de Origen", binaryOpt:"Binario (Base 2)", octalOpt:"Octal (Base 8)", decimalOpt:"Decimal (Base 10)", hexOpt:"Hexadecimal (Base 16)", emptyTitle:"Convertidor de Bases Numéricas", emptyDesc:"Convierte números entre binario, octal, decimal y hexadecimal.", tip1:"Binario", tip2:"Octal", tip3:"Decimal", tip4:"Hexadecimal", binary:"Binario", octal:"Octal", decimal:"Decimal", hex:"Hexadecimal", aboutTitle:"Acerca de esta Herramienta", aboutText:"Convierte cualquier número entre las bases binaria, octal, decimal y hexadecimal al instante." },
}[lang];
---
<section class="base-converter">
  <div class="base-layout">
    <aside class="base-sidebar">

      <CalculatorField id="baseValue" label={copy.number} type="text" placeholder="e.g. 255" />

      <CalculatorField id="fromBase" label={copy.fromBase} type="select">
        <option value="2">{copy.binaryOpt}</option>
        <option value="8">{copy.octalOpt}</option>
        <option value="10" selected>{copy.decimalOpt}</option>
        <option value="16">{copy.hexOpt}</option>
      </CalculatorField>

      <CalculatorActions lang={lang} calculateId="convertBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>

    <main class="base-content">
      <div id="emptyState">
        <EmptyState
          icon="🔢"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={[copy.tip1, copy.tip2, copy.tip3, copy.tip4]}
        />
      </div>

      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="binaryResult" title={copy.binary} icon={Binary} />
          <ResultCard id="octalResult" title={copy.octal} icon={Hash} />
          <ResultCard id="decimalResult" title={copy.decimal} icon={Calculator} />
          <ResultCard id="hexResult" title={copy.hex} icon={Code} />
        </ResultsGrid>

        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/number-base-converter";
</script>

<style>
.base-converter{width:100%;}
.base-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.base-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:4px;}
.base-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.base-layout{grid-template-columns:1fr;}.base-sidebar{position:static;}}
</style>

---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Receipt, Landmark, FileText, Wallet } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { homeLoanGroup:"Home & Loan", homePrice:"Home Price", loanAmount:"Loan Amount", downPayment:"Down Payment", lenderGroup:"Lender Fees", originationRate:"Origination Fee (%)", discountPoints:"Discount Points", titleGroup:"Title & Government", titleInsuranceRate:"Title Insurance (%)", recordingFees:"Recording Fees", transferTaxRate:"Transfer Tax (%)", prepaidsGroup:"Prepaids", monthsPrepaidInsurance:"Months Insurance Prepaid", annualInsurance:"Annual Insurance", monthsPrepaidTax:"Months Tax Prepaid", annualPropertyTax:"Annual Property Tax", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"Closing Costs Calculator", emptyDesc:"Estimate total closing costs and cash needed to close.", tip1:"Total Closing Costs", tip2:"Cash Needed", tip3:"Fee Breakdown", totalClosingCosts:"Total Closing Costs", lenderFees:"Lender Fees + Points", prepaids:"Prepaids & Escrow", cashNeeded:"Total Cash Needed", aboutTitle:"About this Calculator", aboutText:"Estimates lender fees, title costs, transfer taxes, and prepaid escrow amounts to find your total closing costs and cash needed to close.", percentOfPrice:(p:string)=>`${p}% of home price`, cashNeededSub:"Closing Costs + Down Payment" },
  es: { homeLoanGroup:"Vivienda y Préstamo", homePrice:"Precio de la Vivienda", loanAmount:"Monto del Préstamo", downPayment:"Pago Inicial", lenderGroup:"Comisiones del Prestamista", originationRate:"Comisión de Originación (%)", discountPoints:"Puntos de Descuento", titleGroup:"Título y Gobierno", titleInsuranceRate:"Seguro de Título (%)", recordingFees:"Comisiones de Registro", transferTaxRate:"Impuesto de Transferencia (%)", prepaidsGroup:"Prepagos", monthsPrepaidInsurance:"Meses de Seguro Prepagado", annualInsurance:"Seguro Anual", monthsPrepaidTax:"Meses de Impuesto Prepagado", annualPropertyTax:"Impuesto Predial Anual", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora de Costos de Cierre", emptyDesc:"Estima el total de costos de cierre y el efectivo necesario para cerrar.", tip1:"Costos de Cierre Totales", tip2:"Efectivo Necesario", tip3:"Desglose de Comisiones", totalClosingCosts:"Costos de Cierre Totales", lenderFees:"Comisiones de Prestamista + Puntos", prepaids:"Prepagos y Depósito en Garantía", cashNeeded:"Efectivo Total Necesario", aboutTitle:"Acerca de esta Calculadora", aboutText:"Estima las comisiones del prestamista, costos de título, impuestos de transferencia y montos de depósito en garantía prepagados para encontrar tus costos de cierre totales y el efectivo necesario para cerrar.", percentOfPrice:(p:string)=>`${p}% del precio de la vivienda`, cashNeededSub:"Costos de Cierre + Pago Inicial" },
}[lang];
---
<section class="cc-calculator">
  <div class="cc-layout">
    <aside class="cc-sidebar">
      <div class="cc-group">
        <h3>{copy.homeLoanGroup}</h3>
        <CalculatorField id="homePrice" label={copy.homePrice} type="number" placeholder="e.g. 350000" min="0" step="1" />
        <CalculatorField id="loanAmount" label={copy.loanAmount} type="number" placeholder="e.g. 280000" min="0" step="1" />
        <CalculatorField id="downPayment" label={copy.downPayment} type="number" placeholder="e.g. 70000" min="0" step="1" />
      </div>
      <div class="cc-group">
        <h3>{copy.lenderGroup}</h3>
        <CalculatorField id="originationRate" label={copy.originationRate} type="number" placeholder="e.g. 0.5" min="0" step="0.01" />
        <CalculatorField id="discountPointsCount" label={copy.discountPoints} type="number" placeholder="e.g. 0" min="0" step="0.125" />
      </div>
      <div class="cc-group">
        <h3>{copy.titleGroup}</h3>
        <CalculatorField id="titleInsuranceRate" label={copy.titleInsuranceRate} type="number" placeholder="e.g. 0.5" min="0" step="0.01" />
        <CalculatorField id="recordingFees" label={copy.recordingFees} type="number" placeholder="e.g. 200" min="0" step="1" />
        <CalculatorField id="transferTaxRate" label={copy.transferTaxRate} type="number" placeholder="e.g. 0.5" min="0" step="0.01" />
      </div>
      <div class="cc-group">
        <h3>{copy.prepaidsGroup}</h3>
        <CalculatorField id="monthsPrepaidInsurance" label={copy.monthsPrepaidInsurance} type="number" placeholder="e.g. 12" min="0" step="1" />
        <CalculatorField id="annualInsurance" label={copy.annualInsurance} type="number" placeholder="e.g. 1400" min="0" step="1" />
        <CalculatorField id="monthsPrepaidTax" label={copy.monthsPrepaidTax} type="number" placeholder="e.g. 6" min="0" step="1" />
        <CalculatorField id="annualPropertyTax" label={copy.annualPropertyTax} type="number" placeholder="e.g. 3800" min="0" step="1" />
      </div>
      <CalculatorActions calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} calculateText={copy.calculate} resetText={copy.reset} copyText={copy.copy} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="cc-content">
      <div id="emptyState">
        <EmptyState icon="🧾" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="totalClosingCostsResult" title={copy.totalClosingCosts} icon={Receipt} accent="success" subtitle=" " />
          <ResultCard id="lenderFeesResult" title={copy.lenderFees} icon={Landmark} />
          <ResultCard id="prepaidsResult" title={copy.prepaids} icon={FileText} />
          <ResultCard id="cashNeededResult" title={copy.cashNeeded} icon={Wallet} subtitle=" " />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/closing-costs-calculator";
</script>
<style>
.cc-calculator{width:100%;}
.cc-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.cc-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.cc-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.cc-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.cc-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.cc-layout{grid-template-columns:1fr;}.cc-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.cc-layout{gap:24px;}.cc-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
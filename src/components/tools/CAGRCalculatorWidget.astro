---
import CalculatorField from "../calculator/CalculatorField.astro";
import ActionButtons from "../calculator/ActionButtons.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import EmptyState from "../calculator/EmptyState.astro";
import CurrencySelector from "../calculator/CurrencySelector.astro";
import { TrendingUp, Percent, Wallet, Repeat } from "@lucide/astro";
---

<div class="calculator-widget">
  <div class="calculator-inputs">
    <CurrencySelector />
    <CalculatorField
      id="initialValue"
      label="Initial Investment"
      type="number"
      placeholder="e.g. 100000"
    />
    <CalculatorField
      id="finalValue"
      label="Final Value"
      type="number"
      placeholder="e.g. 250000"
    />
    <CalculatorField
      id="years"
      label="Time Period (Years)"
      type="number"
      placeholder="e.g. 5"
    />

    <div id="errorBox" class="error-box" role="alert" hidden></div>

    <ActionButtons
      calculateId="calculateBtn"
      resetId="resetBtn"
      copyId="copyBtn"
      showDownload={false}
      showShare={false}
    />
  </div>

  <div class="calculator-output">
    <EmptyState
      id="emptyState"
      title="Enter values to calculate CAGR"
      description="Your compounded annual growth rate will appear here."
    />

    <ResultsGrid id="resultsContainer" hidden>
      <ResultCard id="cagrResult" title="CAGR" icon={TrendingUp} accent="primary" size="lg" />
      <ResultCard id="absoluteReturnResult" title="Absolute Return" icon={Percent} accent="success" />
      <ResultCard id="totalGrowthResult" title="Total Growth" icon={Wallet} accent="success" />
      <ResultCard id="wealthMultipleResult" title="Wealth Multiple" icon={Repeat} accent="neutral" />
    </ResultsGrid>
  </div>
</div>

<script src="../../scripts/cagr-calculator.ts"></script>

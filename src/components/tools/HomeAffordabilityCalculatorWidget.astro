---
{/* src/components/tools/HomeAffordabilityCalculatorWidget.astro */}
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import CurrencySelector from "../calculator/CurrencySelector.astro";

import { Home, Landmark, Wallet, Receipt } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { annualIncome:"Annual Income ($)", monthlyDebts:"Monthly Debt Payments ($)", monthlyDebtsHelp:"Car loans, credit cards, student loans, etc.", downPayment:"Down Payment ($)", interestRate:"Interest Rate (%)", loanTerm:"Loan Term (Years)", propertyTax:"Property Tax Rate (% / year)", insurance:"Annual Home Insurance ($)", maxDTI:"Max Debt-to-Income Ratio (%)", maxDTIHelp:"Lenders typically cap this at 36–43%.", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"Home Affordability Calculator", emptyDesc:"Find the maximum home price you can afford based on your income, debts and down payment.", tip1:"Max Home Price", tip2:"Estimated Monthly Payment", maxHomePrice:"Max Home Price", maxLoanAmount:"Max Loan Amount", monthlyPayment:"Est. Monthly Payment (PITI)", monthlyPI:"Principal & Interest Only", aboutTitle:"About this Calculator", aboutText:"Estimates the maximum home price you can afford by capping your total monthly housing payment (principal, interest, property tax and insurance) at your target debt-to-income ratio. Does not include HOA fees, PMI, or a lender's specific underwriting rules." },
  es: { annualIncome:"Ingreso Anual ($)", monthlyDebts:"Pagos de Deuda Mensuales ($)", monthlyDebtsHelp:"Préstamos de auto, tarjetas de crédito, préstamos estudiantiles, etc.", downPayment:"Pago Inicial ($)", interestRate:"Tasa de Interés (%)", loanTerm:"Plazo del Préstamo (Años)", propertyTax:"Tasa de Impuesto Predial (% / año)", insurance:"Seguro Anual del Hogar ($)", maxDTI:"Relación Máxima Deuda-Ingreso (%)", maxDTIHelp:"Los prestamistas suelen limitar esto al 36–43%.", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora de Asequibilidad de Vivienda", emptyDesc:"Encuentra el precio máximo de vivienda que puedes pagar según tus ingresos, deudas y pago inicial.", tip1:"Precio Máximo de Vivienda", tip2:"Pago Mensual Estimado", maxHomePrice:"Precio Máximo de Vivienda", maxLoanAmount:"Monto Máximo del Préstamo", monthlyPayment:"Pago Mensual Est. (PITI)", monthlyPI:"Solo Capital e Interés", aboutTitle:"Acerca de esta Calculadora", aboutText:"Estima el precio máximo de vivienda que puedes pagar limitando tu pago mensual total de vivienda (capital, interés, impuesto predial y seguro) a tu relación deuda-ingreso objetivo. No incluye cuotas de HOA, PMI, ni reglas específicas del prestamista." },
}[lang];
---

<section class="ha-calculator">
  <div class="ha-layout">

    <aside class="ha-sidebar">
      <CurrencySelector />

      <CalculatorField
        id="annualIncome"
        label={copy.annualIncome}
        type="number"
        placeholder="e.g. 90000"
        required={true}
        min="0"
        step="0.01"
      />

      <CalculatorField
        id="monthlyDebts"
        label={copy.monthlyDebts}
        type="number"
        placeholder="e.g. 400"
        min="0"
        step="0.01"
        helpText={copy.monthlyDebtsHelp}
      />

      <CalculatorField
        id="downPayment"
        label={copy.downPayment}
        type="number"
        placeholder="e.g. 40000"
        min="0"
        step="0.01"
      />

      <CalculatorField
        id="interestRate"
        label={copy.interestRate}
        type="number"
        placeholder="e.g. 6.5"
        required={true}
        min="0"
        step="0.01"
      />

      <CalculatorField
        id="loanTermYears"
        label={copy.loanTerm}
        type="number"
        placeholder="30"
        required={true}
        min="1"
        step="1"
      />

      <CalculatorField
        id="propertyTaxRate"
        label={copy.propertyTax}
        type="number"
        placeholder="e.g. 1.1"
        min="0"
        step="0.01"
      />

      <CalculatorField
        id="annualInsurance"
        label={copy.insurance}
        type="number"
        placeholder="e.g. 1500"
        min="0"
        step="0.01"
      />

      <CalculatorField
        id="maxDTI"
        label={copy.maxDTI}
        type="number"
        placeholder="36"
        required={true}
        min="1"
        max="100"
        step="1"
        helpText={copy.maxDTIHelp}
      />

      <CalculatorActions
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
        calculateText={copy.calculate}
        resetText={copy.reset}
        copyText={copy.copy}
      />

      <div id="errorBox" class="error-box" hidden></div>
    </aside>

    <main class="ha-content">
      <div id="emptyState">
        <EmptyState
          icon="🏡"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={[copy.tip1, copy.tip2]}
        />
      </div>

      <div id="resultsContainer" hidden>
        <ResultsGrid columns={2}>
          <ResultCard id="maxHomePriceResult" title={copy.maxHomePrice} icon={Home} accent="primary" size="lg" />
          <ResultCard id="maxLoanAmountResult" title={copy.maxLoanAmount} icon={Landmark} accent="neutral" size="lg" />
          <ResultCard id="monthlyPaymentResult" title={copy.monthlyPayment} icon={Wallet} accent="success" />
          <ResultCard id="monthlyPIResult" title={copy.monthlyPI} icon={Receipt} accent="neutral" />
        </ResultsGrid>

        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>

  </div>
</section>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/home-affordability-calculator";
</script>

<style>
.ha-calculator{ width:100%; }
.ha-layout{ display:grid; grid-template-columns:340px minmax(0,1fr); gap:32px; align-items:start; }
.ha-sidebar{ position:sticky; top:24px; display:flex; flex-direction:column; gap:20px; }
.ha-content{ display:flex; flex-direction:column; gap:28px; min-width:0; }
.calculator-info{ padding:24px; border:1px solid var(--border-subtle); border-radius:18px; background:var(--bg-card); }
.calculator-info h2{ margin:0 0 12px; font-size:1.15rem; font-weight:700; color:var(--text-primary); }
.calculator-info p{ margin:0; line-height:1.8; font-size:.95rem; color:var(--text-secondary); }
.error-box{ display:flex; align-items:center; padding:14px 16px; border-radius:14px; background:#FEF2F2; border:1px solid #FCA5A5; color:#B91C1C; font-size:.92rem; font-weight:600; }
:global(.dark) .error-box{ background:#2A1111; border-color:#7F1D1D; color:#FECACA; }
@media(max-width:1024px){ .ha-layout{ grid-template-columns:1fr; } .ha-sidebar{ position:static; } }
@media(max-width:768px){ .ha-layout{ gap:24px; } .ha-content{ gap:20px; } }
@media(max-width:640px){ .calculator-info{ padding:18px; } }
</style>
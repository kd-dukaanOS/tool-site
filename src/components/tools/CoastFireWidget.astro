---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Anchor, CheckCircle, Calendar, TrendingUp } from "@lucide/astro";
---
<section class="cfire-calculator">
  <div class="cfire-layout">
    <aside class="cfire-sidebar">
      <div class="cfire-group">
        <h3>Personal</h3>
        <CalculatorField id="currentAge" label="Current Age" type="number" placeholder="e.g. 30" min="1" step="1" />
        <CalculatorField id="currentSavings" label="Current Savings" type="number" placeholder="e.g. 150000" min="0" step="1" />
        <CalculatorField id="targetRetirementAge" label="Target Retirement Age" type="number" placeholder="e.g. 60" min="1" step="1" />
      </div>
      <div class="cfire-group">
        <h3>Expenses & Savings</h3>
        <CalculatorField id="annualExpenses" label="Annual Expenses at Retirement" type="number" placeholder="e.g. 50000" min="0" step="1" />
        <CalculatorField id="annualContribution" label="Current Annual Contribution" type="number" placeholder="e.g. 10000" min="0" step="1" />
      </div>
      <div class="cfire-group">
        <h3>Assumptions</h3>
        <CalculatorField id="expectedReturnRate" label="Expected Return (%/yr)" type="number" placeholder="e.g. 7" min="0" step="0.1" />
        <CalculatorField id="inflationRate" label="Inflation Rate (%/yr)" type="number" placeholder="e.g. 3" min="0" step="0.1" />
        <CalculatorField id="withdrawalRate" label="Withdrawal Rate (%)" type="number" placeholder="e.g. 4" min="0.1" step="0.1" />
      </div>
      <CalculatorActions calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="cfire-content">
      <div id="emptyState">
        <EmptyState icon="⛵" title="Coast FIRE Calculator" description="Find your Coast FIRE number and whether you've already reached it." tips={["Coast FIRE Number", "Status", "Coast FIRE Age"]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="coastFireNumberResult" title="Coast FIRE Number" icon={Anchor} accent="success" subtitle=" " />
          <ResultCard id="statusResult" title="Status" icon={CheckCircle} subtitle=" " />
          <ResultCard id="coastFireAgeResult" title="Coast FIRE Age" icon={Calendar} />
          <ResultCard id="projectedBalanceResult" title="Balance at Retirement" icon={TrendingUp} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>About this Calculator</h2>
          <p>Calculates the savings level needed today to compound, untouched, into a full FIRE number by your target retirement age — and whether you've already reached it.</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script>
  import "../../scripts/coast-fire-calculator";
</script>
<style>
.cfire-calculator{width:100%;}
.cfire-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.cfire-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.cfire-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.cfire-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.cfire-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.cfire-layout{grid-template-columns:1fr;}.cfire-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.cfire-layout{gap:24px;}.cfire-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
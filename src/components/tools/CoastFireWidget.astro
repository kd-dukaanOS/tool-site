---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Anchor, CheckCircle, Calendar, TrendingUp } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { personal:"Personal", currentAge:"Current Age", currentSavings:"Current Savings", targetAge:"Target Retirement Age", expensesGroup:"Expenses & Savings", annualExpenses:"Annual Expenses at Retirement", annualContribution:"Current Annual Contribution", assumptionsGroup:"Assumptions", expectedReturn:"Expected Return (%/yr)", inflation:"Inflation Rate (%/yr)", withdrawal:"Withdrawal Rate (%)", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"Coast FIRE Calculator", emptyDesc:"Find your Coast FIRE number and whether you've already reached it.", tip1:"Coast FIRE Number", tip2:"Status", tip3:"Coast FIRE Age", coastFireNumber:"Coast FIRE Number", status:"Status", coastFireAge:"Coast FIRE Age", balance:"Balance at Retirement", aboutTitle:"About this Calculator", aboutText:"Calculates the savings level needed today to compound, untouched, into a full FIRE number by your target retirement age — and whether you've already reached it.", reached:"Reached", notYet:"Not Yet", notYetReached:"Not Yet Reached", beyondTimeline:"Beyond timeline", canStop:"You can stop contributing", keepGoing:"Keep contributing" },
  es: { personal:"Personal", currentAge:"Edad Actual", currentSavings:"Ahorros Actuales", targetAge:"Edad Objetivo de Jubilación", expensesGroup:"Gastos y Ahorros", annualExpenses:"Gastos Anuales en Jubilación", annualContribution:"Contribución Anual Actual", assumptionsGroup:"Supuestos", expectedReturn:"Rendimiento Esperado (%/año)", inflation:"Tasa de Inflación (%/año)", withdrawal:"Tasa de Retiro (%)", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora Coast FIRE", emptyDesc:"Encuentra tu número Coast FIRE y si ya lo has alcanzado.", tip1:"Número Coast FIRE", tip2:"Estado", tip3:"Edad Coast FIRE", coastFireNumber:"Número Coast FIRE", status:"Estado", coastFireAge:"Edad Coast FIRE", balance:"Saldo en la Jubilación", aboutTitle:"Acerca de esta Calculadora", aboutText:"Calcula el nivel de ahorro necesario hoy para que, sin más aportes, crezca hasta un número FIRE completo para tu edad objetivo de jubilación — y si ya lo has alcanzado.", reached:"Alcanzado", notYet:"Aún No", notYetReached:"Aún No Alcanzado", beyondTimeline:"Fuera del plazo", canStop:"Puedes dejar de aportar", keepGoing:"Sigue aportando" },
}[lang];
---
<section class="cfire-calculator">
  <div class="cfire-layout">
    <aside class="cfire-sidebar">
      <div class="cfire-group">
        <h3>{copy.personal}</h3>
        <CalculatorField id="currentAge" label={copy.currentAge} type="number" placeholder="e.g. 30" min="1" step="1" />
        <CalculatorField id="currentSavings" label={copy.currentSavings} type="number" placeholder="e.g. 150000" min="0" step="1" />
        <CalculatorField id="targetRetirementAge" label={copy.targetAge} type="number" placeholder="e.g. 60" min="1" step="1" />
      </div>
      <div class="cfire-group">
        <h3>{copy.expensesGroup}</h3>
        <CalculatorField id="annualExpenses" label={copy.annualExpenses} type="number" placeholder="e.g. 50000" min="0" step="1" />
        <CalculatorField id="annualContribution" label={copy.annualContribution} type="number" placeholder="e.g. 10000" min="0" step="1" />
      </div>
      <div class="cfire-group">
        <h3>{copy.assumptionsGroup}</h3>
        <CalculatorField id="expectedReturnRate" label={copy.expectedReturn} type="number" placeholder="e.g. 7" min="0" step="0.1" />
        <CalculatorField id="inflationRate" label={copy.inflation} type="number" placeholder="e.g. 3" min="0" step="0.1" />
        <CalculatorField id="withdrawalRate" label={copy.withdrawal} type="number" placeholder="e.g. 4" min="0.1" step="0.1" />
      </div>
      <CalculatorActions lang={lang} calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} calculateText={copy.calculate} resetText={copy.reset} copyText={copy.copy} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="cfire-content">
      <div id="emptyState">
        <EmptyState icon="⛵" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="coastFireNumberResult" title={copy.coastFireNumber} icon={Anchor} accent="success" subtitle=" " />
          <ResultCard id="statusResult" title={copy.status} icon={CheckCircle} subtitle=" " />
          <ResultCard id="coastFireAgeResult" title={copy.coastFireAge} icon={Calendar} />
          <ResultCard id="projectedBalanceResult" title={copy.balance} icon={TrendingUp} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/coast-fire-calculator";
</script>
<style>
.cfire-calculator{width:100%;}
.cfire-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.cfire-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.cfire-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.cfire-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.cfire-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.cfire-layout{grid-template-columns:1fr;}.cfire-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.cfire-layout{gap:24px;}.cfire-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import ChartCard from "../calculator/ChartCard.astro";
import ScheduleTable from "../calculator/ScheduleTable.astro";

import { TrendingUp, Wallet, PiggyBank, Percent } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { monthlyLabel:"Monthly Investment (₹)", monthlyHelp:"Amount you invest every month.", returnLabel:"Expected Annual Return (%)", returnHelp:"Estimated yearly return rate.", tenureLabel:"Investment Period (years)", tenureHelp:"How long you plan to invest.", yrsSuffix:"Yrs", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"SIP Calculator", emptyDesc:"Estimate the maturity value of your monthly investments and see year-wise growth.", tip1:"Maturity Value & Returns", tip2:"Invested vs Growth Chart", tip3:"Year-wise Growth Table", tip4:"Compounding Insight", maturity:"Maturity Value", invested:"Invested Amount", returns:"Estimated Returns", percent:"Return %", chartTitle:"Invested vs Growth Over Time", yearHeader:"Year", investedHeader:"Invested", valueHeader:"Value", scheduleCaption:"Year-wise Growth", aboutTitle:"About this Calculator", aboutText:"A Systematic Investment Plan (SIP) lets you invest a fixed amount every month. Compounding means your returns also start earning returns, so the growth curve accelerates over time.", formulaTitle:"Formula", formulaText:"— where P is the monthly investment, r is the monthly return rate, and n is the number of months." },
  es: { monthlyLabel:"Inversión Mensual (₹)", monthlyHelp:"Monto que inviertes cada mes.", returnLabel:"Retorno Anual Esperado (%)", returnHelp:"Tasa de retorno anual estimada.", tenureLabel:"Período de Inversión (años)", tenureHelp:"Cuánto tiempo planeas invertir.", yrsSuffix:"Años", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora SIP", emptyDesc:"Estima el valor de vencimiento de tus inversiones mensuales y observa el crecimiento año a año.", tip1:"Valor de Vencimiento y Retornos", tip2:"Gráfico Invertido vs Crecimiento", tip3:"Tabla de Crecimiento Anual", tip4:"Perspectiva de Interés Compuesto", maturity:"Valor de Vencimiento", invested:"Monto Invertido", returns:"Retornos Estimados", percent:"Retorno %", chartTitle:"Invertido vs Crecimiento en el Tiempo", yearHeader:"Año", investedHeader:"Invertido", valueHeader:"Valor", scheduleCaption:"Crecimiento Anual", aboutTitle:"Acerca de esta Calculadora", aboutText:"Un Plan de Inversión Sistemática (SIP) te permite invertir un monto fijo cada mes. El interés compuesto significa que tus retornos también comienzan a generar retornos, por lo que la curva de crecimiento se acelera con el tiempo.", formulaTitle:"Fórmula", formulaText:"— donde P es la inversión mensual, r es la tasa de retorno mensual, y n es el número de meses." },
}[lang];
---

<section class="sip-calculator">

  <div class="sip-layout">

    <aside class="sip-sidebar">

      <CalculatorField
        id="monthlyInvestment"
        label={copy.monthlyLabel}
        type="number"
        placeholder="e.g. 5000"
        required={true}
        min="1"
        helpText={copy.monthlyHelp}
      />

      <CalculatorField
        id="annualReturn"
        label={copy.returnLabel}
        type="number"
        placeholder="e.g. 12"
        required={true}
        min="0"
        step="0.1"
        helpText={copy.returnHelp}
      />

      <CalculatorField
        id="tenure"
        label={copy.tenureLabel}
        type="number"
        placeholder="e.g. 15"
        required={true}
        min="1"
        helpText={copy.tenureHelp}
      />

      <div class="scenario-row">
        <button type="button" class="scenario-btn" data-tenure="5">5 {copy.yrsSuffix}</button>
        <button type="button" class="scenario-btn" data-tenure="10">10 {copy.yrsSuffix}</button>
        <button type="button" class="scenario-btn" data-tenure="15">15 {copy.yrsSuffix}</button>
        <button type="button" class="scenario-btn" data-tenure="20">20 {copy.yrsSuffix}</button>
      </div>

      <CalculatorActions lang={lang}
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
        calculateText={copy.calculate}
        resetText={copy.reset}
        copyText={copy.copy}
      />

      <div
        id="errorBox"
        class="error-box"
        hidden
      ></div>

    </aside>

    <main class="sip-content">

      <div id="emptyState">

        <EmptyState
          icon="📈"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={[
            copy.tip1,
            copy.tip2,
            copy.tip3,
            copy.tip4
          ]}
        />

      </div>

      <div
        id="resultsContainer"
        hidden
      >

        <ResultsGrid columns={4}>

          <ResultCard id="maturityResult" title={copy.maturity} icon={TrendingUp} accent="primary" />
          <ResultCard id="investedResult" title={copy.invested} icon={Wallet} accent="neutral" />
          <ResultCard id="returnsResult" title={copy.returns} icon={PiggyBank} accent="success" />
          <ResultCard id="percentResult" title={copy.percent} icon={Percent} accent="warning" />

        </ResultsGrid>

        <p
          id="insightBox"
          class="insight-box"
          hidden
        ></p>

        <ChartCard
          id="sipLineChart"
          title={copy.chartTitle}
        />

        <ScheduleTable
          id="scheduleBody"
          headers={[copy.yearHeader, copy.investedHeader, copy.valueHeader]}
          caption={copy.scheduleCaption}
        />

        <section class="calculator-info">

          <h2>{copy.aboutTitle}</h2>

          <p>{copy.aboutText}</p>

          <h3>{copy.formulaTitle}</h3>

          <p>
            Maturity Value = P &times; [(1+r)<sup>n</sup> &minus; 1] &divide; r &times; (1+r)
            {copy.formulaText}
          </p>

        </section>

      </div>

    </main>

  </div>

</section>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/sip-calculator";
</script>

<style>

.sip-calculator{

width:100%;

}

.sip-layout{

display:grid;

grid-template-columns:340px minmax(0,1fr);

gap:32px;

align-items:start;

}

.sip-sidebar{

position:sticky;

top:24px;

display:flex;

flex-direction:column;

gap:20px;

}

.sip-content{

display:flex;

flex-direction:column;

gap:28px;

min-width:0;

}

.scenario-row{

display:grid;

grid-template-columns:repeat(4,1fr);

gap:10px;

}

.scenario-btn{

height:40px;

border-radius:12px;

border:1px solid #D1D5DB;

background:#fff;

color:#4F46E5;

font-size:.85rem;

font-weight:600;

cursor:pointer;

transition:all .2s ease;

}

.scenario-btn:hover{

background:#EEF2FF;

border-color:#4F46E5;

}

.insight-box{

margin:0;

padding:18px 20px;

border-radius:16px;

background:#EEF2FF;

border:1px solid #C7D2FE;

color:#3730A3;

font-size:.92rem;

font-weight:600;

line-height:1.6;

}

.calculator-info{

padding:24px;

border:1px solid var(--border-subtle);

border-radius:18px;

background:var(--bg-card);

}

.calculator-info h2{

margin:0 0 12px;

font-size:1.15rem;

font-weight:700;

color:var(--text-primary);

}

.calculator-info h3{

margin:20px 0 10px;

font-size:1rem;

font-weight:700;

color:var(--text-primary);

}

.calculator-info p{

margin:0;

line-height:1.8;

font-size:.95rem;

color:var(--text-secondary);

}

.error-box{

display:flex;

align-items:center;

padding:14px 16px;

border-radius:14px;

background:#FEF2F2;

border:1px solid #FCA5A5;

color:#B91C1C;

font-size:.92rem;

font-weight:600;

}

:global(.dark) .scenario-btn{

background:#18181B;

border-color:#27272A;

color:#A5B4FC;

}

:global(.dark) .scenario-btn:hover{

background:#1E1B4B;

}

:global(.dark) .insight-box{

background:#1E1B4B;

border-color:#3730A3;

color:#C7D2FE;

}



:global(.dark) .error-box{

background:#2A1111;

border-color:#7F1D1D;

color:#FECACA;

}

@media(max-width:1024px){

.sip-layout{

grid-template-columns:1fr;

}

.sip-sidebar{

position:static;

}

}

@media(max-width:640px){

.calculator-info{

padding:18px;

}

}

</style>

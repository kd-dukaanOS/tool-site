---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { PiggyBank, FileMinus, TrendingDown, Landmark } from "@lucide/astro";
---
<section class="tira-calculator">
  <div class="tira-layout">
    <aside class="tira-sidebar">
      <div class="tira-group">
        <h3>Filing Info</h3>
        <CalculatorField type="select" id="taxYear" label="Tax Year">
  <option value="2025">2025 (filed 2026)</option>
  <option value="2026">2026 (filed 2027)</option>
</CalculatorField>
        <CalculatorField type="select" id="filingStatus" label="Filing Status">
  <option value="single">Single</option>
  <option value="hoh">Head of Household</option>
  <option value="mfj">Married Filing Jointly</option>
  <option value="mfs">Married Filing Separately</option>
</CalculatorField>
        <CalculatorField type="select" id="coverage" label="Workplace Plan Coverage">
  <option value="none">Not Covered (You or Spouse)</option>
  <option value="self">You Are Covered</option>
  <option value="spouse-only">Only Spouse Is Covered</option>
</CalculatorField>
        <CalculatorField id="age" label="Your Age" type="number" placeholder="e.g. 35" min="18" step="1" />
      </div>
      <div class="tira-group">
        <h3>Income & Contribution</h3>
        <CalculatorField id="magi" label="Modified AGI (MAGI)" type="number" placeholder="e.g. 84000" min="0" step="1" />
        <CalculatorField id="contribution" label="Planned Contribution" type="number" placeholder="e.g. 7000" min="0" step="1" />
        <CalculatorField id="marginalTaxRate" label="Marginal Tax Rate (%)" type="number" placeholder="e.g. 22" min="0" step="0.1" />
      </div>
      <CalculatorActions calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="tira-content">
      <div id="emptyState">
        <EmptyState icon="🏦" title="Traditional IRA Calculator" description="Estimate your deductible contribution and tax savings for 2025 or 2026." tips={["Deductible Amount", "Nondeductible Amount", "Tax Saved"]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="deductibleResult" title="Deductible Amount" icon={PiggyBank} accent="success" subtitle=" " />
          <ResultCard id="nondeductibleResult" title="Nondeductible (Form 8606)" icon={FileMinus} />
          <ResultCard id="taxSavedResult" title="Estimated Tax Saved" icon={TrendingDown} />
          <ResultCard id="limitResult" title="Contribution Limit" icon={Landmark} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>About this Calculator</h2>
          <p>Estimates how much of your Traditional IRA contribution is tax-deductible based on IRS MAGI phase-out rules for your filing status and workplace plan coverage.</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script>
  import "../../scripts/traditional-ira-calculator";
</script>
<style>
.tira-calculator{width:100%;}
.tira-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.tira-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.tira-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.tira-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.tira-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.tira-layout{grid-template-columns:1fr;}.tira-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.tira-layout{gap:24px;}.tira-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
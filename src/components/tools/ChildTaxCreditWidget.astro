---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Baby, Wallet, TrendingDown, RefreshCw } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { incomeGroup:"Income & Filing", magi:"Modified AGI", filingStatus:"Filing Status", single:"Single", mfj:"Married Filing Jointly", hoh:"Head of Household", mfs:"Married Filing Separately", dependentsGroup:"Dependents", qualifyingChildren:"Qualifying Children (under 17)", otherDependents:"Other Dependents", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"Child Tax Credit Calculator", emptyDesc:"Find your 2026 Child Tax Credit amount after income phase-out.", tip1:"Final Credit", tip2:"Phase-Out", tip3:"Refundable Amount", finalCredit:"Final Credit Amount", baseCredit:"Base Credit", phaseOut:"Phase-Out Reduction", refundableCap:"Max Refundable (ACTC)", aboutTitle:"About this Calculator", aboutText:"Calculates your 2026 Child Tax Credit ($2,200/child) and Credit for Other Dependents ($500), applying the income-based phase-out." },
  es: { incomeGroup:"Ingresos y Estado Civil", magi:"Ingreso Bruto Ajustado Modificado", filingStatus:"Estado Civil Tributario", single:"Soltero", mfj:"Casado Declarando Conjuntamente", hoh:"Cabeza de Familia", mfs:"Casado Declarando por Separado", dependentsGroup:"Dependientes", qualifyingChildren:"Hijos Calificados (menores de 17)", otherDependents:"Otros Dependientes", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora de Crédito Tributario por Hijos", emptyDesc:"Encuentra tu monto de Crédito Tributario por Hijos 2026 después de la reducción por ingresos.", tip1:"Crédito Final", tip2:"Reducción", tip3:"Monto Reembolsable", finalCredit:"Monto de Crédito Final", baseCredit:"Crédito Base", phaseOut:"Reducción por Ingresos", refundableCap:"Máximo Reembolsable (ACTC)", aboutTitle:"Acerca de esta Calculadora", aboutText:"Calcula tu Crédito Tributario por Hijos 2026 ($2,200/hijo) y el Crédito por Otros Dependientes ($500), aplicando la reducción basada en ingresos." },
}[lang];
---
<section class="ctc-calculator">
  <div class="ctc-layout">
    <aside class="ctc-sidebar">
      <div class="ctc-group">
        <h3>{copy.incomeGroup}</h3>
        <CalculatorField id="magi" label={copy.magi} type="number" placeholder="e.g. 150000" min="0" step="1" />
        <CalculatorField type="select" id="filingStatus" label={copy.filingStatus}>
  <option value="single">{copy.single}</option>
  <option value="mfj">{copy.mfj}</option>
  <option value="hoh">{copy.hoh}</option>
  <option value="mfs">{copy.mfs}</option>
</CalculatorField>
      </div>
      <div class="ctc-group">
        <h3>{copy.dependentsGroup}</h3>
        <CalculatorField id="numQualifyingChildren" label={copy.qualifyingChildren} type="number" placeholder="e.g. 2" min="0" step="1" />
        <CalculatorField id="numOtherDependents" label={copy.otherDependents} type="number" placeholder="e.g. 0" min="0" step="1" />
      </div>
      <CalculatorActions calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} calculateText={copy.calculate} resetText={copy.reset} copyText={copy.copy} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="ctc-content">
      <div id="emptyState">
        <EmptyState icon="👶" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="finalCreditResult" title={copy.finalCredit} icon={Baby} accent="success" subtitle=" " />
          <ResultCard id="baseCreditResult" title={copy.baseCredit} icon={Wallet} />
          <ResultCard id="phaseOutResult" title={copy.phaseOut} icon={TrendingDown} />
          <ResultCard id="refundableCapResult" title={copy.refundableCap} icon={RefreshCw} subtitle=" " />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/child-tax-credit-calculator";
</script>
<style>
.ctc-calculator{width:100%;}
.ctc-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.ctc-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.ctc-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.ctc-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.ctc-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.ctc-layout{grid-template-columns:1fr;}.ctc-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.ctc-layout{gap:24px;}.ctc-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
---
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { ShieldCheck, Ruler, Timer, Copy } from "@lucide/astro";
---
<section class="password-generator">
  <div class="pw-layout">
    <aside class="pw-sidebar">
      <div class="tool-field">
        <label class="tool-label" for="pwLength">Length</label>
        <input id="pwLength" type="number" class="tool-input" value="16" min="4" max="128" />
      </div>

      <div class="tool-checkbox-field"><input id="pwUppercase" type="checkbox" checked /><label for="pwUppercase">Uppercase (A-Z)</label></div>
      <div class="tool-checkbox-field"><input id="pwLowercase" type="checkbox" checked /><label for="pwLowercase">Lowercase (a-z)</label></div>
      <div class="tool-checkbox-field"><input id="pwNumbers" type="checkbox" checked /><label for="pwNumbers">Numbers (0-9)</label></div>
      <div class="tool-checkbox-field"><input id="pwSymbols" type="checkbox" checked /><label for="pwSymbols">Symbols (!@#$)</label></div>
      <div class="tool-checkbox-field"><input id="pwExcludeAmbiguous" type="checkbox" /><label for="pwExcludeAmbiguous">Exclude ambiguous (Il1O0)</label></div>

      <CalculatorActions calculateId="generateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>

    <main class="pw-content">
      <div id="emptyState">
        <EmptyState
          icon="🔒"
          title="Password Generator"
          description="Generate strong, random passwords with custom rules."
          tips={["Custom Length", "Strength Meter", "Crack Time Estimate", "Copy Password"]}
        />
      </div>

      <div id="resultsContainer" hidden>
        <div class="tool-field">
          <label class="tool-label"><Copy size={16} /> Generated Password</label>
          <input id="passwordOutput" type="text" class="tool-input password-output" readonly />
        </div>

        <ResultsGrid columns={3}>
          <ResultCard id="strengthResult" title="Strength" icon={ShieldCheck} />
          <ResultCard id="lengthResult" title="Length" icon={Ruler} />
          <ResultCard id="crackTimeResult" title="Est. Crack Time" icon={Timer} />
        </ResultsGrid>

        <section class="calculator-info">
          <h2>About this Tool</h2>
          <p>Generate cryptographically random passwords using your browser's secure random number generator, with strength and crack-time estimates.</p>
        </section>
      </div>
    </main>
  </div>
</section>

<script>
  import "../../scripts/password-generator";
</script>

<style>
.password-generator{width:100%;}
.pw-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.pw-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:16px;}
.tool-field{display:flex;flex-direction:column;gap:8px;}
.tool-field .tool-label{display:flex;align-items:center;gap:6px;}
.tool-checkbox-field{display:flex;align-items:center;gap:8px;font-size:.9rem;color:#374151;}
.pw-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.password-output{font-family:ui-monospace,monospace;font-size:1.05rem;letter-spacing:.5px;}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
:global(.dark) .tool-checkbox-field{color:#A1A1AA;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.pw-layout{grid-template-columns:1fr;}.pw-sidebar{position:static;}}
</style>

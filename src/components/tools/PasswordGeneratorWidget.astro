---
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { ShieldCheck, Ruler, Timer, Copy } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { length:"Length", uppercase:"Uppercase (A-Z)", lowercase:"Lowercase (a-z)", numbers:"Numbers (0-9)", symbols:"Symbols (!@#$)", excludeAmbiguous:"Exclude ambiguous (Il1O0)", emptyTitle:"Password Generator", emptyDesc:"Generate strong, random passwords with custom rules.", tip1:"Custom Length", tip2:"Strength Meter", tip3:"Crack Time Estimate", tip4:"Copy Password", generatedPassword:"Generated Password", strength:"Strength", lengthResult:"Length", crackTime:"Est. Crack Time", aboutTitle:"About this Tool", aboutText:"Generate cryptographically random passwords using your browser's secure random number generator, with strength and crack-time estimates." },
  es: { length:"Longitud", uppercase:"Mayúsculas (A-Z)", lowercase:"Minúsculas (a-z)", numbers:"Números (0-9)", symbols:"Símbolos (!@#$)", excludeAmbiguous:"Excluir ambiguos (Il1O0)", emptyTitle:"Generador de Contraseñas", emptyDesc:"Genera contraseñas seguras y aleatorias con reglas personalizadas.", tip1:"Longitud Personalizada", tip2:"Medidor de Fortaleza", tip3:"Estimación de Tiempo de Descifrado", tip4:"Copiar Contraseña", generatedPassword:"Contraseña Generada", strength:"Fortaleza", lengthResult:"Longitud", crackTime:"Tiempo Est. de Descifrado", aboutTitle:"Acerca de esta Herramienta", aboutText:"Genera contraseñas aleatorias criptográficamente seguras usando el generador de números aleatorios seguro de tu navegador, con estimaciones de fortaleza y tiempo de descifrado." },
}[lang];
---
<section class="password-generator">
  <div class="pw-layout">
    <aside class="pw-sidebar">
      <div class="tool-field">
        <label class="tool-label" for="pwLength">{copy.length}</label>
        <input id="pwLength" type="number" class="tool-input" value="16" min="4" max="128" />
      </div>

      <div class="tool-checkbox-field"><input id="pwUppercase" type="checkbox" checked /><label for="pwUppercase">{copy.uppercase}</label></div>
      <div class="tool-checkbox-field"><input id="pwLowercase" type="checkbox" checked /><label for="pwLowercase">{copy.lowercase}</label></div>
      <div class="tool-checkbox-field"><input id="pwNumbers" type="checkbox" checked /><label for="pwNumbers">{copy.numbers}</label></div>
      <div class="tool-checkbox-field"><input id="pwSymbols" type="checkbox" checked /><label for="pwSymbols">{copy.symbols}</label></div>
      <div class="tool-checkbox-field"><input id="pwExcludeAmbiguous" type="checkbox" /><label for="pwExcludeAmbiguous">{copy.excludeAmbiguous}</label></div>

      <CalculatorActions calculateId="generateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>

    <main class="pw-content">
      <div id="emptyState">
        <EmptyState
          icon="🔒"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={[copy.tip1, copy.tip2, copy.tip3, copy.tip4]}
        />
      </div>

      <div id="resultsContainer" hidden>
        <div class="tool-field">
          <label class="tool-label"><Copy size={16} /> {copy.generatedPassword}</label>
          <input id="passwordOutput" type="text" class="tool-input password-output" readonly />
        </div>

        <ResultsGrid columns={3}>
          <ResultCard id="strengthResult" title={copy.strength} icon={ShieldCheck} />
          <ResultCard id="lengthResult" title={copy.lengthResult} icon={Ruler} />
          <ResultCard id="crackTimeResult" title={copy.crackTime} icon={Timer} />
        </ResultsGrid>

        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/password-generator";
</script>

<style>
.password-generator{width:100%;}
.pw-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.pw-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:16px;}
.tool-field{display:flex;flex-direction:column;gap:8px;}
.tool-field .tool-label{display:flex;align-items:center;gap:6px;}
.tool-checkbox-field{display:flex;align-items:center;gap:8px;font-size:.9rem;color:#374151;}
.pw-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.password-output{font-family:ui-monospace,monospace;font-size:1.05rem;letter-spacing:.5px;}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
:global(.dark) .tool-checkbox-field{color:#A1A1AA;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.pw-layout{grid-template-columns:1fr;}.pw-sidebar{position:static;}}
</style>

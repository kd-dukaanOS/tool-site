---
{/* src/components/tools/SelfEmploymentTaxCalculatorWidget.astro */}
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";

import { Landmark, Percent, Wallet, Receipt } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { netEarningsLabel:"Net Self-Employment Earnings ($)", netEarningsHelp:"Net profit from self-employment, before SE tax.", filingStatusLabel:"Filing Status", single:"Single", marriedJointly:"Married Filing Jointly", marriedSeparately:"Married Filing Separately", headOfHousehold:"Head of Household", taxYearLabel:"Tax Year", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"Self-Employment Tax Calculator", emptyDesc:"Calculate Social Security and Medicare tax owed on your self-employment income.", tip1:"Total SE Tax", tip2:"Deductible Half", totalSETax:"Total SE Tax", deductibleHalf:"Deductible Half", socialSecurity:"Social Security (12.4%)", medicare:"Medicare (2.9% + Additional)", effectiveRate:"Effective Rate", aboutTitle:"About this Calculator", aboutText:"Calculates Social Security and Medicare (self-employment) tax on 92.35% of your net self-employment earnings, using current IRS rates and the Social Security wage base for 2025 and 2026. Also shows the deductible half of SE tax you can claim against income tax." },
  es: { netEarningsLabel:"Ingresos Netos por Trabajo Independiente ($)", netEarningsHelp:"Ganancia neta del trabajo independiente, antes del impuesto SE.", filingStatusLabel:"Estado Civil Tributario", single:"Soltero(a)", marriedJointly:"Casado(a) Declaración Conjunta", marriedSeparately:"Casado(a) Declaración Separada", headOfHousehold:"Cabeza de Familia", taxYearLabel:"Año Fiscal", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora de Impuesto por Trabajo Independiente", emptyDesc:"Calcula el impuesto de Seguro Social y Medicare sobre tus ingresos por trabajo independiente.", tip1:"Impuesto SE Total", tip2:"Mitad Deducible", totalSETax:"Impuesto SE Total", deductibleHalf:"Mitad Deducible", socialSecurity:"Seguro Social (12.4%)", medicare:"Medicare (2.9% + Adicional)", effectiveRate:"Tasa Efectiva", aboutTitle:"Acerca de esta Calculadora", aboutText:"Calcula el impuesto de Seguro Social y Medicare (trabajo independiente) sobre el 92.35% de tus ingresos netos por trabajo independiente, utilizando las tasas actuales del IRS y la base salarial del Seguro Social para 2025 y 2026. También muestra la mitad deducible del impuesto SE que puedes reclamar contra el impuesto sobre la renta." },
}[lang];
---

<section class="set-calculator">
  <div class="set-layout">

    <aside class="set-sidebar">
      <CalculatorField
        id="netEarnings"
        label={copy.netEarningsLabel}
        type="number"
        placeholder="e.g. 60000"
        required={true}
        min="0"
        step="0.01"
        helpText={copy.netEarningsHelp}
      />

      <CalculatorField
        id="filingStatus"
        label={copy.filingStatusLabel}
        type="select"
        required={true}
      >
        <option value="single">{copy.single}</option>
        <option value="marriedJointly">{copy.marriedJointly}</option>
        <option value="marriedSeparately">{copy.marriedSeparately}</option>
        <option value="headOfHousehold">{copy.headOfHousehold}</option>
      </CalculatorField>

      <CalculatorField
        id="taxYear"
        label={copy.taxYearLabel}
        type="select"
        required={true}
      >
        <option value="2026">2026</option>
        <option value="2025">2025</option>
      </CalculatorField>

      <CalculatorActions lang={lang}
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
        calculateText={copy.calculate}
        resetText={copy.reset}
        copyText={copy.copy}
      />

      <div id="errorBox" class="error-box" hidden></div>
    </aside>

    <main class="set-content">
      <div id="emptyState">
        <EmptyState
          icon="🧾"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={[copy.tip1, copy.tip2]}
        />
      </div>

      <div id="resultsContainer" hidden>
        <ResultsGrid columns={2}>
          <ResultCard id="totalSETaxResult" title={copy.totalSETax} icon={Landmark} accent="primary" size="lg" />
          <ResultCard id="deductibleHalfResult" title={copy.deductibleHalf} icon={Wallet} accent="success" size="lg" />
          <ResultCard id="socialSecurityResult" title={copy.socialSecurity} icon={Receipt} accent="neutral" />
          <ResultCard id="medicareResult" title={copy.medicare} icon={Receipt} accent="neutral" />
          <ResultCard id="effectiveRateResult" title={copy.effectiveRate} icon={Percent} accent="primary" />
        </ResultsGrid>

        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>

  </div>
</section>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/self-employment-tax-calculator";
</script>

<style>
.set-calculator{ width:100%; }
.set-layout{ display:grid; grid-template-columns:340px minmax(0,1fr); gap:32px; align-items:start; }
.set-sidebar{ position:sticky; top:24px; display:flex; flex-direction:column; gap:20px; }
.set-content{ display:flex; flex-direction:column; gap:28px; min-width:0; }
.calculator-info{ padding:24px; border:1px solid var(--border-subtle); border-radius:18px; background:var(--bg-card); }
.calculator-info h2{ margin:0 0 12px; font-size:1.15rem; font-weight:700; color:var(--text-primary); }
.calculator-info p{ margin:0; line-height:1.8; font-size:.95rem; color:var(--text-secondary); }
.error-box{ display:flex; align-items:center; padding:14px 16px; border-radius:14px; background:#FEF2F2; border:1px solid #FCA5A5; color:#B91C1C; font-size:.92rem; font-weight:600; }
:global(.dark) .error-box{ background:#2A1111; border-color:#7F1D1D; color:#FECACA; }
@media(max-width:1024px){ .set-layout{ grid-template-columns:1fr; } .set-sidebar{ position:static; } }
@media(max-width:768px){ .set-layout{ gap:24px; } .set-content{ gap:20px; } }
@media(max-width:640px){ .calculator-info{ padding:18px; } }
</style>
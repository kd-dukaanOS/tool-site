---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Shield, PiggyBank, Wallet, Clock } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { expensesGroup:"Your Expenses", monthlyExpenses:"Monthly Essential Expenses", currentSavings:"Current Emergency Savings", goalGroup:"Goal", targetMonths:"Target Months of Coverage", monthlySavingsCapacity:"Monthly Savings Capacity", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"Emergency Fund Calculator", emptyDesc:"Enter your expenses and savings to see your target, progress, and time to reach your goal.", tip1:"Target Amount", tip2:"Progress %", tip3:"Time to Goal", targetAmount:"Target Amount", progress:"Current Progress", remaining:"Remaining to Save", timeToGoal:"Time to Goal", aboutTitle:"About this Calculator", aboutText:"Calculates your emergency fund target based on monthly essential expenses and a chosen coverage period (commonly 3-6 months), then shows your current progress and how long it will take to reach the goal.", monthsOfExpenses:(m:number)=>`${m} months of expenses`, goalReached:"Goal reached", months:(m:number)=>`${m} months`, dash:"—", na:"N/A" },
  es: { expensesGroup:"Tus Gastos", monthlyExpenses:"Gastos Mensuales Esenciales", currentSavings:"Ahorros Actuales de Emergencia", goalGroup:"Meta", targetMonths:"Meses Objetivo de Cobertura", monthlySavingsCapacity:"Capacidad de Ahorro Mensual", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora de Fondo de Emergencia", emptyDesc:"Ingresa tus gastos y ahorros para ver tu objetivo, progreso y tiempo para alcanzar tu meta.", tip1:"Monto Objetivo", tip2:"Progreso %", tip3:"Tiempo para la Meta", targetAmount:"Monto Objetivo", progress:"Progreso Actual", remaining:"Restante por Ahorrar", timeToGoal:"Tiempo para la Meta", aboutTitle:"Acerca de esta Calculadora", aboutText:"Calcula tu objetivo de fondo de emergencia según tus gastos mensuales esenciales y un período de cobertura elegido (comúnmente 3-6 meses), luego muestra tu progreso actual y cuánto tiempo tomará alcanzar la meta.", monthsOfExpenses:(m:number)=>`${m} meses de gastos`, goalReached:"Meta alcanzada", months:(m:number)=>`${m} meses`, dash:"—", na:"N/D" },
}[lang];
---
<section class="ef-calculator">
  <div class="ef-layout">
    <aside class="ef-sidebar">
      <div class="ef-group">
        <h3>{copy.expensesGroup}</h3>
        <CalculatorField id="monthlyExpenses" label={copy.monthlyExpenses} type="number" placeholder="e.g. 3000" min="0" step="1" />
        <CalculatorField id="currentSavings" label={copy.currentSavings} type="number" placeholder="e.g. 2000" min="0" step="1" />
      </div>
      <div class="ef-group">
        <h3>{copy.goalGroup}</h3>
        <CalculatorField id="targetMonths" label={copy.targetMonths} type="number" placeholder="e.g. 6" min="1" step="1" />
        <CalculatorField id="monthlySavingsCapacity" label={copy.monthlySavingsCapacity} type="number" placeholder="e.g. 300" min="0" step="1" />
      </div>
      <CalculatorActions calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} calculateText={copy.calculate} resetText={copy.reset} copyText={copy.copy} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="ef-content">
      <div id="emptyState">
        <EmptyState icon="🛟" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="targetAmountResult" title={copy.targetAmount} icon={Shield} accent="success" subtitle=" " />
          <ResultCard id="progressResult" title={copy.progress} icon={PiggyBank} />
          <ResultCard id="remainingResult" title={copy.remaining} icon={Wallet} />
          <ResultCard id="monthsToGoalResult" title={copy.timeToGoal} icon={Clock} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/emergency-fund-calculator";
</script>
<style>
.ef-calculator{width:100%;}
.ef-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.ef-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;}
.ef-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.ef-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.ef-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.ef-layout{grid-template-columns:1fr;}.ef-sidebar{position:static;}}
@media(max-width:768px){.ef-layout{gap:24px;}.ef-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
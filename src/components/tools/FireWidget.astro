---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Target, Calendar, TrendingUp, PiggyBank } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { personal:"Personal", currentAge:"Current Age", currentSavings:"Current Savings", annualIncome:"Annual Income", expensesGroup:"Expenses & Savings", annualExpenses:"Annual Expenses", annualContribution:"Annual Contribution", assumptionsGroup:"Assumptions", expectedReturn:"Expected Return (%/yr)", inflation:"Inflation Rate (%/yr)", withdrawal:"Withdrawal Rate (%)", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"FIRE Calculator", emptyDesc:"Find your Financial Independence number and years to FIRE.", tip1:"FI Number", tip2:"Years to FI", tip3:"FIRE Age", fiNumber:"FI Number", yearsToFi:"Years to FI", fireAge:"FIRE Age", savingsRate:"Savings Rate", aboutTitle:"About this Calculator", aboutText:"Calculates your Financial Independence number from annual expenses and withdrawal rate, then projects years to reach it using real (inflation-adjusted) investment growth and your annual contribution.", beyond75:"Beyond 75 yrs", yrs:(y:number)=>`${y} yrs`, na:"N/A", atRate:(r:number)=>`At ${r}% withdrawal rate` },
  es: { personal:"Personal", currentAge:"Edad Actual", currentSavings:"Ahorros Actuales", annualIncome:"Ingreso Anual", expensesGroup:"Gastos y Ahorros", annualExpenses:"Gastos Anuales", annualContribution:"Contribución Anual", assumptionsGroup:"Supuestos", expectedReturn:"Rendimiento Esperado (%/año)", inflation:"Tasa de Inflación (%/año)", withdrawal:"Tasa de Retiro (%)", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora FIRE", emptyDesc:"Encuentra tu número de Independencia Financiera y años para lograrlo.", tip1:"Número FI", tip2:"Años para FI", tip3:"Edad FIRE", fiNumber:"Número FI", yearsToFi:"Años para FI", fireAge:"Edad FIRE", savingsRate:"Tasa de Ahorro", aboutTitle:"Acerca de esta Calculadora", aboutText:"Calcula tu número de Independencia Financiera a partir de tus gastos anuales y tasa de retiro, luego proyecta los años para alcanzarlo usando el crecimiento real de inversión (ajustado por inflación) y tu contribución anual.", beyond75:"Más de 75 años", yrs:(y:number)=>`${y} años`, na:"N/D", atRate:(r:number)=>`A una tasa de retiro del ${r}%` },
}[lang];
---
<section class="fire-calculator">
  <div class="fire-layout">
    <aside class="fire-sidebar">
      <div class="fire-group">
        <h3>{copy.personal}</h3>
        <CalculatorField id="currentAge" label={copy.currentAge} type="number" placeholder="e.g. 30" min="1" step="1" />
        <CalculatorField id="currentSavings" label={copy.currentSavings} type="number" placeholder="e.g. 50000" min="0" step="1" />
        <CalculatorField id="annualIncome" label={copy.annualIncome} type="number" placeholder="e.g. 90000" min="0" step="1" />
      </div>
      <div class="fire-group">
        <h3>{copy.expensesGroup}</h3>
        <CalculatorField id="annualExpenses" label={copy.annualExpenses} type="number" placeholder="e.g. 45000" min="0" step="1" />
        <CalculatorField id="annualContribution" label={copy.annualContribution} type="number" placeholder="e.g. 25000" min="0" step="1" />
      </div>
      <div class="fire-group">
        <h3>{copy.assumptionsGroup}</h3>
        <CalculatorField id="expectedReturnRate" label={copy.expectedReturn} type="number" placeholder="e.g. 7" min="0" step="0.1" />
        <CalculatorField id="inflationRate" label={copy.inflation} type="number" placeholder="e.g. 3" min="0" step="0.1" />
        <CalculatorField id="withdrawalRate" label={copy.withdrawal} type="number" placeholder="e.g. 4" min="0.1" step="0.1" />
      </div>
      <CalculatorActions calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} calculateText={copy.calculate} resetText={copy.reset} copyText={copy.copy} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="fire-content">
      <div id="emptyState">
        <EmptyState icon="🔥" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="fiNumberResult" title={copy.fiNumber} icon={Target} accent="success" subtitle=" " />
          <ResultCard id="yearsToFiResult" title={copy.yearsToFi} icon={Calendar} />
          <ResultCard id="fiAgeResult" title={copy.fireAge} icon={TrendingUp} />
          <ResultCard id="savingsRateResult" title={copy.savingsRate} icon={PiggyBank} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/fire-calculator";
</script>
<style>
.fire-calculator{width:100%;}
.fire-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.fire-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.fire-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.fire-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.fire-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.fire-layout{grid-template-columns:1fr;}.fire-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.fire-layout{gap:24px;}.fire-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
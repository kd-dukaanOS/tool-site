---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Target, Calendar, TrendingUp, PiggyBank } from "@lucide/astro";
---
<section class="fire-calculator">
  <div class="fire-layout">
    <aside class="fire-sidebar">
      <div class="fire-group">
        <h3>Personal</h3>
        <CalculatorField id="currentAge" label="Current Age" type="number" placeholder="e.g. 30" min="1" step="1" />
        <CalculatorField id="currentSavings" label="Current Savings" type="number" placeholder="e.g. 50000" min="0" step="1" />
        <CalculatorField id="annualIncome" label="Annual Income" type="number" placeholder="e.g. 90000" min="0" step="1" />
      </div>
      <div class="fire-group">
        <h3>Expenses & Savings</h3>
        <CalculatorField id="annualExpenses" label="Annual Expenses" type="number" placeholder="e.g. 45000" min="0" step="1" />
        <CalculatorField id="annualContribution" label="Annual Contribution" type="number" placeholder="e.g. 25000" min="0" step="1" />
      </div>
      <div class="fire-group">
        <h3>Assumptions</h3>
        <CalculatorField id="expectedReturnRate" label="Expected Return (%/yr)" type="number" placeholder="e.g. 7" min="0" step="0.1" />
        <CalculatorField id="inflationRate" label="Inflation Rate (%/yr)" type="number" placeholder="e.g. 3" min="0" step="0.1" />
        <CalculatorField id="withdrawalRate" label="Withdrawal Rate (%)" type="number" placeholder="e.g. 4" min="0.1" step="0.1" />
      </div>
      <CalculatorActions calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="fire-content">
      <div id="emptyState">
        <EmptyState icon="🔥" title="FIRE Calculator" description="Find your Financial Independence number and years to FIRE." tips={["FI Number", "Years to FI", "FIRE Age"]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="fiNumberResult" title="FI Number" icon={Target} accent="success" subtitle=" " />
          <ResultCard id="yearsToFiResult" title="Years to FI" icon={Calendar} />
          <ResultCard id="fiAgeResult" title="FIRE Age" icon={TrendingUp} />
          <ResultCard id="savingsRateResult" title="Savings Rate" icon={PiggyBank} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>About this Calculator</h2>
          <p>Calculates your Financial Independence number from annual expenses and withdrawal rate, then projects years to reach it using real (inflation-adjusted) investment growth and your annual contribution.</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script>
  import "../../scripts/fire-calculator";
</script>
<style>
.fire-calculator{width:100%;}
.fire-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.fire-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.fire-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.fire-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.fire-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.fire-layout{grid-template-columns:1fr;}.fire-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.fire-layout{gap:24px;}.fire-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
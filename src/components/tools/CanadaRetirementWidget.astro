---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Wallet, Landmark, PiggyBank, TrendingUp } from "@lucide/astro";
---
<section class="cret-calculator">
  <div class="cret-layout">
    <aside class="cret-sidebar">
      <div class="cret-group">
        <h3>Personal</h3>
        <CalculatorField id="currentAge" label="Current Age" type="number" placeholder="e.g. 30" min="1" step="1" />
        <CalculatorField id="retirementAge" label="Retirement Age" type="number" placeholder="e.g. 65" min="1" step="1" />
      </div>
      <div class="cret-group">
        <h3>Current Balances</h3>
        <CalculatorField id="currentRrspBalance" label="Current RRSP Balance" type="number" placeholder="e.g. 20000" min="0" step="1" />
        <CalculatorField id="currentTfsaBalance" label="Current TFSA Balance" type="number" placeholder="e.g. 10000" min="0" step="1" />
      </div>
      <div class="cret-group">
        <h3>Annual Contributions</h3>
        <CalculatorField id="annualRrspContribution" label="Annual RRSP Contribution" type="number" placeholder="e.g. 8000" min="0" step="1" />
        <CalculatorField id="annualTfsaContribution" label="Annual TFSA Contribution" type="number" placeholder="e.g. 7000" min="0" step="1" />
      </div>
      <div class="cret-group">
        <h3>Assumptions</h3>
        <CalculatorField id="expectedReturn" label="Expected Return (%/yr)" type="number" placeholder="e.g. 7" min="0" step="0.1" />
      </div>
      <CalculatorActions calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="cret-content">
      <div id="emptyState">
        <EmptyState icon="🍁" title="Canada Retirement Calculator" description="Project your combined RRSP and TFSA balance at retirement." tips={["Total Balance", "RRSP Balance", "TFSA Balance"]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="totalBalanceResult" title="Total Projected Balance" icon={Wallet} accent="success" subtitle=" " />
          <ResultCard id="rrspBalanceResult" title="RRSP Balance" icon={Landmark} />
          <ResultCard id="tfsaBalanceResult" title="TFSA Balance" icon={PiggyBank} />
          <ResultCard id="totalGrowthResult" title="Investment Growth" icon={TrendingUp} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>About this Calculator</h2>
          <p>Projects your RRSP and TFSA balances separately using your current savings, annual contributions capped at 2026 limits, and expected return, then combines them into a total retirement estimate.</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script>
  import "../../scripts/canada-retirement-calculator";
</script>
<style>
.cret-calculator{width:100%;}
.cret-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.cret-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.cret-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.cret-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.cret-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.cret-layout{grid-template-columns:1fr;}.cret-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.cret-layout{gap:24px;}.cret-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
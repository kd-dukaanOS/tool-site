---
import CalculatorField from "../calculator/CalculatorField.astro";
import ActionButtons from "../calculator/ActionButtons.astro";
import ResultCard from "../calculator/ResultCard.astro";
import EmptyState from "../calculator/EmptyState.astro";
import { Beaker } from "@lucide/astro";
---

<div class="calculator-widget">
  <div class="calculator-form">
    <CalculatorField id="value" label="Value" type="number" placeholder="Enter value" />

    <CalculatorField id="fromUnit" label="From" type="select">
      <option value="ml">Milliliter</option>
      <option value="l" selected>Liter</option>
      <option value="cubicm">Cubic Meter</option>
      <option value="gallon">Gallon</option>
      <option value="quart">Quart</option>
      <option value="pint">Pint</option>
      <option value="cup">Cup</option>
      <option value="floz">Fluid Ounce</option>
    </CalculatorField>

    <CalculatorField id="toUnit" label="To" type="select">
      <option value="ml">Milliliter</option>
      <option value="l">Liter</option>
      <option value="cubicm">Cubic Meter</option>
      <option value="gallon" selected>Gallon</option>
      <option value="quart">Quart</option>
      <option value="pint">Pint</option>
      <option value="cup">Cup</option>
      <option value="floz">Fluid Ounce</option>
    </CalculatorField>

    <div id="errorBox" class="error-box" hidden></div>

    <ActionButtons calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" />
  </div>

  <div class="calculator-results">
    <div id="emptyState">
      <EmptyState icon="??" title="Volume Converter" description="Enter a value to convert." />
    </div>

    <div id="resultsContainer" hidden>
      <ResultCard id="convertedResult" title="Converted Value" icon={Beaker} />
    </div>
  </div>
</div>

<script src="../../scripts/volume-calculator.ts"></script>

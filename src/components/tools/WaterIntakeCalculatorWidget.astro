---
import CalculatorField from "../calculator/CalculatorField.astro";
import ActionButtons from "../calculator/ActionButtons.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import EmptyState from "../calculator/EmptyState.astro";
import { Droplets, GlassWater } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { weight:"Weight (kg)", weightPh:"e.g. 65", activity:"Activity Level", sedentary:"Sedentary", light:"Light Activity", moderate:"Moderate Activity", active:"Very Active", hotClimate:"I live in a hot/humid climate", emptyTitle:"Enter weight to calculate water intake", emptyDesc:"Your recommended daily water intake will appear here.", liters:"Daily Water Intake", glasses:"Equivalent Glasses" },
  es: { weight:"Peso (kg)", weightPh:"ej. 65", activity:"Nivel de Actividad", sedentary:"Sedentario", light:"Actividad Ligera", moderate:"Actividad Moderada", active:"Muy Activo", hotClimate:"Vivo en un clima cálido/húmedo", emptyTitle:"Ingresa tu peso para calcular la ingesta de agua", emptyDesc:"Tu ingesta diaria recomendada de agua aparecerá aquí.", liters:"Ingesta Diaria de Agua", glasses:"Vasos Equivalentes" },
}[lang];
---

<div class="calculator-widget">
  <div class="calculator-inputs">
    <CalculatorField id="weightKg" label={copy.weight} type="number" placeholder={copy.weightPh} />

    <div class="field-group">
      <label for="activityLevel">{copy.activity}</label>
      <select id="activityLevel" class="calculator-input">
        <option value="sedentary">{copy.sedentary}</option>
        <option value="light">{copy.light}</option>
        <option value="moderate" selected>{copy.moderate}</option>
        <option value="active">{copy.active}</option>
      </select>
    </div>

    <label class="checkbox-field">
      <input type="checkbox" id="climateHot" />
      <span>{copy.hotClimate}</span>
    </label>

    <div id="errorBox" class="error-box" role="alert" hidden></div>

    <ActionButtons lang={lang}
      calculateId="calculateBtn"
      resetId="resetBtn"
      copyId="copyBtn"
      showDownload={false}
      showShare={false}
    />
  </div>

  <div class="calculator-output">
    <EmptyState
      id="emptyState"
      title={copy.emptyTitle}
      description={copy.emptyDesc}
    />

    <ResultsGrid id="resultsContainer" hidden>
      <ResultCard id="litersResult" title={copy.liters} icon={Droplets} accent="primary" size="lg" />
      <ResultCard id="glassesResult" title={copy.glasses} icon={GlassWater} accent="neutral" />
    </ResultsGrid>
  </div>
</div>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script src="../../scripts/water-intake-calculator.ts"></script>

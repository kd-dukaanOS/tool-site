---
import CalculatorField from "../calculator/CalculatorField.astro";
import ActionButtons from "../calculator/ActionButtons.astro";
import ResultCard from "../calculator/ResultCard.astro";
import EmptyState from "../calculator/EmptyState.astro";
import { FileSpreadsheet } from "@lucide/astro";
---

<div class="calculator-widget">
  <div class="calculator-form">
    <CalculatorField id="mode" label="Mode" type="select">
      <option value="csvToJson">CSV to JSON</option>
      <option value="jsonToCsv">JSON to CSV</option>
    </CalculatorField>

    <CalculatorField id="text" label="Input" type="textarea" placeholder="Paste CSV or JSON here" />

    <div id="errorBox" class="error-box" hidden></div>

    <ActionButtons calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" />
  </div>

  <div class="calculator-results">
    <div id="emptyState">
      <EmptyState icon="??" title="CSV / JSON Converter" description="Paste data to convert." />
    </div>

    <div id="resultsContainer" hidden>
      <ResultCard id="outputResult" title="Output" icon={FileSpreadsheet} />
    </div>
  </div>
</div>

<script src="../../scripts/csv-json.ts"></script>

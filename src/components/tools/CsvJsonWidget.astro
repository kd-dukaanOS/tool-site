---
import CalculatorField from "../calculator/CalculatorField.astro";
import ActionButtons from "../calculator/ActionButtons.astro";
import ResultCard from "../calculator/ResultCard.astro";
import EmptyState from "../calculator/EmptyState.astro";
import { FileSpreadsheet } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { mode:"Mode", csvToJson:"CSV to JSON", jsonToCsv:"JSON to CSV", input:"Input", placeholder:"Paste CSV or JSON here", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"CSV / JSON Converter", emptyDesc:"Paste data to convert between CSV and JSON instantly.", tip1:"CSV to JSON", tip2:"JSON to CSV", tip3:"Instant Preview", tip4:"Copy Output", output:"Output", aboutTitle:"About this Tool", aboutText:"Convert CSV data to JSON or JSON data to CSV instantly, right in your browser. Nothing is uploaded to a server." },
  es: { mode:"Modo", csvToJson:"CSV a JSON", jsonToCsv:"JSON a CSV", input:"Entrada", placeholder:"Pega CSV o JSON aquí", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Convertidor CSV / JSON", emptyDesc:"Pega datos para convertir entre CSV y JSON al instante.", tip1:"CSV a JSON", tip2:"JSON a CSV", tip3:"Vista Previa Instantánea", tip4:"Copiar Resultado", output:"Resultado", aboutTitle:"Acerca de esta Herramienta", aboutText:"Convierte datos CSV a JSON o JSON a CSV al instante, directamente en tu navegador. Nada se sube a un servidor." },
}[lang];
---
<section class="csv-json-converter">
  <div class="csv-layout">
    <aside class="csv-sidebar">

      <CalculatorField id="mode" label={copy.mode} type="select">
        <option value="csvToJson">{copy.csvToJson}</option>
        <option value="jsonToCsv">{copy.jsonToCsv}</option>
      </CalculatorField>

      <CalculatorField id="text" label={copy.input} type="textarea" placeholder={copy.placeholder} />

      <ActionButtons lang={lang} calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} calculateText={copy.calculate} resetText={copy.reset} copyText={copy.copy} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>

    <main class="csv-content">
      <div id="emptyState">
        <EmptyState
          icon="🔄"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={[copy.tip1, copy.tip2, copy.tip3, copy.tip4]}
        />
      </div>

      <div id="resultsContainer" hidden>
        <ResultCard id="outputResult" title={copy.output} icon={FileSpreadsheet} size="lg" />

        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script src="../../scripts/csv-json.ts"></script>

<style>
.csv-json-converter{width:100%;}
.csv-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.csv-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:4px;}
.csv-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.csv-layout{grid-template-columns:1fr;}.csv-sidebar{position:static;}}
</style>

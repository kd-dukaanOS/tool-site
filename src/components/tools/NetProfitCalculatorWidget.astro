{/* src/components/tools/NetProfitCalculatorWidget.astro */}
---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";

import { DollarSign, Percent } from "@lucide/astro";
---

<section class="np-calculator">
  <div class="np-layout">

    <aside class="np-sidebar">
      <CalculatorField
        id="revenue"
        label="Revenue ($)"
        type="number"
        placeholder="e.g. 20000"
        required={true}
        min="0"
        step="0.01"
        helpText="Total sales revenue."
      />

      <CalculatorField
        id="totalExpenses"
        label="Total Expenses ($)"
        type="number"
        placeholder="e.g. 15000"
        required={true}
        min="0"
        step="0.01"
        helpText="All costs: COGS, operating expenses, taxes, interest."
      />

      <CalculatorActions
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
      />

      <div id="errorBox" class="error-box" hidden></div>
    </aside>

    <main class="np-content">
      <div id="emptyState">
        <EmptyState
          icon="💰"
          title="Net Profit Calculator"
          description="Find your net profit and net profit margin from total revenue and total expenses."
          tips={["Net Profit", "Net Margin %"]}
        />
      </div>

      <div id="resultsContainer" hidden>
        <ResultsGrid columns={2}>
          <ResultCard id="netProfitResult" title="Net Profit" icon={DollarSign} accent="success" size="lg" />
          <ResultCard id="netMarginResult" title="Net Profit Margin" icon={Percent} accent="primary" />
        </ResultsGrid>

        <section class="calculator-info">
          <h2>About this Calculator</h2>
          <p>
            Calculates your net profit and net profit margin from total revenue and total expenses,
            covering COGS, operating costs, interest and taxes. All calculations run locally —
            no external data or paid service is required.
          </p>
        </section>
      </div>
    </main>

  </div>
</section>

<script>
  import "../../scripts/net-profit-calculator";
</script>

<style>
.np-calculator{ width:100%; }
.np-layout{ display:grid; grid-template-columns:340px minmax(0,1fr); gap:32px; align-items:start; }
.np-sidebar{ position:sticky; top:24px; display:flex; flex-direction:column; gap:20px; }
.np-content{ display:flex; flex-direction:column; gap:28px; min-width:0; }
.calculator-info{ padding:24px; border:1px solid #E5E7EB; border-radius:18px; background:#FFFFFF; }
.calculator-info h2{ margin:0 0 12px; font-size:1.15rem; font-weight:700; color:#111827; }
.calculator-info p{ margin:0; line-height:1.8; font-size:.95rem; color:#6B7280; }
.error-box{ display:flex; align-items:center; padding:14px 16px; border-radius:14px; background:#FEF2F2; border:1px solid #FCA5A5; color:#B91C1C; font-size:.92rem; font-weight:600; }
:global(.dark) .calculator-info{ background:#111217; border-color:#27272A; }
:global(.dark) .calculator-info h2{ color:#FAFAFA; }
:global(.dark) .calculator-info p{ color:#A1A1AA; }
:global(.dark) .error-box{ background:#2A1111; border-color:#7F1D1D; color:#FECACA; }
@media(max-width:1024px){ .np-layout{ grid-template-columns:1fr; } .np-sidebar{ position:static; } }
@media(max-width:768px){ .np-layout{ gap:24px; } .np-content{ gap:20px; } }
@media(max-width:640px){ .calculator-info{ padding:18px; } }
</style>
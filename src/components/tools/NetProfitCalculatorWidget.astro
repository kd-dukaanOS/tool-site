
---
{/* src/components/tools/NetProfitCalculatorWidget.astro */}
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import CurrencySelector from "../calculator/CurrencySelector.astro";

import { DollarSign, Percent } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { revenue:"Revenue ($)", revenueHelp:"Total sales revenue.", expenses:"Total Expenses ($)", expensesHelp:"All costs: COGS, operating expenses, taxes, interest.", emptyTitle:"Net Profit Calculator", emptyDesc:"Find your net profit and net profit margin from total revenue and total expenses.", tip1:"Net Profit", tip2:"Net Margin %", netProfit:"Net Profit", netMargin:"Net Profit Margin", aboutTitle:"About this Calculator", aboutText:"Calculates your net profit and net profit margin from total revenue and total expenses, covering COGS, operating costs, interest and taxes. All calculations run locally — no external data or paid service is required." },
  es: { revenue:"Ingresos ($)", revenueHelp:"Ingresos totales por ventas.", expenses:"Gastos Totales ($)", expensesHelp:"Todos los costos: COGS, gastos operativos, impuestos, intereses.", emptyTitle:"Calculadora de Utilidad Neta", emptyDesc:"Calcula tu utilidad neta y margen de utilidad neta a partir de tus ingresos y gastos totales.", tip1:"Utilidad Neta", tip2:"Margen Neto %", netProfit:"Utilidad Neta", netMargin:"Margen de Utilidad Neta", aboutTitle:"Acerca de esta Calculadora", aboutText:"Calcula tu utilidad neta y margen de utilidad neta a partir de tus ingresos y gastos totales, cubriendo COGS, costos operativos, intereses e impuestos. Todos los cálculos se ejecutan localmente — no se requiere ningún servicio externo ni de pago." },
}[lang];
---

<section class="np-calculator">
  <div class="np-layout">

    <aside class="np-sidebar">
      <CurrencySelector />

      <CalculatorField
        id="revenue"
        label={copy.revenue}
        type="number"
        placeholder="e.g. 20000"
        required={true}
        min="0"
        step="0.01"
        helpText={copy.revenueHelp}
      />

      <CalculatorField
        id="totalExpenses"
        label={copy.expenses}
        type="number"
        placeholder="e.g. 15000"
        required={true}
        min="0"
        step="0.01"
        helpText={copy.expensesHelp}
      />

      <CalculatorActions lang={lang}
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
      />

      <div id="errorBox" class="error-box" hidden></div>
    </aside>

    <main class="np-content">
      <div id="emptyState">
        <EmptyState
          icon="💰"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={[copy.tip1, copy.tip2]}
        />
      </div>

      <div id="resultsContainer" hidden>
        <ResultsGrid columns={2}>
          <ResultCard id="netProfitResult" title={copy.netProfit} icon={DollarSign} accent="success" size="lg" />
          <ResultCard id="netMarginResult" title={copy.netMargin} icon={Percent} accent="primary" />
        </ResultsGrid>

        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>

  </div>
</section>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/net-profit-calculator";
</script>

<style>
.np-calculator{ width:100%; }
.np-layout{ display:grid; grid-template-columns:340px minmax(0,1fr); gap:32px; align-items:start; }
.np-sidebar{ position:sticky; top:24px; display:flex; flex-direction:column; gap:20px; }
.np-content{ display:flex; flex-direction:column; gap:28px; min-width:0; }
.calculator-info{ padding:24px; border:1px solid var(--border-subtle); border-radius:18px; background:var(--bg-card); }
.calculator-info h2{ margin:0 0 12px; font-size:1.15rem; font-weight:700; color:var(--text-primary); }
.calculator-info p{ margin:0; line-height:1.8; font-size:.95rem; color:var(--text-secondary); }
.error-box{ display:flex; align-items:center; padding:14px 16px; border-radius:14px; background:#FEF2F2; border:1px solid #FCA5A5; color:#B91C1C; font-size:.92rem; font-weight:600; }
:global(.dark) .error-box{ background:#2A1111; border-color:#7F1D1D; color:#FECACA; }
@media(max-width:1024px){ .np-layout{ grid-template-columns:1fr; } .np-sidebar{ position:static; } }
@media(max-width:768px){ .np-layout{ gap:24px; } .np-content{ gap:20px; } }
@media(max-width:640px){ .calculator-info{ padding:18px; } }
</style>
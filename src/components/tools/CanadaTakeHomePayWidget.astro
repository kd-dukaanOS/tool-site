---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Wallet, CalendarDays, Repeat, MinusCircle } from "@lucide/astro";

interface Props {
  lang?: "en" | "es";
}
const { lang = "en" } = Astro.props as Props;

const copy = {
  en: {
    grossIncomeLabel: "Gross Annual Income", grossIncomeHelp: "Your gross salary before deductions (CAD).",
    provinceLabel: "Province", ontario: "Ontario", alberta: "Alberta", britishColumbia: "British Columbia",
    calculate: "Calculate", reset: "Reset", copy: "Copy",
    emptyTitle: "Canada Take-Home Pay Calculator", emptyDesc: "See your net salary after federal tax, provincial tax, CPP and EI.",
    tip1: "Net Annual Pay", tip2: "Federal & Provincial Tax", tip3: "CPP & EI",
    netAnnual: "Net Annual Pay", netMonthly: "Net Monthly", netBiweekly: "Net Biweekly", totalDeductions: "Total Deductions",
    aboutTitle: "About this Calculator",
    aboutText: "Estimates net pay after federal tax, provincial tax, CPP and EI deductions. Results are estimates — verify against current CRA and provincial figures.",
  },
  es: {
    grossIncomeLabel: "Ingreso Bruto Anual", grossIncomeHelp: "Tu salario bruto antes de deducciones (CAD).",
    provinceLabel: "Provincia", ontario: "Ontario", alberta: "Alberta", britishColumbia: "Columbia Británica",
    calculate: "Calcular", reset: "Restablecer", copy: "Copiar",
    emptyTitle: "Calculadora de Sueldo Neto de Canadá", emptyDesc: "Consulta tu salario neto después del impuesto federal, provincial, CPP y EI.",
    tip1: "Pago Neto Anual", tip2: "Impuesto Federal y Provincial", tip3: "CPP y EI",
    netAnnual: "Pago Neto Anual", netMonthly: "Neto Mensual", netBiweekly: "Neto Quincenal", totalDeductions: "Deducciones Totales",
    aboutTitle: "Acerca de esta Calculadora",
    aboutText: "Estima el pago neto después de las deducciones de impuesto federal, provincial, CPP y EI. Los resultados son estimaciones — verifica con las cifras actuales de la CRA y provinciales.",
  },
}[lang];
---
<section class="cats-calculator">
  <div class="cats-layout">
    <aside class="cats-sidebar">
      <CalculatorField id="grossIncome" label={copy.grossIncomeLabel} type="number" required={true} helpText={copy.grossIncomeHelp} />
      <label class="field-label" for="province">{copy.provinceLabel}</label>
      <select id="province" class="field-select">
        <option value="ON">{copy.ontario}</option>
        <option value="AB">{copy.alberta}</option>
        <option value="BC">{copy.britishColumbia}</option>
      </select>
      <CalculatorActions calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} calculateText={copy.calculate} resetText={copy.reset} copyText={copy.copy} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="cats-content">
      <div id="emptyState">
        <EmptyState icon="🍁" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={3}>
          <ResultCard id="netAnnualResult" title={copy.netAnnual} icon={Wallet} subtitle=" " />
          <ResultCard id="netMonthlyResult" title={copy.netMonthly} icon={CalendarDays} />
          <ResultCard id="netBiweeklyResult" title={copy.netBiweekly} icon={Repeat} />
          <ResultCard id="totalDeductionsResult" title={copy.totalDeductions} icon={MinusCircle} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/ca-take-home-pay";
</script>
<style>
.cats-calculator{width:100%;}
.cats-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.cats-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;}
.cats-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.field-label{font-size:.85rem;font-weight:600;color:var(--text-secondary);}
.field-select{width:100%;padding:10px 12px;border-radius:12px;border:1px solid var(--border-subtle);background:var(--bg-card);font-size:.92rem;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.cats-layout{grid-template-columns:1fr;}.cats-sidebar{position:static;}}
@media(max-width:768px){.cats-layout{gap:24px;}.cats-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
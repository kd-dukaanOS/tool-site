---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Target, Wallet, TrendingUp, Flag } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { goalGroup:"Your Goal", targetAmount:"Target Amount", currentSavings:"Current Savings", timeframeGroup:"Timeframe & Rate", years:"Years", months:"Additional Months", annualRate:"Annual Interest Rate (%)", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"Savings Goal Calculator", emptyDesc:"Enter your target, current savings and timeframe to see the monthly amount you need to save.", tip1:"Monthly Savings", tip2:"Total Contributions", tip3:"Interest Earned", monthlySavings:"Monthly Savings Needed", target:"Target Amount", totalContributions:"Total Contributions", interestEarned:"Interest Earned", onTrack:"Already on track!", overMonths:"Over", monthsSuffix:"months", aboutTitle:"About this Calculator", aboutText:"Calculates the monthly savings amount needed to reach a target, factoring in your current savings, timeframe, and expected interest rate on a savings or investment account." },
  es: { goalGroup:"Tu Meta", targetAmount:"Monto Objetivo", currentSavings:"Ahorros Actuales", timeframeGroup:"Plazo y Tasa", years:"Años", months:"Meses Adicionales", annualRate:"Tasa de Interés Anual (%)", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora de Meta de Ahorro", emptyDesc:"Ingresa tu meta, ahorros actuales y plazo para ver el monto mensual que necesitas ahorrar.", tip1:"Ahorro Mensual", tip2:"Aportes Totales", tip3:"Interés Ganado", monthlySavings:"Ahorro Mensual Necesario", target:"Monto Objetivo", totalContributions:"Aportes Totales", interestEarned:"Interés Ganado", onTrack:"¡Ya vas por buen camino!", overMonths:"En", monthsSuffix:"meses", aboutTitle:"Acerca de esta Calculadora", aboutText:"Calcula el monto de ahorro mensual necesario para alcanzar una meta, considerando tus ahorros actuales, el plazo y la tasa de interés esperada en una cuenta de ahorro o inversión." },
}[lang];
---
<section class="sg-calculator">
  <div class="sg-layout">
    <aside class="sg-sidebar">
      <div class="sg-group">
        <h3>{copy.goalGroup}</h3>
        <CalculatorField id="targetAmount" label={copy.targetAmount} type="number" placeholder="e.g. 50000" min="0" step="1" />
        <CalculatorField id="currentSavings" label={copy.currentSavings} type="number" placeholder="e.g. 5000" min="0" step="1" />
      </div>
      <div class="sg-group">
        <h3>{copy.timeframeGroup}</h3>
        <CalculatorField id="timeframeYears" label={copy.years} type="number" placeholder="e.g. 5" min="0" step="1" />
        <CalculatorField id="timeframeMonths" label={copy.months} type="number" placeholder="e.g. 0" min="0" step="1" />
        <CalculatorField id="annualInterestRate" label={copy.annualRate} type="number" placeholder="e.g. 4" min="0" step="0.01" />
      </div>
      <CalculatorActions lang={lang} calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} calculateText={copy.calculate} resetText={copy.reset} copyText={copy.copy} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="sg-content">
      <div id="emptyState">
        <EmptyState icon="🎯" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="monthlySavingsResult" title={copy.monthlySavings} icon={Target} accent="success" subtitle=" " />
          <ResultCard id="targetAmountResult" title={copy.target} icon={Flag} />
          <ResultCard id="totalContributionsResult" title={copy.totalContributions} icon={Wallet} />
          <ResultCard id="interestEarnedResult" title={copy.interestEarned} icon={TrendingUp} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/savings-goal-calculator";
</script>
<style>
.sg-calculator{width:100%;}
.sg-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.sg-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;}
.sg-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.sg-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.sg-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.sg-layout{grid-template-columns:1fr;}.sg-sidebar{position:static;}}
@media(max-width:768px){.sg-layout{gap:24px;}.sg-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
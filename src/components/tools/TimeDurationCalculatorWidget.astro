---
import CalculatorField from "../calculator/CalculatorField.astro";
import ActionButtons from "../calculator/ActionButtons.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import EmptyState from "../calculator/EmptyState.astro";
import { Clock, Hash } from "@lucide/astro";
---

<div class="calculator-widget">
  <div class="calculator-inputs">
    <CalculatorField id="startTime" label="Start Time" type="time" />
    <CalculatorField id="endTime" label="End Time" type="time" />

    <div id="errorBox" class="error-box" role="alert" hidden></div>

    <ActionButtons
      calculateId="calculateBtn"
      resetId="resetBtn"
      copyId="copyBtn"
      showDownload={false}
      showShare={false}
    />
  </div>

  <div class="calculator-output">
    <EmptyState
      id="emptyState"
      title="Enter times to calculate duration"
      description="Duration between the two times will appear here."
    />

    <ResultsGrid id="resultsContainer" hidden>
      <ResultCard id="durationResult" title="Duration" icon={Clock} accent="primary" size="lg" />
      <ResultCard id="totalMinutesResult" title="Total Minutes" icon={Hash} accent="neutral" />
    </ResultsGrid>
  </div>
</div>

<script src="../../scripts/time-duration-calculator.ts"></script>

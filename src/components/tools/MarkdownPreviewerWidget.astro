<div class="tool-panel">
  <div class="tool-grid-2">
    <div>
      <label class="tool-label" for="markdownInput">Markdown Input</label>
      <textarea
        id="markdownInput"
        class="tool-textarea"
        style="height:24rem"
        placeholder="# Heading&#10;&#10;Type **bold**, *italic*, - lists, and more..."
      ></textarea>
    </div>
    <div>
      <label class="tool-label" for="markdownPreview">Live Preview</label>
      <div id="markdownPreview" class="tool-textarea prose prose-sm max-w-none" style="height:24rem;overflow-y:auto"></div>
    </div>
  </div>
</div>

<script>
  function simpleMarkdownToHtml(md: string) {
    let html = md;

    html = html.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

    html = html.replace(/^### (.*$)/gim, '<h3>$1</h3>');
    html = html.replace(/^## (.*$)/gim, '<h2>$1</h2>');
    html = html.replace(/^# (.*$)/gim, '<h1>$1</h1>');

    html = html.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
    html = html.replace(/\*(.*?)\*/g, '<em>$1</em>');

    html = html.replace(/`([^`]+)`/g, '<code class="bg-gray-100 px-1 rounded">$1</code>');

    html = html.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="text-indigo-600 underline">$1</a>');

    html = html.replace(/^\- (.*$)/gim, '<li>$1</li>');
    html = html.replace(/(<li>.*<\/li>)/gims, '<ul class="list-disc pl-5">$1</ul>');

    html = html.split('\n\n').map(block => {
      if (block.match(/^<h[1-3]>|^<ul>/)) return block;
      return block.trim() ? `<p>${block}</p>` : '';
    }).join('');

    return html;
  }

  const input = document.getElementById('markdownInput');
  const preview = document.getElementById('markdownPreview');

  if (input instanceof HTMLTextAreaElement && preview) {
    const update = () => {
      preview.innerHTML = simpleMarkdownToHtml(input.value);
    };
    input.addEventListener('input', update);
    input.value = '# Hello World\n\nThis is **bold** and this is *italic*.\n\n- List item one\n- List item two';
    update();
  }
</script>

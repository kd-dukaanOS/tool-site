---
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { FileText, Heading, Link2, Image as ImageIcon } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { label:"Markdown", emptyTitle:"Markdown Previewer", emptyDesc:"Write Markdown and preview the rendered HTML live.", tip1:"Live Preview", tip2:"Headings, Links, Images", tip3:"Word Count", tip4:"Copy HTML", words:"Words", headings:"Headings", links:"Links", images:"Images", preview:"Preview", aboutTitle:"About this Tool", aboutText:"Write Markdown on the left and see the rendered HTML preview instantly, with word, heading, link and image counts." },
  es: { label:"Markdown", emptyTitle:"Visor de Markdown", emptyDesc:"Escribe Markdown y previsualiza el HTML renderizado en vivo.", tip1:"Vista Previa en Vivo", tip2:"Encabezados, Enlaces, Imágenes", tip3:"Conteo de Palabras", tip4:"Copiar HTML", words:"Palabras", headings:"Encabezados", links:"Enlaces", images:"Imágenes", preview:"Vista Previa", aboutTitle:"Acerca de esta Herramienta", aboutText:"Escribe Markdown a la izquierda y ve la vista previa del HTML renderizado al instante, con conteo de palabras, encabezados, enlaces e imágenes." },
}[lang];
---
<section class="md-previewer">
  <div class="md-layout">
    <aside class="md-sidebar">
      <div class="tool-field">
        <label class="tool-label" for="markdownInput">{copy.label}</label>
        <textarea id="markdownInput" class="tool-textarea" placeholder="# Heading&#10;Type Markdown here..."></textarea>
      </div>
      <CalculatorActions lang={lang} calculateId="renderBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>

    <main class="md-content">
      <div id="emptyState">
        <EmptyState
          icon="📄"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={[copy.tip1, copy.tip2, copy.tip3, copy.tip4]}
        />
      </div>

      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="wordsResult" title={copy.words} icon={FileText} />
          <ResultCard id="headingsResult" title={copy.headings} icon={Heading} />
          <ResultCard id="linksResult" title={copy.links} icon={Link2} />
          <ResultCard id="imagesResult" title={copy.images} icon={ImageIcon} />
        </ResultsGrid>

        <div class="tool-field">
          <label class="tool-label">{copy.preview}</label>
          <div id="markdownPreview" class="markdown-preview"></div>
        </div>

        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/markdown-previewer";
</script>

<style>
.md-previewer{width:100%;}
.md-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.md-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;}
.tool-field{display:flex;flex-direction:column;gap:8px;}
.md-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.markdown-preview{padding:24px;border:1px solid #E5E7EB;border-radius:18px;background:#FFFFFF;line-height:1.7;overflow:auto;max-height:520px;}
.markdown-preview h1,.markdown-preview h2,.markdown-preview h3{margin:0 0 12px;font-weight:700;color:#111827;}
.markdown-preview p{margin:0 0 12px;color:#374151;}
.markdown-preview code{background:#F3F4F6;padding:2px 6px;border-radius:6px;font-size:.85em;}
.markdown-preview pre{background:#111827;color:#F9FAFB;padding:14px;border-radius:10px;overflow:auto;}
.markdown-preview blockquote{border-left:3px solid #D1D5DB;margin:0 0 12px;padding-left:14px;color:#6B7280;}
.calculator-info{padding:24px;border:1px solid #E5E7EB;border-radius:18px;background:#FFFFFF;}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:#111827;}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:#6B7280;}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .markdown-preview,:global(.dark) .calculator-info{background:#111217;border-color:#27272A;}
:global(.dark) .markdown-preview h1,:global(.dark) .markdown-preview h2,:global(.dark) .markdown-preview h3,:global(.dark) .calculator-info h2{color:#FAFAFA;}
:global(.dark) .markdown-preview p,:global(.dark) .calculator-info p{color:#A1A1AA;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.md-layout{grid-template-columns:1fr;}.md-sidebar{position:static;}}
</style>

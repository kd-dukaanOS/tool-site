---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";

import { Scale, Activity, Ruler } from "@lucide/astro";

interface Props {
  lang?: "en" | "es";
}
const { lang = "en" } = Astro.props as Props;

const copy = {
  en: {
    weightLabel: "Weight (kg)", weightHelp: "Enter your weight in kilograms.",
    heightLabel: "Height (cm)", heightHelp: "Enter your height in centimeters.",
    emptyTitle: "BMI Calculator", emptyDesc: "Find out your Body Mass Index and healthy weight range instantly.",
    tips: ["BMI Value & Category", "Healthy Weight Range", "Personalized Insight"],
    yourBMI: "Your BMI", category: "Category", healthyRange: "Healthy Weight Range",
    aboutTitle: "About this Calculator",
    aboutText: "Body Mass Index (BMI) estimates whether your weight is healthy for your height, using the formula BMI = weight (kg) ÷ height (m)². It's a screening tool, not a diagnosis — muscle mass, age, and body composition all affect what a healthy number looks like for you.",
    categoriesTitle: "BMI Categories",
    cats: ["Below 18.5 — Underweight", "18.5 – 24.9 — Normal weight", "25 – 29.9 — Overweight", "30 and above — Obese"],
  },
  es: {
    weightLabel: "Peso (kg)", weightHelp: "Ingresa tu peso en kilogramos.",
    heightLabel: "Estatura (cm)", heightHelp: "Ingresa tu estatura en centímetros.",
    emptyTitle: "Calculadora de IMC", emptyDesc: "Descubre al instante tu Índice de Masa Corporal y tu rango de peso saludable.",
    tips: ["Valor de IMC y Categoría", "Rango de Peso Saludable", "Análisis Personalizado"],
    yourBMI: "Tu IMC", category: "Categoría", healthyRange: "Rango de Peso Saludable",
    aboutTitle: "Acerca de esta Calculadora",
    aboutText: "El Índice de Masa Corporal (IMC) estima si tu peso es saludable para tu estatura, usando la fórmula IMC = peso (kg) ÷ estatura (m)². Es una herramienta de referencia, no un diagnóstico — la masa muscular, la edad y la composición corporal influyen en qué número es saludable para ti.",
    categoriesTitle: "Categorías de IMC",
    cats: ["Menos de 18.5 — Bajo peso", "18.5 – 24.9 — Peso normal", "25 – 29.9 — Sobrepeso", "30 o más — Obesidad"],
  },
}[lang];
---

<section class="bmi-calculator">

  <div class="bmi-layout">

    <!-- Sidebar -->

    <aside class="bmi-sidebar">

      <CalculatorField
        id="weight"
        label={copy.weightLabel}
        type="number"
        placeholder="e.g. 70"
        required={true}
        min="1"
        step="0.1"
        helpText={copy.weightHelp}
      />

      <CalculatorField
        id="height"
        label={copy.heightLabel}
        type="number"
        placeholder="e.g. 175"
        required={true}
        min="1"
        step="0.1"
        helpText={copy.heightHelp}
      />

      <CalculatorActions
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
      />

      <div
        id="errorBox"
        class="error-box"
        hidden
      ></div>

    </aside>

    <!-- Results -->

    <main class="bmi-content">

      <div id="emptyState">

        <EmptyState
          icon="⚖️"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={copy.tips}
        />

      </div>

      <div
        id="resultsContainer"
        hidden
      >

        <ResultsGrid columns={3}>

          <ResultCard
            id="bmiResult"
            title={copy.yourBMI}
            icon={Scale}
            subtitle=" "
          />

          <ResultCard
            id="categoryResult"
            title={copy.category}
            icon={Activity}
          />

          <ResultCard
            id="rangeResult"
            title={copy.healthyRange}
            icon={Ruler}
            size="lg"
          />

        </ResultsGrid>

        <p
          id="insightBox"
          class="insight-box"
          hidden
        ></p>

        <section class="calculator-info">

          <h2>{copy.aboutTitle}</h2>

          <p>{copy.aboutText}</p>

          <h3>{copy.categoriesTitle}</h3>

          <ul>
            {copy.cats.map((c) => <li>{c}</li>)}
          </ul>

        </section>

      </div>

    </main>

  </div>

</section>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/bmi-calculator";
</script>

<style>

.bmi-calculator{

width:100%;

}

.bmi-layout{

display:grid;

grid-template-columns:340px minmax(0,1fr);

gap:32px;

align-items:start;

}

.bmi-sidebar{

position:sticky;

top:24px;

display:flex;

flex-direction:column;

gap:20px;

}

.bmi-content{

display:flex;

flex-direction:column;

gap:28px;

min-width:0;

}

.insight-box{

margin:0;

padding:18px 20px;

border-radius:16px;

background:#EEF2FF;

border:1px solid #C7D2FE;

color:#3730A3;

font-size:.92rem;

font-weight:600;

line-height:1.6;

}

.calculator-info{
padding:24px;
border:1px solid var(--border-subtle);
border-radius:18px;
background:var(--bg-card);
}

.calculator-info h2{
margin:0 0 12px;
font-size:1.15rem;
font-weight:700;
color:var(--text-primary);
}

.calculator-info h3{
margin:20px 0 10px;
font-size:1rem;
font-weight:700;
color:var(--text-primary);
}

.calculator-info p{
margin:0;
line-height:1.8;
font-size:.95rem;
color:var(--text-secondary);
}

.calculator-info ul{
margin:0;
padding-left:20px;
line-height:1.9;
font-size:.92rem;
color:var(--text-secondary);
}
.error-box{

display:flex;

align-items:center;

padding:14px 16px;

border-radius:14px;

background:#FEF2F2;

border:1px solid #FCA5A5;

color:#B91C1C;

font-size:.92rem;

font-weight:600;

}



:global(.dark) .insight-box{

background:#1E1B4B;

border-color:#3730A3;

color:#C7D2FE;

}

:global(.dark) .error-box{

background:#2A1111;

border-color:#7F1D1D;

color:#FECACA;

}

@media(max-width:1024px){

.bmi-layout{

grid-template-columns:1fr;

}

.bmi-sidebar{

position:static;

}

}

@media(max-width:768px){

.bmi-layout{

gap:24px;

}

.bmi-content{

gap:20px;

}

}

@media(max-width:640px){

.calculator-info{

padding:18px;

}

}

</style>

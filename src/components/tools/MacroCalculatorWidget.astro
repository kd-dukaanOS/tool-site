---
import CalculatorField from "../calculator/CalculatorField.astro";
import ActionButtons from "../calculator/ActionButtons.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import EmptyState from "../calculator/EmptyState.astro";
import { Flame, Beef, Wheat, Droplet } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { gender:"Gender", male:"Male", female:"Female", age:"Age", height:"Height (cm)", weight:"Weight (kg)", activity:"Activity Level", sedentary:"Sedentary (little/no exercise)", light:"Light (1-3 days/week)", moderate:"Moderate (3-5 days/week)", active:"Active (6-7 days/week)", veryActive:"Very Active (physical job)", goal:"Goal", lose:"Lose Weight", maintain:"Maintain Weight", gain:"Gain Weight", emptyTitle:"Enter details to calculate macros", emptyDesc:"Your daily calorie and macro targets will appear here.", calories:"Daily Calories", protein:"Protein", carbs:"Carbs", fat:"Fat" },
  es: { gender:"Género", male:"Masculino", female:"Femenino", age:"Edad", height:"Altura (cm)", weight:"Peso (kg)", activity:"Nivel de Actividad", sedentary:"Sedentario (poco o ningún ejercicio)", light:"Ligero (1-3 días/semana)", moderate:"Moderado (3-5 días/semana)", active:"Activo (6-7 días/semana)", veryActive:"Muy Activo (trabajo físico)", goal:"Objetivo", lose:"Perder Peso", maintain:"Mantener Peso", gain:"Ganar Peso", emptyTitle:"Ingresa los datos para calcular macros", emptyDesc:"Tus objetivos diarios de calorías y macros aparecerán aquí.", calories:"Calorías Diarias", protein:"Proteína", carbs:"Carbohidratos", fat:"Grasa" },
}[lang];
---

<div class="calculator-widget">
  <div class="calculator-inputs">
    <div class="field-group">
      <label for="gender">{copy.gender}</label>
      <select id="gender" class="calculator-input">
        <option value="male">{copy.male}</option>
        <option value="female">{copy.female}</option>
      </select>
    </div>

    <CalculatorField id="age" label={copy.age} type="number" placeholder="e.g. 28" />
    <CalculatorField id="heightCm" label={copy.height} type="number" placeholder="e.g. 170" />
    <CalculatorField id="weightKg" label={copy.weight} type="number" placeholder="e.g. 65" />

    <div class="field-group">
      <label for="activityLevel">{copy.activity}</label>
      <select id="activityLevel" class="calculator-input">
        <option value="sedentary">{copy.sedentary}</option>
        <option value="light">{copy.light}</option>
        <option value="moderate" selected>{copy.moderate}</option>
        <option value="active">{copy.active}</option>
        <option value="veryActive">{copy.veryActive}</option>
      </select>
    </div>

    <div class="field-group">
      <label for="goal">{copy.goal}</label>
      <select id="goal" class="calculator-input">
        <option value="lose">{copy.lose}</option>
        <option value="maintain" selected>{copy.maintain}</option>
        <option value="gain">{copy.gain}</option>
      </select>
    </div>

    <div id="errorBox" class="error-box" role="alert" hidden></div>

    <ActionButtons lang={lang} calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showDownload={false} showShare={false} />
  </div>

  <div class="calculator-output">
    <EmptyState id="emptyState" title={copy.emptyTitle} description={copy.emptyDesc} />

    <ResultsGrid id="resultsContainer" hidden>
      <ResultCard id="caloriesResult" title={copy.calories} icon={Flame} accent="primary" size="lg" />
      <ResultCard id="proteinResult" title={copy.protein} icon={Beef} accent="success" />
      <ResultCard id="carbsResult" title={copy.carbs} icon={Wheat} accent="neutral" />
      <ResultCard id="fatResult" title={copy.fat} icon={Droplet} accent="neutral" />
    </ResultsGrid>
  </div>
</div>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script src="../../scripts/macro-calculator.ts"></script>

---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import CurrencySelector from "../calculator/CurrencySelector.astro";

import {
  TrendingUp,
  Wallet,
  Percent,
  TrendingDown
} from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { amount:"Amount", amountHelp:"Today's amount you want to project.", years:"Time Period (Years)", yearsHelp:"Number of years into the future.", rate:"Annual Inflation Rate (%)", rateHelp:"Check your country's long-term average inflation rate.", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"Inflation Calculator", emptyDesc:"See how inflation erodes purchasing power over time.", tip1:"Future Value Needed", tip2:"Purchasing Power Left", tip3:"Total Inflation %", tip4:"Purchasing Power Lost", futureValue:"Future Value Needed", purchasingPower:"Purchasing Power Left", totalInflation:"Total Inflation Over Period", powerLost:"Purchasing Power Lost", aboutTitle:"About this Calculator", aboutText:"Shows two sides of inflation: the future amount you'd need to buy what today's amount buys now, and how much today's amount will actually be worth in real terms after N years of inflation. All calculations run locally with the rate you provide — no external data required." },
  es: { amount:"Monto", amountHelp:"El monto actual que deseas proyectar.", years:"Período de Tiempo (Años)", yearsHelp:"Número de años hacia el futuro.", rate:"Tasa de Inflación Anual (%)", rateHelp:"Verifica la tasa de inflación promedio a largo plazo de tu país.", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora de Inflación", emptyDesc:"Observa cómo la inflación erosiona el poder adquisitivo con el tiempo.", tip1:"Valor Futuro Necesario", tip2:"Poder Adquisitivo Restante", tip3:"Inflación Total %", tip4:"Poder Adquisitivo Perdido", futureValue:"Valor Futuro Necesario", purchasingPower:"Poder Adquisitivo Restante", totalInflation:"Inflación Total en el Período", powerLost:"Poder Adquisitivo Perdido", aboutTitle:"Acerca de esta Calculadora", aboutText:"Muestra dos caras de la inflación: el monto futuro que necesitarías para comprar lo que el monto actual compra hoy, y cuánto valdrá realmente el monto actual en términos reales después de N años de inflación. Todos los cálculos se ejecutan localmente con la tasa que proporciones — no se requieren datos externos." },
}[lang];
---

<section class="inf-calculator">

  <div class="inf-layout">

    <aside class="inf-sidebar">

      <CurrencySelector />

      <CalculatorField
        id="amount"
        label={copy.amount}
        type="number"
        placeholder="e.g. 100000"
        required={true}
        min="0"
        step="1"
        helpText={copy.amountHelp}
      />

      <CalculatorField
        id="years"
        label={copy.years}
        type="number"
        placeholder="e.g. 10"
        required={true}
        min="0"
        step="1"
        helpText={copy.yearsHelp}
      />

      <CalculatorField
        id="annualRate"
        label={copy.rate}
        type="number"
        placeholder="e.g. 6"
        required={true}
        min="0"
        step="0.01"
        helpText={copy.rateHelp}
      />

      <CalculatorActions lang={lang}
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
        calculateText={copy.calculate}
        resetText={copy.reset}
        copyText={copy.copy}
      />

      <div
        id="errorBox"
        class="error-box"
        hidden
      ></div>

    </aside>

    <main class="inf-content">

      <div id="emptyState">

        <EmptyState
          icon="📉"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={[copy.tip1, copy.tip2, copy.tip3, copy.tip4]}
        />

      </div>

      <div
        id="resultsContainer"
        hidden
      >

        <ResultsGrid columns={2}>

          <ResultCard
            id="futureValueResult"
            title={copy.futureValue}
            icon={TrendingUp}
            accent="warning"
          />

          <ResultCard
            id="purchasingPowerResult"
            title={copy.purchasingPower}
            icon={Wallet}
            accent="danger"
          />

          <ResultCard
            id="totalInflationResult"
            title={copy.totalInflation}
            icon={Percent}
          />

          <ResultCard
            id="powerLostResult"
            title={copy.powerLost}
            icon={TrendingDown}
          />

        </ResultsGrid>

        <section class="calculator-info">

          <h2>{copy.aboutTitle}</h2>

          <p>{copy.aboutText}</p>

        </section>

      </div>

    </main>

  </div>

</section>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/inflation-calculator";
</script>

<style>

.inf-calculator{

width:100%;

}

.inf-layout{

display:grid;

grid-template-columns:340px minmax(0,1fr);

gap:32px;

align-items:start;

}

.inf-sidebar{

position:sticky;

top:24px;

display:flex;

flex-direction:column;

gap:20px;

}

.inf-content{

display:flex;

flex-direction:column;

gap:28px;

min-width:0;

}

.calculator-info{

padding:24px;

border:1px solid var(--border-subtle);

border-radius:18px;

background:var(--bg-card);

}

.calculator-info h2{

margin:0 0 12px;

font-size:1.15rem;

font-weight:700;

color:var(--text-primary);

}

.calculator-info p{

margin:0;

line-height:1.8;

font-size:.95rem;

color:var(--text-secondary);

}

.error-box{

display:flex;

align-items:center;

padding:14px 16px;

border-radius:14px;

background:#FEF2F2;

border:1px solid #FCA5A5;

color:#B91C1C;

font-size:.92rem;

font-weight:600;

}



:global(.dark) .error-box{

background:#2A1111;

border-color:#7F1D1D;

color:#FECACA;

}

@media(max-width:1024px){

.inf-layout{

grid-template-columns:1fr;

}

.inf-sidebar{

position:static;

}

}

@media(max-width:768px){

.inf-layout{

gap:24px;

}

.inf-content{

gap:20px;

}

}

@media(max-width:640px){

.calculator-info{

padding:18px;

}

}

</style>

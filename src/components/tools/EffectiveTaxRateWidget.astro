---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Percent, TrendingUp, Receipt, Wallet } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { incomeGroup:"Income & Filing", grossIncome:"Gross Annual Income", filingStatus:"Filing Status", single:"Single", mfj:"Married Filing Jointly", hoh:"Head of Household", deductionsGroup:"Deductions", deductionType:"Deduction Type", standardDeduction:"Standard Deduction (2026)", itemizedDeduction:"Itemized Deduction", itemizedAmt:"Itemized Deductions (if selected)", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"Effective Tax Rate Calculator", emptyDesc:"See your true average federal tax rate using 2026 IRS brackets.", tip1:"Effective Rate", tip2:"Marginal Bracket", tip3:"After-Tax Income", effectiveRate:"Effective Tax Rate", marginalRate:"Marginal Bracket", totalTax:"Total Federal Tax", afterTax:"After-Tax Income", aboutTitle:"About this Calculator", aboutText:"Uses official 2026 IRS tax brackets and standard deductions to compute your true effective tax rate versus your marginal bracket.", onTaxable:(t:string)=>`On ${t} taxable income` },
  es: { incomeGroup:"Ingresos y Estado Civil", grossIncome:"Ingreso Bruto Anual", filingStatus:"Estado Civil Tributario", single:"Soltero", mfj:"Casado Declarando Conjuntamente", hoh:"Cabeza de Familia", deductionsGroup:"Deducciones", deductionType:"Tipo de Deducción", standardDeduction:"Deducción Estándar (2026)", itemizedDeduction:"Deducción Detallada", itemizedAmt:"Deducciones Detalladas (si aplica)", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora de Tasa Efectiva de Impuestos", emptyDesc:"Consulta tu tasa promedio real de impuesto federal usando los tramos del IRS 2026.", tip1:"Tasa Efectiva", tip2:"Tramo Marginal", tip3:"Ingreso Después de Impuestos", effectiveRate:"Tasa Efectiva de Impuesto", marginalRate:"Tramo Marginal", totalTax:"Impuesto Federal Total", afterTax:"Ingreso Después de Impuestos", aboutTitle:"Acerca de esta Calculadora", aboutText:"Usa los tramos fiscales oficiales del IRS 2026 y las deducciones estándar para calcular tu tasa efectiva de impuesto real frente a tu tramo marginal.", onTaxable:(t:string)=>`Sobre ${t} de ingreso gravable` },
}[lang];
---
<section class="etr-calculator">
  <div class="etr-layout">
    <aside class="etr-sidebar">
      <div class="etr-group">
        <h3>{copy.incomeGroup}</h3>
        <CalculatorField id="grossIncome" label={copy.grossIncome} type="number" placeholder="e.g. 100000" min="0" step="1" />
        <CalculatorField type="select" id="filingStatus" label={copy.filingStatus}>
  <option value="single">{copy.single}</option>
  <option value="mfj">{copy.mfj}</option>
  <option value="hoh">{copy.hoh}</option>
</CalculatorField>
      </div>
      <div class="etr-group">
        <h3>{copy.deductionsGroup}</h3>
        <CalculatorField type="select" id="deductionType" label={copy.deductionType}>
  <option value="standard">{copy.standardDeduction}</option>
  <option value="itemized">{copy.itemizedDeduction}</option>
</CalculatorField>
        <CalculatorField id="itemizedDeductions" label={copy.itemizedAmt} type="number" placeholder="e.g. 20000" min="0" step="1" />
      </div>
      <CalculatorActions lang={lang} calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} calculateText={copy.calculate} resetText={copy.reset} copyText={copy.copy} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="etr-content">
      <div id="emptyState">
        <EmptyState icon="📈" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="effectiveRateResult" title={copy.effectiveRate} icon={Percent} accent="success" />
          <ResultCard id="marginalRateResult" title={copy.marginalRate} icon={TrendingUp} />
          <ResultCard id="totalTaxResult" title={copy.totalTax} icon={Receipt} subtitle=" " />
          <ResultCard id="afterTaxResult" title={copy.afterTax} icon={Wallet} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/effective-tax-rate-calculator";
</script>
<style>
.etr-calculator{width:100%;}
.etr-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.etr-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.etr-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.etr-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.etr-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.etr-layout{grid-template-columns:1fr;}.etr-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.etr-layout{gap:24px;}.etr-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
---
{/* src/components/tools/QuarterlyEstimatedTaxCalculatorWidget.astro */}
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";

import { CalendarClock, Landmark, Receipt, Percent } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { seIncome:"Self-Employment Income ($)", seIncomeHelp:"Expected net self-employment earnings for the year.", otherIncome:"Other Income ($)", otherIncomeHelp:"W-2 wages or other taxable income, if any.", filingStatus:"Filing Status", single:"Single", marriedJointly:"Married Filing Jointly", marriedSeparately:"Married Filing Separately", headOfHousehold:"Head of Household", taxYear:"Tax Year", deduction:"Deduction", standardDeduction:"Standard Deduction", itemizedDeduction:"Itemized Deduction", itemizedAmount:"Itemized Deduction ($)", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"Quarterly Estimated Tax Calculator", emptyDesc:"Estimate your quarterly tax payment by combining federal income tax and self-employment tax.", tip1:"Quarterly Payment", tip2:"Total Annual Tax", quarterlyPayment:"Quarterly Payment", totalAnnualTax:"Total Annual Tax", seTax:"Self-Employment Tax", federalIncomeTax:"Federal Income Tax", effectiveRate:"Effective Rate", aboutTitle:"About this Calculator", aboutText:"Combines federal income tax and self-employment tax on your expected annual income to estimate what to send the IRS each quarter. Uses current 2025/2026 brackets, the self-employment tax deduction, and your chosen deduction type. Does not include state tax." },
  es: { seIncome:"Ingreso por Trabajo Independiente ($)", seIncomeHelp:"Ingresos netos esperados por trabajo independiente para el año.", otherIncome:"Otros Ingresos ($)", otherIncomeHelp:"Salarios W-2 u otros ingresos gravables, si los hay.", filingStatus:"Estado Civil Tributario", single:"Soltero", marriedJointly:"Casado Declarando en Conjunto", marriedSeparately:"Casado Declarando por Separado", headOfHousehold:"Cabeza de Familia", taxYear:"Año Fiscal", deduction:"Deducción", standardDeduction:"Deducción Estándar", itemizedDeduction:"Deducción Detallada", itemizedAmount:"Deducción Detallada ($)", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora de Impuesto Estimado Trimestral", emptyDesc:"Estima tu pago de impuesto trimestral combinando el impuesto federal y el impuesto por trabajo independiente.", tip1:"Pago Trimestral", tip2:"Impuesto Anual Total", quarterlyPayment:"Pago Trimestral", totalAnnualTax:"Impuesto Anual Total", seTax:"Impuesto por Trabajo Independiente", federalIncomeTax:"Impuesto Federal sobre la Renta", effectiveRate:"Tasa Efectiva", aboutTitle:"Acerca de esta Calculadora", aboutText:"Combina el impuesto federal sobre la renta y el impuesto por trabajo independiente sobre tu ingreso anual esperado para estimar lo que debes enviar al IRS cada trimestre. Usa los tramos actuales de 2025/2026, la deducción del impuesto por trabajo independiente, y el tipo de deducción que elijas. No incluye impuesto estatal." },
}[lang];
---

<section class="qet-calculator">
  <div class="qet-layout">

    <aside class="qet-sidebar">
      <CalculatorField
        id="selfEmploymentIncome"
        label={copy.seIncome}
        type="number"
        placeholder="e.g. 60000"
        min="0"
        step="0.01"
        helpText={copy.seIncomeHelp}
      />

      <CalculatorField
        id="otherIncome"
        label={copy.otherIncome}
        type="number"
        placeholder="e.g. 0"
        min="0"
        step="0.01"
        helpText={copy.otherIncomeHelp}
      />

      <CalculatorField
        id="filingStatus"
        label={copy.filingStatus}
        type="select"
        required={true}
      >
        <option value="single">{copy.single}</option>
        <option value="marriedJointly">{copy.marriedJointly}</option>
        <option value="marriedSeparately">{copy.marriedSeparately}</option>
        <option value="headOfHousehold">{copy.headOfHousehold}</option>
      </CalculatorField>

      <CalculatorField
        id="taxYear"
        label={copy.taxYear}
        type="select"
        required={true}
      >
        <option value="2026">2026</option>
        <option value="2025">2025</option>
      </CalculatorField>

      <CalculatorField
        id="deductionMode"
        label={copy.deduction}
        type="select"
        required={true}
      >
        <option value="standard">{copy.standardDeduction}</option>
        <option value="itemized">{copy.itemizedDeduction}</option>
      </CalculatorField>

      <div id="itemizedRow" hidden>
        <CalculatorField
          id="itemizedDeduction"
          label={copy.itemizedAmount}
          type="number"
          placeholder="e.g. 18000"
          min="0"
          step="0.01"
        />
      </div>

      <CalculatorActions lang={lang}
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
        calculateText={copy.calculate}
        resetText={copy.reset}
        copyText={copy.copy}
      />

      <div id="errorBox" class="error-box" hidden></div>
    </aside>

    <main class="qet-content">
      <div id="emptyState">
        <EmptyState
          icon="📅"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={[copy.tip1, copy.tip2]}
        />
      </div>

      <div id="resultsContainer" hidden>
        <ResultsGrid columns={2}>
          <ResultCard id="quarterlyPaymentResult" title={copy.quarterlyPayment} icon={CalendarClock} accent="primary" size="lg" />
          <ResultCard id="totalAnnualTaxResult" title={copy.totalAnnualTax} icon={Landmark} accent="neutral" size="lg" />
          <ResultCard id="seTaxResult" title={copy.seTax} icon={Receipt} accent="neutral" />
          <ResultCard id="federalIncomeTaxResult" title={copy.federalIncomeTax} icon={Receipt} accent="neutral" />
          <ResultCard id="effectiveRateResult" title={copy.effectiveRate} icon={Percent} accent="primary" />
        </ResultsGrid>

        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>

  </div>
</section>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/quarterly-estimated-tax-calculator";
</script>

<style>
.qet-calculator{ width:100%; }
.qet-layout{ display:grid; grid-template-columns:340px minmax(0,1fr); gap:32px; align-items:start; }
.qet-sidebar{ position:sticky; top:24px; display:flex; flex-direction:column; gap:20px; }
.qet-content{ display:flex; flex-direction:column; gap:28px; min-width:0; }
.calculator-info{ padding:24px; border:1px solid var(--border-subtle); border-radius:18px; background:var(--bg-card); }
.calculator-info h2{ margin:0 0 12px; font-size:1.15rem; font-weight:700; color:var(--text-primary); }
.calculator-info p{ margin:0; line-height:1.8; font-size:.95rem; color:var(--text-secondary); }
.error-box{ display:flex; align-items:center; padding:14px 16px; border-radius:14px; background:#FEF2F2; border:1px solid #FCA5A5; color:#B91C1C; font-size:.92rem; font-weight:600; }
:global(.dark) .error-box{ background:#2A1111; border-color:#7F1D1D; color:#FECACA; }
@media(max-width:1024px){ .qet-layout{ grid-template-columns:1fr; } .qet-sidebar{ position:static; } }
@media(max-width:768px){ .qet-layout{ gap:24px; } .qet-content{ gap:20px; } }
@media(max-width:640px){ .calculator-info{ padding:18px; } }
</style>
---
import CalculatorField from "../calculator/CalculatorField.astro";
import ActionButtons from "../calculator/ActionButtons.astro";
import ResultCard from "../calculator/ResultCard.astro";
import EmptyState from "../calculator/EmptyState.astro";
import { Thermometer } from "@lucide/astro";
---

<div class="calculator-widget">
  <div class="calculator-form">
    <CalculatorField id="value" label="Value" type="number" placeholder="Enter value" />

    <CalculatorField id="fromUnit" label="From" type="select">
      <option value="c" selected>Celsius</option>
      <option value="f">Fahrenheit</option>
      <option value="k">Kelvin</option>
    </CalculatorField>

    <CalculatorField id="toUnit" label="To" type="select">
      <option value="c">Celsius</option>
      <option value="f" selected>Fahrenheit</option>
      <option value="k">Kelvin</option>
    </CalculatorField>

    <div id="errorBox" class="error-box" hidden></div>

    <ActionButtons calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" />
  </div>

  <div class="calculator-results">
    <div id="emptyState">
      <EmptyState icon="??" title="Temperature Converter" description="Enter a value to convert." />
    </div>

    <div id="resultsContainer" hidden>
      <ResultCard id="convertedResult" title="Converted Value" icon={Thermometer} />
    </div>
  </div>
</div>

<script src="../../scripts/temperature-calculator.ts"></script>

---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Wallet, CheckCircle2, TrendingUp, Percent } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { filingGroup:"Filing Info", taxYear:"Tax Year", y2025:"2025 (filed 2026)", y2026:"2026 (filed 2027)", filingStatus:"Filing Status", single:"Single", hoh:"Head of Household", mfj:"Married Filing Jointly", mfs:"Married Filing Separately", widowed:"Qualifying Widow(er)", qualifyingChildren:"Qualifying Children", incomeGroup:"Income", earnedIncome:"Earned Income", agi:"Adjusted Gross Income (AGI)", investmentIncome:"Investment Income", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"EITC Calculator", emptyDesc:"Estimate your Earned Income Tax Credit for 2025 or 2026.", tip1:"Estimated Credit", tip2:"Eligibility", tip3:"Max Credit for Family Size", estimatedEitc:"Estimated EITC", eligibility:"Eligibility", maxCredit:"Max Credit for Family Size", phaseoutRate:"Phase-Out Rate", aboutTitle:"About this Calculator", aboutText:"Estimates your federal Earned Income Tax Credit using current IRS phase-in, plateau, and phase-out figures based on your income, filing status, and number of qualifying children." },
  es: { filingGroup:"Información de Declaración", taxYear:"Año Fiscal", y2025:"2025 (declarado 2026)", y2026:"2026 (declarado 2027)", filingStatus:"Estado Civil Tributario", single:"Soltero", hoh:"Cabeza de Familia", mfj:"Casado Declarando Conjuntamente", mfs:"Casado Declarando por Separado", widowed:"Viudo(a) Calificado(a)", qualifyingChildren:"Hijos Calificados", incomeGroup:"Ingresos", earnedIncome:"Ingreso Ganado", agi:"Ingreso Bruto Ajustado (AGI)", investmentIncome:"Ingreso de Inversión", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora EITC", emptyDesc:"Estima tu Crédito Tributario por Ingreso del Trabajo para 2025 o 2026.", tip1:"Crédito Estimado", tip2:"Elegibilidad", tip3:"Crédito Máximo por Tamaño Familiar", estimatedEitc:"EITC Estimado", eligibility:"Elegibilidad", maxCredit:"Crédito Máximo por Tamaño Familiar", phaseoutRate:"Tasa de Reducción", aboutTitle:"Acerca de esta Calculadora", aboutText:"Estima tu Crédito Tributario Federal por Ingreso del Trabajo usando las cifras actuales del IRS de fase de entrada, meseta y reducción, según tu ingreso, estado civil tributario y número de hijos calificados." },
}[lang];
---
<section class="eitc-calculator">
  <div class="eitc-layout">
    <aside class="eitc-sidebar">
      <div class="eitc-group">
        <h3>{copy.filingGroup}</h3>
        <CalculatorField type="select" id="taxYear" label={copy.taxYear}>
  <option value="2025">{copy.y2025}</option>
  <option value="2026">{copy.y2026}</option>
</CalculatorField>
        <CalculatorField type="select" id="filingStatus" label={copy.filingStatus}>
  <option value="single">{copy.single}</option>
  <option value="hoh">{copy.hoh}</option>
  <option value="mfj">{copy.mfj}</option>
  <option value="mfs">{copy.mfs}</option>
  <option value="widowed">{copy.widowed}</option>
</CalculatorField>
        <CalculatorField id="qualifyingChildren" label={copy.qualifyingChildren} type="number" placeholder="e.g. 1" min="0" max="3" step="1" />
      </div>
      <div class="eitc-group">
        <h3>{copy.incomeGroup}</h3>
        <CalculatorField id="earnedIncome" label={copy.earnedIncome} type="number" placeholder="e.g. 20000" min="0" step="1" />
        <CalculatorField id="agi" label={copy.agi} type="number" placeholder="e.g. 20000" min="0" step="1" />
        <CalculatorField id="investmentIncome" label={copy.investmentIncome} type="number" placeholder="e.g. 0" min="0" step="1" />
      </div>
      <CalculatorActions calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} calculateText={copy.calculate} resetText={copy.reset} copyText={copy.copy} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="eitc-content">
      <div id="emptyState">
        <EmptyState icon="💰" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="eitcResult" title={copy.estimatedEitc} icon={Wallet} accent="success" subtitle=" " />
          <ResultCard id="eligibleResult" title={copy.eligibility} icon={CheckCircle2} subtitle=" " />
          <ResultCard id="maxCreditResult" title={copy.maxCredit} icon={TrendingUp} />
          <ResultCard id="phaseoutRateResult" title={copy.phaseoutRate} icon={Percent} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/eitc-calculator";
</script>
<style>
.eitc-calculator{width:100%;}
.eitc-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.eitc-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.eitc-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.eitc-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.eitc-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.eitc-layout{grid-template-columns:1fr;}.eitc-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.eitc-layout{gap:24px;}.eitc-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>

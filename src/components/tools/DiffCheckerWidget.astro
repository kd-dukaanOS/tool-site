---
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";

import {
  GitCompare,
  Plus,
  Minus,
  Equal,
  Percent
} from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { originalText:"Original Text", changedText:"Changed Text", originalPlaceholder:"Paste original text...", changedPlaceholder:"Paste changed text...", calculate:"Compare", reset:"Reset", copy:"Copy", emptyTitle:"Diff Checker", emptyDesc:"Compare two blocks of text line by line.", tip1:"Line-by-Line Diff", tip2:"Added & Removed Lines", tip3:"Similarity Score", tip4:"Copy Summary", added:"Lines Added", removed:"Lines Removed", unchanged:"Unchanged", similarity:"Similarity", diffResultTitle:"Diff Result", aboutTitle:"About this Tool", aboutText:"The Diff Checker compares two blocks of text and highlights lines that were added, removed or left unchanged, along with an overall similarity score." },
  es: { originalText:"Texto Original", changedText:"Texto Modificado", originalPlaceholder:"Pega el texto original...", changedPlaceholder:"Pega el texto modificado...", calculate:"Comparar", reset:"Restablecer", copy:"Copiar", emptyTitle:"Comparador de Diferencias", emptyDesc:"Compara dos bloques de texto línea por línea.", tip1:"Diferencia Línea por Línea", tip2:"Líneas Agregadas y Eliminadas", tip3:"Puntaje de Similitud", tip4:"Copiar Resumen", added:"Líneas Agregadas", removed:"Líneas Eliminadas", unchanged:"Sin Cambios", similarity:"Similitud", diffResultTitle:"Resultado de la Comparación", aboutTitle:"Acerca de esta Herramienta", aboutText:"El Comparador de Diferencias compara dos bloques de texto y resalta las líneas agregadas, eliminadas o sin cambios, junto con un puntaje de similitud general." },
}[lang];
---

<section class="diff-checker">

  <div class="diff-layout">

    <!-- Sidebar -->

    <aside class="diff-sidebar">

      <div class="tool-field">
        <label class="tool-label" for="diffInput1">{copy.originalText}</label>
        <textarea
          id="diffInput1"
          class="tool-textarea"
          placeholder={copy.originalPlaceholder}
        ></textarea>
      </div>

      <div class="tool-field">
        <label class="tool-label" for="diffInput2">{copy.changedText}</label>
        <textarea
          id="diffInput2"
          class="tool-textarea"
          placeholder={copy.changedPlaceholder}
        ></textarea>
      </div>

      <CalculatorActions lang={lang}
        calculateId="compareBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
        calculateText={copy.calculate}
        resetText={copy.reset}
        copyText={copy.copy}
      />

      <div
        id="errorBox"
        class="error-box"
        hidden
      ></div>

    </aside>

    <!-- Results -->

    <main class="diff-content">

      <div id="emptyState">

        <EmptyState
          icon="🔍"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={[
            copy.tip1,
            copy.tip2,
            copy.tip3,
            copy.tip4
          ]}
        />

      </div>

      <div
        id="resultsContainer"
        hidden
      >

        <ResultsGrid columns={4}>

          <ResultCard
            id="addedResult"
            title={copy.added}
            icon={Plus}
          />

          <ResultCard
            id="removedResult"
            title={copy.removed}
            icon={Minus}
          />

          <ResultCard
            id="unchangedResult"
            title={copy.unchanged}
            icon={Equal}
          />

          <ResultCard
            id="similarityResult"
            title={copy.similarity}
            icon={Percent}
          />

        </ResultsGrid>

        <section class="diff-output-section">

          <h2><GitCompare size={18} /> {copy.diffResultTitle}</h2>

          <div id="diffOutput" class="diff-output"></div>

        </section>

        <section class="calculator-info">

          <h2>{copy.aboutTitle}</h2>

          <p>
            {copy.aboutText}
          </p>

        </section>

      </div>

    </main>

  </div>

</section>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/diff-checker-script";
</script>

<style>

.diff-checker{
width:100%;
}

.diff-layout{
display:grid;
grid-template-columns:340px minmax(0,1fr);
gap:32px;
align-items:start;
}

.diff-sidebar{
position:sticky;
top:24px;
display:flex;
flex-direction:column;
gap:20px;
}

.tool-field{
display:flex;
flex-direction:column;
gap:8px;
}

.diff-content{
display:flex;
flex-direction:column;
gap:28px;
min-width:0;
}

:global(.diff-same){
display:block;
color:var(--text-secondary);
}

.calculator-info{
padding:24px;
border:1px solid var(--border-subtle);
border-radius:18px;
background:var(--bg-card);
}

.calculator-info h2{
margin:0 0 12px;
font-size:1.15rem;
font-weight:700;
color:var(--text-primary);
}

.calculator-info p{
margin:0;
line-height:1.8;
font-size:.95rem;
color:var(--text-secondary);
}

.diff-output{
white-space:pre-wrap;
font-family:ui-monospace,monospace;
font-size:.85rem;
line-height:1.6;
max-height:480px;
overflow:auto;
}

:global(.diff-added){
display:block;
background:#DCFCE7;
color:#166534;
}

:global(.diff-removed){
display:block;
background:#FEE2E2;
color:#991B1B;
}

:global(.diff-same){
display:block;
color:var(--text-secondary);
}

.calculator-info{
padding:24px;
border:1px solid var(--border-subtle);
border-radius:18px;
background:var(--bg-card);
}

.calculator-info h2{
margin:0 0 12px;
font-size:1.15rem;
font-weight:700;
color:var(--text-primary);
}

.calculator-info p{
margin:0;
line-height:1.8;
font-size:.95rem;
color:var(--text-secondary);
}

.error-box{
display:flex;
align-items:center;
padding:14px 16px;
border-radius:14px;
background:#FEF2F2;
border:1px solid #FCA5A5;
color:#B91C1C;
font-size:.92rem;
font-weight:600;
}

:global(.dark) .error-box{
background:#2A1111;
border-color:#7F1D1D;
color:#FECACA;
}

@media(max-width:1024px){

.diff-layout{
grid-template-columns:1fr;
}

.diff-sidebar{
position:static;
}

}

@media(max-width:768px){

.diff-layout{
gap:24px;
}

.diff-content{
gap:20px;
}

}

@media(max-width:640px){

.diff-output-section,
.calculator-info{
padding:18px;
}

}

</style>

---
---

<div class="tool-panel">
  <div class="tool-grid-2">
    <div>
      <label class="tool-label" for="diffInput1">Original Text</label>
      <textarea id="diffInput1" class="tool-textarea" placeholder="Paste original text..."></textarea>
    </div>
    <div>
      <label class="tool-label" for="diffInput2">Changed Text</label>
      <textarea id="diffInput2" class="tool-textarea" placeholder="Paste changed text..."></textarea>
    </div>
  </div>

  <div class="tool-actions">
    <button id="compareBtn" class="tool-btn tool-btn-primary">Compare</button>
  </div>

  <div class="mt-6">
    <label class="tool-label" for="diffResult">Result</label>
    <div id="diffResult" class="tool-textarea" style="height:auto;min-height:100px;white-space:pre-wrap"></div>
  </div>
</div>

<script>
  // @ts-nocheck
  const input1 = document.getElementById('diffInput1');
  const input2 = document.getElementById('diffInput2');
  const result = document.getElementById('diffResult');
  const compareBtn = document.getElementById('compareBtn');

  function escapeHtml(str) {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  compareBtn?.addEventListener('click', () => {
    const lines1 = input1.value.split('\n');
    const lines2 = input2.value.split('\n');
    const maxLines = Math.max(lines1.length, lines2.length);
    let output = '';

    for (let i = 0; i < maxLines; i++) {
      const l1 = lines1[i] ?? '';
      const l2 = lines2[i] ?? '';

      if (l1 === l2) {
        output += `  ${escapeHtml(l1)}\n`;
      } else {
        if (l1) output += `<span class="bg-red-100 text-red-700">- ${escapeHtml(l1)}</span>\n`;
        if (l2) output += `<span class="bg-green-100 text-green-700">+ ${escapeHtml(l2)}</span>\n`;
      }
    }

    result.innerHTML = output || 'No differences found — texts are identical.';
  });
</script>

---
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import EmptyState from "../calculator/EmptyState.astro";
import { Link, ArrowRightLeft, Ruler, Plus } from "@lucide/astro";
---
<section class="url-encoder">
  <div class="url-layout">
    <aside class="url-sidebar">
      <div class="tool-field">
        <label class="tool-label" for="urlInput">Text or URL</label>
        <textarea id="urlInput" class="tool-textarea" placeholder="https://example.com/?q=hello world"></textarea>
      </div>

      <div class="tool-checkbox-field">
        <input id="urlComponent" type="checkbox" checked />
        <label for="urlComponent">Encode/decode as URI component (recommended)</label>
      </div>

      <div class="tool-actions">
        <button id="encodeBtn" class="tool-btn tool-btn-primary"><ArrowRightLeft size={16} /> Encode</button>
        <button id="decodeBtn" class="tool-btn tool-btn-secondary">Decode</button>
      </div>

      <div class="tool-actions">
        <button id="resetBtn" class="tool-btn tool-btn-secondary">Reset</button>
        <button id="copyBtn" class="tool-btn tool-btn-secondary">Copy</button>
      </div>

      <div id="errorBox" class="error-box" hidden></div>
    </aside>

    <main class="url-content">
      <div id="emptyState">
        <EmptyState
          icon="🔗"
          title="URL Encoder / Decoder"
          description="Encode or decode URLs and text for safe transmission."
          tips={["Encode", "Decode", "Component or Full URI", "Copy Result"]}
        />
      </div>

      <div id="resultsContainer" hidden>
        <div class="tool-field">
          <label class="tool-label" for="urlOutput">Output</label>
          <textarea id="urlOutput" class="tool-textarea" readonly></textarea>
        </div>

        <ResultsGrid columns={3}>
          <ResultCard id="inputLengthResult" title="Input Length" icon={Ruler} />
          <ResultCard id="outputLengthResult" title="Output Length" icon={Link} />
          <ResultCard id="diffResult" title="Length Diff" icon={Plus} />
        </ResultsGrid>

        <section class="calculator-info">
          <h2>About this Tool</h2>
          <p>Encode text and URLs for safe transmission in query strings, or decode percent-encoded URLs back to readable text.</p>
        </section>
      </div>
    </main>
  </div>
</section>

<script>
  import "../../scripts/url-encoder-decoder";
</script>

<style>
.url-encoder{width:100%;}
.url-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.url-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:16px;}
.tool-field{display:flex;flex-direction:column;gap:8px;}
.tool-checkbox-field{display:flex;align-items:center;gap:8px;font-size:.9rem;color:#374151;}
.url-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
:global(.dark) .tool-checkbox-field{color:#A1A1AA;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.url-layout{grid-template-columns:1fr;}.url-sidebar{position:static;}}
</style>

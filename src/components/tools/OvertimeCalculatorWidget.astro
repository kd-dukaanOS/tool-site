
---
{/* src/components/tools/OvertimeCalculatorWidget.astro */}
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";

import { Wallet, Clock, TrendingUp, Zap } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { hourlyRate:"Hourly Rate ($)", hourlyRateHelp:"Your regular pay per hour.", regularHours:"Regular Hours", regularHoursHelp:"Hours worked at your regular rate.", overtimeHours:"Overtime Hours", overtimeHoursHelp:"Hours worked beyond regular hours.", overtimeMultiplier:"Overtime Multiplier", overtimeMultiplierHelp:"Common rates: 1.5x (time-and-a-half), 2x (double time).", emptyTitle:"Overtime Calculator", emptyDesc:"Find your total pay including overtime, and see your effective overtime rate.", tip1:"Total Pay", tip2:"Regular Pay", tip3:"Overtime Pay", tip4:"Overtime Rate", totalPay:"Total Pay", regularPay:"Regular Pay", overtimePay:"Overtime Pay", effectiveRate:"Overtime Rate", aboutTitle:"About this Calculator", aboutText:"Calculates your total pay including overtime, using your hourly rate, regular hours, overtime hours and overtime multiplier. All calculations run locally — no external data or paid service is required." },
  es: { hourlyRate:"Tarifa por Hora ($)", hourlyRateHelp:"Tu pago regular por hora.", regularHours:"Horas Regulares", regularHoursHelp:"Horas trabajadas a tu tarifa regular.", overtimeHours:"Horas Extra", overtimeHoursHelp:"Horas trabajadas más allá de las horas regulares.", overtimeMultiplier:"Multiplicador de Horas Extra", overtimeMultiplierHelp:"Tarifas comunes: 1.5x (tiempo y medio), 2x (tiempo doble).", emptyTitle:"Calculadora de Horas Extra", emptyDesc:"Calcula tu pago total incluyendo horas extra, y ve tu tarifa efectiva de horas extra.", tip1:"Pago Total", tip2:"Pago Regular", tip3:"Pago de Horas Extra", tip4:"Tarifa de Horas Extra", totalPay:"Pago Total", regularPay:"Pago Regular", overtimePay:"Pago de Horas Extra", effectiveRate:"Tarifa de Horas Extra", aboutTitle:"Acerca de esta Calculadora", aboutText:"Calcula tu pago total incluyendo horas extra, usando tu tarifa por hora, horas regulares, horas extra y multiplicador de horas extra. Todos los cálculos se ejecutan localmente — no se requiere ningún servicio externo ni de pago." },
}[lang];
---

<section class="ot-calculator">
  <div class="ot-layout">

    <aside class="ot-sidebar">
      <CalculatorField
        id="hourlyRate"
        label={copy.hourlyRate}
        type="number"
        placeholder="e.g. 20"
        required={true}
        min="0"
        step="0.01"
        helpText={copy.hourlyRateHelp}
      />

      <CalculatorField
        id="regularHours"
        label={copy.regularHours}
        type="number"
        placeholder="e.g. 40"
        required={true}
        min="0"
        step="0.5"
        helpText={copy.regularHoursHelp}
      />

      <CalculatorField
        id="overtimeHours"
        label={copy.overtimeHours}
        type="number"
        placeholder="e.g. 5"
        required={true}
        min="0"
        step="0.5"
        helpText={copy.overtimeHoursHelp}
      />

      <CalculatorField
        id="overtimeMultiplier"
        label={copy.overtimeMultiplier}
        type="number"
        placeholder="e.g. 1.5"
        required={true}
        min="1.01"
        step="0.1"
        helpText={copy.overtimeMultiplierHelp}
      />

      <CalculatorActions
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
      />

      <div id="errorBox" class="error-box" hidden></div>
    </aside>

    <main class="ot-content">
      <div id="emptyState">
        <EmptyState
          icon="⏱️"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={[copy.tip1, copy.tip2, copy.tip3, copy.tip4]}
        />
      </div>

      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="totalPayResult" title={copy.totalPay} icon={Wallet} accent="success" size="lg" />
          <ResultCard id="regularPayResult" title={copy.regularPay} icon={Clock} />
          <ResultCard id="overtimePayResult" title={copy.overtimePay} icon={TrendingUp} accent="primary" />
          <ResultCard id="effectiveRateResult" title={copy.effectiveRate} icon={Zap} />
        </ResultsGrid>

        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>

  </div>
</section>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/overtime-calculator";
</script>

<style>
.ot-calculator{ width:100%; }
.ot-layout{ display:grid; grid-template-columns:340px minmax(0,1fr); gap:32px; align-items:start; }
.ot-sidebar{ position:sticky; top:24px; display:flex; flex-direction:column; gap:20px; }
.ot-content{ display:flex; flex-direction:column; gap:28px; min-width:0; }
.calculator-info{ padding:24px; border:1px solid var(--border-subtle); border-radius:18px; background:var(--bg-card); }
.calculator-info h2{ margin:0 0 12px; font-size:1.15rem; font-weight:700; color:var(--text-primary); }
.calculator-info p{ margin:0; line-height:1.8; font-size:.95rem; color:var(--text-secondary); }
.error-box{ display:flex; align-items:center; padding:14px 16px; border-radius:14px; background:#FEF2F2; border:1px solid #FCA5A5; color:#B91C1C; font-size:.92rem; font-weight:600; }
:global(.dark) .error-box{ background:#2A1111; border-color:#7F1D1D; color:#FECACA; }
@media(max-width:1024px){ .ot-layout{ grid-template-columns:1fr; } .ot-sidebar{ position:static; } }
@media(max-width:768px){ .ot-layout{ gap:24px; } .ot-content{ gap:20px; } }
@media(max-width:640px){ .calculator-info{ padding:18px; } }
</style>
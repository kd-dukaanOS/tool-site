
---
{/* src/components/tools/OvertimeCalculatorWidget.astro */}
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";

import { Wallet, Clock, TrendingUp, Zap } from "@lucide/astro";
---

<section class="ot-calculator">
  <div class="ot-layout">

    <aside class="ot-sidebar">
      <CalculatorField
        id="hourlyRate"
        label="Hourly Rate ($)"
        type="number"
        placeholder="e.g. 20"
        required={true}
        min="0"
        step="0.01"
        helpText="Your regular pay per hour."
      />

      <CalculatorField
        id="regularHours"
        label="Regular Hours"
        type="number"
        placeholder="e.g. 40"
        required={true}
        min="0"
        step="0.5"
        helpText="Hours worked at your regular rate."
      />

      <CalculatorField
        id="overtimeHours"
        label="Overtime Hours"
        type="number"
        placeholder="e.g. 5"
        required={true}
        min="0"
        step="0.5"
        helpText="Hours worked beyond regular hours."
      />

      <CalculatorField
        id="overtimeMultiplier"
        label="Overtime Multiplier"
        type="number"
        placeholder="e.g. 1.5"
        required={true}
        min="1.01"
        step="0.1"
        helpText="Common rates: 1.5x (time-and-a-half), 2x (double time)."
      />

      <CalculatorActions
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
      />

      <div id="errorBox" class="error-box" hidden></div>
    </aside>

    <main class="ot-content">
      <div id="emptyState">
        <EmptyState
          icon="⏱️"
          title="Overtime Calculator"
          description="Find your total pay including overtime, and see your effective overtime rate."
          tips={["Total Pay", "Regular Pay", "Overtime Pay", "Overtime Rate"]}
        />
      </div>

      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="totalPayResult" title="Total Pay" icon={Wallet} accent="success" size="lg" />
          <ResultCard id="regularPayResult" title="Regular Pay" icon={Clock} />
          <ResultCard id="overtimePayResult" title="Overtime Pay" icon={TrendingUp} accent="primary" />
          <ResultCard id="effectiveRateResult" title="Overtime Rate" icon={Zap} />
        </ResultsGrid>

        <section class="calculator-info">
          <h2>About this Calculator</h2>
          <p>
            Calculates your total pay including overtime, using your hourly rate, regular hours,
            overtime hours and overtime multiplier. All calculations run locally — no external
            data or paid service is required.
          </p>
        </section>
      </div>
    </main>

  </div>
</section>

<script>
  import "../../scripts/overtime-calculator";
</script>

<style>
.ot-calculator{ width:100%; }
.ot-layout{ display:grid; grid-template-columns:340px minmax(0,1fr); gap:32px; align-items:start; }
.ot-sidebar{ position:sticky; top:24px; display:flex; flex-direction:column; gap:20px; }
.ot-content{ display:flex; flex-direction:column; gap:28px; min-width:0; }
.calculator-info{ padding:24px; border:1px solid var(--border-subtle); border-radius:18px; background:var(--bg-card); }
.calculator-info h2{ margin:0 0 12px; font-size:1.15rem; font-weight:700; color:var(--text-primary); }
.calculator-info p{ margin:0; line-height:1.8; font-size:.95rem; color:var(--text-secondary); }
.error-box{ display:flex; align-items:center; padding:14px 16px; border-radius:14px; background:#FEF2F2; border:1px solid #FCA5A5; color:#B91C1C; font-size:.92rem; font-weight:600; }
:global(.dark) .error-box{ background:#2A1111; border-color:#7F1D1D; color:#FECACA; }
@media(max-width:1024px){ .ot-layout{ grid-template-columns:1fr; } .ot-sidebar{ position:static; } }
@media(max-width:768px){ .ot-layout{ gap:24px; } .ot-content{ gap:20px; } }
@media(max-width:640px){ .calculator-info{ padding:18px; } }
</style>
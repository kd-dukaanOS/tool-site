---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { PiggyBank, TrendingDown, Landmark, AlertTriangle } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { taxYearGroup:"Tax Year", incomeGroup:"Income & Room", previousIncome:"Previous Year Earned Income", unusedRoom:"Unused Contribution Room", contribGroup:"Contribution", plannedContribution:"Planned Contribution", marginalTaxRate:"Marginal Tax Rate (%)", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"RRSP Calculator", emptyDesc:"Find your RRSP contribution room and estimated tax savings.", tip1:"Contribution Room", tip2:"Tax Savings", tip3:"Penalty Check", contribRoom:"Available Contribution Room", contribApplied:"Contribution Applied", taxSavings:"Estimated Tax Savings", penaltyTax:"Penalty Tax", none:"None", overContribution:"Over-contribution detected", withinLimit:"Within limit", aboutTitle:"About this Calculator", aboutText:"Estimates your RRSP contribution room, tax savings, and any CRA over-contribution penalty using current annual dollar limits for 2025 and 2026." },
  es: { taxYearGroup:"Año Fiscal", incomeGroup:"Ingreso y Espacio", previousIncome:"Ingreso Ganado del Año Anterior", unusedRoom:"Espacio de Aporte No Utilizado", contribGroup:"Aporte", plannedContribution:"Aporte Planeado", marginalTaxRate:"Tasa de Impuesto Marginal (%)", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora RRSP", emptyDesc:"Encuentra tu espacio de aporte RRSP y el ahorro fiscal estimado.", tip1:"Espacio de Aporte", tip2:"Ahorro Fiscal", tip3:"Verificación de Penalidad", contribRoom:"Espacio de Aporte Disponible", contribApplied:"Aporte Aplicado", taxSavings:"Ahorro Fiscal Estimado", penaltyTax:"Impuesto de Penalidad", none:"Ninguno", overContribution:"Sobre-aporte detectado", withinLimit:"Dentro del límite", aboutTitle:"Acerca de esta Calculadora", aboutText:"Estima tu espacio de aporte RRSP, ahorro fiscal, y cualquier penalidad CRA por sobre-aporte usando los límites anuales actuales para 2025 y 2026." },
}[lang];
---
<section class="rrsp-calculator">
  <div class="rrsp-layout">
    <aside class="rrsp-sidebar">
      <div class="rrsp-group">
        <h3>{copy.taxYearGroup}</h3>
        <CalculatorField type="select" id="taxYear" label="">
          <option value="2025">2025</option>
          <option value="2026">2026</option>
        </CalculatorField>
      </div>
      <div class="rrsp-group">
        <h3>{copy.incomeGroup}</h3>
        <CalculatorField id="previousYearEarnedIncome" label={copy.previousIncome} type="number" placeholder="e.g. 80000" min="0" step="1" />
        <CalculatorField id="unusedContributionRoom" label={copy.unusedRoom} type="number" placeholder="e.g. 5000" min="0" step="1" />
      </div>
      <div class="rrsp-group">
        <h3>{copy.contribGroup}</h3>
        <CalculatorField id="plannedContribution" label={copy.plannedContribution} type="number" placeholder="e.g. 10000" min="0" step="1" />
        <CalculatorField id="marginalTaxRate" label={copy.marginalTaxRate} type="number" placeholder="e.g. 30" min="0" step="0.1" />
      </div>
      <CalculatorActions lang={lang} calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} calculateText={copy.calculate} resetText={copy.reset} copyText={copy.copy} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="rrsp-content">
      <div id="emptyState">
        <EmptyState icon="🍁" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="contributionRoomResult" title={copy.contribRoom} icon={PiggyBank} accent="success" />
          <ResultCard id="maxContributionResult" title={copy.contribApplied} icon={Landmark} />
          <ResultCard id="taxSavingsResult" title={copy.taxSavings} icon={TrendingDown} />
          <ResultCard id="penaltyTaxResult" title={copy.penaltyTax} icon={AlertTriangle} subtitle=" " />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/rrsp-calculator";
</script>
<style>
.rrsp-calculator{width:100%;}
.rrsp-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.rrsp-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.rrsp-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.rrsp-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.rrsp-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.rrsp-layout{grid-template-columns:1fr;}.rrsp-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.rrsp-layout{gap:24px;}.rrsp-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
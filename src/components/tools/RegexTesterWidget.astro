---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Regex, Hash, Type, Layers } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { pattern:"Pattern", flags:"Flags", testText:"Test Text", testTextPlaceholder:"Paste text to test against...", test:"Test", reset:"Reset", copy:"Copy", emptyTitle:"Regex Tester", emptyDesc:"Test regular expressions against text with live match highlighting.", tip1:"Match Highlighting", tip2:"Flags Support", tip3:"Capture Groups", tip4:"Copy Summary", matches:"Matches", firstMatch:"First Match", groups:"Capture Groups", highlighted:"Highlighted Text", aboutTitle:"About this Tool", aboutText:"Test JavaScript regular expressions against sample text with live match highlighting, flags support and capture group detection." },
  es: { pattern:"Patrón", flags:"Indicadores", testText:"Texto de Prueba", testTextPlaceholder:"Pega el texto para probar...", test:"Probar", reset:"Restablecer", copy:"Copiar", emptyTitle:"Probador de Expresiones Regulares", emptyDesc:"Prueba expresiones regulares contra texto con resaltado de coincidencias en vivo.", tip1:"Resaltado de Coincidencias", tip2:"Soporte de Indicadores", tip3:"Grupos de Captura", tip4:"Copiar Resumen", matches:"Coincidencias", firstMatch:"Primera Coincidencia", groups:"Grupos de Captura", highlighted:"Texto Resaltado", aboutTitle:"Acerca de esta Herramienta", aboutText:"Prueba expresiones regulares de JavaScript contra texto de muestra con resaltado de coincidencias en vivo, soporte de indicadores y detección de grupos de captura." },
}[lang];
---
<section class="regex-tester">
  <div class="regex-layout">
    <aside class="regex-sidebar">

      <CalculatorField id="regexPattern" label={copy.pattern} type="text" placeholder="\\d+" />

      <CalculatorField id="regexFlags" label={copy.flags} type="text" value="g" placeholder="g, i, m, s" />

      <CalculatorField id="regexText" label={copy.testText} type="textarea" placeholder={copy.testTextPlaceholder} />

      <CalculatorActions calculateId="testBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} calculateText={copy.test} resetText={copy.reset} copyText={copy.copy} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>

    <main class="regex-content">
      <div id="emptyState">
        <EmptyState
          icon="🧩"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={[copy.tip1, copy.tip2, copy.tip3, copy.tip4]}
        />
      </div>

      <div id="resultsContainer" hidden>
        <ResultsGrid columns={3}>
          <ResultCard id="matchCountResult" title={copy.matches} icon={Hash} />
          <ResultCard id="firstMatchResult" title={copy.firstMatch} icon={Type} />
          <ResultCard id="groupsResult" title={copy.groups} icon={Layers} />
        </ResultsGrid>

        <div class="tool-field">
          <label class="tool-label">{copy.highlighted}</label>
          <div id="highlightedOutput" class="regex-output"></div>
        </div>

        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/regex-tester";
</script>

<style>
.regex-tester{width:100%;}
.regex-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.regex-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:4px;}
.tool-field{display:flex;flex-direction:column;gap:8px;margin-bottom:1.25rem;}
.tool-field .tool-label{display:flex;align-items:center;gap:6px;font-size:.95rem;font-weight:600;color:#111827;}
.regex-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.regex-output{padding:20px;border:1px solid #E5E7EB;border-radius:18px;background:#FFFFFF;white-space:pre-wrap;font-family:ui-monospace,monospace;font-size:.88rem;line-height:1.7;max-height:400px;overflow:auto;}
.regex-output :global(mark){background:#FDE68A;color:#78350F;border-radius:3px;padding:0 2px;}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .regex-output{background:#111217;border-color:#27272A;}
:global(.dark) .tool-field .tool-label{color:#F4F4F5;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.regex-layout{grid-template-columns:1fr;}.regex-sidebar{position:static;}}
</style>

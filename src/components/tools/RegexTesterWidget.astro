---
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Regex, Hash, Type, Layers } from "@lucide/astro";
---
<section class="regex-tester">
  <div class="regex-layout">
    <aside class="regex-sidebar">
      <div class="tool-field">
        <label class="tool-label" for="regexPattern"><Regex size={16} /> Pattern</label>
        <input id="regexPattern" type="text" class="tool-input" placeholder="\\d+" />
      </div>

      <div class="tool-field">
        <label class="tool-label" for="regexFlags">Flags</label>
        <input id="regexFlags" type="text" class="tool-input" value="g" placeholder="g, i, m, s" />
      </div>

      <div class="tool-field">
        <label class="tool-label" for="regexText">Test Text</label>
        <textarea id="regexText" class="tool-textarea" placeholder="Paste text to test against..."></textarea>
      </div>

      <CalculatorActions calculateId="testBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>

    <main class="regex-content">
      <div id="emptyState">
        <EmptyState
          icon="🧩"
          title="Regex Tester"
          description="Test regular expressions against text with live match highlighting."
          tips={["Match Highlighting", "Flags Support", "Capture Groups", "Copy Summary"]}
        />
      </div>

      <div id="resultsContainer" hidden>
        <ResultsGrid columns={3}>
          <ResultCard id="matchCountResult" title="Matches" icon={Hash} />
          <ResultCard id="firstMatchResult" title="First Match" icon={Type} />
          <ResultCard id="groupsResult" title="Capture Groups" icon={Layers} />
        </ResultsGrid>

        <div class="tool-field">
          <label class="tool-label">Highlighted Text</label>
          <div id="highlightedOutput" class="regex-output"></div>
        </div>

        <section class="calculator-info">
          <h2>About this Tool</h2>
          <p>Test JavaScript regular expressions against sample text with live match highlighting, flags support and capture group detection.</p>
        </section>
      </div>
    </main>
  </div>
</section>

<script>
  import "../../scripts/regex-tester";
</script>

<style>
.regex-tester{width:100%;}
.regex-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.regex-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:16px;}
.tool-field{display:flex;flex-direction:column;gap:8px;}
.tool-field .tool-label{display:flex;align-items:center;gap:6px;}
.regex-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.regex-output{padding:20px;border:1px solid #E5E7EB;border-radius:18px;background:#FFFFFF;white-space:pre-wrap;font-family:ui-monospace,monospace;font-size:.88rem;line-height:1.7;max-height:400px;overflow:auto;}
.regex-output :global(mark){background:#FDE68A;color:#78350F;border-radius:3px;padding:0 2px;}
.calculator-info{padding:24px;border:1px solid #E5E7EB;border-radius:18px;background:#FFFFFF;}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:#111827;}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:#6B7280;}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .regex-output,:global(.dark) .calculator-info{background:#111217;border-color:#27272A;}
:global(.dark) .calculator-info h2{color:#FAFAFA;}
:global(.dark) .calculator-info p{color:#A1A1AA;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.regex-layout{grid-template-columns:1fr;}.regex-sidebar{position:static;}}
</style>

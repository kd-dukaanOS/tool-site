---
---

<div class="flex flex-wrap gap-3 mb-4">
  <input
    id="regexPattern"
    type="text"
    placeholder="Enter regex pattern, e.g. \d+"
    class="flex-1 min-w-[200px] p-2 border border-gray-300 rounded-lg font-mono text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400"
  />
  <input
    id="regexFlags"
    type="text"
    placeholder="Flags, e.g. gi"
    class="w-28 p-2 border border-gray-300 rounded-lg font-mono text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400"
  />
</div>

<label class="block text-sm font-medium text-gray-700 mb-1">Test String</label>
<textarea
  id="testString"
  class="w-full h-48 p-3 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400"
  placeholder="Paste text to test your regex against..."
></textarea>

<div class="mt-4">
  <label class="block text-sm font-medium text-gray-700 mb-1">Matches</label>
  <div id="matchResult" class="p-3 border border-gray-300 rounded-lg bg-gray-50 min-h-[80px] text-sm whitespace-pre-wrap"></div>
</div>

<p id="regexError" class="text-red-600 mt-3 font-medium"></p>

<script>
  const patternInput = document.getElementById('regexPattern');
  const flagsInput = document.getElementById('regexFlags');
  const testStringInput = document.getElementById('testString');
  const matchResult = document.getElementById('matchResult');
  const errorEl = document.getElementById('regexError');

  if (
    patternInput instanceof HTMLInputElement &&
    flagsInput instanceof HTMLInputElement &&
    testStringInput instanceof HTMLTextAreaElement &&
    matchResult &&
    errorEl
  ) {
    const runMatch = () => {
      const pattern = patternInput.value;
      const flags = flagsInput.value;
      const text = testStringInput.value;

      errorEl.textContent = '';

      if (!pattern) {
        matchResult.innerHTML = '';
        return;
      }

      try {
        const regex = new RegExp(pattern, flags);
        const matches = [...text.matchAll(new RegExp(pattern, flags.includes('g') ? flags : flags + 'g'))];

        if (matches.length === 0) {
          matchResult.textContent = 'No matches found.';
        } else {
          let highlighted = text;
          const escapeHtml = (str: string) =>
            str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

          highlighted = escapeHtml(text).replace(
            new RegExp(escapeHtml(pattern) === pattern ? pattern : pattern, flags.includes('g') ? flags : flags + 'g'),
            (m) => `<mark class="bg-yellow-200">${escapeHtml(m)}</mark>`
          );

          matchResult.innerHTML = `<strong>${matches.length} match(es) found</strong><br><br>${highlighted}`;
        }
      } catch (e) {
        errorEl.textContent = 'Invalid regex: ' + (e instanceof Error ? e.message : String(e));
        matchResult.innerHTML = '';
      }
    };

    patternInput.addEventListener('input', runMatch);
    flagsInput.addEventListener('input', runMatch);
    testStringInput.addEventListener('input', runMatch);
  }
</script>

---
import CalculatorField from "../calculator/CalculatorField.astro";
import ActionButtons from "../calculator/ActionButtons.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import EmptyState from "../calculator/EmptyState.astro";
import { Percent, Tag } from "@lucide/astro";

interface Props {
  lang?: "en" | "es";
}
const { lang = "en" } = Astro.props as Props;

const copy = {
  en: {
    gender: "Gender", male: "Male", female: "Female",
    height: "Height (cm)", neck: "Neck (cm)", waist: "Waist (cm)", hip: "Hip (cm)",
    emptyTitle: "Enter measurements to calculate body fat", emptyDesc: "Your estimated body fat percentage will appear here.",
    bodyFat: "Body Fat", category: "Category",
  },
  es: {
    gender: "Sexo", male: "Hombre", female: "Mujer",
    height: "Estatura (cm)", neck: "Cuello (cm)", waist: "Cintura (cm)", hip: "Cadera (cm)",
    emptyTitle: "Ingresa tus medidas para calcular tu grasa corporal", emptyDesc: "Aquí verás tu porcentaje estimado de grasa corporal.",
    bodyFat: "Grasa Corporal", category: "Categoría",
  },
}[lang];
---

<div class="calculator-widget">
  <div class="calculator-inputs">
    <CalculatorField id="gender" label={copy.gender} type="select">
      <option value="male">{copy.male}</option>
      <option value="female">{copy.female}</option>
    </CalculatorField>

    <CalculatorField id="heightCm" label={copy.height} type="number" placeholder="e.g. 170" />
    <CalculatorField id="neckCm" label={copy.neck} type="number" placeholder="e.g. 38" />
    <CalculatorField id="waistCm" label={copy.waist} type="number" placeholder="e.g. 85" />

    <div id="hipFieldGroup" hidden>
      <CalculatorField id="hipCm" label={copy.hip} type="number" placeholder="e.g. 95" />
    </div>

    <div id="errorBox" class="error-box" role="alert" hidden></div>

    <ActionButtons lang={lang}
      calculateId="calculateBtn"
      resetId="resetBtn"
      copyId="copyBtn"
      showDownload={false}
      showShare={false}
    />
  </div>

  <div class="calculator-output">
    <EmptyState
      id="emptyState"
      title={copy.emptyTitle}
      description={copy.emptyDesc}
    />

    <ResultsGrid id="resultsContainer" hidden>
      <ResultCard id="bodyFatResult" title={copy.bodyFat} icon={Percent} accent="primary" size="lg" />
      <ResultCard id="categoryResult" title={copy.category} icon={Tag} accent="neutral" />
    </ResultsGrid>
  </div>
</div>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script src="../../scripts/body-fat-calculator.ts"></script>


---

{/* src/components/tools/BonusCalculatorWidget.astro */}
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import CurrencySelector from "../calculator/CurrencySelector.astro";
import { Package, Wallet, Receipt, TrendingUp } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;

const copy = {
  en: {
    salaryLabel: "Annual Salary ($)", salaryPh: "e.g. 60000", salaryHelp: "Your base annual salary.",
    bonusLabel: "Bonus (%)", bonusPh: "e.g. 10", bonusHelp: "Bonus as a percentage of salary.",
    taxLabel: "Tax Rate on Bonus (%)", taxPh: "e.g. 22", taxHelp: "Estimated tax rate applied to bonus pay.",
    emptyTitle: "Bonus Calculator", emptyDesc: "Find your gross bonus, tax on bonus, and net take-home bonus amount.",
    tips: ["Net Bonus", "Gross Bonus", "Tax on Bonus", "Total Compensation"],
    netBonus: "Net Bonus", grossBonus: "Gross Bonus", taxOnBonus: "Tax on Bonus", totalComp: "Total Compensation",
    aboutTitle: "About this Calculator",
    aboutText: "Calculates your gross bonus, estimated tax on the bonus, and net take-home bonus amount from your salary and bonus percentage. All calculations run locally — no external data or paid service is required.",
  },
  es: {
    salaryLabel: "Salario Anual ($)", salaryPh: "ej. 60000", salaryHelp: "Tu salario base anual.",
    bonusLabel: "Bono (%)", bonusPh: "ej. 10", bonusHelp: "Bono como porcentaje del salario.",
    taxLabel: "Tasa de Impuesto sobre el Bono (%)", taxPh: "ej. 22", taxHelp: "Tasa de impuesto estimada aplicada al bono.",
    emptyTitle: "Calculadora de Bono", emptyDesc: "Calcula tu bono bruto, el impuesto sobre el bono y el monto neto a recibir.",
    tips: ["Bono Neto", "Bono Bruto", "Impuesto sobre el Bono", "Compensación Total"],
    netBonus: "Bono Neto", grossBonus: "Bono Bruto", taxOnBonus: "Impuesto sobre el Bono", totalComp: "Compensación Total",
    aboutTitle: "Acerca de esta Calculadora",
    aboutText: "Calcula tu bono bruto, el impuesto estimado sobre el bono y el monto neto a recibir a partir de tu salario y porcentaje de bono. Todos los cálculos se ejecutan localmente, sin datos externos ni servicios de pago.",
  },
}[lang];
---

<section class="bonus-calculator">
  <div class="bonus-layout">

   <aside class="bonus-sidebar">
      <CurrencySelector />

      <CalculatorField
        id="annualSalary"
        label={copy.salaryLabel}
        type="number"
        placeholder={copy.salaryPh}
        required={true}
        min="0"
        step="1"
        helpText={copy.salaryHelp}
      />

      <CalculatorField
        id="bonusPercent"
        label={copy.bonusLabel}
        type="number"
        placeholder={copy.bonusPh}
        required={true}
        min="0"
        step="0.1"
        helpText={copy.bonusHelp}
      />

      <CalculatorField
        id="taxRate"
        label={copy.taxLabel}
        type="number"
        placeholder={copy.taxPh}
        min="0"
        max="100"
        step="0.1"
        helpText={copy.taxHelp}
      />

      <CalculatorActions
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
      />

      <div id="errorBox" class="error-box" hidden></div>
    </aside>

    <main class="bonus-content">
      <div id="emptyState">
      <EmptyState
          icon="🎁"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={copy.tips}
        />
      </div>

      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
           <ResultCard id="netBonusResult" title={copy.netBonus} icon={Wallet} accent="success" size="lg" />
          <ResultCard id="bonusAmountResult" title={copy.grossBonus} icon={Package} accent="primary" />
          <ResultCard id="taxOnBonusResult" title={copy.taxOnBonus} icon={Receipt} />
          <ResultCard id="totalCompResult" title={copy.totalComp} icon={TrendingUp} />        </ResultsGrid>

        <section class="calculator-info">
         <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>

  </div>
</section>

<script define:vars={{ calcLang: lang }}>window.calcLang = calcLang;</script>
<script>
  import "../../scripts/bonus-calculator";
</script>
<style>
.bonus-calculator{ width:100%; }
.bonus-layout{ display:grid; grid-template-columns:340px minmax(0,1fr); gap:32px; align-items:start; }
.bonus-sidebar{ position:sticky; top:24px; display:flex; flex-direction:column; gap:20px; }
.bonus-content{ display:flex; flex-direction:column; gap:28px; min-width:0; }
.calculator-info{ padding:24px; border:1px solid var(--border-subtle); border-radius:18px; background:var(--bg-card); }
.calculator-info h2{ margin:0 0 12px; font-size:1.15rem; font-weight:700; color:var(--text-primary); }
.calculator-info p{ margin:0; line-height:1.8; font-size:.95rem; color:var(--text-secondary); }
.error-box{ display:flex; align-items:center; padding:14px 16px; border-radius:14px; background:#FEF2F2; border:1px solid #FCA5A5; color:#B91C1C; font-size:.92rem; font-weight:600; }
:global(.dark) .error-box{ background:#2A1111; border-color:#7F1D1D; color:#FECACA; }
@media(max-width:1024px){ .bonus-layout{ grid-template-columns:1fr; } .bonus-sidebar{ position:static; } }
@media(max-width:768px){ .bonus-layout{ gap:24px; } .bonus-content{ gap:20px; } }
@media(max-width:640px){ .calculator-info{ padding:18px; } }
</style>
---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";

import {
  Wallet,
  Banknote,
  Landmark,
  House,
  Layers,
  ShieldCheck,
  Building2,
  Receipt
} from "@lucide/astro";
---

<section class="sal-calculator">

  <div class="sal-layout">

    <aside class="sal-sidebar">

      <CalculatorField
        id="annualCTC"
        label="Annual CTC (â‚¹)"
        type="number"
        placeholder="e.g. 1200000"
        required={true}
        min="0"
        step="1"
        helpText="Total Cost to Company per year."
      />

      <CalculatorField
        id="basicPercent"
        label="Basic Salary (% of CTC)"
        type="number"
        value="40"
        min="1"
        max="100"
        step="1"
        helpText="Usually 35â€“50% of CTC."
      />

      <CalculatorField
        id="hraPercent"
        label="HRA (% of Basic)"
        type="number"
        value="50"
        min="0"
        max="100"
        step="1"
        helpText="Usually 40â€“50% of Basic."
      />

      <CalculatorField
        id="employeePFPercent"
        label="Employee PF (% of Basic)"
        type="number"
        value="12"
        min="0"
        max="100"
        step="1"
        helpText="Standard is 12%."
      />

      <CalculatorField
        id="employerPFPercent"
        label="Employer PF (% of Basic)"
        type="number"
        value="12"
        min="0"
        max="100"
        step="1"
        helpText="Part of CTC, not part of gross salary."
      />

      <CalculatorField
        id="professionalTaxMonthly"
        label="Professional Tax (â‚¹/month)"
        type="number"
        value="200"
        min="0"
        step="1"
        helpText="State-specific, often â‚¹200/month."
      />

      <CalculatorActions
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
      />

      <div
        id="errorBox"
        class="error-box"
        hidden
      ></div>

    </aside>

    <main class="sal-content">

      <div id="emptyState">

        <EmptyState
          icon="ðŸ§¾"
          title="Salary Calculator"
          description="Break down your CTC into Basic, HRA, PF and take-House salary."
          tips={[
            "Monthly & Annual Take House",
            "Basic, HRA, Special Allowance",
            "Employee & Employer PF",
            "Professional Tax"
          ]}
        />

      </div>

      <div
        id="resultsContainer"
        hidden
      >

        <ResultsGrid columns={3}>

          <ResultCard
            id="monthlyTakeHomeResult"
            title="Monthly Take House"
            icon={Wallet}
            accent="success"
          />

          <ResultCard
            id="annualTakeHomeResult"
            title="Annual Take House"
            icon={Banknote}
            accent="success"
          />

          <ResultCard
            id="monthlyGrossResult"
            title="Monthly Gross Salary"
            icon={Landmark}
          />

          <ResultCard
            id="basicResult"
            title="Monthly Basic"
            icon={Layers}
          />

          <ResultCard
            id="hraResult"
            title="Monthly HRA"
            icon={House}
          />

          <ResultCard
            id="specialAllowanceResult"
            title="Monthly Special Allowance"
            icon={Layers}
          />

          <ResultCard
            id="employeePFResult"
            title="Employee PF (Monthly)"
            icon={ShieldCheck}
          />

          <ResultCard
            id="employerPFResult"
            title="Employer PF (Monthly)"
            icon={Building2}
          />

          <ResultCard
            id="professionalTaxResult"
            title="Professional Tax (Annual)"
            icon={Receipt}
          />

        </ResultsGrid>

        <section class="calculator-info">

          <h2>About this Calculator</h2>

          <p>
            This calculator breaks your Annual CTC into Basic, HRA,
            Special Allowance, PF contributions and Professional Tax
            to estimate your monthly and annual in-hand (take-House)
            salary. Employer PF is part of your CTC but not part of
            your gross salary or take-House pay.
          </p>

        </section>

      </div>

    </main>

  </div>

</section>

<script>
  import "../../scripts/salary-calculator";
</script>

<style>

.sal-calculator{

width:100%;

}

.sal-layout{

display:grid;

grid-template-columns:340px minmax(0,1fr);

gap:32px;

align-items:start;

}

.sal-sidebar{

position:sticky;

top:24px;

display:flex;

flex-direction:column;

gap:20px;

}

.sal-content{

display:flex;

flex-direction:column;

gap:28px;

min-width:0;

}

.calculator-info{

padding:24px;

border:1px solid var(--border-subtle);

border-radius:18px;

background:var(--bg-card);

}

.calculator-info h2{

margin:0 0 12px;

font-size:1.15rem;

font-weight:700;

color:var(--text-primary);

}

.calculator-info p{

margin:0;

line-height:1.8;

font-size:.95rem;

color:var(--text-secondary);

}

.error-box{

display:flex;

align-items:center;

padding:14px 16px;

border-radius:14px;

background:#FEF2F2;

border:1px solid #FCA5A5;

color:#B91C1C;

font-size:.92rem;

font-weight:600;

}


:global(.dark) .error-box{

background:#2A1111;

border-color:#7F1D1D;

color:#FECACA;

}

@media(max-width:1024px){

.sal-layout{

grid-template-columns:1fr;

}

.sal-sidebar{

position:static;

}

}

@media(max-width:768px){

.sal-layout{

gap:24px;

}

.sal-content{

gap:20px;

}

}

@media(max-width:640px){

.calculator-info{

padding:18px;

}

}

</style>


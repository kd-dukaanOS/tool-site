---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";

import {
  Wallet,
  Banknote,
  Landmark,
  House,
  Layers,
  ShieldCheck,
  Building2,
  Receipt
} from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { ctc:"Annual CTC (₹)", ctcHelp:"Total Cost to Company per year.", basic:"Basic Salary (% of CTC)", hra:"HRA (% of Basic)", empPF:"Employee PF (% of Basic)", empPFHelp:"Standard is 12%.", erPF:"Employer PF (% of Basic)", erPFHelp:"Part of CTC, not part of gross salary.", pt:"Professional Tax (₹/month)", ptHelp:"State-specific, often ₹200/month.", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"Salary Calculator", emptyDesc:"Break down your CTC into Basic, HRA, PF and take-home salary.", tip1:"Monthly & Annual Take Home", tip2:"Basic, HRA, Special Allowance", tip3:"Employee & Employer PF", tip4:"Professional Tax", monthlyTakeHome:"Monthly Take Home", annualTakeHome:"Annual Take Home", monthlyGross:"Monthly Gross Salary", monthlyBasic:"Monthly Basic", monthlyHRA:"Monthly HRA", specialAllowance:"Monthly Special Allowance", empPFResult:"Employee PF (Monthly)", erPFResult:"Employer PF (Monthly)", ptResult:"Professional Tax (Annual)", aboutTitle:"About this Calculator", aboutText:"This calculator breaks your Annual CTC into Basic, HRA, Special Allowance, PF contributions and Professional Tax to estimate your monthly and annual in-hand (take-home) salary. Employer PF is part of your CTC but not part of your gross salary or take-home pay." },
  es: { ctc:"CTC Anual (₹)", ctcHelp:"Costo Total para la Empresa por año.", basic:"Salario Base (% del CTC)", hra:"HRA (% del Base)", empPF:"PF del Empleado (% del Base)", empPFHelp:"El estándar es 12%.", erPF:"PF del Empleador (% del Base)", erPFHelp:"Parte del CTC, no del salario bruto.", pt:"Impuesto Profesional (₹/mes)", ptHelp:"Específico del estado, a menudo ₹200/mes.", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora de Salario", emptyDesc:"Desglosa tu CTC en Base, HRA, PF y salario neto.", tip1:"Salario Neto Mensual y Anual", tip2:"Base, HRA, Asignación Especial", tip3:"PF del Empleado y Empleador", tip4:"Impuesto Profesional", monthlyTakeHome:"Salario Neto Mensual", annualTakeHome:"Salario Neto Anual", monthlyGross:"Salario Bruto Mensual", monthlyBasic:"Base Mensual", monthlyHRA:"HRA Mensual", specialAllowance:"Asignación Especial Mensual", empPFResult:"PF del Empleado (Mensual)", erPFResult:"PF del Empleador (Mensual)", ptResult:"Impuesto Profesional (Anual)", aboutTitle:"Acerca de esta Calculadora", aboutText:"Esta calculadora desglosa tu CTC Anual en Base, HRA, Asignación Especial, contribuciones PF e Impuesto Profesional para estimar tu salario neto mensual y anual. El PF del Empleador es parte de tu CTC pero no de tu salario bruto ni neto." },
}[lang];
---

<section class="sal-calculator">

  <div class="sal-layout">

    <aside class="sal-sidebar">

      <CalculatorField
        id="annualCTC"
        label={copy.ctc}
        type="number"
        placeholder="e.g. 1200000"
        required={true}
        min="0"
        step="1"
        helpText={copy.ctcHelp}
      />

      <CalculatorField
        id="basicPercent"
        label={copy.basic}
        type="number"
        value="40"
        min="1"
        max="100"
        step="1"
        helpText="Usually 35â€“50% of CTC."
      />

      <CalculatorField
        id="hraPercent"
        label={copy.hra}
        type="number"
        value="50"
        min="0"
        max="100"
        step="1"
        helpText="Usually 40â€“50% of Basic."
      />

      <CalculatorField
        id="employeePFPercent"
        label={copy.empPF}
        type="number"
        value="12"
        min="0"
        max="100"
        step="1"
        helpText={copy.empPFHelp}
      />

      <CalculatorField
        id="employerPFPercent"
        label={copy.erPF}
        type="number"
        value="12"
        min="0"
        max="100"
        step="1"
        helpText={copy.erPFHelp}
      />

      <CalculatorField
        id="professionalTaxMonthly"
        label={copy.pt}
        type="number"
        value="200"
        min="0"
        step="1"
        helpText={copy.ptHelp}
      />

      <CalculatorActions
        calculateId="calculateBtn"
        resetId="resetBtn"
        copyId="copyBtn"
        showCopy={true}
        calculateText={copy.calculate}
        resetText={copy.reset}
        copyText={copy.copy}
      />

      <div
        id="errorBox"
        class="error-box"
        hidden
      ></div>

    </aside>

    <main class="sal-content">

      <div id="emptyState">

        <EmptyState
          icon="ðŸ§¾"
          title={copy.emptyTitle}
          description={copy.emptyDesc}
          tips={[copy.tip1, copy.tip2, copy.tip3, copy.tip4]}
        />

      </div>

      <div
        id="resultsContainer"
        hidden
      >

        <ResultsGrid columns={3}>

          <ResultCard
            id="monthlyTakeHomeResult"
            title={copy.monthlyTakeHome}
            icon={Wallet}
            accent="success"
          />

          <ResultCard
            id="annualTakeHomeResult"
            title={copy.annualTakeHome}
            icon={Banknote}
            accent="success"
          />

          <ResultCard
            id="monthlyGrossResult"
            title={copy.monthlyGross}
            icon={Landmark}
          />

          <ResultCard
            id="basicResult"
            title={copy.monthlyBasic}
            icon={Layers}
          />

          <ResultCard
            id="hraResult"
            title={copy.monthlyHRA}
            icon={House}
          />

          <ResultCard
            id="specialAllowanceResult"
            title={copy.specialAllowance}
            icon={Layers}
          />

          <ResultCard
            id="employeePFResult"
            title={copy.empPFResult}
            icon={ShieldCheck}
          />

          <ResultCard
            id="employerPFResult"
            title={copy.erPFResult}
            icon={Building2}
          />

          <ResultCard
            id="professionalTaxResult"
            title={copy.ptResult}
            icon={Receipt}
          />

        </ResultsGrid>

        <section class="calculator-info">

          <h2>{copy.aboutTitle}</h2>

          <p>{copy.aboutText}</p>

        </section>

      </div>

    </main>

  </div>

</section>

<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/salary-calculator";
</script>

<style>

.sal-calculator{

width:100%;

}

.sal-layout{

display:grid;

grid-template-columns:340px minmax(0,1fr);

gap:32px;

align-items:start;

}

.sal-sidebar{

position:sticky;

top:24px;

display:flex;

flex-direction:column;

gap:20px;

}

.sal-content{

display:flex;

flex-direction:column;

gap:28px;

min-width:0;

}

.calculator-info{

padding:24px;

border:1px solid var(--border-subtle);

border-radius:18px;

background:var(--bg-card);

}

.calculator-info h2{

margin:0 0 12px;

font-size:1.15rem;

font-weight:700;

color:var(--text-primary);

}

.calculator-info p{

margin:0;

line-height:1.8;

font-size:.95rem;

color:var(--text-secondary);

}

.error-box{

display:flex;

align-items:center;

padding:14px 16px;

border-radius:14px;

background:#FEF2F2;

border:1px solid #FCA5A5;

color:#B91C1C;

font-size:.92rem;

font-weight:600;

}


:global(.dark) .error-box{

background:#2A1111;

border-color:#7F1D1D;

color:#FECACA;

}

@media(max-width:1024px){

.sal-layout{

grid-template-columns:1fr;

}

.sal-sidebar{

position:static;

}

}

@media(max-width:768px){

.sal-layout{

gap:24px;

}

.sal-content{

gap:20px;

}

}

@media(max-width:640px){

.calculator-info{

padding:18px;

}

}

</style>


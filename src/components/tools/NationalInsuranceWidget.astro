---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { ShieldCheck, Users, Building2, Coins } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { income:"Gross Annual Salary", incomeHelp:"Your gross annual salary (GBP).", emptyTitle:"National Insurance Calculator", emptyDesc:"Estimate your Class 1 National Insurance contribution.", tip1:"Earnings Above Threshold", tip2:"Employee Portion", tip3:"Employer Portion", earningsAbove:"Earnings Above Threshold", employee:"Employee Contribution", employer:"Employer Contribution", total:"Total Contribution", deducted:"deducted from your pay", aboutTitle:"About this Calculator", aboutText:"Estimates Class 1 National Insurance on earnings above the primary threshold. Doesn't cover reduced NI categories. Verify against current HMRC figures." },
  es: { income:"Salario Bruto Anual", incomeHelp:"Tu salario bruto anual (GBP).", emptyTitle:"Calculadora de Seguro Nacional", emptyDesc:"Calcula tu contribución de Seguro Nacional Clase 1.", tip1:"Ingresos Sobre el Umbral", tip2:"Parte del Empleado", tip3:"Parte del Empleador", earningsAbove:"Ingresos Sobre el Umbral", employee:"Contribución del Empleado", employer:"Contribución del Empleador", total:"Contribución Total", deducted:"deducido de tu salario", aboutTitle:"Acerca de esta Calculadora", aboutText:"Calcula el Seguro Nacional Clase 1 sobre ingresos por encima del umbral primario. No cubre categorías de NI reducidas. Verifica con las cifras actuales de HMRC." },
}[lang];
---
<section class="ni-calculator">
  <div class="ni-layout">
    <aside class="ni-sidebar">
      <CalculatorField id="grossIncome" label={copy.income} type="number" required={true} helpText={copy.incomeHelp} />
      <CalculatorActions calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="ni-content">
      <div id="emptyState">
        <EmptyState icon="🛡️" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={2}>
          <ResultCard id="earningsAboveResult" title={copy.earningsAbove} icon={ShieldCheck} />
          <ResultCard id="employeeResult" title={copy.employee} icon={Users} subtitle=" " />
          <ResultCard id="employerResult" title={copy.employer} icon={Building2} />
          <ResultCard id="totalResult" title={copy.total} icon={Coins} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/uk-national-insurance-calculator";
</script>
<style>
.ni-calculator{width:100%;}
.ni-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.ni-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;}
.ni-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.ni-layout{grid-template-columns:1fr;}.ni-sidebar{position:static;}}
@media(max-width:768px){.ni-layout{gap:24px;}.ni-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
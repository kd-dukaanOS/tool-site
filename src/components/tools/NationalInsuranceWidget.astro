---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { ShieldCheck, Users, Building2, Coins } from "@lucide/astro";
---
<section class="ni-calculator">
  <div class="ni-layout">
    <aside class="ni-sidebar">
      <CalculatorField id="grossIncome" label="Gross Annual Salary" type="number" required={true} helpText="Your gross annual salary (GBP)." />
      <CalculatorActions calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="ni-content">
      <div id="emptyState">
        <EmptyState icon="🛡️" title="National Insurance Calculator" description="Estimate your Class 1 National Insurance contribution." tips={["Earnings Above Threshold", "Employee Portion", "Employer Portion"]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={2}>
          <ResultCard id="earningsAboveResult" title="Earnings Above Threshold" icon={ShieldCheck} />
          <ResultCard id="employeeResult" title="Employee Contribution" icon={Users} subtitle=" " />
          <ResultCard id="employerResult" title="Employer Contribution" icon={Building2} />
          <ResultCard id="totalResult" title="Total Contribution" icon={Coins} />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>About this Calculator</h2>
          <p>Estimates Class 1 National Insurance on earnings above the primary threshold. Doesn't cover reduced NI categories. Verify against current HMRC figures.</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script>
  import "../../scripts/uk-national-insurance-calculator";
</script>
<style>
.ni-calculator{width:100%;}
.ni-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.ni-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;}
.ni-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.ni-layout{grid-template-columns:1fr;}.ni-sidebar{position:static;}}
@media(max-width:768px){.ni-layout{gap:24px;}.ni-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
---
import CalculatorField from "../calculator/CalculatorField.astro";
import CalculatorActions from "../calculator/ActionButtons.astro";
import EmptyState from "../calculator/EmptyState.astro";
import ResultCard from "../calculator/ResultCard.astro";
import ResultsGrid from "../calculator/ResultsGrid.astro";
import { Wallet, DollarSign, Calendar, TrendingDown } from "@lucide/astro";

interface Props { lang?: "en" | "es"; }
const { lang = "en" } = Astro.props as Props;
const copy = {
  en: { savingsGroup:"Savings & Withdrawal", currentSavings:"Current Retirement Savings", withdrawalRate:"Withdrawal Rate (%)", birthYear:"Birth Year", otherIncomeGroup:"Other Income", socialSecurity:"Annual Social Security", pension:"Annual Pension", otherIncome:"Other Annual Income", assumptionsGroup:"Assumptions", expectedReturn:"Expected Return (%/yr)", inflationRate:"Inflation Rate (%/yr)", retirementYears:"Retirement Horizon (years)", calculate:"Calculate", reset:"Reset", copy:"Copy", emptyTitle:"Retirement Income Calculator", emptyDesc:"Estimate your sustainable retirement income and portfolio longevity.", tip1:"Monthly Income", tip2:"Annual Income", tip3:"Portfolio Outlook", monthlyIncome:"Monthly Retirement Income", annualIncome:"Annual Retirement Income", rmdBegin:"RMDs Begin", portfolioOutlook:"Portfolio Outlook", aboutTitle:"About this Calculator", aboutText:"Estimates your sustainable monthly and annual retirement income by combining a safe withdrawal rate from savings with Social Security, pension, and other income, then simulates portfolio longevity." },
  es: { savingsGroup:"Ahorros y Retiro", currentSavings:"Ahorros Actuales para el Retiro", withdrawalRate:"Tasa de Retiro (%)", birthYear:"Año de Nacimiento", otherIncomeGroup:"Otros Ingresos", socialSecurity:"Seguro Social Anual", pension:"Pensión Anual", otherIncome:"Otros Ingresos Anuales", assumptionsGroup:"Supuestos", expectedReturn:"Retorno Esperado (%/año)", inflationRate:"Tasa de Inflación (%/año)", retirementYears:"Horizonte de Jubilación (años)", calculate:"Calcular", reset:"Restablecer", copy:"Copiar", emptyTitle:"Calculadora de Ingreso de Jubilación", emptyDesc:"Estima tu ingreso de jubilación sostenible y la duración de tu portafolio.", tip1:"Ingreso Mensual", tip2:"Ingreso Anual", tip3:"Panorama del Portafolio", monthlyIncome:"Ingreso Mensual de Jubilación", annualIncome:"Ingreso Anual de Jubilación", rmdBegin:"Inicio de RMD", portfolioOutlook:"Panorama del Portafolio", aboutTitle:"Acerca de esta Calculadora", aboutText:"Estima tu ingreso mensual y anual sostenible de jubilación combinando una tasa de retiro segura de tus ahorros con el Seguro Social, pensión y otros ingresos, luego simula la duración del portafolio." },
}[lang];
---
<section class="ric-calculator">
  <div class="ric-layout">
    <aside class="ric-sidebar">
      <div class="ric-group">
        <h3>{copy.savingsGroup}</h3>
        <CalculatorField id="currentSavings" label={copy.currentSavings} type="number" placeholder="e.g. 1000000" min="0" step="1" />
        <CalculatorField id="withdrawalRate" label={copy.withdrawalRate} type="number" placeholder="e.g. 4" min="0" step="0.1" />
        <CalculatorField id="birthYear" label={copy.birthYear} type="number" placeholder="e.g. 1965" min="1930" step="1" />
      </div>
      <div class="ric-group">
        <h3>{copy.otherIncomeGroup}</h3>
        <CalculatorField id="annualSocialSecurity" label={copy.socialSecurity} type="number" placeholder="e.g. 24000" min="0" step="1" />
        <CalculatorField id="annualPension" label={copy.pension} type="number" placeholder="e.g. 0" min="0" step="1" />
        <CalculatorField id="otherAnnualIncome" label={copy.otherIncome} type="number" placeholder="e.g. 0" min="0" step="1" />
      </div>
      <div class="ric-group">
        <h3>{copy.assumptionsGroup}</h3>
        <CalculatorField id="expectedAnnualReturn" label={copy.expectedReturn} type="number" placeholder="e.g. 6" min="0" step="0.1" />
        <CalculatorField id="inflationRate" label={copy.inflationRate} type="number" placeholder="e.g. 3" min="0" step="0.1" />
        <CalculatorField id="retirementYears" label={copy.retirementYears} type="number" placeholder="e.g. 30" min="1" step="1" />
      </div>
      <CalculatorActions lang={lang} calculateId="calculateBtn" resetId="resetBtn" copyId="copyBtn" showCopy={true} calculateText={copy.calculate} resetText={copy.reset} copyText={copy.copy} />
      <div id="errorBox" class="error-box" hidden></div>
    </aside>
    <main class="ric-content">
      <div id="emptyState">
        <EmptyState icon="🏖️" title={copy.emptyTitle} description={copy.emptyDesc} tips={[copy.tip1, copy.tip2, copy.tip3]} />
      </div>
      <div id="resultsContainer" hidden>
        <ResultsGrid columns={4}>
          <ResultCard id="monthlyIncomeResult" title={copy.monthlyIncome} icon={Wallet} accent="success" subtitle=" " />
          <ResultCard id="totalAnnualIncomeResult" title={copy.annualIncome} icon={DollarSign} />
          <ResultCard id="rmdAgeResult" title={copy.rmdBegin} icon={Calendar} />
          <ResultCard id="depletionResult" title={copy.portfolioOutlook} icon={TrendingDown} subtitle=" " />
        </ResultsGrid>
        <section class="calculator-info">
          <h2>{copy.aboutTitle}</h2>
          <p>{copy.aboutText}</p>
        </section>
      </div>
    </main>
  </div>
</section>
<script define:vars={{ calcLang: lang }}>
  window.calcLang = calcLang;
</script>
<script>
  import "../../scripts/retirement-income-calculator";
</script>
<style>
.ric-calculator{width:100%;}
.ric-layout{display:grid;grid-template-columns:340px minmax(0,1fr);gap:32px;align-items:start;}
.ric-sidebar{position:sticky;top:24px;display:flex;flex-direction:column;gap:20px;max-height:calc(100vh - 48px);overflow-y:auto;}
.ric-content{display:flex;flex-direction:column;gap:28px;min-width:0;}
.ric-group{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--border-subtle);border-radius:14px;background:var(--bg-card);}
.ric-group h3{margin:0;font-size:.9rem;font-weight:700;color:var(--text-primary);}
.calculator-info{padding:24px;border:1px solid var(--border-subtle);border-radius:18px;background:var(--bg-card);}
.calculator-info h2{margin:0 0 12px;font-size:1.15rem;font-weight:700;color:var(--text-primary);}
.calculator-info p{margin:0;line-height:1.8;font-size:.95rem;color:var(--text-secondary);}
.error-box{display:flex;align-items:center;padding:14px 16px;border-radius:14px;background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;font-size:.92rem;font-weight:600;}
:global(.dark) .error-box{background:#2A1111;border-color:#7F1D1D;color:#FECACA;}
@media(max-width:1024px){.ric-layout{grid-template-columns:1fr;}.ric-sidebar{position:static;max-height:none;}}
@media(max-width:768px){.ric-layout{gap:24px;}.ric-content{gap:20px;}}
@media(max-width:640px){.calculator-info{padding:18px;}}
</style>
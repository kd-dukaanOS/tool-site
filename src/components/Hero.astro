---
import Badge from './ui/Badge.astro';
import Input from './ui/Input.astro';
import Button from './ui/Button.astro';
import { tools } from '../data/tools.js';
const popularSearches = [
  { name: 'JSON Formatter', href: '/developer-tools/json-formatter/' },
  { name: 'Word Counter', href: '/text-tools/word-counter/' },
  { name: 'UUID Generator', href: '/security-tools/uuid-generator/' },
  { name: 'Hash Generator', href: '/security-tools/hash-generator/' },
  { name: 'EMI Calculator', href: '/finance/emi-calculator/' },
  { name: 'GST Calculator', href: '/finance/gst-calculator/' },
  { name: 'BMI Calculator', href: '/health/bmi-calculator/' },
  { name: 'Age Calculator', href: '/date-time/age-calculator/' },
];
---
<section class="ts-hero">
  <div class="ts-hero-float f1"><span class="dot" style="background:#ef4444"></span> JSON</div>
  <div class="ts-hero-float f2"><span class="dot" style="background:#2563eb"></span> BMI</div>
  <div class="ts-hero-float f3"><span class="dot" style="background:#059669"></span> GST</div>
  <div class="ts-hero-float f4"><span class="dot" style="background:#ea580c"></span> EMI</div>
  <div class="ts-hero-float f5"><span class="dot" style="background:#7c3aed"></span> Word Count</div>
  <div class="ts-hero-float f6"><span class="dot" style="background:#d97706"></span> QR Code</div>
  <div class="ts-hero-float f7"><span class="dot" style="background:#0891b2"></span> Percentage</div>
  <div class="ts-hero-float f8"><span class="dot" style="background:#db2777"></span> Age</div>
  <div class="ts-hero-inner reveal">
    <Badge tone="primary" class="ts-hero-badge">
      ✦ 77+ Free Tools · 100% Private · No Sign-up
    </Badge>

    <h1 class="ts-hero-heading">
      Essential Tools.<br />
      <span class="ts-hero-gradient">Instant</span> Results.
    </h1>

    <p class="ts-hero-desc">
      77+ fast, free browser-based tools for developers, creators, and everyday
      tasks — no installs, no accounts, and nothing ever leaves your device.
    </p>

    <div class="ts-hero-search">
      <div class="ts-input-wrap">
        <span class="ts-input-icon">🔍</span>
        <input class="ts-input" type="text" id="hero-search-input" placeholder="Search any tool..." autocomplete="off" />
        <button id="hero-clear-btn" class="ts-hero-clear" style="display:none">✕</button>
        <kbd class="ts-input-kbd">Ctrl /</kbd>
        <button id="hero-search-btn" class="ts-btn ts-btn-primary ts-hero-search-btn">→</button>
      </div>
      <div class="ts-hero-search-results" id="hero-search-results"></div>
    </div>

    <div class="ts-hero-popular">
      <span class="ts-hero-popular-label">Popular:</span>
      {popularSearches.map((term) => (
        <a href={term.href} class="ts-hero-chip">{term.name}</a>
      ))}
    </div>
  </div>
</section>

<style>
  .ts-hero {
    position: relative;
    padding: var(--space-16) var(--space-6) var(--space-12);
    background: var(--bg-hero-glow), var(--bg-page);
    overflow-x: hidden;
  }
  .ts-hero-inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    position: relative;
    z-index: 1;
  }

  .ts-hero-badge { margin-bottom: var(--space-2); }

  .ts-hero-heading {
    font-family: var(--font-sans);
    font-size: var(--fs-hero);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--text-primary);
    margin: 0;
  }
  .ts-hero-gradient {
    background: var(--gradient-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .ts-hero-desc {
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    color: var(--text-secondary);
    max-width: 560px;
    line-height: 1.6;
    margin: 0;
  }

  .ts-hero-search {
    width: 100%;
    max-width: 560px;
    position: relative;
  }
  .ts-hero-search-btn {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
  }

  .ts-hero-popular {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
  }
  .ts-hero-popular-label {
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    color: var(--text-muted);
    margin-right: var(--space-1);
  }
  .ts-hero-chip {
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--text-secondary);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-2xl);
    padding: var(--space-1) var(--space-4);
    text-decoration: none;
    transition: transform var(--duration-fast) var(--ease-standard),
                border-color var(--duration-fast) var(--ease-standard);
  }
  .ts-hero-chip:hover {
    transform: translateY(-1px);
    border-color: var(--border-hover);
    color: var(--text-primary);
  }

  @media (max-width: 600px) {
    .ts-hero { padding: var(--space-12) var(--space-4) var(--space-8); }
  }

  .ts-input-wrap {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    padding: 6px 8px 6px 20px;
    box-shadow: var(--shadow-md);
  }
  .ts-input-icon { color: var(--text-muted); font-size: var(--fs-body); flex-shrink: 0; }
  .ts-input {
    flex: 1;
    border: none;
    outline: none;
    background: none;
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    color: var(--text-primary);
    padding: 8px 0;
  }
  .ts-input-kbd {
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 2px 6px;
    flex-shrink: 0;
  }
  .ts-hero-search-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    flex-shrink: 0;
    padding: 0;
  }
.ts-hero-clear {
    border: none; background: none; cursor: pointer; color: var(--text-muted);
    font-size: 14px; padding: 4px;
  }
  .ts-hero-search-results {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    text-align: left;
    z-index: 30;
  }
  :global(.ts-hero-search-results) {
    display: none;
  }
  :global(.ts-hero-search-results.open) {
    display: block;
    background: var(--bg-card); border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg); overflow-y: auto; max-height: 280px;
    box-shadow: var(--shadow-lg, var(--shadow-md));
    scrollbar-width: thin;
    scrollbar-color: transparent transparent;
  }
  :global(.ts-hero-search-results.open:hover) {
    scrollbar-color: var(--text-muted, #999) transparent;
  }
  :global(.ts-hero-search-results.open::-webkit-scrollbar) { width: 5px; }
  :global(.ts-hero-search-results.open::-webkit-scrollbar-track) { background: transparent; margin-block: 6px; }
  :global(.ts-hero-search-results.open::-webkit-scrollbar-thumb) {
    background: transparent; border-radius: 999px;
  }
  :global(.ts-hero-search-results.open:hover::-webkit-scrollbar-thumb) {
    background: var(--text-muted, #999);
  }
  :global(.ts-hero-result-item) {
    padding-right: 14px;
  }
  :global(.ts-hero-result-item) {
    display: flex;
    width: 100%;
    box-sizing: border-box;
    align-items: center;
    padding: 12px 20px;
    color: var(--text-primary);
    text-decoration: none;
    font-size: var(--fs-small);
    font-weight: 500;
    border-bottom: 1px solid var(--border-subtle);
    transition: background var(--duration-fast) var(--ease-standard);
  }
  :global(.ts-hero-result-item:last-child) { border-bottom: none; }
  :global(.ts-hero-result-item:hover) { background: var(--bg-page); }
  :global(.ts-hero-result-empty) { padding: 14px 20px; color: var(--text-muted); font-size: var(--fs-small); text-align: center; }
</style>

<script define:vars={{ toolsData: JSON.stringify(tools) }}>
  const allTools = JSON.parse(toolsData);
  const input = document.getElementById('hero-search-input');
  const clearBtn = document.getElementById('hero-clear-btn');
  const goBtn = document.getElementById('hero-search-btn');
  const results = document.getElementById('hero-search-results');

  function matchTools(q) {
    q = q.trim().toLowerCase();
    if (!q) return [];
    const scored = allTools
      .map(t => {
        const name = t.name.toLowerCase();
        const words = name.split(' ');
        let score = -1;
        if (name.startsWith(q)) score = 0;
        else if (words.some(w => w.startsWith(q))) score = 1;
        return { t, score };
      })
      .filter(x => x.score !== -1)
      .sort((a, b) => a.score - b.score || a.t.name.length - b.t.name.length);
    return scored.map(x => x.t).slice(0, 6);
  }

  function render() {
    const q = input.value;
    clearBtn.style.display = q ? 'block' : 'none';
    const matches = matchTools(q);
    if (!q) { results.innerHTML = ''; results.classList.remove('open'); return; }
    results.innerHTML = matches.length
      ? matches.map(t => `<a href="/${t.category}/${t.slug}/" class="ts-hero-result-item">${t.name}</a>`).join('')
      : '<div class="ts-hero-result-empty">No tools found</div>';
    results.classList.add('open');
  }

  input?.addEventListener('input', render);

  clearBtn?.addEventListener('click', () => {
    input.value = '';
    render();
    input.focus();
  });

  function goToFirstMatch() {
    const matches = matchTools(input.value);
    if (matches.length) window.location.href = `/${matches[0].category}/${matches[0].slug}/`;
  }

  goBtn?.addEventListener('click', goToFirstMatch);
  input?.addEventListener('keydown', (e) => { if (e.key === 'Enter') goToFirstMatch(); });

  document.addEventListener('click', (e) => {
    if (!e.target.closest('.ts-hero-search')) results?.classList.remove('open');
  });
</script>
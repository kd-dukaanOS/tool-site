---
import { categories, tools } from '../data/tools.js';
import { SPANISH_CATEGORIES, SPANISH_TOOLS } from '../utils/i18n';

interface Props {
  lang?: "en" | "es";
}

const { lang = "en" } = Astro.props as Props;

const isEs = lang === "es";
const homeHref = isEs ? "/es/" : "/";

const copy = {
  en: {
    tagline: "Fast, private, free tools for everyday work — nothing ever leaves your browser.",
    categoriesTitle: "Categories",
    resourcesTitle: "Resources",
    popularTitle: "Popular",
    legalTitle: "Legal",
    about: "About",
    contact: "Contact",
    blog: "Blog",
    tools: "All Tools",
    privacy: "Privacy Policy",
    terms: "Terms & Conditions",
    rights: "All rights reserved.",
  },
  es: {
    tagline: "Herramientas rápidas, privadas y gratuitas para el trabajo diario — nada sale de tu navegador.",
    categoriesTitle: "Categorías",
    resourcesTitle: "Recursos",
    popularTitle: "Populares",
    legalTitle: "Legal",
    about: "Quiénes Somos",
    contact: "Contacto",
    blog: "Blog",
    tools: "Todas las Herramientas",
    privacy: "Política de Privacidad",
    terms: "Términos y Condiciones",
    rights: "Todos los derechos reservados.",
  },
}[lang];

const footerCategories = isEs
  ? SPANISH_CATEGORIES.slice(0, 5).map(c => ({ name: c.name, href: `/es/${c.slug}/` }))
  : categories.slice(0, 5).map(c => ({ name: c.name, href: `/${c.slug}/` }));

const footerPopular = isEs
  ? SPANISH_TOOLS.slice(0, 5).map(t => ({ name: t.name, href: `/es/${t.category}/${t.slug}/` }))
  : tools.slice(0, 5).map(t => ({ name: t.name, href: `/${t.category}/${t.slug}/` }));

const resources = isEs
  ? [
      { name: copy.about, href: "/es/about/" },
      { name: copy.contact, href: "/es/contact/" },
      { name: copy.tools, href: "/es/tools/" },
    ]
  : [
      { name: copy.blog, href: "/blog/" },
      { name: copy.about, href: "/about/" },
      { name: copy.contact, href: "/contact/" },
    ];

const legal = isEs
  ? [
      { name: copy.privacy, href: "/es/privacy-policy/" },
      { name: copy.terms, href: "/es/terms/" },
    ]
  : [
      { name: copy.privacy, href: "/privacy-policy/" },
      { name: copy.terms, href: "/terms/" },
    ];
---
<footer class="ts-footer">
  <div class="ts-footer-inner">
    <div class="ts-footer-grid">
      <div class="ts-footer-brand">
        <a href={homeHref} class="ts-footer-logo"><span class="ts-footer-mark">T</span>TooManyToolz</a>
        <p>{copy.tagline}</p>
      </div>
      <div>
        <h5>{copy.categoriesTitle}</h5>
        <ul>{footerCategories.map((c) => <li><a href={c.href}>{c.name}</a></li>)}</ul>
      </div>
      <div>
        <h5>{copy.resourcesTitle}</h5>
        <ul>{resources.map((r) => <li><a href={r.href}>{r.name}</a></li>)}</ul>
      </div>
      <div>
        <h5>{copy.popularTitle}</h5>
        <ul>{footerPopular.map((t) => <li><a href={t.href}>{t.name}</a></li>)}</ul>
      </div>
      <div>
        <h5>{copy.legalTitle}</h5>
        <ul>{legal.map((l) => <li><a href={l.href}>{l.name}</a></li>)}</ul>
      </div>
    </div>
    <div class="ts-footer-bottom">
      <span>© 2026 TooManyToolz. {copy.rights}</span>
      <div class="ts-footer-social">
        <a href="https://github.com" aria-label="GitHub">GitHub</a>
        <a href="https://twitter.com" aria-label="Twitter">Twitter</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .ts-footer { border-top: 1px solid var(--border-subtle); margin-top: var(--space-8); padding: var(--space-8) var(--space-6) var(--space-6); }
  .ts-footer-inner { max-width: 1120px; margin: 0 auto; }
  .ts-footer-grid { display: grid; grid-template-columns: 1.6fr repeat(4, 1fr); gap: var(--space-6); margin-bottom: var(--space-6); }
  .ts-footer-brand p { font-size: 13px; color: var(--text-muted); margin-top: var(--space-2); max-width: 220px; line-height: 1.5; }
  .ts-footer-logo { display: flex; align-items: center; gap: 8px; font-family: var(--font-sans); font-weight: 700; font-size: 17px; color: var(--text-primary); }
  .ts-footer-mark { width: 26px; height: 26px; border-radius: 7px; background: var(--gradient-brand); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 13px; }
  .ts-footer h5 { font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin: 0 0 var(--space-3); }
  .ts-footer ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .ts-footer ul a { font-size: 13.5px; color: var(--text-secondary); }
  .ts-footer ul a:hover { color: var(--text-primary); }
  .ts-footer-bottom {
    display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--space-2);
    padding-top: var(--space-4); border-top: 1px solid var(--border-subtle);
    font-size: 12.5px; color: var(--text-muted);
  }
  .ts-footer-social { display: flex; gap: var(--space-4); }
  .ts-footer-social a { color: var(--text-secondary); font-size: 12.5px; }
  .ts-footer-social a:hover { color: var(--text-primary); }

  @media (max-width: 860px) { .ts-footer-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .ts-footer-grid { grid-template-columns: 1fr; } }
</style>

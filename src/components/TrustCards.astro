---
const trustItems = [
  { icon: '✨', title: '77+', subtitle: 'Free Tools' },
  { icon: '🛡️', title: '100%', subtitle: 'Runs in Your Browser' },
  { icon: '🔒', title: 'No Sign-up', subtitle: 'Ever Needed' },
  { icon: '🛡️', title: 'Private', subtitle: 'Your Data Stays Local' },
  { icon: '⚡', title: 'Lightning Fast', subtitle: 'Instant Results' },
  { icon: '❤️', title: 'Open Source', subtitle: 'Community Driven' },
];
---
<section class="ts-trust">
  <div class="ts-trust-inner">
    {trustItems.map((item) => (
      <div class="ts-trust-item">
        <span class="ts-trust-icon">{item.icon}</span>
        <div class="ts-trust-text">
          <span class="ts-trust-title">{item.title}</span>
          <span class="ts-trust-subtitle">{item.subtitle}</span>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .ts-trust {
    padding: 0 var(--space-6) var(--space-8);
  }
  .ts-trust-inner {
    max-width: 1280px;
    margin: 0 auto;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
    padding: var(--space-4) var(--space-6);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .ts-trust-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex: 1 1 160px;
    min-width: 160px;
  }
  .ts-trust-icon {
    font-size: 1.25rem;
    flex-shrink: 0;
  }
  .ts-trust-text {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .ts-trust-title {
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--text-primary);
  }
  .ts-trust-subtitle {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  @media (max-width: 700px) {
    .ts-trust-inner { justify-content: flex-start; }
    .ts-trust-item { flex: 1 1 45%; }
  }
</style>
---
const highlights = [
  { icon: '🔒', text: 'Calculations run in your browser — nothing you type is uploaded.' },
  { icon: '⚡', text: 'No sign-up, no install. Open a tool and get your result instantly.' },
  { icon: '♾️', text: 'Every tool is free with unlimited use, no paywalls or limits.' },
];
---
<section class="ts-social">
  <div class="ts-social-inner">
    <div class="ts-social-left">
      <div>
        <p class="ts-social-title">Built for speed and privacy</p>
        <p class="ts-social-sub">77+ browser-based tools, no accounts required.</p>
      </div>
    </div>

    <div class="ts-social-quote">
      {highlights.map((h) => (
        <div class="ts-social-highlight">
          <span class="ts-social-highlight-icon">{h.icon}</span>
          <p>{h.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .ts-social { padding: var(--space-12) var(--space-6); }
  .ts-social-inner {
    max-width: 1120px; margin: 0 auto;
    display: grid; grid-template-columns: 1.1fr 1fr; gap: var(--space-8);
    align-items: center;
  }
  .ts-social-left { display: flex; gap: var(--space-4); align-items: flex-start; }
  .ts-social-title { font-family: var(--font-sans); font-weight: 700; font-size: var(--fs-h3); color: var(--text-primary); margin: 0 0 4px; }
  .ts-social-sub { font-size: var(--fs-small); color: var(--text-secondary); margin: 0; max-width: 320px; }

  .ts-social-quote {
    background: var(--bg-card); border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl); padding: var(--space-6);
    box-shadow: var(--shadow-sm); margin: 0;
    display: flex; flex-direction: column; gap: var(--space-3);
  }
  .ts-social-highlight { display: flex; align-items: flex-start; gap: var(--space-3); }
  .ts-social-highlight-icon { font-size: 18px; line-height: 1.4; flex-shrink: 0; }
  .ts-social-highlight p { font-size: var(--fs-small); color: var(--text-primary); margin: 0; line-height: 1.5; }

  @media (max-width: 720px) {
    .ts-social-inner { grid-template-columns: 1fr; }
    .ts-social-left { flex-direction: column; }
  }
</style>
